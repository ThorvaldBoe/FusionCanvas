<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:groups="using:FusionCanvas.App.Groups"
        x:Class="FusionCanvas.App.Groups.GroupActionConfirmationWindow"
        x:DataType="groups:GroupActionConfirmationViewModel"
        Title="Confirm group action"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto" Margin="24" RowSpacing="22">
    <StackPanel Spacing="10">
      <TextBlock Text="{Binding Title}"
                 FontSize="20"
                 FontWeight="SemiBold" />
      <TextBlock Text="{Binding Message}"
                 TextWrapping="Wrap"
                 FontSize="14" />
    </StackPanel>
    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">
      <Button Content="Cancel" MinWidth="90" Click="OnCancelClick" />
      <Button Content="Confirm" MinWidth="100" Click="OnConfirmClick" />
    </StackPanel>
  </Grid>
</Window>
