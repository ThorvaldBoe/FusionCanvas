<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:stores="using:FusionCanvas.App.Stores"
        xmlns:printify="using:FusionCanvas.Application.Stores.Printify"
        x:Class="FusionCanvas.App.Stores.PrintifyListingImportWindow"
        x:DataType="stores:PrintifyListingImportViewModel"
        Title="Import from Printify"
        Width="900" Height="680" MinWidth="680" MinHeight="480"
        Background="{DynamicResource ApplicationBackgroundBrush}">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20" RowSpacing="12">
    <StackPanel Spacing="4">
      <TextBlock Text="Import from Printify" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" />
      <TextBlock Text="Choose existing shop listings to add to this Niche. Imported Printify products are read only." Foreground="{DynamicResource SecondaryTextBrush}" />
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
      <Button Content="Refresh" Command="{Binding LoadCommand}" Classes="secondary" />
      <Button Content="Show/hide linked products" Command="{Binding ToggleLinkedCommand}" Classes="secondary" />
      <Button Content="Check selected for duplicates" Command="{Binding CheckDuplicatesCommand}" IsEnabled="{Binding CanImport}" Classes="secondary" />
      <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
    </StackPanel>
    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding VisibleProducts}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="stores:PrintifyListingImportRowViewModel">
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10">
                <Grid ColumnDefinitions="Auto,*,Auto,250" ColumnSpacing="12">
                  <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding !IsLinked}" VerticalAlignment="Center" AutomationProperties.AutomationId="Printify.ProductSelection" />
                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ProductId}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding ImportOutcome}" IsVisible="{Binding HasImportOutcome}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Visibility}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="3" Spacing="4">
                    <TextBlock Text="{Binding CandidateSummary}" IsVisible="{Binding HasCandidates}" FontSize="11" TextWrapping="Wrap" />
                    <ComboBox ItemsSource="{Binding ConnectableCandidates}" SelectedItem="{Binding SelectedCandidate}" PlaceholderText="Import as new">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="printify:PrintifyListingImportCandidate">
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Already linked" IsVisible="{Binding IsLinked}" Foreground="{DynamicResource SecondaryTextBrush}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
      <TextBlock Grid.Column="0" Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Open Store setup" Click="OnOpenStoreSetup" Classes="secondary" />
      <Button Grid.Column="2" Content="Cancel operation" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Classes="secondary" />
      <Button Grid.Column="3" Content="Close" Click="OnClose" Classes="secondary" AutomationProperties.AutomationId="Printify.CloseImport" />
      <Button Grid.Column="4" Content="Import selected" Command="{Binding ImportCommand}" IsEnabled="{Binding CanImport}" AutomationProperties.AutomationId="Printify.ConfirmImport" />
    </Grid>
  </Grid>
</Window>
