<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:stores="clr-namespace:FusionCanvas.App.Stores"
        xmlns:appStores="clr-namespace:FusionCanvas.Application.Stores;assembly=FusionCanvas.Application"
        xmlns:appNiches="clr-namespace:FusionCanvas.Application.Niches;assembly=FusionCanvas.Application"
        xmlns:appTags="clr-namespace:FusionCanvas.Application.Tags;assembly=FusionCanvas.Application"
        xmlns:appProducts="clr-namespace:FusionCanvas.Application.Products;assembly=FusionCanvas.Application"
        xmlns:catalog="clr-namespace:FusionCanvas.Domain.Catalog;assembly=FusionCanvas.Domain"
        xmlns:mockups="clr-namespace:FusionCanvas.Domain.Mockups;assembly=FusionCanvas.Domain"
        xmlns:virtualGrid="clr-namespace:AvaloniaVirtualDataGrid.Controls;assembly=AvaloniaVirtualDataGrid"
        xmlns:virtualColumns="clr-namespace:AvaloniaVirtualDataGrid.Columns;assembly=AvaloniaVirtualDataGrid"
        x:Class="FusionCanvas.App.Stores.StoreEditorWindow"
        x:DataType="stores:StoreManagementViewModel"
        Title="Store Editor"
        Width="900"
        Height="620"
        MinWidth="720"
        MinHeight="520"
        Background="{DynamicResource ApplicationBackgroundBrush}">
  <Window.Resources>
    <stores:FulfillmentStrategyLabelConverter x:Key="FulfillmentStrategyLabel" />
  </Window.Resources>
  <Grid ColumnDefinitions="260,*"
        RowDefinitions="*">
    <Border Grid.Column="0"
            Background="{DynamicResource ElevatedSurfaceBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="0,0,1,0"
            Padding="{DynamicResource Token.Layout.Padding.Uniform.SectionPlus}">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top"
                    Spacing="{DynamicResource Token.Spacing.ControlGap}"
                    Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_None.Right_None.Bottom_SectionPlus}">
          <TextBlock Text="Stores"
                     FontSize="{DynamicResource Token.Typography.ToolTitle}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}" />
          <Button Content="New store"
                  AutomationProperties.AutomationId="StoreEditor.NewStore"
                  Command="{Binding StartCreateStoreCommand}"
                  Classes="primary" />
        </StackPanel>

        <StackPanel Spacing="{DynamicResource Token.Spacing.Gap.Panel}">
          <TextBlock Text="Active"
                     FontSize="{DynamicResource Token.Typography.Caption}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource SecondaryTextBrush}" />
          <ItemsControl ItemsSource="{Binding EditorActiveStores}"
                        AutomationProperties.AutomationId="StoreEditor.ActiveStores">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="appStores:StoreSummary">
                <Button Content="{Binding Name}"
                        Command="{Binding $parent[ItemsControl].DataContext.EditStoreCommand}"
                        CommandParameter="{Binding}"
                        Classes="listItem"
                        HorizontalContentAlignment="Left" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock IsVisible="{Binding HasArchivedStores}"
                     Text="Archived"
                     FontSize="{DynamicResource Token.Typography.Caption}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_Control.Right_None.Bottom_None}" />
          <ItemsControl IsVisible="{Binding HasArchivedStores}"
                        ItemsSource="{Binding ArchivedStores}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="appStores:StoreSummary">
                <Button Content="{Binding Name}"
                        Command="{Binding $parent[ItemsControl].DataContext.EditStoreCommand}"
                        CommandParameter="{Binding}"
                        Classes="listItem"
                        HorizontalContentAlignment="Left" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Column="1"
            Margin="{DynamicResource Token.Layout.Margin.Uniform.Large}"
            Padding="{DynamicResource Token.Layout.Padding.Uniform.Wide}"
            Background="{DynamicResource ElevatedSurfaceBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1">
      <ScrollViewer>
        <StackPanel Spacing="{DynamicResource Token.Spacing.Gap.Panel}">
          <TextBlock Text="Store Management"
                     FontSize="{DynamicResource Token.Typography.PageHeading}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}" />
          <TextBlock Text="{Binding ErrorMessage}"
                     IsVisible="{Binding HasError}"
                     FontSize="{DynamicResource Token.Typography.Caption}"
                     Foreground="{DynamicResource DangerTextBrush}" />
          <ProgressBar IsVisible="{Binding IsBusy}"
                       IsIndeterminate="True"
                       Height="4"
                       AutomationProperties.Name="Working with store" />
          <Border AutomationProperties.AutomationId="StoreEditor.TabNavigation"
                  Background="{DynamicResource TabBarBackgroundBrush}"
                  BorderBrush="{DynamicResource TabBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="{DynamicResource Token.Layout.CompactPadding}">
            <StackPanel Orientation="Horizontal"
                        Spacing="{DynamicResource Token.Spacing.ControlGap}">
              <Button Content="Basic info"
                      Command="{Binding SelectBasicInfoTabCommand}"
                      Classes="tabButton"
                      Classes.selected="{Binding IsBasicInfoTabSelected}" />
              <Button Content="Niches"
                      Command="{Binding SelectNichesTabCommand}"
                      Classes="tabButton"
                      Classes.selected="{Binding IsNichesTabSelected}" />
              <Button Content="Tags"
                      Command="{Binding SelectTagsTabCommand}"
                      Classes="tabButton"
                      Classes.selected="{Binding IsTagsTabSelected}" />
              <Button Content="Catalog &amp; mockups"
                      Command="{Binding SelectProductsTabCommand}"
                      Classes="tabButton"
                      Classes.selected="{Binding IsProductsTabSelected}" />
            </StackPanel>
          </Border>

          <Border AutomationProperties.AutomationId="StoreEditor.TabContent"
                  Background="{DynamicResource PanelSurfaceBrush}"
                  BorderBrush="{DynamicResource TabBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="{DynamicResource Token.Layout.CardPadding}">
            <StackPanel Spacing="{DynamicResource Token.Spacing.Gap.Panel}">
              <StackPanel IsVisible="{Binding IsBasicInfoTabSelected}"
                          Spacing="{DynamicResource Token.Spacing.Gap.Panel}">
            <TextBlock Text="Basic info"
                       FontSize="{DynamicResource Token.Typography.SubsectionHeading}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource StrongTextBrush}" />
            <TextBox x:Name="StoreNameTextBox"
                     AutomationProperties.AutomationId="StoreEditor.Name"
                     Text="{Binding NewStoreName}"
                     PlaceholderText="Store name"
                     Classes="field" />
            <TextBox Text="{Binding Description}"
                     PlaceholderText="Description"
                     Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_None.Right_SectionPlus.Bottom_None}"
                     Classes="field" />
            <StackPanel Spacing="{DynamicResource Token.Spacing.CompactGap}">
              <TextBlock Text="Fulfillment strategy"
                         FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding AvailableFulfillmentStrategies}"
                        SelectedItem="{Binding SelectedFulfillmentStrategy}"
                        IsEnabled="{Binding CanEditStoreConfiguration}"
                        AutomationProperties.AutomationId="StoreEditor.FulfillmentStrategy">
                <ComboBox.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding ., Converter={StaticResource FulfillmentStrategyLabel}}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <StackPanel IsVisible="{Binding ShowStrategyWarning}" Spacing="{DynamicResource Token.Spacing.ControlGap}">
                <TextBlock Text="Changing strategy makes Printify configuration unavailable. The saved key and catalog will be retained. Save this change?" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Token.Spacing.ControlGap}">
                  <Button Content="Save strategy change" Command="{Binding ConfirmStrategyCommand}" />
                  <Button Content="Cancel strategy change" Command="{Binding CancelStrategyCommand}" />
                </StackPanel>
              </StackPanel>
              <StackPanel DataContext="{Binding PrintifyCredentials}" x:DataType="stores:StorePrintifyCredentialsViewModel"
                          IsVisible="{Binding IsVisible}" Spacing="{DynamicResource Token.Spacing.ControlGap}">
                <TextBlock Text="{Binding Status}" IsVisible="{Binding !IsMissing}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Status}" IsVisible="{Binding IsMissing}" Foreground="{DynamicResource DangerStrongBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Token.Spacing.ControlGap}">
                  <Button x:Name="PrintifyManageButton" Content="{Binding ManageLabel}" Command="{Binding ManageCommand}" IsEnabled="{Binding CanManage}" />
                  <Button Content="Verify" Command="{Binding VerifyCommand}" IsVisible="{Binding HasKey}" IsEnabled="{Binding CanVerify}" />
                  <Button Content="Retry" Command="{Binding RetryCommand}" IsVisible="{Binding HasError}" />
                </StackPanel>
                <TextBlock Text="Save the selected Printify strategy before verifying." IsVisible="{Binding ShowSaveGuidance}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding RepairGuidance}" IsVisible="{Binding HasRepairGuidance}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Text="{Binding Verification}" TextWrapping="Wrap" />
                <ComboBox ItemsSource="{Binding Shops}" SelectedItem="{Binding SelectedShop, Mode=TwoWay}" DisplayMemberBinding="{Binding DisplayName}" IsVisible="{Binding HasKey}" PlaceholderText="Select Printify shop" AutomationProperties.AutomationId="StoreEditor.PrintifyShop" />
              </StackPanel>
              <TextBlock Text="Manual means Fusion Canvas records catalog data locally without communicating with Shopify or Printify. Shopify + Manual does not connect to Printify. Printify and Shopify + Printify use a Printify key; standalone Printify does not enable Shopify integration or publishing. Verify runs only when requested."
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
            <TextBox Text="{Binding Notes}"
                     PlaceholderText="Notes"
                     Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_None.Right_SectionPlus.Bottom_None}"
                     AcceptsReturn="True"
                     MinHeight="84"
                     Classes="field" />
            <TextBox Text="{Binding TargetMarket}"
                     PlaceholderText="Target market"
                     Classes="field" />
            <TextBox Text="{Binding BrandDirection}"
                     PlaceholderText="Brand direction"
                     Classes="field" />
            <TextBox Text="{Binding PlanningContext}"
                     PlaceholderText="Planning context"
                     Classes="field" />
            <TextBox Text="{Binding Url}"
                     PlaceholderText="Store URL"
                     Classes="field" />

            <StackPanel Orientation="Horizontal"
                        Spacing="{DynamicResource Token.Spacing.ControlGap}"
                        Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_Control.Right_None.Bottom_None}">
              <Button Content="Save"
                      AutomationProperties.AutomationId="StoreEditor.SaveStore"
                      Command="{Binding SaveSelectedStoreCommand}"
                      IsEnabled="{Binding CanSaveSelectedStore}"
                      Classes="primary fixedAction" />
              <Button Content="Archive"
                      Command="{Binding ArchiveSelectedStoreCommand}"
                      IsEnabled="{Binding CanArchiveSelectedStore}"
                      Classes="secondary fixedAction" />
              <Button Content="Delete"
                      Command="{Binding RequestDeleteSelectedStoreCommand}"
                      IsEnabled="{Binding CanDeleteSelectedStore}"
                      Classes="danger fixedAction" />
            </StackPanel>

            <Button Content="Restore selected archived store"
                    IsVisible="{Binding CanRestoreSelectedStore}"
                    Command="{Binding RestoreStoreCommand}"
                    CommandParameter="{Binding SelectedStore}"
                    Classes="secondary restoreAction" />
              </StackPanel>

          <Grid IsVisible="{Binding IsNichesTabSelected}"
                ColumnDefinitions="220,*"
                ColumnSpacing="{DynamicResource Token.Spacing.Gap.SectionPlus}">
            <StackPanel Grid.Column="0"
                        Spacing="{DynamicResource Token.Spacing.GroupGap}">
              <Button Content="New niche"
                      Command="{Binding StartCreateNicheCommand}"
                      Classes="primary" />
              <TextBlock Text="Active niches"
                         FontSize="{DynamicResource Token.Typography.Caption}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <TextBlock Text="No active niches"
                         IsVisible="{Binding !HasActiveNiches}"
                         FontSize="{DynamicResource Token.Typography.Caption}"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <ItemsControl ItemsSource="{Binding EditorActiveNiches}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="appNiches:NicheSummary">
                    <Button Content="{Binding Name}"
                            Command="{Binding $parent[ItemsControl].DataContext.EditNicheCommand}"
                            CommandParameter="{Binding}"
                            Classes="listItem"
                            HorizontalContentAlignment="Left" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock IsVisible="{Binding HasArchivedNiches}"
                         Text="Archived niches"
                         FontSize="{DynamicResource Token.Typography.Caption}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_Control.Right_None.Bottom_None}" />
              <ItemsControl IsVisible="{Binding HasArchivedNiches}"
                            ItemsSource="{Binding ArchivedNiches}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="appNiches:NicheSummary">
                    <Button Content="{Binding Name}"
                            Command="{Binding $parent[ItemsControl].DataContext.EditNicheCommand}"
                            CommandParameter="{Binding}"
                            Classes="listItem"
                            HorizontalContentAlignment="Left" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Spacing="{DynamicResource Token.Spacing.GroupGap}"
                        Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_None.Right_SectionPlus.Bottom_None}">
              <TextBlock Text="Niche details"
                         FontSize="{DynamicResource Token.Typography.SubsectionHeading}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource StrongTextBrush}" />
              <Grid ColumnDefinitions="*,Auto"
                    ColumnSpacing="{DynamicResource Token.Spacing.ControlGap}"
                    Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_None.Right_SectionPlus.Bottom_None}">
                <TextBox Grid.Column="0"
                         Text="{Binding NicheName}"
                         PlaceholderText="Niche name"
                         ToolTip.Tip="Niche name"
                         Classes="field" />
                <Button Grid.Column="1"
                        Content="{Binding NichePopulationButtonText}"
                        Command="{Binding PopulateNicheCommand}"
                        IsEnabled="{Binding CanPopulateNiche}"
                        AutomationProperties.Name="Populate niche fields"
                        AutomationProperties.AutomationId="StoreEditor.PopulateNiche"
                        Classes="secondary nichePopulateAction" />
              </Grid>
              <ProgressBar IsVisible="{Binding IsNichePopulationBusy}"
                           IsIndeterminate="True"
                           Height="4"
                           Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_None.Right_SectionPlus.Bottom_None}" />
              <TextBlock Text="{Binding NichePopulationStatusMessage}"
                         IsVisible="{Binding HasNichePopulationStatus}"
                         TextWrapping="Wrap"
                         FontSize="{DynamicResource Token.Typography.Caption}"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_None.Right_SectionPlus.Bottom_None}" />
              <TextBox Text="{Binding NicheDescription}"
                       PlaceholderText="Description"
                       ToolTip.Tip="Description"
                       Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_None.Right_SectionPlus.Bottom_None}"
                       Classes="field" />
              <TextBox Text="{Binding NicheAudience}"
                       PlaceholderText="Audience"
                       ToolTip.Tip="Audience"
                       Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_None.Right_SectionPlus.Bottom_None}"
                       Classes="field" />
              <TextBox Text="{Binding NicheHumorStyle}"
                       PlaceholderText="Humor style"
                       ToolTip.Tip="Humor style"
                       Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_None.Right_SectionPlus.Bottom_None}"
                       Classes="field" />
              <TextBox Text="{Binding NicheVisualStyleGuidance}"
                       PlaceholderText="Visual style guidance"
                       ToolTip.Tip="Visual style guidance"
                       Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_None.Right_SectionPlus.Bottom_None}"
                       Classes="field" />
              <TextBox Text="{Binding NicheConstraints}"
                       PlaceholderText="Constraints"
                       ToolTip.Tip="Constraints"
                       Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_None.Right_SectionPlus.Bottom_None}"
                       Classes="field" />
              <TextBox Text="{Binding NicheRisks}"
                       PlaceholderText="Risks"
                       ToolTip.Tip="Risks"
                       Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_None.Right_SectionPlus.Bottom_None}"
                       Classes="field" />
              <TextBox Text="{Binding NicheResearchNotes}"
                       PlaceholderText="Research notes"
                       ToolTip.Tip="Research notes"
                       Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_None.Right_SectionPlus.Bottom_None}"
                       AcceptsReturn="True"
                       MinHeight="70"
                       Classes="field" />
              <TextBox Text="{Binding NicheNotes}"
                       PlaceholderText="Notes"
                       ToolTip.Tip="Notes"
                       Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_None.Right_SectionPlus.Bottom_None}"
                       AcceptsReturn="True"
                       MinHeight="70"
                       Classes="field" />

              <StackPanel Orientation="Horizontal"
                          Spacing="{DynamicResource Token.Spacing.ControlGap}"
                          Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_Control.Right_None.Bottom_None}">
                <Button Content="Save"
                        Command="{Binding SaveSelectedNicheCommand}"
                        IsEnabled="{Binding CanSaveSelectedNiche}"
                        Classes="primary fixedAction" />
                <Button Content="Archive"
                        Command="{Binding ArchiveSelectedNicheCommand}"
                        IsEnabled="{Binding CanArchiveSelectedNiche}"
                        Classes="secondary fixedAction" />
                <Button Content="Delete"
                        Command="{Binding RequestDeleteSelectedNicheCommand}"
                        IsEnabled="{Binding CanDeleteSelectedNiche}"
                        Classes="danger fixedAction" />
              </StackPanel>

              <Button Content="Restore selected archived niche"
                      IsVisible="{Binding CanRestoreSelectedNiche}"
                      Command="{Binding RestoreNicheCommand}"
                      CommandParameter="{Binding SelectedNiche}"
                      Classes="secondary restoreAction" />
            </StackPanel>
          </Grid>

          <Grid IsVisible="{Binding IsTagsTabSelected}"
                ColumnDefinitions="220,*"
                ColumnSpacing="{DynamicResource Token.Spacing.Gap.SectionPlus}">
            <StackPanel Grid.Column="0"
                        Spacing="{DynamicResource Token.Spacing.GroupGap}">
              <Button Content="New tag"
                      Command="{Binding StartCreateTagCommand}"
                      Classes="primary" />
              <TextBlock Text="Active tags"
                         FontSize="{DynamicResource Token.Typography.Caption}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <TextBlock Text="No active tags"
                         IsVisible="{Binding !HasActiveTags}"
                         FontSize="{DynamicResource Token.Typography.Caption}"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <ItemsControl ItemsSource="{Binding EditorActiveTags}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="appTags:TagSummary">
                    <Button Content="{Binding Name}"
                            Command="{Binding $parent[ItemsControl].DataContext.EditTagCommand}"
                            CommandParameter="{Binding}"
                            Classes="listItem"
                            HorizontalContentAlignment="Left" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock IsVisible="{Binding HasArchivedTags}"
                         Text="Archived tags"
                         FontSize="{DynamicResource Token.Typography.Caption}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_Control.Right_None.Bottom_None}" />
              <ItemsControl IsVisible="{Binding HasArchivedTags}"
                            ItemsSource="{Binding ArchivedTags}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="appTags:TagSummary">
                    <Button Content="{Binding Name}"
                            Command="{Binding $parent[ItemsControl].DataContext.EditTagCommand}"
                            CommandParameter="{Binding}"
                            Classes="listItem"
                            HorizontalContentAlignment="Left" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Spacing="{DynamicResource Token.Spacing.GroupGap}"
                        Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_None.Right_SectionPlus.Bottom_None}">
              <TextBlock Text="Tag details"
                         FontSize="{DynamicResource Token.Typography.SubsectionHeading}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource StrongTextBrush}" />
              <TextBox Text="{Binding TagName}"
                       PlaceholderText="Tag name"
                       Classes="field" />
              <StackPanel Spacing="{DynamicResource Token.Spacing.CompactGap}">
                <TextBlock Text="Color"
                           FontSize="{DynamicResource Token.Typography.Caption}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBox Text="{Binding TagColor}"
                         PlaceholderText="#RRGGBB (optional)"
                         Classes="field" />
              </StackPanel>
              <TextBox Text="{Binding TagDescription}"
                       PlaceholderText="Description"
                       Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_None.Right_Broad.Bottom_None}"
                       Classes="field" />

              <StackPanel Orientation="Horizontal"
                          Spacing="{DynamicResource Token.Spacing.ControlGap}"
                          Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_Control.Right_None.Bottom_None}">
                <Button Content="Save"
                        Command="{Binding SaveSelectedTagCommand}"
                        IsEnabled="{Binding CanSaveSelectedTag}"
                        Classes="primary fixedAction" />
                <Button Content="Archive"
                        Command="{Binding ArchiveSelectedTagCommand}"
                        IsEnabled="{Binding CanArchiveSelectedTag}"
                        Classes="secondary fixedAction" />
                <Button Content="Delete"
                        Command="{Binding RequestDeleteSelectedTagCommand}"
                        IsEnabled="{Binding CanDeleteSelectedTag}"
                        Classes="danger fixedAction" />
              </StackPanel>

              <Button Content="Restore selected archived tag"
                      IsVisible="{Binding CanRestoreSelectedTag}"
                      Command="{Binding RestoreTagCommand}"
                      CommandParameter="{Binding SelectedTag}"
                      Classes="secondary restoreAction" />
            </StackPanel>
          </Grid>

          <Border IsVisible="{Binding TagDeleteWarningVisible}"
                  Background="{DynamicResource DangerBackgroundBrush}"
                  BorderBrush="{DynamicResource DangerBorderBrush}"
                  BorderThickness="1"
                  Padding="{DynamicResource Token.Layout.Padding.Uniform.Panel}"
                  Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_Control.Right_None.Bottom_None}">
            <StackPanel Spacing="{DynamicResource Token.Spacing.ControlGap}">
              <TextBlock Text="{Binding TagDeleteWarningMessage}"
                         FontSize="{DynamicResource Token.Typography.Body}"
                         Foreground="{DynamicResource DangerTextBrush}" />
              <StackPanel Orientation="Horizontal"
                          Spacing="{DynamicResource Token.Spacing.ControlGap}">
                <Button Content="Delete permanently"
                        Command="{Binding ConfirmDeleteTagCommand}"
                        IsEnabled="{Binding CanConfirmDeleteTag}"
                        Classes="danger fixedDanger" />
                <Button Content="Cancel"
                        Command="{Binding CancelDeleteTagCommand}"
                        Classes="secondary fixedAction" />
              </StackPanel>
            </StackPanel>
          </Border>

          <StackPanel IsVisible="{Binding IsProductsTabSelected}"
                      Spacing="{DynamicResource Token.Spacing.Gap.Panel}">
            <StackPanel IsVisible="{Binding IsCatalogOverview}"
                        Spacing="{DynamicResource Token.Spacing.Gap.Panel}">
              <TextBlock Text="Catalog overview"
                         FontSize="{DynamicResource Token.Typography.SubsectionHeading}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource StrongTextBrush}" />
              <TextBlock Text="Define Blueprints, fulfillment offerings, Variants, and Placeholders. Blueprint is Printify terminology for the base product; Placeholder is the named design target on an offering."
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Token.Spacing.ControlGap}">
                <Button Content="New Blueprint"
                        Command="{Binding StartCreateProductCommand}"
                        IsEnabled="{Binding CanCreateCatalogItem}"
                        Classes="primary" />
                <CheckBox Content="Show archived Blueprints"
                          IsChecked="{Binding ShowArchivedProducts, Mode=TwoWay}"
                          AutomationProperties.AutomationId="Catalog.ShowArchivedBlueprints" />
                <Button Content="Import from Printify"
                        x:Name="PrintifyImportButton"
                        Command="{Binding PrintifyCatalogImportSession.OpenCommand}"
                        IsVisible="{Binding PrintifyCatalogImportSession, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Classes="secondary"
                        AutomationProperties.AutomationId="Catalog.ImportFromPrintify" />
              </StackPanel>
              <Border x:Name="PrintifyImportPanel" IsVisible="{Binding PrintifyCatalogImportSession.IsOpen}"
                      Focusable="True"
                      KeyDown="OnPrintifyImportKeyDown"
                      Classes="panel"
                      Padding="{DynamicResource Token.Layout.Padding.Uniform.Panel}"
                      AutomationProperties.AutomationId="Catalog.PrintifyImportPanel">
                <StackPanel DataContext="{Binding PrintifyCatalogImportSession}" Spacing="{DynamicResource Token.Spacing.ControlGap}">
                  <TextBlock Text="Import Blueprints from Printify" FontWeight="SemiBold" />
                  <TextBlock Text="Select Blueprints used by products in the selected Printify shop. Their used Providers and full sellable variant catalogs will be added or updated locally. No changes are saved until you confirm."
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource SecondaryTextBrush}" />
                  <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="4" />
                  <TextBlock IsVisible="{Binding !HasBlueprints}" Text="No products are available in the selected Printify shop to identify Blueprints." Foreground="{DynamicResource SecondaryTextBrush}" />
                  <virtualGrid:VirtualDataGrid x:Name="PrintifyBlueprintGrid"
                                               Classes="printifyBlueprintGrid"
                                               Height="360"
                                               RowHeight="72"
                                               SelectionMode="None"
                                               AutomationProperties.AutomationId="Catalog.PrintifyBlueprintGrid"
                                               AutomationProperties.Name="Printify Blueprints used by this shop to import">
                    <virtualGrid:VirtualDataGrid.Columns>
                      <virtualColumns:VirtualDataGridTemplateColumn Header="Select" Width="48" IsSortable="False" IsResizable="False">
                        <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                          <DataTemplate x:DataType="stores:PrintifyCatalogImportItemViewModel">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="Catalog.PrintifyBlueprintChoice"
                                      AutomationProperties.Name="{Binding SelectionAccessibleName}"
                                      ToolTip.Tip="{Binding SelectionAccessibleName}"
                                      VerticalAlignment="Center" />
                          </DataTemplate>
                        </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                      </virtualColumns:VirtualDataGridTemplateColumn>
                      <virtualColumns:VirtualDataGridTemplateColumn Header="Blueprint" Width="170" IsSortable="False" IsResizable="False">
                        <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                          <DataTemplate x:DataType="stores:PrintifyCatalogImportItemViewModel">
                            <TextBlock Text="{Binding BlueprintName}"
                                       ToolTip.Tip="{Binding BlueprintName}"
                                       AutomationProperties.HelpText="{Binding BlueprintName}"
                                       TextTrimming="CharacterEllipsis"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="{DynamicResource Token.Layout.Margin.HorizontalVertical.Control.None}" />
                          </DataTemplate>
                        </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                      </virtualColumns:VirtualDataGridTemplateColumn>
                      <virtualColumns:VirtualDataGridTemplateColumn Header="Providers used" Width="220" IsSortable="False" IsResizable="False">
                        <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                          <DataTemplate x:DataType="stores:PrintifyCatalogImportItemViewModel">
                            <TextBlock Text="{Binding ProviderSummary}"
                                       ToolTip.Tip="{Binding ProviderSummary}"
                                       AutomationProperties.HelpText="{Binding ProviderSummary}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="{DynamicResource Token.Layout.Margin.HorizontalVertical.Control.None}" />
                          </DataTemplate>
                        </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                      </virtualColumns:VirtualDataGridTemplateColumn>
                      <virtualColumns:VirtualDataGridTemplateColumn Header="Shop products" Width="360" IsSortable="False" IsResizable="False">
                        <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                          <DataTemplate x:DataType="stores:PrintifyCatalogImportItemViewModel">
                            <TextBlock Text="{Binding ShopProductSummary}"
                                       ToolTip.Tip="{Binding ShopProductSummary}"
                                       AutomationProperties.HelpText="{Binding ShopProductSummary}"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{DynamicResource Token.Typography.Caption}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="{DynamicResource Token.Layout.Margin.HorizontalVertical.Control.None}" />
                          </DataTemplate>
                        </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                      </virtualColumns:VirtualDataGridTemplateColumn>
                    </virtualGrid:VirtualDataGrid.Columns>
                  </virtualGrid:VirtualDataGrid>
                  <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Token.Spacing.ControlGap}">
                    <Button Content="Load selected" Command="{Binding ConfirmCommand}" Classes="primary fixedAction" Width="112" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Classes="secondary fixedAction" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <TextBlock IsVisible="{Binding !HasProducts}"
                         Text="No Blueprints yet. Add a Blueprint to begin."
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <ItemsControl ItemsSource="{Binding EditorProducts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="appProducts:StoreProductSummary">
                    <Button Command="{Binding $parent[ItemsControl].DataContext.OpenProductDetailCommand}"
                            CommandParameter="{Binding}"
                            Classes="listItem"
                            HorizontalContentAlignment="Left">
                      <StackPanel Spacing="{DynamicResource Token.Spacing.Gap.Tight}">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Offerings.Count, StringFormat='{}{0} Blueprint Offering(s)'}"
                                   FontSize="{DynamicResource Token.Typography.Caption}"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock IsVisible="{Binding IsArchived}"
                                   Text="Archived"
                                   FontSize="{DynamicResource Token.Typography.Caption}"
                                   Foreground="{DynamicResource WarningTextBrush}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel IsVisible="{Binding IsProductDetail}"
                        Spacing="{DynamicResource Token.Spacing.Gap.Panel}">
              <StackPanel Spacing="{DynamicResource Token.Spacing.Gap.Panel}"
                          Margin="{DynamicResource Token.Layout.PageInset}"
                          AutomationProperties.AutomationId="Catalog.BlueprintDetailContext">
                <Button Content="‹  Back to Blueprints"
                        Command="{Binding BackToProductsCommand}"
                        Classes="secondary" />
                <TextBlock Text="{Binding CatalogBreadcrumb}"
                           FontSize="{DynamicResource Token.Typography.Caption}"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Text="{Binding ProductName}"
                           FontSize="{DynamicResource Token.Typography.SurfaceHeading}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource StrongTextBrush}" />
                <TextBlock Text="{Binding SelectedProductSummary}"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
              </StackPanel>
              <Border Classes="panel" Padding="{DynamicResource Token.Layout.Padding.Uniform.Panel}"
                      AutomationProperties.AutomationId="Catalog.BlueprintBasics">
                <StackPanel Spacing="{DynamicResource Token.Spacing.ControlGap}">
                  <ToggleButton Content="Basics"
                                IsChecked="{Binding IsBlueprintBasicsExpanded, Mode=TwoWay}"
                                HorizontalContentAlignment="Left"
                                ToolTip.Tip="Edit the Blueprint name and description without leaving this page." />
                  <StackPanel IsVisible="{Binding IsBlueprintBasicsExpanded}" IsEnabled="{Binding !SelectedStore.IsArchived}" Spacing="{DynamicResource Token.Spacing.ControlGap}">
                    <TextBlock Text="Blueprint is Printify's term for the base product definition."
                               TextWrapping="Wrap" FontSize="{DynamicResource Token.Typography.Caption}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="Name" FontSize="{DynamicResource Token.Typography.Caption}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox x:Name="ProductNameTextBox"
                             Text="{Binding ProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Blueprint name"
                             Classes="field"
                             AutomationProperties.AutomationId="Catalog.BlueprintName" />
                    <TextBlock Text="Description" FontSize="{DynamicResource Token.Typography.Caption}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox Text="{Binding ProductDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             MinHeight="56"
                             Classes="field" />
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Token.Spacing.ControlGap}">
                      <Button Content="Save Blueprint"
                              AutomationProperties.AutomationId="Catalog.SaveBlueprint"
                              Command="{Binding SaveSelectedProductCommand}"
                              IsEnabled="{Binding CanSaveSelectedProduct}"
                              Classes="primary fixedAction blueprintAction" />
                      <Button Content="Archive Blueprint"
                              AutomationProperties.AutomationId="Catalog.ArchiveBlueprint"
                              Command="{Binding RequestArchiveSelectedProductCommand}"
                              IsVisible="{Binding !SelectedProduct.IsArchived}"
                              IsEnabled="{Binding CanArchiveSelectedProduct}"
                              Classes="danger fixedAction blueprintAction" />
                      <Button Content="Reactivate Blueprint"
                              AutomationProperties.AutomationId="Catalog.ReactivateBlueprint"
                              Command="{Binding RequestReactivateSelectedProductCommand}"
                              IsVisible="{Binding SelectedProduct.IsArchived}"
                              IsEnabled="{Binding CanReactivateSelectedProduct}"
                              Classes="primary fixedAction blueprintAction" />
                      <Button Content="Delete permanently"
                              AutomationProperties.AutomationId="Catalog.DeleteArchivedBlueprint"
                              Command="{Binding RequestDeleteSelectedProductCommand}"
                              IsVisible="{Binding SelectedProduct.IsArchived}"
                              IsEnabled="{Binding CanDeleteSelectedProduct}"
                              Classes="danger fixedAction blueprintAction" />
                    </StackPanel>
                    <Border IsVisible="{Binding ProductArchiveWarningVisible}"
                            AutomationProperties.AutomationId="Catalog.BlueprintArchiveWarning"
                            Background="{DynamicResource WarningBackgroundBrush}"
                            BorderBrush="{DynamicResource WarningBorderBrush}"
                            BorderThickness="2"
                            Padding="{DynamicResource Token.Layout.Padding.Uniform.Panel}">
                      <StackPanel Spacing="{DynamicResource Token.Spacing.ControlGap}">
                        <TextBlock Text="HIGH-IMPACT BLUEPRINT ARCHIVE"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource WarningTextBrush}" />
                        <TextBlock Text="{Binding ProductArchiveWarningMessage}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningTextBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Token.Spacing.ControlGap}">
                          <Button Content="Archive Blueprint and dependents"
                                  Command="{Binding ConfirmArchiveSelectedProductCommand}"
                                  AutomationProperties.Name="Confirm archive Blueprint and dependents"
                                  Classes="danger fixedAction" />
                          <Button Content="Cancel"
                                  Command="{Binding CancelArchiveSelectedProductCommand}"
                                  AutomationProperties.Name="Cancel Blueprint archive"
                                  Classes="secondary fixedAction" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <Border IsVisible="{Binding ProductReactivateWarningVisible}"
                            AutomationProperties.AutomationId="Catalog.BlueprintReactivateWarning"
                            Background="{DynamicResource WarningBackgroundBrush}"
                            BorderBrush="{DynamicResource WarningBorderBrush}"
                            BorderThickness="2"
                            Padding="{DynamicResource Token.Layout.Padding.Uniform.Panel}">
                      <StackPanel Spacing="{DynamicResource Token.Spacing.ControlGap}">
                        <TextBlock Text="REACTIVATE BLUEPRINT AND CATALOG"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource WarningTextBrush}" />
                        <TextBlock Text="{Binding ProductReactivateWarningMessage}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningTextBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Token.Spacing.ControlGap}">
                          <Button Content="Reactivate Blueprint"
                                  Command="{Binding ConfirmReactivateSelectedProductCommand}"
                                  IsEnabled="{Binding CanReactivateSelectedProduct}"
                                  AutomationProperties.Name="Confirm reactivate Blueprint"
                                  Classes="primary fixedAction" />
                          <Button Content="Cancel"
                                  Command="{Binding CancelReactivateSelectedProductCommand}"
                                  AutomationProperties.Name="Cancel Blueprint reactivation"
                                  Classes="secondary fixedAction" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Classes="panel" Padding="{DynamicResource Token.Layout.Padding.Uniform.Panel}"
                      AutomationProperties.AutomationId="Catalog.BlueprintOfferingList">
                <StackPanel Spacing="{DynamicResource Token.Spacing.ControlGap}">
                  <TextBlock Text="Blueprint Offerings"
                             FontWeight="SemiBold"
                             ToolTip.Tip="An Offering is a concrete fulfillment choice for a Blueprint." />
                  <TextBlock Text="An Offering is one way this Blueprint is supplied."
                             FontSize="{DynamicResource Token.Typography.Caption}"
                             Foreground="{DynamicResource SecondaryTextBrush}" />
                  <Button Content="Add Blueprint Offering"
                          Command="{Binding StartCreateOfferingCommand}"
                          IsEnabled="{Binding CanCreateCatalogItem}"
                          Classes="primary" />
                  <CheckBox Content="Show archived Blueprint Offerings" IsChecked="{Binding ShowArchivedOfferings, Mode=TwoWay}" />
                  <TextBlock IsVisible="{Binding !HasBlueprintOfferingCards}"
                             Text="No Blueprint Offerings yet. Add an Offering to connect this Blueprint to a fulfillment setup."
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource SecondaryTextBrush}" />
                  <virtualGrid:VirtualDataGrid x:Name="BlueprintOfferingGrid"
                                               Height="220"
                                               RowHeight="32"
                                               SelectionMode="None"
                                               IsVisible="{Binding HasBlueprintOfferingCards}"
                                               AutomationProperties.AutomationId="Catalog.BlueprintOfferingGrid">
                    <virtualGrid:VirtualDataGrid.Columns>
                      <virtualColumns:VirtualDataGridTemplateColumn Header="Action" Width="72" IsSortable="False" IsResizable="False">
                        <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                          <DataTemplate x:DataType="stores:BlueprintOfferingCardViewModel">
                            <Button Content="Open"
                                    Command="{Binding $parent[virtualGrid:VirtualDataGrid].DataContext.SelectOfferingCommand}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.AutomationId="Catalog.OpenOffering"
                                    AutomationProperties.Name="Open Offering"
                                    Classes="secondary fixedAction" />
                          </DataTemplate>
                        </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                      </virtualColumns:VirtualDataGridTemplateColumn>
                      <virtualColumns:VirtualDataGridTemplateColumn Header="Offering" Width="120" IsSortable="False" IsResizable="False">
                        <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                          <DataTemplate x:DataType="stores:BlueprintOfferingCardViewModel">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Name}" AutomationProperties.HelpText="{Binding Name}" />
                          </DataTemplate>
                        </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                      </virtualColumns:VirtualDataGridTemplateColumn>
                      <virtualColumns:VirtualDataGridTemplateColumn Header="Fulfillment" Width="116" IsSortable="False" IsResizable="False">
                        <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                          <DataTemplate x:DataType="stores:BlueprintOfferingCardViewModel">
                            <TextBlock Text="{Binding FulfillmentContext}" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding FulfillmentContext}" AutomationProperties.HelpText="{Binding FulfillmentContext}" />
                          </DataTemplate>
                        </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                      </virtualColumns:VirtualDataGridTemplateColumn>
                      <virtualColumns:VirtualDataGridTemplateColumn Header="Status" Width="126" IsSortable="False" IsResizable="False">
                        <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                          <DataTemplate x:DataType="stores:BlueprintOfferingCardViewModel">
                            <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Status}" AutomationProperties.HelpText="{Binding Status}" />
                          </DataTemplate>
                        </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                      </virtualColumns:VirtualDataGridTemplateColumn>
                      <virtualColumns:VirtualDataGridTemplateColumn Header="Setup" Width="142" IsSortable="False" IsResizable="False">
                        <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                          <DataTemplate x:DataType="stores:BlueprintOfferingCardViewModel">
                            <TextBlock Text="{Binding SetupSummary}" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding SetupSummary}" AutomationProperties.HelpText="{Binding SetupSummary}" />
                          </DataTemplate>
                        </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                      </virtualColumns:VirtualDataGridTemplateColumn>
                      <virtualColumns:VirtualDataGridTemplateColumn Header="Readiness" Width="154" IsSortable="False" IsResizable="False">
                        <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                          <DataTemplate x:DataType="stores:BlueprintOfferingCardViewModel">
                            <TextBlock Text="{Binding ReadinessSummary}" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding ReadinessDetails}"
                                       AutomationProperties.HelpText="{Binding ReadinessDetails}"
                                       AutomationProperties.Name="Offering readiness summary" />
                          </DataTemplate>
                        </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                      </virtualColumns:VirtualDataGridTemplateColumn>
                    </virtualGrid:VirtualDataGrid.Columns>
                  </virtualGrid:VirtualDataGrid>
                </StackPanel>
              </Border>
            </StackPanel>

              <StackPanel IsVisible="{Binding IsOfferingContext}"
                          Spacing="{DynamicResource Token.Spacing.Gap.Panel}">
                <Border AutomationProperties.AutomationId="Catalog.ContextHeader"
                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="{DynamicResource Token.Layout.Padding.Sides.Left_None.Top_None.Right_None.Bottom_Panel}"
                        Margin="{DynamicResource Token.Layout.PageInset}">
                  <StackPanel Spacing="{DynamicResource Token.Spacing.ControlGap}">
                    <Button Content="‹  Back to Blueprint"
                            Command="{Binding BackToProductCommand}"
                            IsVisible="{Binding IsOfferingDetail}"
                            Classes="secondary" />
                    <Button Content="‹  Back to Offering overview"
                            Command="{Binding BackToOfferingOverviewCommand}"
                            IsVisible="{Binding !IsOfferingDetail}"
                            Classes="secondary" />
                    <TextBlock Text="{Binding CatalogBreadcrumb}"
                               FontSize="{DynamicResource Token.Typography.Caption}"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding OfferingName}"
                               IsVisible="{Binding IsCreatingNewOffering}"
                               FontSize="{DynamicResource Token.Typography.SurfaceHeading}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource StrongTextBrush}" />
                    <TextBlock Text="{Binding CatalogSetup.OfferingName}"
                               IsVisible="{Binding CatalogSetup.HasSelectedOffering}"
                               FontSize="{DynamicResource Token.Typography.SurfaceHeading}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource StrongTextBrush}" />
                    <TextBlock Text="{Binding CatalogSetup.OfferingReadinessStatus}"
                               IsVisible="{Binding CatalogSetup.HasSelectedOffering}"
                               FontSize="{DynamicResource Token.Typography.Caption}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               AutomationProperties.AutomationId="Catalog.OfferingStatus" />
                  </StackPanel>
                </Border>
              <Border IsVisible="{Binding CatalogSetup.IsOfferingContextUnavailable}"
                      Background="{DynamicResource WarningBackgroundBrush}"
                      BorderBrush="{DynamicResource WarningBorderBrush}"
                      BorderThickness="1"
                      Padding="{DynamicResource Token.Layout.Padding.Uniform.Panel}">
                <TextBlock Text="This Blueprint Offering could not be repaired into the normalized catalog. Return to the Blueprint and reopen it, or review the catalog error below."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource WarningTextBrush}" />
              </Border>
              <TextBlock Text="{Binding CatalogSetup.ErrorMessage}"
                         IsVisible="{Binding CatalogSetup.HasError}"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource DangerTextBrush}" />

              <Border Classes="panel" Padding="{DynamicResource Token.Layout.Padding.Uniform.Panel}" IsVisible="{Binding IsCreatingNewOffering}">
                <StackPanel Spacing="{DynamicResource Token.Spacing.ControlGap}">
                  <TextBlock Text="New Blueprint Offering" FontWeight="SemiBold" />
                  <TextBlock Text="Choose the fulfillment relationship first. After saving, Options, Variants, Placeholders, and Mockup Templates become available."
                             TextWrapping="Wrap" FontSize="{DynamicResource Token.Typography.Caption}" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <StackPanel Spacing="{DynamicResource Token.Spacing.ControlGap}">
                    <TextBlock Text="Name" FontSize="{DynamicResource Token.Typography.Caption}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox x:Name="OfferingNameTextBox" Text="{Binding OfferingName}" PlaceholderText="Offering name" Classes="field" />
                    <TextBlock Text="Fulfillment type" FontSize="{DynamicResource Token.Typography.Caption}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ComboBox SelectedIndex="{Binding OfferingKindIndex}" Classes="field">
                      <ComboBoxItem Content="Fixed Print Provider" />
                      <ComboBoxItem Content="Printify Choice Provider Network" />
                    </ComboBox>
                    <TextBlock IsVisible="{Binding !IsChoiceNetworkOffering}" Text="Print Provider name" FontSize="{DynamicResource Token.Typography.Caption}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox IsVisible="{Binding !IsChoiceNetworkOffering}"
                             Text="{Binding OfferingProviderName}"
                             PlaceholderText="Print Provider name"
                             Classes="field" />
                    <TextBlock Text="Description" FontSize="{DynamicResource Token.Typography.Caption}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox Text="{Binding OfferingDescription}" AcceptsReturn="True" MinHeight="96" Classes="field"
                             AutomationProperties.AutomationId="Catalog.NewOfferingDescription" />
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Token.Spacing.ControlGap}">
                      <Button Content="Save Blueprint Offering"
                              Command="{Binding SaveSelectedOfferingCommand}"
                              IsEnabled="{Binding CanSaveSelectedOffering}"
                              Classes="primary fixedAction" />
                      <Button Content="Cancel"
                              Command="{Binding CancelNewOfferingCommand}"
                              Classes="secondary fixedAction" />
              </StackPanel>
            </StackPanel>
            </StackPanel>
          </Border>

              <Border Classes="panel" Padding="{DynamicResource Token.Layout.Padding.Uniform.Panel}" IsVisible="{Binding IsOfferingDetail}"
                      AutomationProperties.AutomationId="Catalog.OfferingBasics">
                <StackPanel Spacing="{DynamicResource Token.Spacing.ControlGap}">
                  <ToggleButton Content="Basics" IsChecked="{Binding IsBasicsSectionExpanded, Mode=TwoWay}" HorizontalContentAlignment="Left" />
                  <StackPanel IsVisible="{Binding IsBasicsSectionExpanded}" Spacing="{DynamicResource Token.Spacing.ControlGap}">
                    <TextBlock Text="Name" FontSize="{DynamicResource Token.Typography.Caption}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox Text="{Binding CatalogSetup.OfferingName}" PlaceholderText="Offering name" Classes="field" />
                    <TextBlock Text="Fulfillment type" FontSize="{DynamicResource Token.Typography.Caption}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding CatalogSetup.OfferingKindLabel}" />
                    <StackPanel IsVisible="{Binding !CatalogSetup.IsProviderNetworkOffering}" Spacing="{DynamicResource Token.Spacing.CompactGap}">
                      <TextBlock Text="Print Provider" FontSize="{DynamicResource Token.Typography.Caption}" Foreground="{DynamicResource SecondaryTextBrush}" />
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Token.Spacing.ControlGap}">
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding CatalogSetup.AvailablePrintProviders}"
                                  SelectedItem="{Binding CatalogSetup.SelectedPrintProvider}"
                                  DisplayMemberBinding="{Binding Name}"
                                  PlaceholderText="Select Print Provider"
                                  AutomationProperties.AutomationId="Catalog.OfferingProvider" />
                        <Button Grid.Column="1" Content="Add Provider"
                                Command="{Binding CatalogSetup.StartAddPrintProviderCommand}"
                                Classes="secondary" />
                      </Grid>
                      <StackPanel IsVisible="{Binding CatalogSetup.IsAddingPrintProvider}" Spacing="{DynamicResource Token.Spacing.InlineGap}">
                        <TextBlock Text="New Print Provider" FontWeight="SemiBold" />
                        <TextBox Text="{Binding CatalogSetup.NewPrintProviderName}"
                                 PlaceholderText="Provider name, for example SwiftPOD"
                                 Classes="field" />
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Token.Spacing.ControlGap}">
                          <Button Content="Create and select Provider"
                                  Command="{Binding CatalogSetup.CreatePrintProviderCommand}"
                                  Classes="primary" />
                          <Button Content="Cancel"
                                  Command="{Binding CatalogSetup.CancelAddPrintProviderCommand}"
                                  Classes="secondary" />
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                    <StackPanel IsVisible="{Binding CatalogSetup.IsProviderNetworkOffering}" Spacing="{DynamicResource Token.Spacing.CompactGap}">
                      <TextBlock Text="Provider Network code" FontSize="{DynamicResource Token.Typography.Caption}" Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBox Text="{Binding CatalogSetup.ProviderNetworkCode}" Classes="field" />
                      <TextBlock Text="A Provider Network can route fulfillment through different Print Providers. Its stable code preserves identity if the display label changes."
                                 TextWrapping="Wrap" FontSize="{DynamicResource Token.Typography.Caption}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <TextBlock Text="Description" FontSize="{DynamicResource Token.Typography.Caption}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox Text="{Binding CatalogSetup.OfferingDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" MinHeight="96" Classes="field"
                             AutomationProperties.AutomationId="Catalog.OfferingDescription" />
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Token.Spacing.ControlGap}">
                      <Button Content="Save Blueprint Offering" Command="{Binding CatalogSetup.SaveOfferingCommand}" Classes="primary offeringAction" />
                      <Button Content="Archive Blueprint Offering"
                              Command="{Binding CatalogSetup.RequestArchiveOfferingCommand}"
                              Classes="danger offeringAction"
                              AutomationProperties.AutomationId="Catalog.ArchiveOffering" />
                      <Button Content="Restore Blueprint Offering"
                              Command="{Binding CatalogSetup.RequestRestoreOfferingCommand}"
                              IsVisible="{Binding CatalogSetup.SelectedOffering.IsArchived}"
                              Classes="primary offeringAction" />
                      <Button Content="Delete permanently"
                              Command="{Binding CatalogSetup.RequestDeleteOfferingCommand}"
                              IsVisible="{Binding CatalogSetup.SelectedOffering.IsArchived}"
                              Classes="danger offeringAction" />
                    </StackPanel>
                    </StackPanel>
                </StackPanel>
              </Border>

              <Border IsVisible="{Binding CatalogSetup.IsArchiveOfferingConfirmationVisible}"
                      Background="{DynamicResource DangerBackgroundBrush}"
                      BorderBrush="{DynamicResource DangerBorderBrush}"
                      BorderThickness="1" Padding="{DynamicResource Token.Layout.Padding.Uniform.Panel}">
                <StackPanel Spacing="{DynamicResource Token.Spacing.ControlGap}">
                  <TextBlock Text="Archive Blueprint Offering?" FontWeight="SemiBold" />
                  <TextBlock Text="This is reversible. The Offering and its active catalog-owned dependents will be archived together; nothing will be permanently deleted."
                             TextWrapping="Wrap" Foreground="{DynamicResource DangerTextBrush}" />
                  <TextBlock Text="{Binding CatalogSetup.ArchiveOfferingPlan.OfferingName}" FontWeight="SemiBold" />
                  <ItemsControl ItemsSource="{Binding CatalogSetup.ArchiveOfferingPlan.CatalogDependents}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding DisplayText}"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock IsVisible="{Binding CatalogSetup.ArchiveOfferingPlan.HasExternalBlockers}"
                             Text="Resolve the external dependents below before archiving this Offering:"
                             TextWrapping="Wrap" Foreground="{DynamicResource DangerTextBrush}" />
                  <ItemsControl ItemsSource="{Binding CatalogSetup.ArchiveOfferingPlan.ExternalBlockers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding DisplayText}"
                                   Foreground="{DynamicResource DangerTextBrush}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Token.Spacing.ControlGap}">
                    <Button Content="Archive Offering and Dependents"
                            Command="{Binding CatalogSetup.ConfirmArchiveOfferingCommand}"
                            Classes="danger fixedDanger" />
                    <Button Content="Cancel" Command="{Binding CatalogSetup.CancelArchiveOfferingCommand}" Classes="secondary fixedAction" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border IsVisible="{Binding CatalogSetup.IsDeleteOfferingConfirmationVisible}"
                      Background="{DynamicResource DangerBackgroundBrush}"
                      BorderBrush="{DynamicResource DangerBorderBrush}"
                      BorderThickness="1" Padding="{DynamicResource Token.Layout.Padding.Uniform.Panel}">
                <StackPanel Spacing="{DynamicResource Token.Spacing.ControlGap}">
                  <TextBlock Text="Delete Blueprint Offering permanently?" FontWeight="SemiBold" />
                  <TextBlock Text="This cannot be undone. All catalog-owned descendants will be removed. External references block deletion until they are resolved." TextWrapping="Wrap" Foreground="{DynamicResource DangerTextBrush}" />
                  <TextBlock Text="{Binding CatalogSetup.DeleteOfferingPlan.OfferingName}" FontWeight="SemiBold" />
                  <ItemsControl ItemsSource="{Binding CatalogSetup.DeleteOfferingPlan.ExternalBlockers}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayText}" Foreground="{DynamicResource DangerTextBrush}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Token.Spacing.ControlGap}"><Button Content="Delete permanently" Command="{Binding CatalogSetup.ConfirmDeleteOfferingCommand}" Classes="danger fixedDanger" /><Button Content="Cancel" Command="{Binding CatalogSetup.CancelDeleteOfferingCommand}" Classes="secondary fixedAction" /></StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="panel" Padding="{DynamicResource Token.Layout.Padding.Uniform.Panel}" IsVisible="{Binding IsOfferingDetail}">
                <StackPanel Spacing="{DynamicResource Token.Spacing.GroupGap}"
                            AutomationProperties.AutomationId="Catalog.OfferingSetup">
                <TextBlock Text="Setup" FontSize="{DynamicResource Token.Typography.SubsectionHeading}" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" />
                <TextBlock Text="Configure each part of this Offering in a focused screen. Provider means the fulfillment partner that produces the item; Printify is the catalog and integration source."
                           TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                <Border IsVisible="{Binding IsChoiceNetworkOffering}"
                        Background="{DynamicResource WarningBackgroundBrush}"
                        BorderBrush="{DynamicResource WarningBorderBrush}"
                        BorderThickness="1" Padding="{DynamicResource Token.Layout.Padding.Uniform.Group}">
                  <TextBlock Text="Printify Choice is a Provider Network, not a single Print Provider. The actual fulfillment partner may vary by order or catalog availability."
                             TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" />
                </Border>
                <TextBlock IsVisible="{Binding SelectedStore.IsArchived}"
                           Text="This Store is archived. Catalog setup is available for review but cannot be changed."
                           TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                <Border Classes="listItem" Padding="{DynamicResource Token.Layout.Padding.Uniform.Group}">
                  <Grid ColumnDefinitions="2*,Auto,Auto" ColumnSpacing="{DynamicResource Token.Spacing.Gap.Panel}">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="30" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="30" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="{DynamicResource Token.Spacing.Gap.Tight}">
                      <TextBlock Text="Variants" FontWeight="SemiBold" />
                      <TextBlock Text="Possible choices and explicit sellable combinations."
                                 TextWrapping="Wrap" FontSize="{DynamicResource Token.Typography.Caption}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" TextAlignment="Right"
                               Text="{Binding CatalogSetup.AvailableVariantCount, StringFormat='{}{0} configured'}"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <Button Grid.Row="0" Grid.Column="2" Content="Manage Variants" Command="{Binding OpenVariantManagementCommand}" Classes="secondary" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Manage Variants"
                            AutomationProperties.AutomationId="Catalog.ManageVariants" />

                    <StackPanel Grid.Row="2" Grid.Column="0" Spacing="{DynamicResource Token.Spacing.Gap.Tight}">
                      <TextBlock Text="Design Areas" FontWeight="SemiBold" />
                      <TextBlock Text="Printable regions and compatible Variants."
                                 TextWrapping="Wrap" FontSize="{DynamicResource Token.Typography.Caption}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" TextAlignment="Right"
                               Text="{Binding CatalogSetup.AvailableDesignAreaCount, StringFormat='{}{0} configured'}"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <Button Grid.Row="2" Grid.Column="2" Content="Manage Design Areas" Command="{Binding OpenDesignAreaManagementCommand}" Classes="secondary" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Manage Design Areas"
                            AutomationProperties.AutomationId="Catalog.ManageDesignAreas" />

                    <StackPanel Grid.Row="4" Grid.Column="0" Spacing="{DynamicResource Token.Spacing.Gap.Tight}">
                      <TextBlock Text="Mockup Templates" FontWeight="SemiBold" />
                      <TextBlock Text="Provider images linked to Design Areas and Colors."
                                 TextWrapping="Wrap" FontSize="{DynamicResource Token.Typography.Caption}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" TextAlignment="Right"
                               Text="{Binding CatalogSetup.AvailableTemplateCount, StringFormat='{}{0} configured'}"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <Button Grid.Row="4" Grid.Column="2" Content="Manage Mockup Templates" Command="{Binding OpenMockupTemplateManagementCommand}" Classes="secondary" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Manage Mockup Templates"
                            AutomationProperties.AutomationId="Catalog.ManageMockupTemplates" />
                  </Grid>
                </Border>
                <Border Classes="panel" Padding="{DynamicResource Token.Layout.Padding.Uniform.Group}"
                        AutomationProperties.AutomationId="Catalog.OfferingReadiness">
                  <StackPanel Spacing="{DynamicResource Token.Spacing.InlineGap}">
                    <TextBlock Text="Setup readiness" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CatalogSetup.OfferingReadinessSummary}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               AutomationProperties.Name="Offering setup readiness"
                               AutomationProperties.AutomationId="Catalog.OfferingReadinessSummary" />
                    <TextBlock Text="{Binding CatalogSetup.ReadyMockupTemplateCount, StringFormat='{}{0} ready Mockup Templates'}"
                               FontSize="{DynamicResource Token.Typography.Caption}"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding CatalogSetup.OfferingReadinessError}"
                               IsVisible="{Binding CatalogSetup.HasOfferingReadinessError}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerTextBrush}"
                               AutomationProperties.Name="Offering readiness error" />
                    <ItemsControl ItemsSource="{Binding CatalogSetup.OfferingReadinessGuidance}"
                                  IsVisible="{Binding CatalogSetup.HasOfferingReadinessGuidance}"
                                  AutomationProperties.Name="Offering readiness guidance"
                                  AutomationProperties.AutomationId="Catalog.OfferingReadinessGuidance">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding}"
                                     TextWrapping="Wrap"
                                     Foreground="{DynamicResource WarningTextBrush}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Open next setup step"
                            Command="{Binding OpenNextOfferingReadinessStepCommand}"
                            IsVisible="{Binding CatalogSetup.HasOfferingReadinessGuidance}"
                            Classes="secondary"
                            AutomationProperties.Name="Open next offering setup step"
                            AutomationProperties.AutomationId="Catalog.OpenNextOfferingReadinessStep" />
                  </StackPanel>
                </Border>
                </StackPanel>
              </Border>

              <Border Classes="panel" Padding="{DynamicResource Token.Layout.Padding.Uniform.Panel}" IsVisible="{Binding IsVariantManagement}"
                      AutomationProperties.AutomationId="Catalog.VariantAvailableChoices">
                <StackPanel Spacing="{DynamicResource Token.Spacing.ControlGap}">
                  <TextBlock Text="1. Available choices" FontSize="{DynamicResource Token.Typography.ToolTitle}" FontWeight="SemiBold" />
                  <TextBlock Text="Define which Color, Size, and other values may be combined. This does not make every combination sellable."
                             TextWrapping="Wrap" FontSize="{DynamicResource Token.Typography.Caption}" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBlock IsVisible="{Binding !CatalogSetup.HasAvailableOptions}" Text="No Options configured." Foreground="{DynamicResource SecondaryTextBrush}" />
                  <ItemsControl ItemsSource="{Binding CatalogSetup.AvailableChoiceGroups}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="stores:OfferingChoiceGroupViewModel">
                        <Border Classes="choiceCard" Padding="{DynamicResource Token.Layout.Padding.Uniform.Group}" Width="{Binding CardWidth}" Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_None.Right_Group.Bottom_Group}"
                                AutomationProperties.AutomationId="Catalog.OptionCard">
                          <StackPanel Spacing="{DynamicResource Token.Spacing.InlineGap}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Token.Spacing.ControlGap}">
                              <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                              <TextBlock Grid.Column="1" Text="{Binding KindLabel}" FontSize="{DynamicResource Token.Typography.Caption}" Foreground="{DynamicResource SecondaryTextBrush}"
                                         VerticalAlignment="Center" />
                              <Button Grid.Column="2"
                                      Content="..."
                                      Classes="iconButton"
                                      AutomationProperties.Name="{Binding AccessibleOverflowName}"
                                      AutomationProperties.AutomationId="{Binding OverflowAutomationId}"
                                      VerticalAlignment="Top">
<Button.Flyout>
                                  <MenuFlyout>
                                    <MenuItem Header="Archive option"
                                              Classes="danger"
                                              Command="{Binding ArchiveOptionCommand}"
                                              CommandParameter="{Binding Option}" />
                                  </MenuFlyout>
                                </Button.Flyout>
                              </Button>
                            </Grid>
                            <TextBlock IsVisible="{Binding ShowEmptyValueSummary}" Text="{Binding ValuesSummary}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       AutomationProperties.AutomationId="{Binding EmptyValueSummaryAutomationId}" />
                            <virtualGrid:VirtualDataGrid IsVisible="{Binding ShowValueGrid}"
                                                         Classes="optionValueSummaryGrid"
                                                         ItemsSource="{Binding ValueRows}"
                                                         Height="{Binding ValueGridHeight}" RowHeight="{Binding ValueGridRowHeight}"
                                                         SelectionMode="None" Focusable="False"
                                                         AutomationProperties.Name="{Binding ValueGridAccessibleName}"
                                                         AutomationProperties.AutomationId="{Binding ValueGridAutomationId}">
                              <virtualGrid:VirtualDataGrid.Columns>
                                <virtualColumns:VirtualDataGridTemplateColumn Header="Configured values" Width="195"
                                                                             IsSortable="False" IsResizable="False">
                                  <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="stores:AvailableOptionValueGridRowViewModel">
                                      <Border Classes="optionValueGridRow" Classes.alternate="{Binding IsAlternate}" Padding="{DynamicResource Token.Layout.Padding.HorizontalVertical.Control.None}">
                                        <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" ToolTip.Tip="{Binding Value}"
                                                   AutomationProperties.Name="{Binding AccessibleName}"
                                                   AutomationProperties.HelpText="{Binding AccessibleHelpText}" />
                                      </Border>
                                    </DataTemplate>
                                  </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                                </virtualColumns:VirtualDataGridTemplateColumn>
                              </virtualGrid:VirtualDataGrid.Columns>
                            </virtualGrid:VirtualDataGrid>
                            <StackPanel IsVisible="{Binding IsColor}" Spacing="{DynamicResource Token.Spacing.InlineGap}">
                              <TextBlock IsVisible="{Binding $parent[ItemsControl].DataContext.CatalogSetup.AvailableColorsGrid.HasNoColors}"
                                         Text="No Colors configured." Foreground="{DynamicResource SecondaryTextBrush}"
                                         AutomationProperties.AutomationId="Catalog.ColorNoValues" />
                              <StackPanel IsVisible="{Binding $parent[ItemsControl].DataContext.CatalogSetup.AvailableColorsGrid.HasColors}" Spacing="{DynamicResource Token.Spacing.InlineGap}">
                                <TextBox Classes="field"
                                         PlaceholderText="Search colors"
                                         AutomationProperties.Name="Search Colors"
                                         AutomationProperties.AutomationId="Catalog.ColorSearch"
                                         Text="{Binding $parent[ItemsControl].DataContext.CatalogSetup.AvailableColorsGrid.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource Token.Spacing.ControlGap}">
                                  <StackPanel Grid.Column="0" Spacing="{DynamicResource Token.Spacing.Gap.Tight}">
                                    <TextBlock Text="Sort by" FontSize="{DynamicResource Token.Typography.Label}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <ComboBox ItemsSource="{Binding $parent[ItemsControl].DataContext.CatalogSetup.AvailableColorsGrid.SortOptions}"
                                              SelectedItem="{Binding $parent[ItemsControl].DataContext.CatalogSetup.AvailableColorsGrid.SortOption, Mode=TwoWay}"
                                              AutomationProperties.Name="Sort Colors"
                                              AutomationProperties.AutomationId="Catalog.ColorSort" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="1" Spacing="{DynamicResource Token.Spacing.Gap.Tight}">
                                    <TextBlock Text="Rows per page" FontSize="{DynamicResource Token.Typography.Label}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <ComboBox ItemsSource="{Binding $parent[ItemsControl].DataContext.CatalogSetup.AvailableColorsGrid.PageSizes}"
                                              SelectedItem="{Binding $parent[ItemsControl].DataContext.CatalogSetup.AvailableColorsGrid.PageSize, Mode=TwoWay}"
                                              AutomationProperties.Name="Colors per page"
                                              AutomationProperties.AutomationId="Catalog.ColorPageSize" />
                                  </StackPanel>
                                </Grid>
                                <Grid Height="280">
                                  <virtualGrid:VirtualDataGrid x:Name="AvailableColorsGrid" Classes="colorValuesGrid"
                                                               ItemsSource="{Binding $parent[ItemsControl].DataContext.CatalogSetup.AvailableColorsGrid.Rows}"
                                                               Height="280" RowHeight="32" SelectionMode="None" Focusable="False"
                                                               AutomationProperties.Name="Available Colors"
                                                               AutomationProperties.AutomationId="Catalog.ColorGrid">
                                    <virtualGrid:VirtualDataGrid.Columns>
                                      <virtualColumns:VirtualDataGridTemplateColumn Header="Color" Width="348" IsSortable="False" IsResizable="False">
                                        <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                                          <DataTemplate x:DataType="stores:AvailableColorGridRowViewModel">
                                            <Border Classes="colorChoiceGridRow" Classes.alternate="{Binding IsAlternate}" Padding="{DynamicResource Token.Layout.Padding.HorizontalVertical.Control.None}">
                                              <TextBlock Text="{Binding ColorName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                         ToolTip.Tip="{Binding ColorName}" />
                                            </Border>
                                          </DataTemplate>
                                        </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                                      </virtualColumns:VirtualDataGridTemplateColumn>
                                    </virtualGrid:VirtualDataGrid.Columns>
                                  </virtualGrid:VirtualDataGrid>
                                  <TextBlock IsVisible="{Binding $parent[ItemsControl].DataContext.CatalogSetup.AvailableColorsGrid.HasNoSearchResults}"
                                             Text="No Colors match your search."
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Foreground="{DynamicResource SecondaryTextBrush}"
                                             AutomationProperties.AutomationId="Catalog.ColorNoMatches" />
                                </Grid>
                              </StackPanel>
                              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Token.Spacing.ControlGap}">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding $parent[ItemsControl].DataContext.CatalogSetup.AvailableColorsGrid.PageSummary}"
                                           VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="Catalog.ColorPageSummary" />
                                <Button Grid.Column="1" Content="Previous"
                                        Command="{Binding $parent[ItemsControl].DataContext.CatalogSetup.AvailableColorsGrid.PreviousPageCommand}"
                                        Classes="secondary" Padding="{DynamicResource Token.Layout.Padding.HorizontalVertical.Control.Compact}"
                                        AutomationProperties.Name="Previous Colors page"
                                        AutomationProperties.AutomationId="Catalog.ColorPreviousPage" />
                                <Button Grid.Column="2" Content="Next"
                                        Command="{Binding $parent[ItemsControl].DataContext.CatalogSetup.AvailableColorsGrid.NextPageCommand}"
                                        Classes="secondary" Padding="{DynamicResource Token.Layout.Padding.HorizontalVertical.Control.Compact}"
                                        AutomationProperties.Name="Next Colors page"
                                        AutomationProperties.AutomationId="Catalog.ColorNextPage" />
                              </Grid>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Token.Spacing.ControlGap}">
                              <Button Content="Manage values"
                                      Command="{Binding $parent[ItemsControl].DataContext.CatalogSetup.ManageOptionCommand}"
                                      CommandParameter="{Binding Option}" Classes="secondary" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button x:Name="AddOptionButton" Content="Add Option" Command="{Binding CatalogSetup.StartAddOptionCommand}" Classes="secondary" />
                  <StackPanel IsVisible="{Binding CatalogSetup.IsAddingOption}" Spacing="{DynamicResource Token.Spacing.InlineGap}">
                    <ComboBox ItemsSource="{Binding CatalogSetup.OptionKinds}" SelectedItem="{Binding CatalogSetup.SelectedOptionKind}" />
                    <TextBox Text="{Binding CatalogSetup.OptionName}" PlaceholderText="Option name" Classes="field" />
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Token.Spacing.ControlGap}">
                      <Button Content="Save Option" Command="{Binding CatalogSetup.CreateOptionCommand}" Classes="primary fixedAction" />
                      <Button Content="Cancel" Command="{Binding CatalogSetup.CancelAddOptionCommand}" Classes="secondary fixedAction" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="panel" Padding="{DynamicResource Token.Layout.Padding.Uniform.Panel}" IsVisible="{Binding IsVariantManagement}"
                      AutomationProperties.AutomationId="Catalog.VariantSellableVariants">
                <StackPanel Spacing="{DynamicResource Token.Spacing.ControlGap}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Token.Spacing.Gap.Panel}">
                    <StackPanel Grid.Column="0" Spacing="{DynamicResource Token.Spacing.Gap.Micro}">
                      <TextBlock Text="2. Sellable Variants" FontSize="{DynamicResource Token.Typography.ToolTitle}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding CatalogSetup.AvailableVariantCount, StringFormat='{}{0} configured'}" FontSize="{DynamicResource Token.Typography.Caption}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource Token.Spacing.ControlGap}">
                      <Button x:Name="AddVariantButton" Content="Add Variant" Command="{Binding CatalogSetup.StartAddVariantCommand}" Classes="secondary" />
                      <Button x:Name="BulkAddVariantButton" Content="Bulk add" Command="{Binding CatalogSetup.StartBulkVariantsCommand}" Classes="secondary" />
                    </StackPanel>
                  </Grid>
                    <TextBlock Text="A Variant is one concrete combination of Option Values, such as Black and Medium."
                               TextWrapping="Wrap" FontSize="{DynamicResource Token.Typography.Caption}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock IsVisible="{Binding !CatalogSetup.HasAvailableOptions}" Text="Add Options and Values before creating Variants." Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock IsVisible="{Binding !CatalogSetup.HasAvailableVariants}" Text="No concrete Variants configured." Foreground="{DynamicResource SecondaryTextBrush}" />
                    <virtualGrid:VirtualDataGrid x:Name="SellableVariantGrid" Height="224" Classes="sellableVariantGrid"
                                                 RowHeight="32" SelectionMode="None"
                                                 AutomationProperties.Name="Sellable Variants"
                                                 AutomationProperties.AutomationId="Catalog.SellableVariantGrid">
                      <virtualGrid:VirtualDataGrid.Columns>
                        <virtualColumns:VirtualDataGridTemplateColumn Header="Name" Width="140" IsSortable="False" IsResizable="False">
                          <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="stores:SellableVariantRowViewModel">
                              <Border Classes="listItem" Padding="{DynamicResource Token.Layout.Padding.HorizontalVertical.Control.None}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Name}" AutomationProperties.Name="Variant name"
                                           AutomationProperties.HelpText="{Binding Name}" />
                              </Border>
                            </DataTemplate>
                          </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                        </virtualColumns:VirtualDataGridTemplateColumn>
                        <virtualColumns:VirtualDataGridTemplateColumn Header="Color" Width="82" IsSortable="False" IsResizable="False">
                          <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="stores:SellableVariantRowViewModel">
                              <Border Classes="listItem" Padding="{DynamicResource Token.Layout.Padding.HorizontalVertical.Control.None}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="{Binding Color}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Color}" AutomationProperties.Name="Color"
                                           AutomationProperties.HelpText="{Binding Color}" />
                              </Border>
                            </DataTemplate>
                          </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                        </virtualColumns:VirtualDataGridTemplateColumn>
                        <virtualColumns:VirtualDataGridTemplateColumn Header="Size" Width="66" IsSortable="False" IsResizable="False">
                          <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="stores:SellableVariantRowViewModel">
                              <Border Classes="listItem" Padding="{DynamicResource Token.Layout.Padding.HorizontalVertical.Control.None}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="{Binding Size}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Size}" AutomationProperties.Name="Size"
                                           AutomationProperties.HelpText="{Binding Size}" />
                              </Border>
                            </DataTemplate>
                          </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                        </virtualColumns:VirtualDataGridTemplateColumn>
                        <virtualColumns:VirtualDataGridTemplateColumn Header="Other" Width="110" IsSortable="False" IsResizable="False">
                          <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="stores:SellableVariantRowViewModel">
                              <Border Classes="listItem" Padding="{DynamicResource Token.Layout.Padding.HorizontalVertical.Control.None}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="{Binding Other}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Other}" AutomationProperties.Name="Other option values"
                                           AutomationProperties.HelpText="{Binding Other}" />
                              </Border>
                            </DataTemplate>
                          </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                        </virtualColumns:VirtualDataGridTemplateColumn>
                        <virtualColumns:VirtualDataGridTemplateColumn Header="Action" Width="84" IsSortable="False" IsResizable="False">
                          <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="stores:SellableVariantRowViewModel">
                              <Border Classes="listItem" Padding="{DynamicResource Token.Layout.Padding.HorizontalVertical.Compact.None}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Button MinWidth="72" Content="Archive" CommandParameter="{Binding}"
                                        Classes="secondary sellableVariantArchive"
                                        AutomationProperties.Name="{Binding Name, StringFormat='Archive Variant {0}'}" />
                              </Border>
                            </DataTemplate>
                          </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                        </virtualColumns:VirtualDataGridTemplateColumn>
                      </virtualGrid:VirtualDataGrid.Columns>
                    </virtualGrid:VirtualDataGrid>
                </StackPanel>
              </Border>

              <Border IsVisible="{Binding IsDesignAreaManagement}" Classes="panel" Padding="{DynamicResource Token.Layout.Padding.Uniform.Panel}"
                        AutomationProperties.AutomationId="Catalog.DesignAreaList">
                  <StackPanel Spacing="{DynamicResource Token.Spacing.GroupGap}">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="{DynamicResource Token.Spacing.Gap.Tight}">
                        <TextBlock Text="Design Areas" FontSize="{DynamicResource Token.Typography.ToolTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="Printable regions for this Offering." Foreground="{DynamicResource SecondaryTextBrush}" />
                      </StackPanel>
                      <Button x:Name="AddDesignAreaButton" Grid.Column="1" Content="Add Design Area" Command="{Binding CatalogSetup.StartAddPlaceholderCommand}" Classes="primary" />
                    </Grid>
                    <TextBlock IsVisible="{Binding !CatalogSetup.HasAvailablePlaceholders}" Text="No Design Areas configured." Foreground="{DynamicResource SecondaryTextBrush}" />
                    <virtualGrid:VirtualDataGrid x:Name="DesignAreaGrid" Height="260" Classes="designAreaGrid"
                                                 DataContext="{Binding CatalogSetup}"
                                                 RowHeight="32" SelectionMode="None"
                                                 AutomationProperties.Name="Design Areas"
                                                 AutomationProperties.AutomationId="Catalog.DesignAreaGrid">
                      <virtualGrid:VirtualDataGrid.Columns>
                        <virtualColumns:VirtualDataGridTemplateColumn Header="Name" Width="104" IsSortable="False" IsResizable="False">
                          <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="stores:DesignAreaCardViewModel">
                              <Border Classes="designAreaGridCell" Padding="{DynamicResource Token.Layout.Padding.HorizontalVertical.Inline.Compact}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                                           AutomationProperties.HelpText="{Binding Name}" />
                              </Border>
                            </DataTemplate>
                          </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                        </virtualColumns:VirtualDataGridTemplateColumn>
                        <virtualColumns:VirtualDataGridTemplateColumn Header="Placement" Width="62" IsSortable="False" IsResizable="False">
                          <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="stores:DesignAreaCardViewModel">
                              <Border Classes="designAreaGridCell" Padding="{DynamicResource Token.Layout.Padding.HorizontalVertical.Inline.Compact}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="{Binding Placement}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Placement}" AutomationProperties.Name="{Binding Placement}"
                                           AutomationProperties.HelpText="{Binding Placement}" />
                              </Border>
                            </DataTemplate>
                          </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                        </virtualColumns:VirtualDataGridTemplateColumn>
                        <virtualColumns:VirtualDataGridTemplateColumn Header="Maximum size" Width="100" IsSortable="False" IsResizable="False">
                          <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="stores:DesignAreaCardViewModel">
                              <Border Classes="designAreaGridCell" Padding="{DynamicResource Token.Layout.Padding.HorizontalVertical.Inline.Compact}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="{Binding MaximumSizeSummary}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding MaximumSizeSummary}" AutomationProperties.Name="{Binding MaximumSizeSummary, StringFormat='Maximum size: {0}'}"
                                           AutomationProperties.HelpText="{Binding MaximumSizeSummary}" />
                              </Border>
                            </DataTemplate>
                          </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                        </virtualColumns:VirtualDataGridTemplateColumn>
                        <virtualColumns:VirtualDataGridTemplateColumn Header="Compatibility" Width="106" IsSortable="False" IsResizable="False">
                          <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="stores:DesignAreaCardViewModel">
                              <Border Classes="designAreaGridCell" Padding="{DynamicResource Token.Layout.Padding.HorizontalVertical.Inline.Tight}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource Token.Spacing.Gap.Hairline}">
                                  <TextBlock Text="{Binding CompatibilitySummary}" FontSize="{DynamicResource Token.Typography.Label}" Foreground="{DynamicResource SecondaryTextBrush}"
                                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                             ToolTip.Tip="{Binding CompatibilityAccessibilitySummary}"
                                             AutomationProperties.Name="{Binding CompatibilityAccessibilitySummary}"
                                             AutomationProperties.HelpText="{Binding CompatibilityAccessibilitySummary}" />
                                  <TextBlock Text="Primary" IsVisible="{Binding IsPrimaryForArtworkGeneration}"
                                             FontSize="{DynamicResource Token.Typography.Label}" Foreground="{DynamicResource AccentBrush}"
                                             TextWrapping="NoWrap"
                                             ToolTip.Tip="Primary for artwork generation"
                                             AutomationProperties.Name="Primary for artwork generation" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                        </virtualColumns:VirtualDataGridTemplateColumn>
                        <virtualColumns:VirtualDataGridTemplateColumn Header="Actions" Width="112" IsSortable="False" IsResizable="False">
                          <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="stores:DesignAreaCardViewModel">
                              <Border Classes="designAreaGridCell" Padding="{DynamicResource Token.Layout.Padding.HorizontalVertical.Compact.None}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Token.Spacing.CompactGap}" VerticalAlignment="Center">
                                  <Button Width="42" MinHeight="28" Padding="{DynamicResource Token.Layout.Padding.HorizontalVertical.Micro.Micro}" FontSize="11" Content="Edit"
                                          Command="{Binding $parent[virtualGrid:VirtualDataGrid].DataContext.EditPlaceholderCommand}"
                                          CommandParameter="{Binding}" Classes="secondary designAreaEdit"
                                          AutomationProperties.Name="{Binding Name, StringFormat='Edit Design Area {0}'}" />
                                  <Button Width="58" MinHeight="28" Padding="{DynamicResource Token.Layout.Padding.HorizontalVertical.Micro.Micro}" FontSize="11" Content="Archive"
                                          Command="{Binding $parent[virtualGrid:VirtualDataGrid].DataContext.ArchivePlaceholderCommand}"
                                          CommandParameter="{Binding}" Classes="danger designAreaArchive"
                                          AutomationProperties.Name="{Binding Name, StringFormat='Archive Design Area {0}'}" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                        </virtualColumns:VirtualDataGridTemplateColumn>
                      </virtualGrid:VirtualDataGrid.Columns>
                    </virtualGrid:VirtualDataGrid>
                  </StackPanel>
              </Border>

              <Grid IsVisible="{Binding IsMockupTemplateManagement}">
                <Border Classes="panel" Padding="{DynamicResource Token.Layout.Padding.Uniform.Panel}"
                        AutomationProperties.AutomationId="Catalog.MockupTemplateList">
                  <StackPanel Spacing="{DynamicResource Token.Spacing.ControlGap}">
                  <TextBlock Text="Mockup Templates" FontSize="{DynamicResource Token.Typography.ToolTitle}" FontWeight="SemiBold" />
                  <TextBlock Text="Each template groups local mockup source images under one shared Design Area. Compatible concrete Variants are derived from their applicability."
                             TextWrapping="Wrap"
                             FontSize="{DynamicResource Token.Typography.Caption}"
                             Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBlock Text="{Binding CatalogSetup.ProviderCatalogMessage}"
                             IsVisible="{Binding CatalogSetup.HasProviderCatalogMessage}"
                             TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBox x:Name="MockupTemplateSearchBox"
                           Text="{Binding CatalogSetup.MockupTemplateSearchText, Mode=TwoWay}"
                           PlaceholderText="Search templates"
                           AutomationProperties.Name="Search Mockup Templates"
                           AutomationProperties.AutomationId="Catalog.MockupTemplateSearch" />
                  <TextBlock IsVisible="{Binding !CatalogSetup.HasAvailableTemplates}"
                             Text="No Mockup Templates configured."
                             Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBlock IsVisible="{Binding CatalogSetup.HasNoMockupTemplateSearchResults}"
                             Text="No active Mockup Templates match this search. Clear or change the query."
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             AutomationProperties.AutomationId="Catalog.MockupTemplateNoSearchResults" />
                  <virtualGrid:VirtualDataGrid x:Name="MockupTemplateGrid"
                                               Height="240"
                                               RowHeight="40"
                                               SelectionMode="Single"
                                               Focusable="True"
                                               IsTabStop="True"
                                               IsVisible="{Binding CatalogSetup.HasFilteredMockupTemplateCards}"
                                               AutomationProperties.Name="Active Mockup Templates"
                                               AutomationProperties.AutomationId="Catalog.MockupTemplateTable">
                    <virtualGrid:VirtualDataGrid.Columns>
                      <virtualColumns:VirtualDataGridTemplateColumn Header="Template" Width="116" IsSortable="False" IsResizable="False">
                        <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                          <DataTemplate x:DataType="stores:MockupTemplateCardViewModel">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding Name}" AutomationProperties.Name="{Binding Name}" />
                          </DataTemplate>
                        </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                      </virtualColumns:VirtualDataGridTemplateColumn>
                      <virtualColumns:VirtualDataGridTemplateColumn Header="Design Area" Width="100" IsSortable="False" IsResizable="False">
                        <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                          <DataTemplate x:DataType="stores:MockupTemplateCardViewModel">
                            <TextBlock Text="{Binding TargetDesignArea}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding TargetDesignArea}" AutomationProperties.Name="{Binding TargetDesignArea}" />
                          </DataTemplate>
                        </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                      </virtualColumns:VirtualDataGridTemplateColumn>
                      <virtualColumns:VirtualDataGridTemplateColumn Header="Colors" Width="110" IsSortable="False" IsResizable="False">
                        <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                          <DataTemplate x:DataType="stores:MockupTemplateCardViewModel">
                            <TextBlock Text="{Binding ColorSummary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding ColorSummary}" AutomationProperties.Name="{Binding ColorSummary}" />
                          </DataTemplate>
                        </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                      </virtualColumns:VirtualDataGridTemplateColumn>
                      <virtualColumns:VirtualDataGridTemplateColumn Header="Variants" Width="92" IsSortable="False" IsResizable="False">
                        <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                          <DataTemplate x:DataType="stores:MockupTemplateCardViewModel">
                            <TextBlock Text="{Binding VariantSummary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding VariantSummary}" AutomationProperties.Name="{Binding VariantSummary}" />
                          </DataTemplate>
                        </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                      </virtualColumns:VirtualDataGridTemplateColumn>
                      <virtualColumns:VirtualDataGridTemplateColumn Header="Revision" Width="110" IsSortable="False" IsResizable="False">
                        <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                          <DataTemplate x:DataType="stores:MockupTemplateCardViewModel">
                            <TextBlock Text="{Binding RevisionSummary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding RevisionSummary}" AutomationProperties.Name="{Binding RevisionSummary}" />
                          </DataTemplate>
                        </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                      </virtualColumns:VirtualDataGridTemplateColumn>
                    </virtualGrid:VirtualDataGrid.Columns>
                  </virtualGrid:VirtualDataGrid>
                  <Border Classes="panel" Padding="{DynamicResource Token.Layout.PreviewPadding}"
                          IsVisible="{Binding CatalogSetup.HasSelectedMockupTemplateCard}"
                          AutomationProperties.AutomationId="Catalog.SelectedMockupTemplateDetails">
                    <StackPanel Spacing="{DynamicResource Token.Spacing.InlineGap}">
                      <TextBlock Text="{Binding CatalogSetup.SelectedMockupTemplateCard.Name}"
                                 FontWeight="SemiBold"
                                 AutomationProperties.Name="{Binding CatalogSetup.SelectedMockupTemplateCard.Name}" />
                      <TextBlock Text="{Binding CatalogSetup.SelectedMockupTemplateCard.TargetDesignArea, StringFormat='Design Area: {0}'}"
                                 TextWrapping="Wrap"
                                 AutomationProperties.Name="{Binding CatalogSetup.SelectedMockupTemplateCard.TargetDesignArea}" />
                      <TextBlock Text="{Binding CatalogSetup.SelectedMockupTemplateCard.ColorSummary, StringFormat='Colors: {0}'}"
                                 TextWrapping="Wrap"
                                 AutomationProperties.Name="{Binding CatalogSetup.SelectedMockupTemplateCard.ColorSummary}" />
                      <TextBlock Text="{Binding CatalogSetup.SelectedMockupTemplateCard.VariantSummary}"
                                 TextWrapping="Wrap"
                                 AutomationProperties.Name="{Binding CatalogSetup.SelectedMockupTemplateCard.VariantSummary}" />
                      <TextBlock Text="{Binding CatalogSetup.SelectedMockupTemplateCard.RevisionSummary}"
                                 TextWrapping="Wrap"
                                 AutomationProperties.Name="{Binding CatalogSetup.SelectedMockupTemplateCard.RevisionSummary}" />
                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Token.Spacing.ControlGap}">
                        <Button Content="Edit"
                                Command="{Binding CatalogSetup.EditTemplateCommand}"
                                CommandParameter="{Binding CatalogSetup.SelectedMockupTemplateCard}"
                                AutomationProperties.Name="{Binding CatalogSetup.SelectedMockupTemplateCard.Name, StringFormat='Edit {0}'}" />
                        <Button Content="Duplicate"
                                Command="{Binding CatalogSetup.DuplicateTemplateCommand}"
                                CommandParameter="{Binding CatalogSetup.SelectedMockupTemplateCard}"
                                AutomationProperties.Name="{Binding CatalogSetup.SelectedMockupTemplateCard.Name, StringFormat='Duplicate {0}'}" />
                        <Button Content="Archive"
                                Command="{Binding CatalogSetup.ArchiveTemplateCommand}"
                                CommandParameter="{Binding CatalogSetup.SelectedMockupTemplateCard}"
                                AutomationProperties.Name="{Binding CatalogSetup.SelectedMockupTemplateCard.Name, StringFormat='Archive {0}'}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Border IsVisible="{Binding !CatalogSetup.HasAvailablePlaceholders}"
                          Background="{DynamicResource WarningBackgroundBrush}"
                          BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" Padding="{DynamicResource Token.Layout.Padding.Uniform.Group}">
                    <StackPanel Spacing="{DynamicResource Token.Spacing.InlineGap}">
                      <TextBlock Text="Create a Design Area before configuring Mockup Templates." TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" />
                      <Button Content="Manage Design Areas" Command="{Binding OpenDesignAreaManagementCommand}" Classes="secondary" />
                    </StackPanel>
                  </Border>
                  <Button x:Name="AddMockupTemplateButton" Content="Add Mockup Template" Command="{Binding CatalogSetup.StartAddTemplateCommand}" Classes="secondary" />
                  </StackPanel>
                </Border>
              </Grid>

              <Border Classes="panel" Padding="{DynamicResource Token.Layout.Padding.Uniform.Panel}" IsVisible="{Binding IsOfferingDetail}">
                <StackPanel Spacing="{DynamicResource Token.Spacing.ControlGap}">
                  <ToggleButton Content="Advanced"
                                IsChecked="{Binding IsAdvancedSectionExpanded, Mode=TwoWay}"
                                HorizontalContentAlignment="Left" />
                  <StackPanel IsVisible="{Binding IsAdvancedSectionExpanded}" Spacing="{DynamicResource Token.Spacing.ControlGap}">
                    <TextBlock Text="Provider-network identity and external identifiers are preserved by the catalog model. Shopify publication and credentials are future integration work."
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource Token.Typography.Caption}"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="External offering ID" FontSize="{DynamicResource Token.Typography.Caption}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox Text="{Binding CatalogSetup.ExternalOfferingId}" Classes="field" />
                  </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>

          <Border IsVisible="{Binding ProductDeleteWarningVisible}"
                  Background="{DynamicResource DangerBackgroundBrush}"
                  BorderBrush="{DynamicResource DangerBorderBrush}"
                  BorderThickness="1"
                  Padding="{DynamicResource Token.Layout.Padding.Uniform.Panel}"
                  Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_Control.Right_None.Bottom_None}">
            <StackPanel Spacing="{DynamicResource Token.Spacing.ControlGap}">
              <TextBlock Text="{Binding ProductDeleteWarningMessage}"
                         FontSize="{DynamicResource Token.Typography.Body}"
                         Foreground="{DynamicResource DangerTextBrush}" />
              <StackPanel Orientation="Horizontal"
                          Spacing="{DynamicResource Token.Spacing.ControlGap}">
                <Button Content="Delete permanently"
                        Command="{Binding ConfirmDeleteProductCommand}"
                        Classes="danger fixedDanger" />
                <Button Content="Cancel"
                        Command="{Binding CancelDeleteProductCommand}"
                        Classes="secondary fixedAction" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border IsVisible="{Binding OfferingDeleteWarningVisible}"
                  Background="{DynamicResource DangerBackgroundBrush}"
                  BorderBrush="{DynamicResource DangerBorderBrush}"
                  BorderThickness="1"
                  Padding="{DynamicResource Token.Layout.Padding.Uniform.Panel}"
                  Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_Control.Right_None.Bottom_None}">
            <StackPanel Spacing="{DynamicResource Token.Spacing.ControlGap}">
              <TextBlock Text="{Binding OfferingDeleteWarningMessage}"
                         FontSize="{DynamicResource Token.Typography.Body}"
                         Foreground="{DynamicResource DangerTextBrush}" />
              <StackPanel Orientation="Horizontal"
                          Spacing="{DynamicResource Token.Spacing.ControlGap}">
                <Button Content="Delete permanently"
                        Command="{Binding ConfirmDeleteOfferingCommand}"
                        Classes="danger fixedDanger" />
                <Button Content="Cancel"
                        Command="{Binding CancelDeleteOfferingCommand}"
                        Classes="secondary fixedAction" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border IsVisible="{Binding DeleteWarningVisible}"
                  Background="{DynamicResource DangerBackgroundBrush}"
                  BorderBrush="{DynamicResource DangerBorderBrush}"
                  BorderThickness="1"
                  Padding="{DynamicResource Token.Layout.Padding.Uniform.Panel}"
                  Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_Control.Right_None.Bottom_None}">
            <StackPanel Spacing="{DynamicResource Token.Spacing.ControlGap}">
              <TextBlock Text="{Binding DeleteWarningMessage}"
                         FontSize="{DynamicResource Token.Typography.Body}"
                         Foreground="{DynamicResource DangerTextBrush}" />
              <StackPanel Orientation="Horizontal"
                          Spacing="{DynamicResource Token.Spacing.ControlGap}">
                <Button Content="Delete permanently"
                        Command="{Binding ConfirmDeleteStoreCommand}"
                        Classes="danger fixedDanger" />
                <Button Content="Cancel"
                        Command="{Binding CancelDeleteStoreCommand}"
                        Classes="secondary fixedAction" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border IsVisible="{Binding NicheDeleteWarningVisible}"
                  Background="{DynamicResource DangerBackgroundBrush}"
                  BorderBrush="{DynamicResource DangerBorderBrush}"
                  BorderThickness="1"
                  Padding="{DynamicResource Token.Layout.Padding.Uniform.Panel}"
                  Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_Control.Right_None.Bottom_None}">
            <StackPanel Spacing="{DynamicResource Token.Spacing.ControlGap}">
              <TextBlock Text="{Binding NicheDeleteWarningMessage}"
                         FontSize="{DynamicResource Token.Typography.Body}"
                         Foreground="{DynamicResource DangerTextBrush}" />
              <StackPanel Orientation="Horizontal"
                          Spacing="{DynamicResource Token.Spacing.ControlGap}">
                <Button Content="Delete permanently"
                        Command="{Binding ConfirmDeleteNicheCommand}"
                        Classes="danger fixedDanger" />
                <Button Content="Cancel"
                        Command="{Binding CancelDeleteNicheCommand}"
                        Classes="secondary fixedAction" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border IsVisible="{Binding DiscardChangesPromptVisible}"
                  Background="{DynamicResource WarningBackgroundBrush}"
                  BorderBrush="{DynamicResource WarningBorderBrush}"
                  BorderThickness="1"
                  Padding="{DynamicResource Token.Layout.Padding.Uniform.Panel}"
                  Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_Control.Right_None.Bottom_None}">
            <StackPanel Spacing="{DynamicResource Token.Spacing.ControlGap}">
              <TextBlock Text="{Binding DiscardChangesMessage}"
                         FontSize="{DynamicResource Token.Typography.Body}"
                         Foreground="{DynamicResource StrongTextBrush}" />
              <StackPanel Orientation="Horizontal"
                          Spacing="{DynamicResource Token.Spacing.ControlGap}">
                <Button Content="Discard changes"
                        Command="{Binding ConfirmDiscardChangesCommand}"
                        Classes="danger fixedDanger" />
                <Button Content="Keep editing"
                        Command="{Binding KeepEditingCommand}"
                        Classes="secondary fixedDanger" />
              </StackPanel>
            </StackPanel>
          </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
  <Window.Styles>
    <Style Selector="Button.primary">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource CommandBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CommandForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CommandBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.iconButton">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="MenuItem.danger">
      <Setter Property="Foreground" Value="{DynamicResource DangerStrongBrush}" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource DangerStrongBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CommandForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.fixedAction">
      <Setter Property="Width" Value="104" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.nichePopulateAction">
      <Setter Property="MinWidth" Value="104" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.offeringAction">
      <Setter Property="Width" Value="200" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.blueprintAction">
      <Setter Property="Width" Value="140" />
    </Style>
    <Style Selector="Button.fixedDanger">
      <Setter Property="Width" Value="156" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.restoreAction">
      <Setter Property="Width" Value="220" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.listItem">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource PanelSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.choiceCard">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
    </Style>
    <Style Selector="Border.colorChoiceGridRow">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.colorChoiceGridRow.alternate">
      <Setter Property="Background" Value="{DynamicResource Token.Color.SurfaceSubtle}" />
    </Style>
    <Style Selector="Border.optionValueGridRow">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.optionValueGridRow.alternate">
      <Setter Property="Background" Value="{DynamicResource Token.Color.SurfaceSubtle}" />
    </Style>
    <Style Selector="virtualGrid|VirtualDataGrid.colorValuesGrid /template/ ScrollViewer#PART_ScrollViewer">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="virtualGrid|VirtualDataGrid.designAreaGrid /template/ ScrollViewer#PART_ScrollViewer">
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style Selector="virtualGrid|VirtualDataGridHeaderPanel">
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="virtualGrid|VirtualDataGrid.printifyBlueprintGrid /template/ ScrollViewer#PART_ScrollViewer">
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style Selector="Button.tabButton">
      <Setter Property="MinWidth" Value="116" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.tabButton.selected">
      <Setter Property="Background" Value="{DynamicResource CommandBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CommandForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CommandBorderBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBox.field">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Window.Styles>
</Window>
