<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:stores="clr-namespace:FusionCanvas.App.Stores"
        xmlns:appStores="clr-namespace:FusionCanvas.Application.Stores;assembly=FusionCanvas.Application"
        xmlns:appNiches="clr-namespace:FusionCanvas.Application.Niches;assembly=FusionCanvas.Application"
        xmlns:appTags="clr-namespace:FusionCanvas.Application.Tags;assembly=FusionCanvas.Application"
        xmlns:appProducts="clr-namespace:FusionCanvas.Application.Products;assembly=FusionCanvas.Application"
        xmlns:catalogApplication="clr-namespace:FusionCanvas.Application.Catalog;assembly=FusionCanvas.Application"
        xmlns:catalog="clr-namespace:FusionCanvas.Domain.Catalog;assembly=FusionCanvas.Domain"
        xmlns:mockups="clr-namespace:FusionCanvas.Domain.Mockups;assembly=FusionCanvas.Domain"
        x:Class="FusionCanvas.App.Stores.StoreEditorWindow"
        x:DataType="stores:StoreManagementViewModel"
        Title="Store Editor"
        Width="860"
        Height="620"
        MinWidth="720"
        MinHeight="520"
        Background="{DynamicResource ApplicationBackgroundBrush}">
  <Grid ColumnDefinitions="260,*"
        RowDefinitions="*">
    <Border Grid.Column="0"
            Background="{DynamicResource ElevatedSurfaceBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="0,0,1,0"
            Padding="16">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top"
                    Spacing="8"
                    Margin="0,0,0,16">
          <TextBlock Text="Stores"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}" />
          <Button Content="New store"
                  AutomationProperties.AutomationId="StoreEditor.NewStore"
                  Command="{Binding StartCreateStoreCommand}"
                  Classes="primary" />
        </StackPanel>

        <StackPanel Spacing="12">
          <TextBlock Text="Active"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource SecondaryTextBrush}" />
          <ItemsControl ItemsSource="{Binding EditorActiveStores}"
                        AutomationProperties.AutomationId="StoreEditor.ActiveStores">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="appStores:StoreSummary">
                <Button Content="{Binding Name}"
                        Command="{Binding $parent[ItemsControl].DataContext.EditStoreCommand}"
                        CommandParameter="{Binding}"
                        Classes="listItem"
                        HorizontalContentAlignment="Left" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock IsVisible="{Binding HasArchivedStores}"
                     Text="Archived"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     Margin="0,8,0,0" />
          <ItemsControl IsVisible="{Binding HasArchivedStores}"
                        ItemsSource="{Binding ArchivedStores}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="appStores:StoreSummary">
                <Button Content="{Binding Name}"
                        Command="{Binding $parent[ItemsControl].DataContext.EditStoreCommand}"
                        CommandParameter="{Binding}"
                        Classes="listItem"
                        HorizontalContentAlignment="Left" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Column="1"
            Margin="18"
            Padding="20"
            Background="{DynamicResource ElevatedSurfaceBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1">
      <ScrollViewer>
        <StackPanel Spacing="12">
          <TextBlock Text="Store Management"
                     FontSize="22"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}" />
          <TextBlock Text="{Binding ErrorMessage}"
                     IsVisible="{Binding HasError}"
                     FontSize="12"
                     Foreground="{DynamicResource DangerTextBrush}" />
          <StackPanel Orientation="Horizontal"
                      Spacing="8">
            <Button Content="Basic info"
                    Command="{Binding SelectBasicInfoTabCommand}"
                    Classes="tabButton"
                    Classes.selected="{Binding IsBasicInfoTabSelected}" />
            <Button Content="Niches"
                    Command="{Binding SelectNichesTabCommand}"
                    Classes="tabButton"
                    Classes.selected="{Binding IsNichesTabSelected}" />
            <Button Content="Tags"
                    Command="{Binding SelectTagsTabCommand}"
                    Classes="tabButton"
                    Classes.selected="{Binding IsTagsTabSelected}" />
            <Button Content="Catalog &amp; mockups"
                    Command="{Binding SelectProductsTabCommand}"
                    Classes="tabButton"
                    Classes.selected="{Binding IsProductsTabSelected}" />
          </StackPanel>

          <StackPanel IsVisible="{Binding IsBasicInfoTabSelected}"
                      Spacing="12">
            <TextBlock Text="Basic info"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource StrongTextBrush}" />
            <TextBox x:Name="StoreNameTextBox"
                     AutomationProperties.AutomationId="StoreEditor.Name"
                     Text="{Binding NewStoreName}"
                     PlaceholderText="Store name"
                     Classes="field" />
            <TextBox Text="{Binding Description}"
                     PlaceholderText="Description"
                     Margin="0,0,16,0"
                     Classes="field" />
            <StackPanel Spacing="4">
              <TextBlock Text="Fulfillment strategy"
                         FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding AvailableFulfillmentStrategies}"
                        SelectedItem="{Binding SelectedFulfillmentStrategy}"
                        IsEnabled="{Binding CanEditStoreConfiguration}"
                        AutomationProperties.AutomationId="StoreEditor.FulfillmentStrategy" />
              <TextBlock Text="Shopify manual — future strategy"
                         Foreground="{DynamicResource DisabledTextBrush}" />
              <TextBlock Text="Shopify + Printify — future strategy"
                         Foreground="{DynamicResource DisabledTextBrush}" />
              <TextBlock Text="Manual means Fusion Canvas records catalog data locally and does not communicate with Shopify or Printify. Future strategies will add their own configuration."
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
            <TextBox Text="{Binding Notes}"
                     PlaceholderText="Notes"
                     Margin="0,0,16,0"
                     AcceptsReturn="True"
                     MinHeight="84"
                     Classes="field" />
            <TextBox Text="{Binding TargetMarket}"
                     PlaceholderText="Target market"
                     Classes="field" />
            <TextBox Text="{Binding BrandDirection}"
                     PlaceholderText="Brand direction"
                     Classes="field" />
            <TextBox Text="{Binding PlanningContext}"
                     PlaceholderText="Planning context"
                     Classes="field" />
            <TextBox Text="{Binding Url}"
                     PlaceholderText="Store URL"
                     Classes="field" />

            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,8,0,0">
              <Button Content="Save"
                      AutomationProperties.AutomationId="StoreEditor.SaveStore"
                      Command="{Binding SaveSelectedStoreCommand}"
                      IsEnabled="{Binding CanSaveSelectedStore}"
                      Classes="primary fixedAction" />
              <Button Content="Archive"
                      Command="{Binding ArchiveSelectedStoreCommand}"
                      IsEnabled="{Binding CanArchiveSelectedStore}"
                      Classes="secondary fixedAction" />
              <Button Content="Delete"
                      Command="{Binding RequestDeleteSelectedStoreCommand}"
                      IsEnabled="{Binding CanDeleteSelectedStore}"
                      Classes="danger fixedAction" />
            </StackPanel>

            <Button Content="Restore selected archived store"
                    IsVisible="{Binding CanRestoreSelectedStore}"
                    Command="{Binding RestoreStoreCommand}"
                    CommandParameter="{Binding SelectedStore}"
                    Classes="secondary restoreAction" />
          </StackPanel>

          <Grid IsVisible="{Binding IsNichesTabSelected}"
                ColumnDefinitions="220,*"
                ColumnSpacing="16">
            <StackPanel Grid.Column="0"
                        Spacing="10">
              <Button Content="New niche"
                      Command="{Binding StartCreateNicheCommand}"
                      Classes="primary" />
              <TextBlock Text="Active niches"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <TextBlock Text="No active niches"
                         IsVisible="{Binding !HasActiveNiches}"
                         FontSize="12"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <ItemsControl ItemsSource="{Binding EditorActiveNiches}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="appNiches:NicheSummary">
                    <Button Content="{Binding Name}"
                            Command="{Binding $parent[ItemsControl].DataContext.EditNicheCommand}"
                            CommandParameter="{Binding}"
                            Classes="listItem"
                            HorizontalContentAlignment="Left" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock IsVisible="{Binding HasArchivedNiches}"
                         Text="Archived niches"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         Margin="0,8,0,0" />
              <ItemsControl IsVisible="{Binding HasArchivedNiches}"
                            ItemsSource="{Binding ArchivedNiches}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="appNiches:NicheSummary">
                    <Button Content="{Binding Name}"
                            Command="{Binding $parent[ItemsControl].DataContext.EditNicheCommand}"
                            CommandParameter="{Binding}"
                            Classes="listItem"
                            HorizontalContentAlignment="Left" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Spacing="10"
                        Margin="0,0,16,0">
              <TextBlock Text="Niche details"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource StrongTextBrush}" />
              <TextBox Text="{Binding NicheName}"
                       PlaceholderText="Niche name"
                       Margin="0,0,16,0"
                       Classes="field" />
              <TextBox Text="{Binding NicheDescription}"
                       PlaceholderText="Description"
                       Margin="0,0,16,0"
                       Classes="field" />
              <TextBox Text="{Binding NicheAudience}"
                       PlaceholderText="Audience"
                       Margin="0,0,16,0"
                       Classes="field" />
              <TextBox Text="{Binding NicheHumorStyle}"
                       PlaceholderText="Humor style"
                       Margin="0,0,16,0"
                       Classes="field" />
              <TextBox Text="{Binding NicheVisualStyleGuidance}"
                       PlaceholderText="Visual style guidance"
                       Margin="0,0,16,0"
                       Classes="field" />
              <TextBox Text="{Binding NicheConstraints}"
                       PlaceholderText="Constraints"
                       Margin="0,0,16,0"
                       Classes="field" />
              <TextBox Text="{Binding NicheRisks}"
                       PlaceholderText="Risks"
                       Margin="0,0,16,0"
                       Classes="field" />
              <TextBox Text="{Binding NicheResearchNotes}"
                       PlaceholderText="Research notes"
                       Margin="0,0,16,0"
                       AcceptsReturn="True"
                       MinHeight="70"
                       Classes="field" />
              <TextBox Text="{Binding NicheNotes}"
                       PlaceholderText="Notes"
                       Margin="0,0,16,0"
                       AcceptsReturn="True"
                       MinHeight="70"
                       Classes="field" />

              <StackPanel Orientation="Horizontal"
                          Spacing="8"
                          Margin="0,8,0,0">
                <Button Content="Save"
                        Command="{Binding SaveSelectedNicheCommand}"
                        IsEnabled="{Binding CanSaveSelectedNiche}"
                        Classes="primary fixedAction" />
                <Button Content="Archive"
                        Command="{Binding ArchiveSelectedNicheCommand}"
                        IsEnabled="{Binding CanArchiveSelectedNiche}"
                        Classes="secondary fixedAction" />
                <Button Content="Delete"
                        Command="{Binding RequestDeleteSelectedNicheCommand}"
                        IsEnabled="{Binding CanDeleteSelectedNiche}"
                        Classes="danger fixedAction" />
              </StackPanel>

              <Button Content="Restore selected archived niche"
                      IsVisible="{Binding CanRestoreSelectedNiche}"
                      Command="{Binding RestoreNicheCommand}"
                      CommandParameter="{Binding SelectedNiche}"
                      Classes="secondary restoreAction" />
            </StackPanel>
          </Grid>

          <Grid IsVisible="{Binding IsTagsTabSelected}"
                ColumnDefinitions="220,*"
                ColumnSpacing="16">
            <StackPanel Grid.Column="0"
                        Spacing="10">
              <Button Content="New tag"
                      Command="{Binding StartCreateTagCommand}"
                      Classes="primary" />
              <TextBlock Text="Active tags"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <TextBlock Text="No active tags"
                         IsVisible="{Binding !HasActiveTags}"
                         FontSize="12"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <ItemsControl ItemsSource="{Binding EditorActiveTags}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="appTags:TagSummary">
                    <Button Content="{Binding Name}"
                            Command="{Binding $parent[ItemsControl].DataContext.EditTagCommand}"
                            CommandParameter="{Binding}"
                            Classes="listItem"
                            HorizontalContentAlignment="Left" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock IsVisible="{Binding HasArchivedTags}"
                         Text="Archived tags"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         Margin="0,8,0,0" />
              <ItemsControl IsVisible="{Binding HasArchivedTags}"
                            ItemsSource="{Binding ArchivedTags}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="appTags:TagSummary">
                    <Button Content="{Binding Name}"
                            Command="{Binding $parent[ItemsControl].DataContext.EditTagCommand}"
                            CommandParameter="{Binding}"
                            Classes="listItem"
                            HorizontalContentAlignment="Left" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Spacing="10"
                        Margin="0,0,16,0">
              <TextBlock Text="Tag details"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource StrongTextBrush}" />
              <TextBox Text="{Binding TagName}"
                       PlaceholderText="Tag name"
                       Classes="field" />
              <StackPanel Spacing="4">
                <TextBlock Text="Color"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBox Text="{Binding TagColor}"
                         PlaceholderText="#RRGGBB (optional)"
                         Classes="field" />
              </StackPanel>
              <TextBox Text="{Binding TagDescription}"
                       PlaceholderText="Description"
                       Margin="0,0,64,0"
                       Classes="field" />

              <StackPanel Orientation="Horizontal"
                          Spacing="8"
                          Margin="0,8,0,0">
                <Button Content="Save"
                        Command="{Binding SaveSelectedTagCommand}"
                        IsEnabled="{Binding CanSaveSelectedTag}"
                        Classes="primary fixedAction" />
                <Button Content="Archive"
                        Command="{Binding ArchiveSelectedTagCommand}"
                        IsEnabled="{Binding CanArchiveSelectedTag}"
                        Classes="secondary fixedAction" />
                <Button Content="Delete"
                        Command="{Binding RequestDeleteSelectedTagCommand}"
                        IsEnabled="{Binding CanDeleteSelectedTag}"
                        Classes="danger fixedAction" />
              </StackPanel>

              <Button Content="Restore selected archived tag"
                      IsVisible="{Binding CanRestoreSelectedTag}"
                      Command="{Binding RestoreTagCommand}"
                      CommandParameter="{Binding SelectedTag}"
                      Classes="secondary restoreAction" />
            </StackPanel>
          </Grid>

          <Border IsVisible="{Binding TagDeleteWarningVisible}"
                  Background="{DynamicResource DangerBackgroundBrush}"
                  BorderBrush="{DynamicResource DangerBorderBrush}"
                  BorderThickness="1"
                  Padding="12"
                  Margin="0,8,0,0">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding TagDeleteWarningMessage}"
                         FontSize="13"
                         Foreground="{DynamicResource DangerTextBrush}" />
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <Button Content="Delete permanently"
                        Command="{Binding ConfirmDeleteTagCommand}"
                        Classes="danger fixedDanger" />
                <Button Content="Cancel"
                        Command="{Binding CancelDeleteTagCommand}"
                        Classes="secondary fixedAction" />
              </StackPanel>
            </StackPanel>
          </Border>

          <StackPanel IsVisible="{Binding IsProductsTabSelected}"
                      Spacing="12">
            <StackPanel IsVisible="{Binding IsCatalogOverview}"
                        Spacing="12">
              <TextBlock Text="Catalog overview"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource StrongTextBrush}" />
              <TextBlock Text="Define Blueprints, fulfillment offerings, Variants, and Placeholders. Blueprint is Printify terminology for the base product; Placeholder is the named design target on an offering."
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <Button Content="New Blueprint"
                      Command="{Binding StartCreateProductCommand}"
                      IsEnabled="{Binding CanCreateCatalogItem}"
                      Classes="primary" />
              <TextBlock IsVisible="{Binding !HasProducts}"
                         Text="No Blueprints yet. Add a Blueprint to begin."
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <ItemsControl ItemsSource="{Binding EditorProducts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="appProducts:StoreProductSummary">
                    <Button Command="{Binding $parent[ItemsControl].DataContext.OpenProductDetailCommand}"
                            CommandParameter="{Binding}"
                            Classes="listItem"
                            HorizontalContentAlignment="Left">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Offerings.Count, StringFormat='{}{0} Blueprint Offering(s)'}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel IsVisible="{Binding IsProductDetail}"
                        Spacing="12">
              <Button Content="‹  Back to Blueprints"
                      Command="{Binding BackToProductsCommand}"
                      Classes="secondary" />
              <TextBlock Text="{Binding CatalogBreadcrumb}"
                         FontSize="12"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <TextBlock Text="{Binding ProductName}"
                         FontSize="20"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource StrongTextBrush}" />
              <TextBlock Text="{Binding SelectedProductSummary}"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <Border Classes="panel" Padding="12">
                <StackPanel Spacing="8">
                  <TextBlock Text="Blueprint details"
                             FontWeight="SemiBold"
                             ToolTip.Tip="Blueprint is Printify's term for the base product definition." />
                  <TextBlock Text="Name" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBox x:Name="ProductNameTextBox"
                           Text="{Binding ProductName}"
                           PlaceholderText="Blueprint name"
                           Classes="field" />
                  <TextBlock Text="Description" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBox Text="{Binding ProductDescription}"
                           AcceptsReturn="True"
                           MinHeight="56"
                           Classes="field" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Save Blueprint"
                            Command="{Binding SaveSelectedProductCommand}"
                            IsEnabled="{Binding CanSaveSelectedProduct}"
                            Classes="primary fixedAction" />
                    <Button Content="Delete Blueprint"
                            Command="{Binding RequestDeleteSelectedProductCommand}"
                            IsEnabled="{Binding CanDeleteSelectedProduct}"
                            Classes="danger fixedAction" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Classes="panel" Padding="12">
                <StackPanel Spacing="8">
                  <TextBlock Text="Blueprint Offerings"
                             FontWeight="SemiBold"
                             ToolTip.Tip="An Offering is a concrete fulfillment choice for a Blueprint." />
                  <TextBlock Text="An Offering is one way this Blueprint is supplied."
                             FontSize="12"
                             Foreground="{DynamicResource SecondaryTextBrush}" />
                  <Button Content="Add Blueprint Offering"
                          Command="{Binding StartCreateOfferingCommand}"
                          IsEnabled="{Binding CanCreateCatalogItem}"
                          Classes="primary" />
                  <TextBlock IsVisible="{Binding !HasSelectedProductOfferings}"
                             Text="No Blueprint Offerings yet."
                             Foreground="{DynamicResource SecondaryTextBrush}" />
                  <ItemsControl ItemsSource="{Binding SelectedProduct.Offerings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="appProducts:FulfillmentOfferingSummary">
                        <Button Command="{Binding $parent[ItemsControl].DataContext.OpenOfferingDetailCommand}"
                                CommandParameter="{Binding}"
                                Classes="listItem"
                                HorizontalContentAlignment="Left">
                          <StackPanel Spacing="3">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding FulfillmentContextLabel}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding SetupSummary}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel IsVisible="{Binding IsOfferingContext}"
                        Spacing="12">
              <Button Content="‹  Back to Blueprint"
                      Command="{Binding BackToProductCommand}"
                      IsVisible="{Binding IsOfferingDetail}"
                      Classes="secondary" />
              <Button Content="Back to Offering overview"
                      Command="{Binding BackToOfferingOverviewCommand}"
                      IsVisible="{Binding !IsOfferingDetail}"
                      Classes="secondary" />
              <TextBlock Text="{Binding CatalogBreadcrumb}"
                         FontSize="12"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <TextBlock Text="{Binding OfferingName}"
                         IsVisible="{Binding IsCreatingNewOffering}"
                         FontSize="20"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource StrongTextBrush}" />
              <TextBlock Text="{Binding CatalogSetup.OfferingName}"
                         IsVisible="{Binding CatalogSetup.HasSelectedOffering}"
                         FontSize="20"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource StrongTextBrush}" />
              <Border IsVisible="{Binding CatalogSetup.IsOfferingContextUnavailable}"
                      Background="{DynamicResource WarningBackgroundBrush}"
                      BorderBrush="{DynamicResource WarningBorderBrush}"
                      BorderThickness="1"
                      Padding="12">
                <TextBlock Text="This Blueprint Offering could not be repaired into the normalized catalog. Return to the Blueprint and reopen it, or review the catalog error below."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource WarningTextBrush}" />
              </Border>
              <TextBlock Text="{Binding CatalogSetup.ErrorMessage}"
                         IsVisible="{Binding CatalogSetup.HasError}"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource DangerTextBrush}" />

              <Border Classes="panel" Padding="12" IsVisible="{Binding IsCreatingNewOffering}">
                <StackPanel Spacing="8">
                  <TextBlock Text="New Blueprint Offering" FontWeight="SemiBold" />
                  <TextBlock Text="Choose the fulfillment relationship first. After saving, Options, Variants, Placeholders, and Mockup Templates become available."
                             TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <StackPanel Spacing="8">
                    <TextBlock Text="Name" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox x:Name="OfferingNameTextBox" Text="{Binding OfferingName}" PlaceholderText="Offering name" Classes="field" />
                    <TextBlock Text="Fulfillment type" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ComboBox SelectedIndex="{Binding OfferingKindIndex}" Classes="field">
                      <ComboBoxItem Content="Fixed Print Provider" />
                      <ComboBoxItem Content="Printify Choice Provider Network" />
                    </ComboBox>
                    <TextBlock IsVisible="{Binding !IsChoiceNetworkOffering}" Text="Print Provider name" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox IsVisible="{Binding !IsChoiceNetworkOffering}"
                             Text="{Binding OfferingProviderName}"
                             PlaceholderText="Print Provider name"
                             Classes="field" />
                    <TextBlock Text="Description" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox Text="{Binding OfferingDescription}" AcceptsReturn="True" MinHeight="44" Classes="field" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Save Blueprint Offering"
                              Command="{Binding SaveSelectedOfferingCommand}"
                              IsEnabled="{Binding CanSaveSelectedOffering}"
                              Classes="primary fixedAction" />
                      <Button Content="Cancel"
                              Command="{Binding CancelNewOfferingCommand}"
                              Classes="secondary fixedAction" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="panel" Padding="12" IsVisible="{Binding IsOfferingDetail}">
                <StackPanel Spacing="8">
                  <ToggleButton Content="Basics" IsChecked="{Binding IsBasicsSectionExpanded, Mode=TwoWay}" HorizontalContentAlignment="Left" />
                  <StackPanel IsVisible="{Binding IsBasicsSectionExpanded}" Spacing="8">
                    <TextBlock Text="Name" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox Text="{Binding CatalogSetup.OfferingName}" PlaceholderText="Offering name" Classes="field" />
                    <TextBlock Text="Fulfillment type" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding CatalogSetup.OfferingKindLabel}" />
                    <StackPanel IsVisible="{Binding !CatalogSetup.IsProviderNetworkOffering}" Spacing="4">
                      <TextBlock Text="Print Provider" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBlock Text="{Binding CatalogSetup.ProviderDisplayName}" />
                    </StackPanel>
                    <StackPanel IsVisible="{Binding CatalogSetup.IsProviderNetworkOffering}" Spacing="4">
                      <TextBlock Text="Provider Network code" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBox Text="{Binding CatalogSetup.ProviderNetworkCode}" Classes="field" />
                      <TextBlock Text="A Provider Network can route fulfillment through different Print Providers. Its stable code preserves identity if the display label changes."
                                 TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <TextBlock Text="Description" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox Text="{Binding CatalogSetup.OfferingDescription}" AcceptsReturn="True" MinHeight="44" Classes="field" />
                    <Button Content="Save Blueprint Offering" Command="{Binding CatalogSetup.SaveOfferingCommand}" Classes="primary fixedAction" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <StackPanel IsVisible="{Binding IsOfferingDetail}" Spacing="10">
                <TextBlock Text="Setup" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" />
                <TextBlock Text="Configure each part of this Offering in a focused screen. Provider means the fulfillment partner that produces the item; Printify is the catalog and integration source."
                           TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                <Border IsVisible="{Binding IsChoiceNetworkOffering}"
                        Background="{DynamicResource WarningBackgroundBrush}"
                        BorderBrush="{DynamicResource WarningBorderBrush}"
                        BorderThickness="1" Padding="10">
                  <TextBlock Text="Printify Choice is a Provider Network, not a single Print Provider. The actual fulfillment partner may vary by order or catalog availability."
                             TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" />
                </Border>
                <TextBlock IsVisible="{Binding SelectedStore.IsArchived}"
                           Text="This Store is archived. Catalog setup is available for review but cannot be changed."
                           TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                <Button Command="{Binding OpenVariantManagementCommand}" Classes="listItem" HorizontalContentAlignment="Left">
                  <StackPanel Spacing="3">
                    <TextBlock Text="Manage Variants" FontWeight="SemiBold" />
                    <TextBlock Text="Define possible Color and Size values, then create explicit sellable combinations."
                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                  </StackPanel>
                </Button>
                <Button Command="{Binding OpenDesignAreaManagementCommand}" Classes="listItem" HorizontalContentAlignment="Left">
                  <StackPanel Spacing="3">
                    <TextBlock Text="Manage Design Areas" FontWeight="SemiBold" />
                    <TextBlock Text="Describe printable regions and which Variants each region supports."
                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                  </StackPanel>
                </Button>
                <Button Command="{Binding OpenMockupTemplateManagementCommand}" Classes="listItem" HorizontalContentAlignment="Left">
                  <StackPanel Spacing="3">
                    <TextBlock Text="Manage Mockup Templates" FontWeight="SemiBold" />
                    <TextBlock Text="Link provider mockup images to Design Areas and applicable Colors."
                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                  </StackPanel>
                </Button>
              </StackPanel>

              <Border Classes="panel" Padding="12" IsVisible="{Binding IsVariantManagement}">
                <StackPanel Spacing="8">
                  <ToggleButton Content="Options &amp; Values" IsChecked="True" HorizontalContentAlignment="Left" />
                  <TextBlock Text="Options define stable meanings such as Color and Size. Add Values inside an Option before creating concrete Variants."
                             TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBlock IsVisible="{Binding !CatalogSetup.HasAvailableOptions}" Text="No Options configured." Foreground="{DynamicResource SecondaryTextBrush}" />
                  <ItemsControl ItemsSource="{Binding CatalogSetup.AvailableOptions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="catalog:OfferingOption">
                        <Border Classes="listItem" Padding="8">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding OptionKind}" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <Button Content="Archive Option" Command="{Binding $parent[ItemsControl].DataContext.CatalogSetup.ArchiveOptionCommand}" CommandParameter="{Binding}" Classes="danger" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Content="Add Option" Command="{Binding CatalogSetup.StartAddOptionCommand}" Classes="secondary" />
                  <StackPanel IsVisible="{Binding CatalogSetup.IsAddingOption}" Spacing="6">
                    <ComboBox ItemsSource="{Binding CatalogSetup.OptionKinds}" SelectedItem="{Binding CatalogSetup.SelectedOptionKind}" />
                    <TextBox Text="{Binding CatalogSetup.OptionName}" PlaceholderText="Option name" Classes="field" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Save Option" Command="{Binding CatalogSetup.CreateOptionCommand}" Classes="primary fixedAction" />
                      <Button Content="Cancel" Command="{Binding CatalogSetup.CancelAddOptionCommand}" Classes="secondary fixedAction" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel IsVisible="{Binding CatalogSetup.HasAvailableOptions}" Spacing="6">
                    <TextBlock Text="Selected Option" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ComboBox ItemsSource="{Binding CatalogSetup.AvailableOptions}" SelectedItem="{Binding CatalogSetup.SelectedOption}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Select Option" />
                    <TextBlock IsVisible="{Binding !CatalogSetup.HasAvailableValues}" Text="No Values configured for this Option." Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ItemsControl ItemsSource="{Binding CatalogSetup.AvailableValues}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="catalog:OfferingOptionValue">
                          <Border Classes="listItem" Padding="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding Value}" />
                              <Button Content="Archive Option Value" Command="{Binding $parent[ItemsControl].DataContext.CatalogSetup.ArchiveOptionValueCommand}" CommandParameter="{Binding}" Classes="danger" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Add Option Value" Command="{Binding CatalogSetup.StartAddOptionValueCommand}" Classes="secondary" />
                    <StackPanel IsVisible="{Binding CatalogSetup.IsAddingOptionValue}" Spacing="6">
                      <TextBox Text="{Binding CatalogSetup.OptionValue}" PlaceholderText="Option Value" Classes="field" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save Option Value" Command="{Binding CatalogSetup.CreateOptionValueCommand}" Classes="primary fixedAction" />
                        <Button Content="Cancel" Command="{Binding CatalogSetup.CancelAddOptionValueCommand}" Classes="secondary fixedAction" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="panel" Padding="12" IsVisible="{Binding IsVariantManagement}">
                <StackPanel Spacing="8">
                  <ToggleButton Content="Variants"
                                IsChecked="{Binding IsVariantsSectionExpanded, Mode=TwoWay}"
                                HorizontalContentAlignment="Left" />
                  <StackPanel IsVisible="{Binding IsVariantsSectionExpanded}" Spacing="8">
                    <TextBlock Text="A Variant is one concrete combination of Option Values, such as Black and Medium."
                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock IsVisible="{Binding !CatalogSetup.HasAvailableOptions}" Text="Add Options and Values before creating Variants." Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock IsVisible="{Binding !CatalogSetup.HasAvailableVariants}" Text="No concrete Variants configured." Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ItemsControl ItemsSource="{Binding CatalogSetup.AvailableVariants}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="catalog:OfferingVariant">
                          <Border Classes="listItem" Padding="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding Name}" />
                              <Button Content="Archive Variant" Command="{Binding $parent[ItemsControl].DataContext.CatalogSetup.ArchiveVariantCommand}" CommandParameter="{Binding}" Classes="danger" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Add Variant" Command="{Binding CatalogSetup.StartAddVariantCommand}" Classes="secondary" />
                    <StackPanel IsVisible="{Binding CatalogSetup.IsAddingVariant}" Spacing="6">
                      <TextBox Text="{Binding CatalogSetup.VariantName}" PlaceholderText="Variant name (optional)" Classes="field" />
                      <TextBlock Text="Option Values" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                      <ItemsControl ItemsSource="{Binding CatalogSetup.VariantValueChoices}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="stores:OptionValueChoiceViewModel">
                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save Variant" Command="{Binding CatalogSetup.CreateVariantCommand}" Classes="primary fixedAction" />
                        <Button Content="Cancel" Command="{Binding CatalogSetup.CancelAddVariantCommand}" Classes="secondary fixedAction" />
                      </StackPanel>
                    </StackPanel>
                    <Border Classes="panel" Padding="10">
                      <StackPanel Spacing="8">
                        <TextBlock Text="Add all valid sizes for a Color" FontWeight="SemiBold" />
                        <TextBlock Text="Select an enabled Color and the Sizes you want to sell. Fusion Canvas previews only combinations confirmed by the provider catalog before creating anything."
                                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <ComboBox ItemsSource="{Binding CatalogSetup.AvailableColors}"
                                  SelectedItem="{Binding CatalogSetup.BulkColor}"
                                  DisplayMemberBinding="{Binding Value}"
                                  PlaceholderText="Select Color" />
                        <ItemsControl ItemsSource="{Binding CatalogSetup.BulkSizeChoices}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="stores:BulkSizeChoiceViewModel">
                              <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Content="Preview valid Variants" Command="{Binding CatalogSetup.PreviewBulkVariantsCommand}" Classes="secondary" />
                          <Button Content="Cancel" Command="{Binding CatalogSetup.CancelBulkVariantsCommand}" Classes="secondary fixedAction" />
                        </StackPanel>
                        <TextBlock Text="{Binding CatalogSetup.BulkResultMessage}"
                                   IsVisible="{Binding CatalogSetup.HasBulkResultMessage}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <ItemsControl ItemsSource="{Binding CatalogSetup.BulkPreviewCandidates}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="catalogApplication:BulkVariantCandidate">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding SizeName}" />
                                <TextBlock Text="{Binding ExclusionReason}" Foreground="{DynamicResource SecondaryTextBrush}" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Create previewed Variants"
                                IsVisible="{Binding CatalogSetup.HasBulkPreview}"
                                Command="{Binding CatalogSetup.ConfirmBulkVariantsCommand}"
                                Classes="primary" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="panel" Padding="12" IsVisible="{Binding IsDesignAreaManagement}">
                <StackPanel Spacing="8">
                  <ToggleButton Content="Design Areas"
                                IsChecked="{Binding IsDesignAreasSectionExpanded, Mode=TwoWay}"
                                HorizontalContentAlignment="Left" />
                  <StackPanel IsVisible="{Binding IsDesignAreasSectionExpanded}" Spacing="8">
                    <TextBlock Text="A Design Area is an actual printable region on this Offering, such as Front or Back."
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <Button Content="Add Design Area"
                            Command="{Binding CatalogSetup.StartAddPlaceholderCommand}"
                            Classes="secondary" />
                    <StackPanel IsVisible="{Binding CatalogSetup.IsAddingPlaceholder}" Spacing="6">
                      <TextBlock Text="Name" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBox Text="{Binding CatalogSetup.PlaceholderName}" PlaceholderText="Front" Classes="field" />
                      <TextBlock Text="Position" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBox Text="{Binding CatalogSetup.PlaceholderPosition}" PlaceholderText="front" Classes="field" />
                      <TextBlock Text="Decoration method" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBox Text="{Binding CatalogSetup.PlaceholderDecorationMethod}" PlaceholderText="DTG" Classes="field" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <StackPanel Width="120" Spacing="4">
                          <TextBlock Text="Width (px)" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                          <TextBox Text="{Binding CatalogSetup.PlaceholderWidth}" Classes="field" />
                        </StackPanel>
                        <StackPanel Width="120" Spacing="4">
                          <TextBlock Text="Height (px)" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                          <TextBox Text="{Binding CatalogSetup.PlaceholderHeight}" Classes="field" />
                        </StackPanel>
                      </StackPanel>
                      <TextBlock Text="Description (optional)" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBox Text="{Binding CatalogSetup.PlaceholderDescription}" AcceptsReturn="True" MinHeight="44" Classes="field" />
                      <CheckBox Content="Compatible with all current Variants"
                                IsChecked="{Binding CatalogSetup.PlaceholderUsesAllVariants, Mode=TwoWay}" />
                      <StackPanel IsVisible="{Binding !CatalogSetup.PlaceholderUsesAllVariants}" Spacing="4">
                        <TextBlock Text="Compatible Variants"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <ItemsControl ItemsSource="{Binding CatalogSetup.PlaceholderVariantChoices}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="stores:VariantChoiceViewModel">
                              <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <TextBlock Text="Recommended artwork" FontWeight="SemiBold" Margin="0,6,0,0" />
                      <TextBlock Text="Maximum printable dimensions are shown in pixels first. Inches and millimetres are derived only when reliable DPI metadata is available."
                                 TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Width="130" Text="{Binding CatalogSetup.ArtworkWidth}" PlaceholderText="Width (px)" Classes="field" />
                        <TextBox Width="130" Text="{Binding CatalogSetup.ArtworkHeight}" PlaceholderText="Height (px)" Classes="field" />
                        <TextBox Width="100" Text="{Binding CatalogSetup.ArtworkDpi}" PlaceholderText="DPI" Classes="field" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Width="130" Text="{Binding CatalogSetup.ArtworkFormat}" PlaceholderText="Format (PNG)" Classes="field" />
                        <TextBox Width="210" Text="{Binding CatalogSetup.ArtworkBackground}" PlaceholderText="Background (transparent)" Classes="field" />
                      </StackPanel>
                      <TextBlock Text="{Binding CatalogSetup.PhysicalSizeSummary}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                      <Expander Header="Advanced provider data">
                        <TextBox Text="{Binding CatalogSetup.PlaceholderProviderReference}"
                                 PlaceholderText="Provider Design Area reference"
                                 Classes="field"
                                 ToolTip.Tip="Normally populated from the Printify catalog integration." />
                      </Expander>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save Design Area" Command="{Binding CatalogSetup.CreatePlaceholderCommand}" Classes="primary fixedAction" />
                        <Button Content="Cancel" Command="{Binding CatalogSetup.CancelAddPlaceholderCommand}" Classes="secondary fixedAction" />
                      </StackPanel>
                    </StackPanel>
                  <TextBlock IsVisible="{Binding !CatalogSetup.HasAvailablePlaceholders}" Text="No Design Areas configured." Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ItemsControl ItemsSource="{Binding CatalogSetup.AvailablePlaceholders}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="catalog:OfferingPlaceholder">
                          <Border Classes="listItem" Padding="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <Button Content="Edit"
                                      Command="{Binding $parent[ItemsControl].DataContext.CatalogSetup.EditPlaceholderCommand}"
                                      CommandParameter="{Binding}"
                                      Classes="secondary" />
                              <TextBlock Text="{Binding Name}" />
                              <TextBlock Text="·" Foreground="{DynamicResource SecondaryTextBrush}" />
                              <TextBlock Text="{Binding Position}" />
                              <TextBlock Text="{Binding Width, StringFormat='{}{0}px'}" Foreground="{DynamicResource SecondaryTextBrush}" />
                              <TextBlock Text="×" Foreground="{DynamicResource SecondaryTextBrush}" />
                              <TextBlock Text="{Binding Height, StringFormat='{}{0}px'}" Foreground="{DynamicResource SecondaryTextBrush}" />
                              <Button Content="Archive Design Area"
                                      Command="{Binding $parent[ItemsControl].DataContext.CatalogSetup.ArchivePlaceholderCommand}"
                                      CommandParameter="{Binding}"
                                      Classes="danger" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="panel"
                      Padding="12"
                      IsVisible="{Binding IsMockupTemplateManagement}">
                <StackPanel Spacing="8">
                  <ToggleButton Content="Mockup Templates"
                                IsChecked="True"
                                HorizontalContentAlignment="Left" />
                  <TextBlock Text="Each template links one provider mockup image to one Design Area and one or more Colors. Compatible concrete Variants are derived from those Colors."
                             TextWrapping="Wrap"
                             FontSize="12"
                             Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBlock Text="{Binding CatalogSetup.ProviderCatalogMessage}"
                             IsVisible="{Binding CatalogSetup.HasProviderCatalogMessage}"
                             TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBlock IsVisible="{Binding !CatalogSetup.HasAvailableTemplates}" Text="No Mockup Templates configured." Foreground="{DynamicResource SecondaryTextBrush}" />
                  <ItemsControl ItemsSource="{Binding CatalogSetup.AvailableTemplates}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="mockups:MockupTemplate">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Command="{Binding $parent[ItemsControl].DataContext.CatalogSetup.EditTemplateCommand}"
                                  CommandParameter="{Binding}" Classes="listItem" HorizontalContentAlignment="Left">
                            <StackPanel Spacing="3">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding CurrentRevision, StringFormat='Revision {0}'}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                          </Button>
                          <Button Content="Archive"
                                  Command="{Binding $parent[ItemsControl].DataContext.CatalogSetup.ArchiveTemplateCommand}"
                                  CommandParameter="{Binding}" Classes="danger" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border IsVisible="{Binding !CatalogSetup.HasAvailablePlaceholders}"
                          Background="{DynamicResource WarningBackgroundBrush}"
                          BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" Padding="10">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Create a Design Area before configuring Mockup Templates." TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" />
                      <Button Content="Manage Design Areas" Command="{Binding OpenDesignAreaManagementCommand}" Classes="secondary" />
                    </StackPanel>
                  </Border>
                  <Button Content="Add Mockup Template" Command="{Binding CatalogSetup.StartAddTemplateCommand}" Classes="secondary" />
                  <StackPanel IsVisible="{Binding CatalogSetup.IsAddingTemplate}" Spacing="6">
                    <TextBox Text="{Binding CatalogSetup.TemplateName}" PlaceholderText="Mockup Template name" Classes="field" />
                    <ComboBox ItemsSource="{Binding CatalogSetup.ProviderMockupCandidates}"
                              SelectedItem="{Binding CatalogSetup.SelectedProviderMockup}"
                              DisplayMemberBinding="{Binding DisplayName}"
                              PlaceholderText="Provider mockup image" />
                    <ComboBox ItemsSource="{Binding CatalogSetup.AvailablePlaceholders}"
                              SelectedItem="{Binding CatalogSetup.SelectedPlaceholder}"
                              DisplayMemberBinding="{Binding Name}"
                              PlaceholderText="Linked Design Area" />
                    <TextBlock Text="Applicable Colors" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ItemsControl ItemsSource="{Binding CatalogSetup.TemplateColorChoices}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="stores:OptionValueChoiceViewModel">
                          <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Design Area placement in provider image" FontWeight="SemiBold" />
                    <TextBlock Text="Drag the rectangle to move it, drag its lower-right handle to resize, or use arrow keys. Hold Shift with arrow keys to resize. Numeric values are source-image pixels."
                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <stores:MockupPlacementEditor Height="280"
                                                   IsEnabled="{Binding CatalogSetup.CanEdit}"
                                                   PlacementX="{Binding CatalogSetup.MappingX, Mode=TwoWay}"
                                                   PlacementY="{Binding CatalogSetup.MappingY, Mode=TwoWay}"
                                                   PlacementWidth="{Binding CatalogSetup.MappingWidth, Mode=TwoWay}"
                                                   PlacementHeight="{Binding CatalogSetup.MappingHeight, Mode=TwoWay}"
                                                   ImageWidth="{Binding CatalogSetup.MappingImageWidth}"
                                                   ImageHeight="{Binding CatalogSetup.MappingImageHeight}" />
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                      <TextBox Grid.Column="0" Text="{Binding CatalogSetup.MappingX}" PlaceholderText="X (px)" Classes="field" />
                      <TextBox Grid.Column="1" Text="{Binding CatalogSetup.MappingY}" PlaceholderText="Y (px)" Classes="field" />
                      <TextBox Grid.Column="2" Text="{Binding CatalogSetup.MappingWidth}" PlaceholderText="Width (px)" Classes="field" />
                      <TextBox Grid.Column="3" Text="{Binding CatalogSetup.MappingHeight}" PlaceholderText="Height (px)" Classes="field" />
                    </Grid>
                    <Expander Header="Advanced provider data">
                      <TextBlock Text="{Binding CatalogSetup.SelectedProviderMockup.ProviderReference}"
                                 ToolTip.Tip="Stable provider mockup reference from the Printify catalog." />
                    </Expander>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Save Mockup Template"
                              Command="{Binding CatalogSetup.CreateTemplateCommand}"
                              Classes="primary fixedAction" />
                      <Button Content="Cancel"
                              Command="{Binding CatalogSetup.CancelAddTemplateCommand}"
                              Classes="secondary fixedAction" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="panel" Padding="12" IsVisible="{Binding IsOfferingDetail}">
                <StackPanel Spacing="8">
                  <ToggleButton Content="Advanced"
                                IsChecked="{Binding IsAdvancedSectionExpanded, Mode=TwoWay}"
                                HorizontalContentAlignment="Left" />
                  <StackPanel IsVisible="{Binding IsAdvancedSectionExpanded}" Spacing="8">
                    <TextBlock Text="Provider-network identity and external identifiers are preserved by the catalog model. Shopify publication and credentials are future integration work."
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="External offering ID" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox Text="{Binding CatalogSetup.ExternalOfferingId}" Classes="field" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>

          <Border IsVisible="{Binding ProductDeleteWarningVisible}"
                  Background="{DynamicResource DangerBackgroundBrush}"
                  BorderBrush="{DynamicResource DangerBorderBrush}"
                  BorderThickness="1"
                  Padding="12"
                  Margin="0,8,0,0">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding ProductDeleteWarningMessage}"
                         FontSize="13"
                         Foreground="{DynamicResource DangerTextBrush}" />
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <Button Content="Delete permanently"
                        Command="{Binding ConfirmDeleteProductCommand}"
                        Classes="danger fixedDanger" />
                <Button Content="Cancel"
                        Command="{Binding CancelDeleteProductCommand}"
                        Classes="secondary fixedAction" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border IsVisible="{Binding OfferingDeleteWarningVisible}"
                  Background="{DynamicResource DangerBackgroundBrush}"
                  BorderBrush="{DynamicResource DangerBorderBrush}"
                  BorderThickness="1"
                  Padding="12"
                  Margin="0,8,0,0">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding OfferingDeleteWarningMessage}"
                         FontSize="13"
                         Foreground="{DynamicResource DangerTextBrush}" />
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <Button Content="Delete permanently"
                        Command="{Binding ConfirmDeleteOfferingCommand}"
                        Classes="danger fixedDanger" />
                <Button Content="Cancel"
                        Command="{Binding CancelDeleteOfferingCommand}"
                        Classes="secondary fixedAction" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border IsVisible="{Binding DeleteWarningVisible}"
                  Background="{DynamicResource DangerBackgroundBrush}"
                  BorderBrush="{DynamicResource DangerBorderBrush}"
                  BorderThickness="1"
                  Padding="12"
                  Margin="0,8,0,0">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding DeleteWarningMessage}"
                         FontSize="13"
                         Foreground="{DynamicResource DangerTextBrush}" />
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <Button Content="Delete permanently"
                        Command="{Binding ConfirmDeleteStoreCommand}"
                        Classes="danger fixedDanger" />
                <Button Content="Cancel"
                        Command="{Binding CancelDeleteStoreCommand}"
                        Classes="secondary fixedAction" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border IsVisible="{Binding NicheDeleteWarningVisible}"
                  Background="{DynamicResource DangerBackgroundBrush}"
                  BorderBrush="{DynamicResource DangerBorderBrush}"
                  BorderThickness="1"
                  Padding="12"
                  Margin="0,8,0,0">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding NicheDeleteWarningMessage}"
                         FontSize="13"
                         Foreground="{DynamicResource DangerTextBrush}" />
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <Button Content="Delete permanently"
                        Command="{Binding ConfirmDeleteNicheCommand}"
                        Classes="danger fixedDanger" />
                <Button Content="Cancel"
                        Command="{Binding CancelDeleteNicheCommand}"
                        Classes="secondary fixedAction" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border IsVisible="{Binding DiscardChangesPromptVisible}"
                  Background="{DynamicResource WarningBackgroundBrush}"
                  BorderBrush="{DynamicResource WarningBorderBrush}"
                  BorderThickness="1"
                  Padding="12"
                  Margin="0,8,0,0">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding DiscardChangesMessage}"
                         FontSize="13"
                         Foreground="{DynamicResource StrongTextBrush}" />
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <Button Content="Discard changes"
                        Command="{Binding ConfirmDiscardChangesCommand}"
                        Classes="danger fixedDanger" />
                <Button Content="Keep editing"
                        Command="{Binding KeepEditingCommand}"
                        Classes="secondary fixedDanger" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
  <Window.Styles>
    <Style Selector="Button.primary">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource CommandBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CommandForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CommandBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource DangerStrongBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CommandForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.fixedAction">
      <Setter Property="Width" Value="104" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.fixedDanger">
      <Setter Property="Width" Value="156" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.restoreAction">
      <Setter Property="Width" Value="220" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.listItem">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource PanelSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.tabButton">
      <Setter Property="MinWidth" Value="116" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.tabButton.selected">
      <Setter Property="Background" Value="{DynamicResource CommandBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CommandForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CommandBorderBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBox.field">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Window.Styles>
</Window>
