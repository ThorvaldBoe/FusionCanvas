<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:stores="clr-namespace:FusionCanvas.App.Stores"
        xmlns:appStores="clr-namespace:FusionCanvas.Application.Stores;assembly=FusionCanvas.Application"
        xmlns:appNiches="clr-namespace:FusionCanvas.Application.Niches;assembly=FusionCanvas.Application"
        xmlns:appTags="clr-namespace:FusionCanvas.Application.Tags;assembly=FusionCanvas.Application"
        xmlns:appProducts="clr-namespace:FusionCanvas.Application.Products;assembly=FusionCanvas.Application"
        x:Class="FusionCanvas.App.Stores.StoreEditorWindow"
        x:DataType="stores:StoreManagementViewModel"
        Title="Store Editor"
        Width="860"
        Height="620"
        MinWidth="720"
        MinHeight="520"
        Background="{DynamicResource ApplicationBackgroundBrush}">
  <Grid ColumnDefinitions="260,*"
        RowDefinitions="*">
    <Border Grid.Column="0"
            Background="{DynamicResource ElevatedSurfaceBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="0,0,1,0"
            Padding="16">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top"
                    Spacing="8"
                    Margin="0,0,0,16">
          <TextBlock Text="Stores"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}" />
          <Button Content="New store"
                  AutomationProperties.AutomationId="StoreEditor.NewStore"
                  Command="{Binding StartCreateStoreCommand}"
                  Classes="primary" />
        </StackPanel>

        <StackPanel Spacing="12">
          <TextBlock Text="Active"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource SecondaryTextBrush}" />
          <ItemsControl ItemsSource="{Binding EditorActiveStores}"
                        AutomationProperties.AutomationId="StoreEditor.ActiveStores">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="appStores:StoreSummary">
                <Button Content="{Binding Name}"
                        Command="{Binding $parent[ItemsControl].DataContext.EditStoreCommand}"
                        CommandParameter="{Binding}"
                        Classes="listItem"
                        HorizontalContentAlignment="Left" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock IsVisible="{Binding HasArchivedStores}"
                     Text="Archived"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     Margin="0,8,0,0" />
          <ItemsControl IsVisible="{Binding HasArchivedStores}"
                        ItemsSource="{Binding ArchivedStores}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="appStores:StoreSummary">
                <Button Content="{Binding Name}"
                        Command="{Binding $parent[ItemsControl].DataContext.EditStoreCommand}"
                        CommandParameter="{Binding}"
                        Classes="listItem"
                        HorizontalContentAlignment="Left" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Column="1"
            Margin="18"
            Padding="20"
            Background="{DynamicResource ElevatedSurfaceBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1">
      <ScrollViewer>
        <StackPanel Spacing="12">
          <TextBlock Text="Store Management"
                     FontSize="22"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}" />
          <TextBlock Text="{Binding ErrorMessage}"
                     IsVisible="{Binding HasError}"
                     FontSize="12"
                     Foreground="{DynamicResource DangerTextBrush}" />
          <StackPanel Orientation="Horizontal"
                      Spacing="8">
            <Button Content="Basic info"
                    Command="{Binding SelectBasicInfoTabCommand}"
                    Classes="tabButton"
                    Classes.selected="{Binding IsBasicInfoTabSelected}" />
            <Button Content="Niches"
                    Command="{Binding SelectNichesTabCommand}"
                    Classes="tabButton"
                    Classes.selected="{Binding IsNichesTabSelected}" />
            <Button Content="Tags"
                    Command="{Binding SelectTagsTabCommand}"
                    Classes="tabButton"
                    Classes.selected="{Binding IsTagsTabSelected}" />
            <Button Content="Catalog &amp; mockups"
                    Command="{Binding SelectProductsTabCommand}"
                    Classes="tabButton"
                    Classes.selected="{Binding IsProductsTabSelected}" />
          </StackPanel>

          <StackPanel IsVisible="{Binding IsBasicInfoTabSelected}"
                      Spacing="12">
            <TextBlock Text="Basic info"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource StrongTextBrush}" />
            <TextBox x:Name="StoreNameTextBox"
                     AutomationProperties.AutomationId="StoreEditor.Name"
                     Text="{Binding NewStoreName}"
                     PlaceholderText="Store name"
                     Classes="field" />
            <TextBox Text="{Binding Description}"
                     PlaceholderText="Description"
                     Margin="0,0,16,0"
                     Classes="field" />
            <StackPanel Spacing="4">
              <TextBlock Text="Fulfillment strategy"
                         FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding AvailableFulfillmentStrategies}"
                        SelectedItem="{Binding SelectedFulfillmentStrategy}"
                        IsEnabled="{Binding CanEditStoreConfiguration}"
                        AutomationProperties.AutomationId="StoreEditor.FulfillmentStrategy" />
              <TextBlock Text="Shopify manual — future strategy"
                         Foreground="{DynamicResource DisabledTextBrush}" />
              <TextBlock Text="Shopify + Printify — future strategy"
                         Foreground="{DynamicResource DisabledTextBrush}" />
              <TextBlock Text="Manual means Fusion Canvas records catalog data locally and does not communicate with Shopify or Printify. Future strategies will add their own configuration."
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
            <TextBox Text="{Binding Notes}"
                     PlaceholderText="Notes"
                     Margin="0,0,16,0"
                     AcceptsReturn="True"
                     MinHeight="84"
                     Classes="field" />
            <TextBox Text="{Binding TargetMarket}"
                     PlaceholderText="Target market"
                     Classes="field" />
            <TextBox Text="{Binding BrandDirection}"
                     PlaceholderText="Brand direction"
                     Classes="field" />
            <TextBox Text="{Binding PlanningContext}"
                     PlaceholderText="Planning context"
                     Classes="field" />
            <TextBox Text="{Binding Url}"
                     PlaceholderText="Store URL"
                     Classes="field" />

            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,8,0,0">
              <Button Content="Save"
                      AutomationProperties.AutomationId="StoreEditor.SaveStore"
                      Command="{Binding SaveSelectedStoreCommand}"
                      IsEnabled="{Binding CanSaveSelectedStore}"
                      Classes="primary fixedAction" />
              <Button Content="Archive"
                      Command="{Binding ArchiveSelectedStoreCommand}"
                      IsEnabled="{Binding CanArchiveSelectedStore}"
                      Classes="secondary fixedAction" />
              <Button Content="Delete"
                      Command="{Binding RequestDeleteSelectedStoreCommand}"
                      IsEnabled="{Binding CanDeleteSelectedStore}"
                      Classes="danger fixedAction" />
            </StackPanel>

            <Button Content="Restore selected archived store"
                    IsVisible="{Binding CanRestoreSelectedStore}"
                    Command="{Binding RestoreStoreCommand}"
                    CommandParameter="{Binding SelectedStore}"
                    Classes="secondary restoreAction" />
          </StackPanel>

          <Grid IsVisible="{Binding IsNichesTabSelected}"
                ColumnDefinitions="220,*"
                ColumnSpacing="16">
            <StackPanel Grid.Column="0"
                        Spacing="10">
              <Button Content="New niche"
                      Command="{Binding StartCreateNicheCommand}"
                      Classes="primary" />
              <TextBlock Text="Active niches"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <TextBlock Text="No active niches"
                         IsVisible="{Binding !HasActiveNiches}"
                         FontSize="12"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <ItemsControl ItemsSource="{Binding EditorActiveNiches}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="appNiches:NicheSummary">
                    <Button Content="{Binding Name}"
                            Command="{Binding $parent[ItemsControl].DataContext.EditNicheCommand}"
                            CommandParameter="{Binding}"
                            Classes="listItem"
                            HorizontalContentAlignment="Left" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock IsVisible="{Binding HasArchivedNiches}"
                         Text="Archived niches"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         Margin="0,8,0,0" />
              <ItemsControl IsVisible="{Binding HasArchivedNiches}"
                            ItemsSource="{Binding ArchivedNiches}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="appNiches:NicheSummary">
                    <Button Content="{Binding Name}"
                            Command="{Binding $parent[ItemsControl].DataContext.EditNicheCommand}"
                            CommandParameter="{Binding}"
                            Classes="listItem"
                            HorizontalContentAlignment="Left" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Spacing="10"
                        Margin="0,0,16,0">
              <TextBlock Text="Niche details"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource StrongTextBrush}" />
              <TextBox Text="{Binding NicheName}"
                       PlaceholderText="Niche name"
                       Margin="0,0,16,0"
                       Classes="field" />
              <TextBox Text="{Binding NicheDescription}"
                       PlaceholderText="Description"
                       Margin="0,0,16,0"
                       Classes="field" />
              <TextBox Text="{Binding NicheAudience}"
                       PlaceholderText="Audience"
                       Margin="0,0,16,0"
                       Classes="field" />
              <TextBox Text="{Binding NicheHumorStyle}"
                       PlaceholderText="Humor style"
                       Margin="0,0,16,0"
                       Classes="field" />
              <TextBox Text="{Binding NicheVisualStyleGuidance}"
                       PlaceholderText="Visual style guidance"
                       Margin="0,0,16,0"
                       Classes="field" />
              <TextBox Text="{Binding NicheConstraints}"
                       PlaceholderText="Constraints"
                       Margin="0,0,16,0"
                       Classes="field" />
              <TextBox Text="{Binding NicheRisks}"
                       PlaceholderText="Risks"
                       Margin="0,0,16,0"
                       Classes="field" />
              <TextBox Text="{Binding NicheResearchNotes}"
                       PlaceholderText="Research notes"
                       Margin="0,0,16,0"
                       AcceptsReturn="True"
                       MinHeight="70"
                       Classes="field" />
              <TextBox Text="{Binding NicheNotes}"
                       PlaceholderText="Notes"
                       Margin="0,0,16,0"
                       AcceptsReturn="True"
                       MinHeight="70"
                       Classes="field" />

              <StackPanel Orientation="Horizontal"
                          Spacing="8"
                          Margin="0,8,0,0">
                <Button Content="Save"
                        Command="{Binding SaveSelectedNicheCommand}"
                        IsEnabled="{Binding CanSaveSelectedNiche}"
                        Classes="primary fixedAction" />
                <Button Content="Archive"
                        Command="{Binding ArchiveSelectedNicheCommand}"
                        IsEnabled="{Binding CanArchiveSelectedNiche}"
                        Classes="secondary fixedAction" />
                <Button Content="Delete"
                        Command="{Binding RequestDeleteSelectedNicheCommand}"
                        IsEnabled="{Binding CanDeleteSelectedNiche}"
                        Classes="danger fixedAction" />
              </StackPanel>

              <Button Content="Restore selected archived niche"
                      IsVisible="{Binding CanRestoreSelectedNiche}"
                      Command="{Binding RestoreNicheCommand}"
                      CommandParameter="{Binding SelectedNiche}"
                      Classes="secondary restoreAction" />
            </StackPanel>
          </Grid>

          <Grid IsVisible="{Binding IsTagsTabSelected}"
                ColumnDefinitions="220,*"
                ColumnSpacing="16">
            <StackPanel Grid.Column="0"
                        Spacing="10">
              <Button Content="New tag"
                      Command="{Binding StartCreateTagCommand}"
                      Classes="primary" />
              <TextBlock Text="Active tags"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <TextBlock Text="No active tags"
                         IsVisible="{Binding !HasActiveTags}"
                         FontSize="12"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <ItemsControl ItemsSource="{Binding EditorActiveTags}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="appTags:TagSummary">
                    <Button Content="{Binding Name}"
                            Command="{Binding $parent[ItemsControl].DataContext.EditTagCommand}"
                            CommandParameter="{Binding}"
                            Classes="listItem"
                            HorizontalContentAlignment="Left" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock IsVisible="{Binding HasArchivedTags}"
                         Text="Archived tags"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         Margin="0,8,0,0" />
              <ItemsControl IsVisible="{Binding HasArchivedTags}"
                            ItemsSource="{Binding ArchivedTags}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="appTags:TagSummary">
                    <Button Content="{Binding Name}"
                            Command="{Binding $parent[ItemsControl].DataContext.EditTagCommand}"
                            CommandParameter="{Binding}"
                            Classes="listItem"
                            HorizontalContentAlignment="Left" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Spacing="10"
                        Margin="0,0,16,0">
              <TextBlock Text="Tag details"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource StrongTextBrush}" />
              <TextBox Text="{Binding TagName}"
                       PlaceholderText="Tag name"
                       Classes="field" />
              <StackPanel Spacing="4">
                <TextBlock Text="Color"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBox Text="{Binding TagColor}"
                         PlaceholderText="#RRGGBB (optional)"
                         Classes="field" />
              </StackPanel>
              <TextBox Text="{Binding TagDescription}"
                       PlaceholderText="Description"
                       Margin="0,0,64,0"
                       Classes="field" />

              <StackPanel Orientation="Horizontal"
                          Spacing="8"
                          Margin="0,8,0,0">
                <Button Content="Save"
                        Command="{Binding SaveSelectedTagCommand}"
                        IsEnabled="{Binding CanSaveSelectedTag}"
                        Classes="primary fixedAction" />
                <Button Content="Archive"
                        Command="{Binding ArchiveSelectedTagCommand}"
                        IsEnabled="{Binding CanArchiveSelectedTag}"
                        Classes="secondary fixedAction" />
                <Button Content="Delete"
                        Command="{Binding RequestDeleteSelectedTagCommand}"
                        IsEnabled="{Binding CanDeleteSelectedTag}"
                        Classes="danger fixedAction" />
              </StackPanel>

              <Button Content="Restore selected archived tag"
                      IsVisible="{Binding CanRestoreSelectedTag}"
                      Command="{Binding RestoreTagCommand}"
                      CommandParameter="{Binding SelectedTag}"
                      Classes="secondary restoreAction" />
            </StackPanel>
          </Grid>

          <Border IsVisible="{Binding TagDeleteWarningVisible}"
                  Background="{DynamicResource DangerBackgroundBrush}"
                  BorderBrush="{DynamicResource DangerBorderBrush}"
                  BorderThickness="1"
                  Padding="12"
                  Margin="0,8,0,0">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding TagDeleteWarningMessage}"
                         FontSize="13"
                         Foreground="{DynamicResource DangerTextBrush}" />
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <Button Content="Delete permanently"
                        Command="{Binding ConfirmDeleteTagCommand}"
                        Classes="danger fixedDanger" />
                <Button Content="Cancel"
                        Command="{Binding CancelDeleteTagCommand}"
                        Classes="secondary fixedAction" />
              </StackPanel>
            </StackPanel>
          </Border>

          <StackPanel IsVisible="{Binding IsProductsTabSelected}"
                      Spacing="12">
            <StackPanel IsVisible="{Binding IsCatalogOverview}"
                        Spacing="12">
              <TextBlock Text="Catalog overview"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource StrongTextBrush}" />
              <TextBlock Text="Define Blueprints, fulfillment offerings, Variants, and Placeholders. Blueprint is Printify terminology for the base product; Placeholder is the named design target on an offering."
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <Button Content="New Blueprint"
                      Command="{Binding StartCreateProductCommand}"
                      IsEnabled="{Binding CanCreateCatalogItem}"
                      Classes="primary" />
              <TextBlock IsVisible="{Binding !HasProducts}"
                         Text="No Blueprints yet. Add a Blueprint to begin."
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <ItemsControl ItemsSource="{Binding EditorProducts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="appProducts:StoreProductSummary">
                    <Button Command="{Binding $parent[ItemsControl].DataContext.OpenProductDetailCommand}"
                            CommandParameter="{Binding}"
                            Classes="listItem"
                            HorizontalContentAlignment="Left">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Offerings.Count, StringFormat='{}{0} Blueprint Offering(s)'}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel IsVisible="{Binding IsProductDetail}"
                        Spacing="12">
              <Button Content="‹  Back to Blueprints"
                      Command="{Binding BackToProductsCommand}"
                      Classes="secondary" />
              <TextBlock Text="{Binding CatalogBreadcrumb}"
                         FontSize="12"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <TextBlock Text="{Binding ProductName}"
                         FontSize="20"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource StrongTextBrush}" />
              <TextBlock Text="{Binding SelectedProductSummary}"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <Border Classes="panel" Padding="12">
                <StackPanel Spacing="8">
                  <TextBlock Text="Blueprint details"
                             FontWeight="SemiBold"
                             ToolTip.Tip="Blueprint is Printify's term for the base product definition." />
                  <TextBlock Text="Name" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBox x:Name="ProductNameTextBox"
                           Text="{Binding ProductName}"
                           PlaceholderText="Blueprint name"
                           Classes="field" />
                  <TextBlock Text="Description" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBox Text="{Binding ProductDescription}"
                           AcceptsReturn="True"
                           MinHeight="56"
                           Classes="field" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Save Blueprint"
                            Command="{Binding SaveSelectedProductCommand}"
                            IsEnabled="{Binding CanSaveSelectedProduct}"
                            Classes="primary fixedAction" />
                    <Button Content="Delete Blueprint"
                            Command="{Binding RequestDeleteSelectedProductCommand}"
                            IsEnabled="{Binding CanDeleteSelectedProduct}"
                            Classes="danger fixedAction" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Classes="panel" Padding="12">
                <StackPanel Spacing="8">
                  <TextBlock Text="Blueprint Offerings"
                             FontWeight="SemiBold"
                             ToolTip.Tip="An Offering is a concrete fulfillment choice for a Blueprint." />
                  <TextBlock Text="An Offering is one way this Blueprint is supplied."
                             FontSize="12"
                             Foreground="{DynamicResource SecondaryTextBrush}" />
                  <Button Content="Add Blueprint Offering"
                          Command="{Binding StartCreateOfferingCommand}"
                          IsEnabled="{Binding CanCreateCatalogItem}"
                          Classes="primary" />
                  <TextBlock IsVisible="{Binding !HasSelectedProductOfferings}"
                             Text="No Blueprint Offerings yet."
                             Foreground="{DynamicResource SecondaryTextBrush}" />
                  <ItemsControl ItemsSource="{Binding SelectedProduct.Offerings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="appProducts:FulfillmentOfferingSummary">
                        <Button Command="{Binding $parent[ItemsControl].DataContext.OpenOfferingDetailCommand}"
                                CommandParameter="{Binding}"
                                Classes="listItem"
                                HorizontalContentAlignment="Left">
                          <StackPanel Spacing="3">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Kind}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel IsVisible="{Binding IsOfferingDetail}"
                        Spacing="12">
              <Button Content="‹  Back to Blueprint"
                      Command="{Binding BackToProductCommand}"
                      Classes="secondary" />
              <TextBlock Text="{Binding CatalogBreadcrumb}"
                         FontSize="12"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <TextBlock Text="{Binding OfferingName}"
                         FontSize="20"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource StrongTextBrush}" />
              <TextBlock Text="{Binding SelectedOfferingSummary}"
                         Foreground="{DynamicResource SecondaryTextBrush}" />

              <Border Classes="panel" Padding="12">
                <StackPanel Spacing="8">
                  <ToggleButton Content="Basics"
                                IsChecked="{Binding IsBasicsSectionExpanded, Mode=TwoWay}"
                                HorizontalContentAlignment="Left" />
                  <StackPanel IsVisible="{Binding IsBasicsSectionExpanded}" Spacing="8">
                    <TextBlock Text="Name" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox Text="{Binding OfferingName}" PlaceholderText="Offering name" Classes="field" />
                    <TextBlock Text="Fulfillment type" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ComboBox SelectedIndex="{Binding OfferingKindIndex}" Classes="field">
                      <ComboBoxItem Content="Fixed provider" />
                      <ComboBoxItem Content="Printify Choice network" />
                    </ComboBox>
                    <TextBlock IsVisible="{Binding !IsChoiceNetworkOffering}" Text="Provider name" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox IsVisible="{Binding !IsChoiceNetworkOffering}"
                             Text="{Binding OfferingProviderName}"
                             PlaceholderText="Provider name"
                             Classes="field" />
                    <TextBlock Text="Description" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox Text="{Binding OfferingDescription}" AcceptsReturn="True" MinHeight="44" Classes="field" />
                    <TextBlock IsVisible="{Binding IsChoiceNetworkOffering}"
                               Text="Printify Choice is a variable fulfillment network; exact panel dimensions and placement can vary by fulfillment provider."
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource WarningTextBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Save offering"
                              Command="{Binding SaveSelectedOfferingCommand}"
                              IsEnabled="{Binding CanSaveSelectedOffering}"
                              Classes="primary fixedAction" />
                      <Button Content="Delete offering"
                              Command="{Binding RequestDeleteSelectedOfferingCommand}"
                              IsEnabled="{Binding CanDeleteSelectedOffering}"
                              Classes="danger fixedAction" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="panel" Padding="12">
                <StackPanel Spacing="8">
                  <ToggleButton Content="Variants"
                                IsChecked="{Binding IsVariantsSectionExpanded, Mode=TwoWay}"
                                HorizontalContentAlignment="Left" />
                  <StackPanel IsVisible="{Binding IsVariantsSectionExpanded}" Spacing="8">
                    <TextBlock Text="Concrete color and size options supported by this offering."
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <Button Content="Add variant"
                            Command="{Binding StartAddVariantCommand}"
                            Classes="secondary" />
                    <StackPanel IsVisible="{Binding IsAddingVariant}" Spacing="6">
                      <TextBlock Text="Color" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBox Text="{Binding VariantColor}" Classes="field" />
                      <TextBlock Text="Size" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBox Text="{Binding VariantSize}" Classes="field" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Add variant" Command="{Binding AddVariantCommand}" Classes="primary fixedAction" />
                        <Button Content="Cancel" Command="{Binding CancelAddVariantCommand}" Classes="secondary fixedAction" />
                      </StackPanel>
                    </StackPanel>
                    <TextBlock IsVisible="{Binding !HasOfferingVariants}" Text="No concrete Variants configured." Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ItemsControl ItemsSource="{Binding OfferingVariants}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="appProducts:ProductVariantSummary">
                          <Border Classes="listItem" Padding="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                              <Button Content="Remove variant"
                                      Command="{Binding $parent[ItemsControl].DataContext.RemoveSelectedVariantCommand}"
                                      CommandParameter="{Binding}"
                                      Classes="danger" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="panel" Padding="12">
                <StackPanel Spacing="8">
                  <ToggleButton Content="Options / Values"
                                IsChecked="True"
                                HorizontalContentAlignment="Left" />
                  <TextBlock Text="Options have stable semantic kinds: Color, Size, or Other. Values are selected by identity when concrete Variants and mockup templates are configured."
                             TextWrapping="Wrap"
                             FontSize="12"
                             Foreground="{DynamicResource SecondaryTextBrush}" />
                  <ComboBox ItemsSource="{Binding CatalogSetup.Offerings}"
                            SelectedItem="{Binding CatalogSetup.SelectedOffering}"
                            DisplayMemberBinding="{Binding Name}"
                            PlaceholderText="Select Blueprint Offering" />
                  <TextBlock Text="Option kind" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <ComboBox ItemsSource="{Binding CatalogSetup.OptionKinds}"
                            SelectedItem="{Binding CatalogSetup.SelectedOptionKind}" />
                  <TextBox Text="{Binding CatalogSetup.OptionName}" PlaceholderText="Option name" Classes="field" />
                  <Button Content="Add typed Option"
                          Command="{Binding CatalogSetup.CreateOptionCommand}"
                          IsEnabled="{Binding CatalogSetup.CanEdit}"
                          Classes="secondary" />
                  <ComboBox ItemsSource="{Binding CatalogSetup.AvailableOptions}"
                            SelectedItem="{Binding CatalogSetup.SelectedOption}"
                            DisplayMemberBinding="{Binding Name}"
                            PlaceholderText="Select Option" />
                  <TextBox Text="{Binding CatalogSetup.OptionValue}" PlaceholderText="Option value" Classes="field" />
                  <Button Content="Add Option Value"
                          Command="{Binding CatalogSetup.CreateOptionValueCommand}"
                          IsEnabled="{Binding CatalogSetup.CanEdit}"
                          Classes="secondary" />
                  <TextBlock Text="{Binding CatalogSetup.ErrorMessage}"
                             IsVisible="{Binding CatalogSetup.HasError}"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource DangerTextBrush}" />
                </StackPanel>
              </Border>

              <Border Classes="panel" Padding="12">
                <StackPanel Spacing="8">
                  <ToggleButton Content="Placeholders"
                                IsChecked="{Binding IsDesignAreasSectionExpanded, Mode=TwoWay}"
                                HorizontalContentAlignment="Left" />
                  <StackPanel IsVisible="{Binding IsDesignAreasSectionExpanded}" Spacing="8">
                    <TextBlock Text="Placeholders are named design targets for this Offering."
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <Button Content="Add Placeholder"
                            Command="{Binding StartAddDesignAreaCommand}"
                            Classes="secondary" />
                    <StackPanel IsVisible="{Binding IsAddingDesignArea}" Spacing="6">
                      <TextBlock Text="Name" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBox Text="{Binding AreaName}" PlaceholderText="Front" Classes="field" />
                      <TextBlock Text="Position" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBox Text="{Binding AreaPosition}" Classes="field" />
                      <TextBlock Text="Decoration method" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBox Text="{Binding AreaDecorationMethod}" PlaceholderText="DTG" Classes="field" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <StackPanel Width="120" Spacing="4">
                          <TextBlock Text="Width (px)" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                          <TextBox Text="{Binding AreaWidth}" Classes="field" />
                        </StackPanel>
                        <StackPanel Width="120" Spacing="4">
                          <TextBlock Text="Height (px)" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                          <TextBox Text="{Binding AreaHeight}" Classes="field" />
                        </StackPanel>
                      </StackPanel>
                      <StackPanel IsVisible="{Binding HasSelectedVariant}" Spacing="4">
                        <TextBlock Text="Applies to (leave clear for all variants)"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <ItemsControl ItemsSource="{Binding ApplicableVariants}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="stores:ApplicableVariantViewModel">
                              <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Add Placeholder" Command="{Binding AddDesignAreaCommand}" Classes="primary fixedAction" />
                        <Button Content="Cancel" Command="{Binding CancelAddDesignAreaCommand}" Classes="secondary fixedAction" />
                      </StackPanel>
                    </StackPanel>
                  <TextBlock IsVisible="{Binding !HasOfferingDesignAreas}" Text="No Placeholders configured." Foreground="{DynamicResource SecondaryTextBrush}" />
                  <Button Content="Use selected normalized Placeholder as offering default"
                          Command="{Binding CatalogSetup.SetDefaultPlaceholderCommand}"
                          IsEnabled="{Binding CatalogSetup.CanEdit}"
                          Classes="secondary" />
                    <ItemsControl ItemsSource="{Binding OfferingDesignAreas}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="appProducts:DesignAreaSummary">
                          <Border Classes="listItem" Padding="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding Name}" />
                              <TextBlock Text="·" Foreground="{DynamicResource SecondaryTextBrush}" />
                              <TextBlock Text="{Binding Position}" />
                              <TextBlock Text="{Binding Width, StringFormat='{}{0}px'}" Foreground="{DynamicResource SecondaryTextBrush}" />
                              <TextBlock Text="×" Foreground="{DynamicResource SecondaryTextBrush}" />
                              <TextBlock Text="{Binding Height, StringFormat='{}{0}px'}" Foreground="{DynamicResource SecondaryTextBrush}" />
                              <Button Content="Remove Placeholder"
                                      Command="{Binding $parent[ItemsControl].DataContext.RemoveSelectedDesignAreaCommand}"
                                      CommandParameter="{Binding}"
                                      Classes="danger" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="panel" Padding="12">
                <StackPanel Spacing="8">
                  <ToggleButton Content="Mockup Templates"
                                IsChecked="True"
                                HorizontalContentAlignment="Left" />
                  <TextBlock Text="Each template targets one Placeholder and links one Color Option Value. The binding is selected during template setup, not during listing."
                             TextWrapping="Wrap"
                             FontSize="12"
                             Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBlock Text="Source image: not configured. Upload, placement, rendering, and compositing are future work."
                             TextWrapping="Wrap"
                             FontSize="11"
                             Foreground="{DynamicResource MutedTextBrush}" />
                  <ComboBox ItemsSource="{Binding CatalogSetup.AvailablePlaceholders}"
                            SelectedItem="{Binding CatalogSetup.SelectedPlaceholder}"
                            DisplayMemberBinding="{Binding Name}"
                            PlaceholderText="Target Placeholder" />
                  <TextBox Text="{Binding CatalogSetup.TemplateName}" PlaceholderText="Mockup Template name" Classes="field" />
                  <Button Content="Create Mockup Template"
                          Command="{Binding CatalogSetup.CreateTemplateCommand}"
                          IsEnabled="{Binding CatalogSetup.CanEdit}"
                          Classes="secondary" />
                  <ComboBox ItemsSource="{Binding CatalogSetup.AvailableTemplates}"
                            SelectedItem="{Binding CatalogSetup.SelectedTemplate}"
                            DisplayMemberBinding="{Binding Name}"
                            PlaceholderText="Select Mockup Template" />
                  <ComboBox ItemsSource="{Binding CatalogSetup.AvailableColors}"
                            SelectedItem="{Binding CatalogSetup.SelectedColor}"
                            DisplayMemberBinding="{Binding Value}"
                            PlaceholderText="Color Option Value" />
                  <Button Content="Link Color Option Value"
                          Command="{Binding CatalogSetup.AddTemplateColorCommand}"
                          IsEnabled="{Binding CatalogSetup.CanEdit}"
                          Classes="secondary" />
                </StackPanel>
              </Border>

              <Border Classes="panel" Padding="12">
                <StackPanel Spacing="8">
                  <ToggleButton Content="Advanced"
                                IsChecked="False"
                                HorizontalContentAlignment="Left" />
                  <TextBlock Text="Provider-network identity and external identifiers are preserved by the catalog model. Shopify publication and credentials are future integration work."
                             TextWrapping="Wrap"
                             FontSize="12"
                             Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
              </Border>

              <Border Classes="panel" Padding="12">
                <StackPanel Spacing="8">
                  <ToggleButton Content="Advanced identifiers"
                                IsChecked="{Binding IsAdvancedSectionExpanded, Mode=TwoWay}"
                                HorizontalContentAlignment="Left" />
                  <StackPanel IsVisible="{Binding IsAdvancedSectionExpanded}" Spacing="8">
                    <TextBlock Text="External offering ID" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox Text="{Binding OfferingExternalOfferingId}" Classes="field" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>

          <Border IsVisible="{Binding ProductDeleteWarningVisible}"
                  Background="{DynamicResource DangerBackgroundBrush}"
                  BorderBrush="{DynamicResource DangerBorderBrush}"
                  BorderThickness="1"
                  Padding="12"
                  Margin="0,8,0,0">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding ProductDeleteWarningMessage}"
                         FontSize="13"
                         Foreground="{DynamicResource DangerTextBrush}" />
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <Button Content="Delete permanently"
                        Command="{Binding ConfirmDeleteProductCommand}"
                        Classes="danger fixedDanger" />
                <Button Content="Cancel"
                        Command="{Binding CancelDeleteProductCommand}"
                        Classes="secondary fixedAction" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border IsVisible="{Binding OfferingDeleteWarningVisible}"
                  Background="{DynamicResource DangerBackgroundBrush}"
                  BorderBrush="{DynamicResource DangerBorderBrush}"
                  BorderThickness="1"
                  Padding="12"
                  Margin="0,8,0,0">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding OfferingDeleteWarningMessage}"
                         FontSize="13"
                         Foreground="{DynamicResource DangerTextBrush}" />
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <Button Content="Delete permanently"
                        Command="{Binding ConfirmDeleteOfferingCommand}"
                        Classes="danger fixedDanger" />
                <Button Content="Cancel"
                        Command="{Binding CancelDeleteOfferingCommand}"
                        Classes="secondary fixedAction" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border IsVisible="{Binding DeleteWarningVisible}"
                  Background="{DynamicResource DangerBackgroundBrush}"
                  BorderBrush="{DynamicResource DangerBorderBrush}"
                  BorderThickness="1"
                  Padding="12"
                  Margin="0,8,0,0">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding DeleteWarningMessage}"
                         FontSize="13"
                         Foreground="{DynamicResource DangerTextBrush}" />
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <Button Content="Delete permanently"
                        Command="{Binding ConfirmDeleteStoreCommand}"
                        Classes="danger fixedDanger" />
                <Button Content="Cancel"
                        Command="{Binding CancelDeleteStoreCommand}"
                        Classes="secondary fixedAction" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border IsVisible="{Binding NicheDeleteWarningVisible}"
                  Background="{DynamicResource DangerBackgroundBrush}"
                  BorderBrush="{DynamicResource DangerBorderBrush}"
                  BorderThickness="1"
                  Padding="12"
                  Margin="0,8,0,0">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding NicheDeleteWarningMessage}"
                         FontSize="13"
                         Foreground="{DynamicResource DangerTextBrush}" />
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <Button Content="Delete permanently"
                        Command="{Binding ConfirmDeleteNicheCommand}"
                        Classes="danger fixedDanger" />
                <Button Content="Cancel"
                        Command="{Binding CancelDeleteNicheCommand}"
                        Classes="secondary fixedAction" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border IsVisible="{Binding DiscardChangesPromptVisible}"
                  Background="{DynamicResource WarningBackgroundBrush}"
                  BorderBrush="{DynamicResource WarningBorderBrush}"
                  BorderThickness="1"
                  Padding="12"
                  Margin="0,8,0,0">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding DiscardChangesMessage}"
                         FontSize="13"
                         Foreground="{DynamicResource StrongTextBrush}" />
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <Button Content="Discard changes"
                        Command="{Binding ConfirmDiscardChangesCommand}"
                        Classes="danger fixedDanger" />
                <Button Content="Keep editing"
                        Command="{Binding KeepEditingCommand}"
                        Classes="secondary fixedDanger" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
  <Window.Styles>
    <Style Selector="Button.primary">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource CommandBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CommandForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CommandBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource DangerStrongBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CommandForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.fixedAction">
      <Setter Property="Width" Value="104" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.fixedDanger">
      <Setter Property="Width" Value="156" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.restoreAction">
      <Setter Property="Width" Value="220" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.listItem">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource PanelSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.tabButton">
      <Setter Property="MinWidth" Value="116" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.tabButton.selected">
      <Setter Property="Background" Value="{DynamicResource CommandBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CommandForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CommandBorderBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBox.field">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Window.Styles>
</Window>
