<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:stores="clr-namespace:FusionCanvas.App.Stores"
        x:Class="FusionCanvas.App.Stores.DesignAreaEditorWindow"
        x:DataType="stores:CatalogSetupViewModel"
        Title="{Binding DesignAreaEditorDialogTitle}"
        Width="680"
        Height="760"
        MinWidth="520"
        MinHeight="520"
        CanResize="True"
        ShowActivated="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        AutomationProperties.Name="{Binding DesignAreaEditorDialogTitle}"
        AutomationProperties.AutomationId="Catalog.DesignAreaEditorDialog">
  <Grid RowDefinitions="Auto,*,Auto" Margin="20" RowSpacing="14">
    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Text="{Binding DesignAreaEditorDialogTitle}" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="Configure the printable region, artwork guidance, and compatible Variants for this Offering."
                 TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
      <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
                 Foreground="{DynamicResource DangerTextBrush}" AutomationProperties.AutomationId="Catalog.DesignAreaEditorError" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="8" Margin="0,0,8,0" AutomationProperties.AutomationId="Catalog.DesignAreaEditorForm">
        <TextBlock Text="Identity" FontWeight="SemiBold" />
        <TextBlock Text="Name" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
        <TextBox x:Name="DesignAreaNameTextBox" Text="{Binding PlaceholderName}" PlaceholderText="Front" Classes="field"
                 AutomationProperties.Name="Name" />
        <TextBlock Text="Position" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
        <TextBox Text="{Binding PlaceholderPosition}" PlaceholderText="front" Classes="field" AutomationProperties.Name="Position" />
        <TextBlock Text="Decoration method" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
        <TextBox Text="{Binding PlaceholderDecorationMethod}" PlaceholderText="DTG" Classes="field" AutomationProperties.Name="Decoration method" />
        <TextBlock Text="Description (optional)" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
        <TextBox Text="{Binding PlaceholderDescription}" AcceptsReturn="True" MinHeight="56" Classes="field" AutomationProperties.Name="Description" />

        <TextBlock Text="Maximum design size" FontWeight="SemiBold" Margin="0,8,0,0" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Text="Width (px)" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBox Text="{Binding PlaceholderWidth}" Classes="field" AutomationProperties.Name="Width (px)" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="Height (px)" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBox Text="{Binding PlaceholderHeight}" Classes="field" AutomationProperties.Name="Height (px)" />
          </StackPanel>
        </Grid>
        <TextBlock Text="{Binding PhysicalSizeSummary}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />

        <TextBlock Text="Recommended artwork" FontWeight="SemiBold" Margin="0,8,0,0" />
        <TextBlock Text="Maximum printable dimensions are shown in pixels first. Inches and millimetres are derived only when reliable DPI metadata is available."
                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
          <TextBox Grid.Column="0" Text="{Binding ArtworkWidth}" PlaceholderText="Width (px)" Classes="field" AutomationProperties.Name="Recommended artwork width (px)" />
          <TextBox Grid.Column="1" Text="{Binding ArtworkHeight}" PlaceholderText="Height (px)" Classes="field" AutomationProperties.Name="Recommended artwork height (px)" />
          <TextBox Grid.Column="2" Text="{Binding ArtworkDpi}" PlaceholderText="DPI" Classes="field" AutomationProperties.Name="Recommended artwork DPI" />
        </Grid>
        <Grid ColumnDefinitions="2*,3*" ColumnSpacing="8">
          <TextBox Grid.Column="0" Text="{Binding ArtworkFormat}" PlaceholderText="Format (PNG)" Classes="field" AutomationProperties.Name="Recommended artwork format" />
          <TextBox Grid.Column="1" Text="{Binding ArtworkBackground}" PlaceholderText="Background (transparent)" Classes="field" AutomationProperties.Name="Recommended artwork background" />
        </Grid>

        <TextBlock Text="Compatibility" FontWeight="SemiBold" Margin="0,8,0,0" />
        <CheckBox Content="Compatible with all current Variants"
                  IsChecked="{Binding PlaceholderUsesAllVariants, Mode=TwoWay}"
                  AutomationProperties.Name="Compatible with all current Variants" />
        <StackPanel IsVisible="{Binding !PlaceholderUsesAllVariants}" Spacing="4">
          <TextBlock Text="Compatible Variants" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
          <ItemsControl ItemsSource="{Binding PlaceholderVariantChoices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="stores:VariantChoiceViewModel">
                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Expander Header="Advanced provider data" Margin="0,8,0,0">
          <TextBox Text="{Binding PlaceholderProviderReference}"
                   PlaceholderText="Provider Design Area reference"
                   Classes="field"
                   AutomationProperties.Name="Provider Design Area reference"
                   ToolTip.Tip="Normally populated from the Printify catalog integration." />
        </Expander>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2">
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsDesignAreaDiscardConfirmationVisible}">
        <Button Content="Save design area" Command="{Binding CreatePlaceholderCommand}" Classes="primary" AutomationProperties.Name="Save design area" />
        <Button Content="Cancel" Command="{Binding RequestCancelDesignAreaCommand}" Classes="secondary" AutomationProperties.Name="Cancel Design Area editing" />
      </StackPanel>
      <Border IsVisible="{Binding IsDesignAreaDiscardConfirmationVisible}" Classes="discardPrompt" Padding="12">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
          <TextBlock Text="Discard unsaved Design Area changes?" TextWrapping="Wrap" />
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Discard changes" Command="{Binding ConfirmDiscardDesignAreaCommand}" Classes="danger" />
            <Button x:Name="KeepEditingButton" Content="Keep editing" Command="{Binding KeepEditingDesignAreaCommand}" Classes="secondary" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
  <Window.Styles>
    <Style Selector="Button.primary">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource CommandBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CommandForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CommandBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource DangerStrongBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CommandForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox.field">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.discardPrompt">
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WarningTextBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </Window.Styles>
</Window>

