<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:stores="clr-namespace:FusionCanvas.App.Stores"
        x:Class="FusionCanvas.App.Stores.MockupTemplateArchiveConfirmationWindow"
        x:DataType="stores:CatalogSetupViewModel"
        Title="Archive Mockup Template?"
        Width="480"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ElevatedSurfaceBrush}">
  <Grid RowDefinitions="Auto,Auto" Margin="24" RowSpacing="22">
    <StackPanel Spacing="10">
      <TextBlock Text="Archive Mockup Template?"
                 FontSize="20"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource DangerStrongBrush}" />
      <TextBlock Text="{Binding MockupTemplateArchiveConfirmationMessage}"
                 TextWrapping="Wrap"
                 FontSize="14" />
    </StackPanel>

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">
      <Button x:Name="CancelButton"
              Content="Cancel"
              MinWidth="90"
              Click="OnCancelClick"
              AutomationProperties.Name="Cancel Mockup Template archive" />
      <Button Content="Archive template"
              MinWidth="150"
              Background="{DynamicResource DangerStrongBrush}"
              Foreground="{DynamicResource CommandForegroundBrush}"
              Click="OnConfirmClick"
              AutomationProperties.Name="Confirm Mockup Template archive" />
    </StackPanel>
  </Grid>
</Window>
