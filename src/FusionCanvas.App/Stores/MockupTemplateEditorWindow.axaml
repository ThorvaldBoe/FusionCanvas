<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:stores="using:FusionCanvas.App.Stores"
        xmlns:virtualGrid="clr-namespace:AvaloniaVirtualDataGrid.Controls;assembly=AvaloniaVirtualDataGrid"
        xmlns:virtualColumns="clr-namespace:AvaloniaVirtualDataGrid.Columns;assembly=AvaloniaVirtualDataGrid"
        x:Class="FusionCanvas.App.Stores.MockupTemplateEditorWindow"
        x:DataType="stores:CatalogSetupViewModel"
        Title="{Binding MockupTemplateEditorDialogTitle}"
         Width="980" Height="900" MinWidth="700" MinHeight="620"
        CanResize="True" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}">
  <Window.Styles>
    <Style Selector="Border.mockupGridRow"><Setter Property="Background" Value="{DynamicResource PanelSurfaceBrush}" /></Style>
    <Style Selector="Border.mockupGridRow.alternate"><Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" /></Style>
    <Style Selector="Border.mockupGridRow.selected"><Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" /></Style>
    <Style Selector="Button.mockupTableFile">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="virtualGrid|VirtualDataGridHeaderPanel">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </Window.Styles>
  <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" RowSpacing="12">
    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Text="Mockup Template" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="Upload source images first, then configure each selected image independently." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="16">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="Template name" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
        <TextBox x:Name="TemplateNameTextBox" Text="{Binding TemplateName}" PlaceholderText="Mockup Template name" Classes="field" IsReadOnly="{Binding !CanEdit}" AutomationProperties.Name="Template name" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock Text="Shared Design Area" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
        <ComboBox ItemsSource="{Binding AvailablePlaceholders}" SelectedItem="{Binding SelectedPlaceholder}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Linked Design Area" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Shared Design Area" />
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="4">
        <TextBlock Text="Maximum mockup long edge (px)" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
        <TextBox Text="{Binding MaximumMockupLongEdgeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="2000" Classes="field" IsReadOnly="{Binding !CanEdit}"
                 AutomationProperties.Name="Maximum mockup long edge in pixels"
                 AutomationProperties.HelpText="{Binding MaximumMockupLongEdgeHelpText}" />
        <TextBlock Text="{Binding MaximumMockupLongEdgeHelpText}" TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
        <TextBlock Text="{Binding MaximumMockupLongEdgeValidationMessage}"
                   IsVisible="{Binding HasMaximumMockupLongEdgeValidationMessage}"
                   Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" FontSize="12" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
      <StackPanel Grid.Row="0" Spacing="8">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
        <StackPanel Spacing="2">
          <TextBlock Text="Mockup source images" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="Select a row to edit its metadata below." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>
        <Button Grid.Column="1" Content="{Binding LocalSourceArchiveLabel}" Command="{Binding RemoveLocalSourceCommand}" IsEnabled="{Binding HasSelectedLocalSources}"
                AutomationProperties.Name="Archive selected source images" AutomationProperties.HelpText="Archive every selected source image." Classes="secondary" />
        <Button Grid.Column="2" Content="Upload images..." Command="{Binding BrowseLocalSourceCommand}" Classes="primary"
                AutomationProperties.Name="Upload source images"
                AutomationProperties.HelpText="Select one or more supported raster images." />
        <Button Grid.Column="3" Content="Plan coverage" Command="{Binding GenerateCoveragePlanCommand}" Classes="secondary"
                AutomationProperties.Name="Generate mockup coverage plan" />
        <Button Grid.Column="4" Content="Set up metadata with AI" Command="{Binding AssistMockupSourceMetadataCommand}" Classes="secondary"
              IsEnabled="{Binding CanAssistMockupSourceMetadata}"
                AutomationProperties.Name="Set up source image metadata with AI"
                AutomationProperties.HelpText="Use the General AI settings to suggest colors, sizes, and reusable placement for selected source images." />
      </Grid>
      <Border Grid.Row="1" Padding="10" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              IsVisible="{Binding HasCoveragePanel}" AutomationProperties.AutomationId="Catalog.MockupCoveragePanel">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <StackPanel Spacing="2">
              <TextBlock Text="Coverage planning" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="{Binding CoverageStateLabel}" FontWeight="SemiBold"
                         IsVisible="{Binding HasCoverageStatus}" AutomationProperties.Name="Mockup coverage state" />
              <TextBlock Text="{Binding CoverageStateHelp}" TextWrapping="Wrap"
                         IsVisible="{Binding HasCoverageStatus}" Foreground="{DynamicResource SecondaryTextBrush}"
                         AutomationProperties.HelpText="Explains the current mockup coverage state and next action." />
              <TextBlock Text="{Binding CoverageSummary}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                         AutomationProperties.Name="Mockup coverage summary" />
              <TextBlock Text="{Binding IncompleteCoverageSummary}" IsVisible="{Binding HasIncompleteCoverageSummary}"
                         TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" />
            </StackPanel>
            <ComboBox Grid.Column="1" Width="150" ItemsSource="{Binding CoverageGroupingStrategies}"
                      SelectedItem="{Binding CoverageGroupingStrategy, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"
                      AutomationProperties.Name="Coverage grouping strategy" />
            <Button Grid.Column="2" Content="Refresh plan" Command="{Binding GenerateCoveragePlanCommand}" Classes="secondary"
                    AutomationProperties.Name="Refresh mockup coverage plan" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Optional exemplar" VerticalAlignment="Center" />
            <ComboBox Width="220" ItemsSource="{Binding CoverageExemplarChoices}"
                      SelectedItem="{Binding SelectedCoverageExemplar, Mode=TwoWay}"
                      DisplayMemberBinding="{Binding DisplayName}" IsEnabled="{Binding CanEdit}"
                      AutomationProperties.Name="Coverage exemplar" />
            <TextBlock Text="{Binding ExemplarMappingSummary}" IsVisible="{Binding HasExemplarMappingSummary}"
                       TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding CoverageRequirements}" AutomationProperties.Name="Mockup coverage requirements">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="6" Margin="0,2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                    <StackPanel Spacing="1">
                      <TextBlock Text="{Binding VariantSummary}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="Add mockup image" Command="{Binding $parent[Window].DataContext.AddCoverageRequirementImageCommand}"
                            CommandParameter="{Binding}" IsVisible="{Binding IsActionable}" Classes="link"
                            AutomationProperties.Name="Add mockup image for coverage requirement" />
                    <Button Grid.Column="3" Content="Use selected image" Command="{Binding $parent[Window].DataContext.AssignExistingCoverageImageCommand}"
                            CommandParameter="{Binding}" IsVisible="{Binding IsActionable}" IsEnabled="{Binding $parent[Window].DataContext.CanAssignExistingCoverageImage}"
                            Classes="secondary" AutomationProperties.Name="Assign selected managed image to coverage requirement" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      </StackPanel>
      <Border x:Name="MockupSourceTableBorder" Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Background="{DynamicResource TabBarBackgroundBrush}" Padding="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="175,260,120,95">
              <Button Content="{Binding FileSortLabel}" Command="{Binding SortLocalSourcesCommand}" CommandParameter="File" Classes="link" HorizontalAlignment="Left" FontWeight="Bold" AutomationProperties.Name="{Binding FileSortAccessibleName}" />
              <Button Grid.Column="1" Content="{Binding ApplicabilitySortLabel}" Command="{Binding SortLocalSourcesCommand}" CommandParameter="Applicability" Classes="link" HorizontalAlignment="Left" FontWeight="Bold" AutomationProperties.Name="{Binding ApplicabilitySortAccessibleName}" />
              <Button Grid.Column="2" Content="{Binding StatusSortLabel}" Command="{Binding SortLocalSourcesCommand}" CommandParameter="Status" Classes="link" HorizontalAlignment="Left" FontWeight="Bold" AutomationProperties.Name="{Binding StatusSortAccessibleName}" />
              <TextBlock Grid.Column="3" Text="Action" FontWeight="Bold" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <virtualGrid:VirtualDataGrid x:Name="MockupSourceGrid" Grid.Row="1" Classes="mockupSourceGrid"
                                       RowHeight="32" SelectionMode="None"
                                       AutomationProperties.Name="Mockup source image table"
                                       AutomationProperties.AutomationId="Catalog.MockupSourceGrid">
            <virtualGrid:VirtualDataGrid.Columns>
              <virtualColumns:VirtualDataGridTemplateColumn Header="File" Width="175" IsSortable="False" IsResizable="False">
                <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="stores:LocalMockupSourceDraftViewModel">
                    <Border Classes="mockupGridRow" Classes.alternate="{Binding IsAlternateRow}" Classes.selected="{Binding IsSelected}" Padding="8,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                            Focusable="True" IsTabStop="True" AutomationProperties.Name="{Binding DisplayName, StringFormat='Select source image {0}'}"
                            AutomationProperties.HelpText="Press Enter or Space to select; hold Ctrl to toggle or Shift to select a range"
                            AutomationProperties.ItemStatus="{Binding IsSelected, StringFormat='Selected: {0}'}">
                      <Button Content="{Binding DisplayName}" HorizontalContentAlignment="Left" Classes="mockupTableFile" />
                    </Border>
                  </DataTemplate>
                </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
              </virtualColumns:VirtualDataGridTemplateColumn>
              <virtualColumns:VirtualDataGridTemplateColumn Header="Applicability" Width="260" IsSortable="False" IsResizable="False">
                <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="stores:LocalMockupSourceDraftViewModel">
                    <Border Classes="mockupGridRow" Classes.alternate="{Binding IsAlternateRow}" Classes.selected="{Binding IsSelected}" Padding="8,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                      <TextBlock Text="{Binding ApplicabilitySummary}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ApplicabilitySummary}"
                                 AutomationProperties.Name="Applicability" AutomationProperties.HelpText="{Binding ApplicabilitySummary}" />
                    </Border>
                  </DataTemplate>
                </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
              </virtualColumns:VirtualDataGridTemplateColumn>
              <virtualColumns:VirtualDataGridTemplateColumn Header="Status" Width="120" IsSortable="False" IsResizable="False">
                <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="stores:LocalMockupSourceDraftViewModel">
                    <Border Classes="mockupGridRow" Classes.alternate="{Binding IsAlternateRow}" Classes.selected="{Binding IsSelected}" Padding="8,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold" ToolTip.Tip="{Binding AssistanceStatus}"
                                   AutomationProperties.Name="Metadata assistance status" AutomationProperties.HelpText="{Binding AssistanceStatus}" />
                        <TextBlock Text="⚠" IsVisible="{Binding HasPreviewReadError}" Foreground="{DynamicResource WarningTextBrush}"
                                   ToolTip.Tip="{Binding PreviewReadError}" AutomationProperties.Name="Source image preview warning"
                                   AutomationProperties.HelpText="{Binding PreviewReadError}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
              </virtualColumns:VirtualDataGridTemplateColumn>
              <virtualColumns:VirtualDataGridTemplateColumn Header="Action" Width="95" IsSortable="False" IsResizable="False">
                <virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="stores:LocalMockupSourceDraftViewModel">
                    <Border Classes="mockupGridRow" Classes.alternate="{Binding IsAlternateRow}" Classes.selected="{Binding IsSelected}" Padding="4,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                      <Button MinWidth="80" Content="Archive" CommandParameter="{Binding}"
                              Classes="secondary mockupSourceArchive" AutomationProperties.Name="Archive source image" />
                    </Border>
                  </DataTemplate>
                </virtualColumns:VirtualDataGridTemplateColumn.CellTemplate>
              </virtualColumns:VirtualDataGridTemplateColumn>
            </virtualGrid:VirtualDataGrid.Columns>
          </virtualGrid:VirtualDataGrid>
        </Grid>
      </Border>
      <TextBlock Grid.Row="2" IsVisible="{Binding !HasLocalSource}" Text="No source images uploaded yet. Upload an image to begin." Foreground="{DynamicResource SecondaryTextBrush}" />
      <StackPanel Grid.Row="3" Spacing="4">
        <ItemsControl ItemsSource="{Binding MockupTemplateReadinessMessages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasMockupSourceMetadataAssistanceStatus}">
          <TextBlock Text="{Binding MockupSourceMetadataAssistanceStatus}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
          <Button Content="Cancel" Command="{Binding CancelMockupSourceMetadataCommand}" IsVisible="{Binding IsMockupSourceMetadataAssistanceBusy}" Classes="link" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <Border Grid.Row="3" Classes="listItem" Padding="12" IsVisible="{Binding HasSelectedLocalSource}" AutomationProperties.AutomationId="Catalog.MockupSelectedImageEditor">
      <Grid ColumnDefinitions="3*,2*" ColumnSpacing="16">
        <StackPanel Grid.Column="0" Spacing="8">
          <TextBlock Text="Image and design placement" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="{Binding SelectedLocalSource.DisplayName}" Foreground="{DynamicResource SecondaryTextBrush}" />
          <Grid Height="240">
            <stores:MockupPlacementEditor x:Name="PlacementEditor" IsEnabled="{Binding CanEdit}"
                                           PlacementX="{Binding MappingX, Mode=TwoWay}" PlacementY="{Binding MappingY, Mode=TwoWay}"
                                           PlacementWidth="{Binding MappingWidth, Mode=TwoWay}" PlacementHeight="{Binding MappingHeight, Mode=TwoWay}"
                                           AspectRatio="{Binding PlacementAspectRatio}" KeepAspectRatio="{Binding KeepAspectRatio, Mode=TwoWay}"
                                           ImageWidth="{Binding MappingImageWidth}" ImageHeight="{Binding MappingImageHeight}"
                                           ImagePath="{Binding SelectedImagePreviewPath}"
                                           AutomationProperties.Name="Selected image placement" />
            <Button x:Name="OpenEnlargedPlacementEditorButton" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"
                    Width="40" Height="40" Padding="0" Background="{DynamicResource IconButtonBackgroundBrush}"
                    Foreground="{DynamicResource IconButtonForegroundBrush}"
                    ToolTip.Tip="Open enlarged image placement editor"
                    Command="{Binding OpenEnlargedPlacementEditorCommand}"
                    AutomationProperties.Name="Open enlarged image placement editor"
                    AutomationProperties.HelpText="Open a larger view for precise design-area placement">
              <PathIcon Data="M9.5,3 A6.5,6.5 0,1 0,13.6,14.55 L19,20 L20.4,18.6 L15,13.2 A6.5,6.5 0,0 0,9.5,3 Z M9.5,5 A4.5,4.5 0,1 1,9.5,14 A4.5,4.5 0,0 1,9.5,5 Z M9,7 L9,9 L7,9 L7,11 L9,11 L9,13 L11,13 L11,11 L13,11 L13,9 L11,9 L11,7 Z" />
            </Button>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Re-use mapping from" VerticalAlignment="Center" />
            <ComboBox Width="220" ItemsSource="{Binding MappedSourceChoices}" SelectedItem="{Binding SelectedMappingSource}" DisplayMemberBinding="{Binding DisplayName}" IsEnabled="{Binding CanEdit}" />
            <Button Content="Apply" Command="{Binding ReuseMappingCommand}" CommandParameter="{Binding SelectedMappingSource}" Classes="secondary" />
          </StackPanel>
          <TextBlock Text="Mapping is optional while this image is being configured. Set positive in-bounds values before using it." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="8">
          <TextBlock Text="Image metadata" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="Color (choose one or more)" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
          <TextBox Text="{Binding TemplateColorSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   PlaceholderText="Search Colors"
                   Classes="field"
                   AutomationProperties.AutomationId="Catalog.MockupColorSearch"
                   AutomationProperties.Name="Search Colors"
                   AutomationProperties.HelpText="Filter Color applicability choices as you type." />
          <ScrollViewer x:Name="ColorChoicesScrollViewer"
                        AutomationProperties.AutomationId="Catalog.MockupColorChoices"
                        MaxHeight="240"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding FilteredTemplateColorChoices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="stores:OptionValueChoiceViewModel">
                  <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding $parent[Window].DataContext.CanEdit}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Text="No Colors match this search. Clear or change the query."
                     IsVisible="{Binding HasNoMatchingTemplateColors}"
                     TextWrapping="Wrap"
                     FontSize="12"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     AutomationProperties.AutomationId="Catalog.MockupColorSearchNoResults" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Size and other options" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
            <Button Content="Select all" Command="{Binding SelectAllTemplateSizesCommand}" Classes="link" Padding="0" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding TemplateAdditionalOptionChoices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="stores:OptionValueChoiceViewModel">
                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding $parent[Window].DataContext.CanEdit}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Image-space mapping (pixels)" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="X" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Y" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding MappingXText}" Classes="field" IsReadOnly="{Binding !CanEdit}" AutomationProperties.Name="X" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MappingYText}" Classes="field" IsReadOnly="{Binding !CanEdit}" AutomationProperties.Name="Y" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Width" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="Height" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBox Grid.Row="3" Grid.Column="0" Text="{Binding MappingWidthText}" Classes="field" IsReadOnly="{Binding !CanEdit}" AutomationProperties.Name="Width" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MappingHeightText}" Classes="field" IsReadOnly="{Binding !CanEdit}" AutomationProperties.Name="Height" />
          </Grid>
          <CheckBox Content="Keep aspect ratio" IsChecked="{Binding KeepAspectRatio, Mode=TwoWay}" IsEnabled="{Binding CanKeepAspectRatio}"
                    ToolTip.Tip="Preserve the selected Design Area width-to-height ratio while resizing or editing dimensions."
                    AutomationProperties.Name="Keep aspect ratio"
                    AutomationProperties.HelpText="Preserve the selected Design Area width-to-height ratio." />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="4" IsVisible="{Binding IsMockupTemplateDiscardConfirmationVisible}" Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" Padding="10">
      <StackPanel Spacing="8">
        <TextBlock Text="Discard unsaved Mockup Template changes?" FontWeight="SemiBold" />
        <TextBlock Text="Your current template values and placement will be lost." TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Discard changes" Command="{Binding ConfirmDiscardMockupTemplateCommand}" Classes="danger" />
          <Button x:Name="KeepEditingButton" Content="Keep editing" Command="{Binding KeepEditingMockupTemplateCommand}" Classes="secondary" />
        </StackPanel>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="SaveMockupTemplateButton" Content="Save Mockup Template" Command="{Binding CreateTemplateCommand}" Classes="primary" />
      <Button Content="Cancel" Command="{Binding RequestCancelMockupTemplateCommand}" Classes="secondary" />
    </StackPanel>
  </Grid>
</Window>
