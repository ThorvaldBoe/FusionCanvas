<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:stores="using:FusionCanvas.App.Stores"
        x:Class="FusionCanvas.App.Stores.MockupTemplateEditorWindow"
        x:DataType="stores:CatalogSetupViewModel"
        Title="{Binding MockupTemplateEditorDialogTitle}"
        Width="980" Height="820" MinWidth="700" MinHeight="620"
        CanResize="True" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}">
  <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" RowSpacing="12">
    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Text="Mockup Template" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="Upload source images first, then configure each selected image independently." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="16">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="Template name" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
        <TextBox x:Name="TemplateNameTextBox" Text="{Binding TemplateName}" PlaceholderText="Mockup Template name" Classes="field" IsReadOnly="{Binding !CanEdit}" AutomationProperties.Name="Template name" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock Text="Shared Design Area" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
        <ComboBox ItemsSource="{Binding AvailablePlaceholders}" SelectedItem="{Binding SelectedPlaceholder}" DisplayMemberBinding="{Binding Name}" PlaceholderText="Linked Design Area" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Shared Design Area" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <StackPanel Spacing="2">
          <TextBlock Text="Mockup source images" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="Select a row to edit its metadata below." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>
        <Button Grid.Column="1" Content="Archive selected" Command="{Binding RemoveLocalSourceCommand}" CommandParameter="{Binding SelectedLocalSource}" Classes="secondary" />
        <Button Grid.Column="2" Content="Upload image..." Command="{Binding BrowseLocalSourceCommand}" Classes="primary" />
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding LocalSourceDrafts}" AutomationProperties.Name="Mockup source image table">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="stores:LocalMockupSourceDraftViewModel">
              <Border Classes="listItem" Padding="8" Margin="0,2">
                <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="10">
                  <Button Grid.Column="0" Content="{Binding DisplayName}" Command="{Binding $parent[Window].DataContext.SelectLocalSourceCommand}" CommandParameter="{Binding}" HorizontalContentAlignment="Left" Classes="link" />
                  <TextBlock Grid.Column="1" Text="{Binding ApplicabilitySummary}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" VerticalAlignment="Center" FontWeight="SemiBold" />
                  <Button Grid.Column="3" Content="Archive" Command="{Binding $parent[Window].DataContext.RemoveLocalSourceCommand}" CommandParameter="{Binding}" Classes="secondary" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <TextBlock Grid.Row="2" IsVisible="{Binding !HasLocalSource}" Text="No source images uploaded yet. Upload an image to begin." Foreground="{DynamicResource SecondaryTextBrush}" />
      <ItemsControl Grid.Row="3" ItemsSource="{Binding MockupTemplateReadinessMessages}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <Border Grid.Row="3" Classes="listItem" Padding="12" IsVisible="{Binding HasSelectedLocalSource}" AutomationProperties.AutomationId="Catalog.MockupSelectedImageEditor">
      <Grid ColumnDefinitions="3*,2*" ColumnSpacing="16">
        <StackPanel Grid.Column="0" Spacing="8">
          <TextBlock Text="Image and design placement" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="{Binding SelectedLocalSource.DisplayName}" Foreground="{DynamicResource SecondaryTextBrush}" />
          <stores:MockupPlacementEditor x:Name="PlacementEditor" Height="240" IsEnabled="{Binding CanEdit}"
                                         PlacementX="{Binding MappingX, Mode=TwoWay}" PlacementY="{Binding MappingY, Mode=TwoWay}"
                                         PlacementWidth="{Binding MappingWidth, Mode=TwoWay}" PlacementHeight="{Binding MappingHeight, Mode=TwoWay}"
                                         ImageWidth="{Binding MappingImageWidth}" ImageHeight="{Binding MappingImageHeight}"
                                         AutomationProperties.Name="Selected image placement" />
          <TextBlock Text="Mapping is optional while this image is being configured. Set positive in-bounds values before using it." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="8">
          <TextBlock Text="Image metadata" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="Color (choose one or more)" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
          <ItemsControl ItemsSource="{Binding TemplateColorChoices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="stores:OptionValueChoiceViewModel">
                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding $parent[Window].DataContext.CanEdit}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Size and other options" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
          <ItemsControl ItemsSource="{Binding TemplateAdditionalOptionChoices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="stores:OptionValueChoiceViewModel">
                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding $parent[Window].DataContext.CanEdit}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Image-space mapping (pixels)" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="X" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Y" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding MappingXText}" Classes="field" IsReadOnly="{Binding !CanEdit}" AutomationProperties.Name="X" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MappingYText}" Classes="field" IsReadOnly="{Binding !CanEdit}" AutomationProperties.Name="Y" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Width" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="Height" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBox Grid.Row="3" Grid.Column="0" Text="{Binding MappingWidthText}" Classes="field" IsReadOnly="{Binding !CanEdit}" AutomationProperties.Name="Width" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MappingHeightText}" Classes="field" IsReadOnly="{Binding !CanEdit}" AutomationProperties.Name="Height" />
          </Grid>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="4" IsVisible="{Binding IsMockupTemplateDiscardConfirmationVisible}" Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" Padding="10">
      <StackPanel Spacing="8">
        <TextBlock Text="Discard unsaved Mockup Template changes?" FontWeight="SemiBold" />
        <TextBlock Text="Your current template values and placement will be lost." TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Discard changes" Command="{Binding ConfirmDiscardMockupTemplateCommand}" Classes="danger" />
          <Button x:Name="KeepEditingButton" Content="Keep editing" Command="{Binding KeepEditingMockupTemplateCommand}" Classes="secondary" />
        </StackPanel>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="SaveMockupTemplateButton" Content="Save Mockup Template" Command="{Binding CreateTemplateCommand}" Classes="primary" />
      <Button Content="Cancel" Command="{Binding RequestCancelMockupTemplateCommand}" Classes="secondary" />
    </StackPanel>
  </Grid>
</Window>
