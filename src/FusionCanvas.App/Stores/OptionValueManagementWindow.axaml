<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:stores="clr-namespace:FusionCanvas.App.Stores"
        xmlns:catalog="clr-namespace:FusionCanvas.Domain.Catalog;assembly=FusionCanvas.Domain"
        x:Class="FusionCanvas.App.Stores.OptionValueManagementWindow"
        x:DataType="stores:CatalogSetupViewModel"
        Title="{Binding ManageOptionValuesDialogTitle}"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        ShowActivated="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        AutomationProperties.AutomationId="Catalog.OptionValueManagementDialog">
  <Grid RowDefinitions="*,Auto" Margin="20" RowSpacing="16">
    <StackPanel Grid.Row="0" Spacing="8" AutomationProperties.AutomationId="Catalog.OptionValueEditor">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="Manage values" FontWeight="SemiBold" />
          <TextBlock Text="{Binding SelectedOption.Name}" Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button x:Name="OptionValueCancelButton" Content="Cancel" Click="OnCancelClick" Classes="secondary" />
          <Button x:Name="OptionValueDoneButton" Content="Done" Click="OnDoneClick" Classes="secondary" />
        </StackPanel>
      </Grid>
      <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" FontSize="12" Foreground="{DynamicResource DangerTextBrush}" />
      <TextBlock IsVisible="{Binding !HasAvailableValues}" Text="No Values configured for this Option." Foreground="{DynamicResource SecondaryTextBrush}" />
      <ItemsControl ItemsSource="{Binding AvailableValues}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="catalog:OfferingOptionValue">
            <Border Classes="listItem" Padding="8">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Grid.Column="0" Text="{Binding Value}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="Archive"
                        Command="{Binding $parent[ItemsControl].DataContext.ArchiveOptionValueCommand}"
                        CommandParameter="{Binding}"
                        Classes="compactDanger"
                        AutomationProperties.Name="{Binding Value, StringFormat='Archive {0}'}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button x:Name="AddOptionValueButton" Content="Add Option Value" Command="{Binding StartAddOptionValueCommand}" Classes="secondary" />
      <StackPanel IsVisible="{Binding IsAddingOptionValue}" Spacing="6">
        <TextBox x:Name="OptionValueTextBox" Text="{Binding OptionValue}" PlaceholderText="Option Value" Classes="field" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Save Option Value" Command="{Binding CreateOptionValueCommand}" Classes="primary fixedAction" />
          <Button Content="Cancel add" Command="{Binding CancelAddOptionValueCommand}" Classes="secondary fixedAction" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Grid>
  <Window.Styles>
    <Style Selector="Button.primary">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource CommandBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CommandForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CommandBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource DangerStrongBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CommandForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.compactDanger">
      <Setter Property="Padding" Value="7,4" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.fixedAction">
      <Setter Property="Width" Value="104" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.listItem">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource PanelSurfaceBrush}" />
    </Style>
    <Style Selector="TextBox.field">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Window.Styles>
</Window>
