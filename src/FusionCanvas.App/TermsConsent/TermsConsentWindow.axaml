<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:terms="clr-namespace:FusionCanvas.App.TermsConsent"
        x:Class="FusionCanvas.App.TermsConsent.TermsConsentWindow"
        x:DataType="terms:TermsConsentViewModel"
        Title="FusionCanvas terms and responsible use"
        Width="820"
        Height="720"
        MinWidth="680"
        MinHeight="560"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Token.Color.WindowBackground}">
  <Grid RowDefinitions="Auto,*,Auto,Auto"
        Margin="{DynamicResource Token.Layout.PageInset}">
    <StackPanel Grid.Row="0" Spacing="{DynamicResource Token.Spacing.InlineGap}">
      <TextBlock Text="Before you start using FusionCanvas"
                 FontSize="{DynamicResource Token.Typography.Title}"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource Token.Color.TextStrong}" />
      <TextBlock Text="Please review the local policy and confirm each responsibility that applies to provider-connected work."
                 TextWrapping="Wrap"
                 FontSize="{DynamicResource Token.Typography.Body}"
                 Foreground="{DynamicResource Token.Color.TextSecondary}" />
      <TextBlock Text="FusionCanvas policy version {Binding TermsVersion}; acknowledgement policy {Binding PolicyVersion}."
                 FontSize="{DynamicResource Token.Typography.Caption}"
                 Foreground="{DynamicResource Token.Color.TextSecondary}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="{DynamicResource Token.Spacing.SectionGap}">
        <Border Padding="{DynamicResource Token.Layout.CardPadding}"
                Background="{DynamicResource Token.Color.SurfaceElevated}"
                BorderBrush="{DynamicResource Token.Color.Border}"
                BorderThickness="{DynamicResource Token.Border.Default}"
                CornerRadius="{DynamicResource Token.Radius.Card}">
          <StackPanel Spacing="{DynamicResource Token.Spacing.GroupGap}">
            <TextBlock Text="FusionCanvas Terms of Use and Responsible Use Policy"
                       FontWeight="SemiBold"
                       FontSize="{DynamicResource Token.Typography.SectionHeading}"
                       Foreground="{DynamicResource Token.Color.TextStrong}" />
            <TextBlock Text="The bundled FusionCanvas policy is readable offline. It is a product draft pending human/legal approval and is not legal advice."
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource Token.Typography.Caption}"
                       Foreground="{DynamicResource Token.Color.TextSecondary}" />
            <TextBox Text="{Binding PolicyText}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="{DynamicResource Token.Control.PolicyTextMinHeight}"
                     MaxHeight="{DynamicResource Token.Control.PolicyTextMaxHeight}"
                     FontSize="{DynamicResource Token.Typography.Caption}"
                     Background="{DynamicResource Token.Color.Surface}"
                     BorderBrush="{DynamicResource Token.Color.Border}" />
          </StackPanel>
        </Border>

        <StackPanel Spacing="{DynamicResource Token.Spacing.GroupGap}">
          <TextBlock Text="Required acknowledgements"
                     FontSize="{DynamicResource Token.Typography.SectionHeading}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource Token.Color.TextStrong}" />
          <CheckBox x:Name="FusionCanvasTermsCheckBox"
                    IsChecked="{Binding FusionCanvasTermsSelected, Mode=TwoWay}"
                    AutomationProperties.Name="I have read and agree to the FusionCanvas Terms of Use and Responsible Use Policy"
                    Content="I have read and agree to the FusionCanvas Terms of Use and Responsible Use Policy." />
          <CheckBox IsChecked="{Binding PrintifyTermsSelected, Mode=TwoWay}"
                    AutomationProperties.Name="I understand and will comply with Printify terms and policies"
                    Content="I understand that Printify's current terms and policies apply when I use Printify-connected features, and I will comply with them." />
          <StackPanel Orientation="Horizontal"
                      Spacing="{DynamicResource Token.Spacing.ControlGap}"
                      Margin="{DynamicResource Token.Layout.IndentedContent}">
            <Button Content="Printify Terms"
                    Command="{Binding OpenPrintifyTermsCommand}"
                    AutomationProperties.Name="Open official Printify terms" />
            <Button Content="Printify IP Policy"
                    Command="{Binding OpenPrintifyIpPolicyCommand}"
                    AutomationProperties.Name="Open official Printify intellectual property policy" />
          </StackPanel>
          <CheckBox IsChecked="{Binding ShopifyTermsSelected, Mode=TwoWay}"
                    AutomationProperties.Name="I understand and will comply with Shopify terms and policies"
                    Content="I understand that Shopify's current terms and policies apply when I use Shopify-connected features, and I will comply with them." />
          <StackPanel Orientation="Horizontal"
                      Spacing="{DynamicResource Token.Spacing.ControlGap}"
                      Margin="{DynamicResource Token.Layout.IndentedContent}">
            <Button Content="Shopify Terms"
                    Command="{Binding OpenShopifyTermsCommand}"
                    AutomationProperties.Name="Open official Shopify terms" />
            <Button Content="Shopify Acceptable Use"
                    Command="{Binding OpenShopifyAupCommand}"
                    AutomationProperties.Name="Open official Shopify acceptable use policy" />
            <Button Content="Shopify API Terms"
                    Command="{Binding OpenShopifyApiTermsCommand}"
                    AutomationProperties.Name="Open official Shopify API terms" />
          </StackPanel>
          <CheckBox IsChecked="{Binding IntellectualPropertySelected, Mode=TwoWay}"
                    AutomationProperties.Name="I am responsible for rights licenses permissions trademarks and intellectual property"
                    Content="I am responsible for having the rights, licences, permissions, and authorizations for my content, brands, trademarks, and other intellectual property." />
        </StackPanel>

        <Border Padding="{DynamicResource Token.Layout.CardPadding}"
                Background="{DynamicResource Token.Color.SurfaceSubtle}"
                BorderBrush="{DynamicResource Token.Color.Warning}"
                BorderThickness="{DynamicResource Token.Border.Default}"
                CornerRadius="{DynamicResource Token.Radius.Card}">
          <TextBlock Text="FusionCanvas does not provide legal advice, verify ownership, or guarantee non-infringement. Checking these boxes does not accept Printify or Shopify agreements on your behalf; you remain responsible for reviewing and accepting the provider terms that apply to your accounts and use. Provider links are external and may require internet access."
                     TextWrapping="Wrap"
                     FontSize="{DynamicResource Token.Typography.Caption}"
                     Foreground="{DynamicResource Token.Color.TextSecondary}" />
        </Border>
      </StackPanel>
    </ScrollViewer>

    <TextBlock Grid.Row="2"
               Margin="{DynamicResource Token.Layout.ValidationMessage}"
               IsVisible="{Binding HasError}"
               Text="{Binding ErrorMessage}"
               TextWrapping="Wrap"
               Foreground="{DynamicResource Token.Color.Error}"
               AutomationProperties.Name="Consent error" />

    <Grid Grid.Row="3"
          ColumnDefinitions="*,Auto,Auto"
          ColumnSpacing="{DynamicResource Token.Spacing.ControlGap}">
      <ProgressBar Grid.Column="0"
                   IsVisible="{Binding IsSaving}"
                   IsIndeterminate="True"
                   VerticalAlignment="Center"
                   Height="{DynamicResource Token.Control.ProgressHeight}"
                   AutomationProperties.Name="Saving acknowledgement" />
      <Button Grid.Column="1"
              Content="Quit FusionCanvas"
              Command="{Binding QuitCommand}"
              AutomationProperties.Name="Quit FusionCanvas" />
      <Button Grid.Column="2"
              Content="Agree and continue"
              Command="{Binding AgreeCommand}"
              IsEnabled="{Binding CanAgree}"
              Classes="primary"
              AutomationProperties.Name="Agree and continue" />
    </Grid>
  </Grid>
  <Window.Styles>
    <Style Selector="Button.primary">
      <Setter Property="Padding" Value="{DynamicResource Token.Control.ButtonPadding}" />
      <Setter Property="Background" Value="{DynamicResource Token.Color.AccentStrong}" />
      <Setter Property="Foreground" Value="{DynamicResource Token.Color.OnAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Token.Color.AccentStrong}" />
      <Setter Property="BorderThickness" Value="{DynamicResource Token.Border.Default}" />
    </Style>
  </Window.Styles>
</Window>
