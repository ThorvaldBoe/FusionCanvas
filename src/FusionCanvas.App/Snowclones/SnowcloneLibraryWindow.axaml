<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:snowclones="using:FusionCanvas.App.Snowclones"
        xmlns:appSnowclones="using:FusionCanvas.Application.Snowclones"
        x:Class="FusionCanvas.App.Snowclones.SnowcloneLibraryWindow"
        x:DataType="snowclones:SnowcloneLibraryViewModel"
        Title="Snowclone Library"
        Width="920"
        Height="650"
        MinWidth="700"
        MinHeight="500"
        Background="{DynamicResource ApplicationBackgroundBrush}">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="{DynamicResource Token.Layout.Margin.Uniform.Wide}">
    <StackPanel Grid.Row="0" Spacing="{DynamicResource Token.Spacing.CompactGap}" Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_None.Right_None.Bottom_Section}">
      <TextBlock Text="Snowclone Library"
                 FontSize="{DynamicResource Token.Typography.PageHeading}"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource StrongTextBrush}" />
      <TextBlock Text="Maintain reusable phrase structures and guidance for future ideation."
                 FontSize="{DynamicResource Token.Typography.Caption}"
                 Foreground="{DynamicResource SecondaryTextBrush}" />
    </StackPanel>

    <Grid Grid.Row="1"
          ColumnDefinitions="*,Auto,Auto,Auto"
          ColumnSpacing="{DynamicResource Token.Spacing.ControlGap}"
          Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_None.Right_None.Bottom_Section}">
      <TextBox x:Name="SearchBox"
               Grid.Column="0"
               Text="{Binding SearchText}"
               PlaceholderText="Search phrase or guidance"
               Classes="field" />
      <Button Grid.Column="1"
              Content="Import CSV…"
              Command="{Binding ImportCommand}"
              IsEnabled="{Binding CanMutate}"
              Classes="secondary" />
      <Button Grid.Column="2"
              Content="Export CSV…"
              Command="{Binding ExportCommand}"
              IsEnabled="{Binding !IsBusy}"
              Classes="secondary" />
      <Button Grid.Column="3"
              Content="Import bundled library"
              Command="{Binding ImportBundledCommand}"
              IsEnabled="{Binding CanMutate}"
              Classes="secondary" />
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="300,*" ColumnSpacing="{DynamicResource Token.Spacing.Gap.SectionPlus}">
      <Border Grid.Column="0"
              Padding="{DynamicResource Token.Layout.Padding.Uniform.Panel}"
              Background="{DynamicResource PanelSurfaceBrush}"
              BorderBrush="{DynamicResource ControlBorderBrush}"
              BorderThickness="1"
              CornerRadius="6">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Grid.Row="0"
                     Text="Phrases"
                     FontSize="{DynamicResource Token.Typography.Body}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource StrongTextBrush}"
                     Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_None.Right_None.Bottom_Group}" />

          <Grid Grid.Row="1">
            <ScrollViewer>
              <ItemsControl x:Name="SnowcloneList"
                            ItemsSource="{Binding Snowclones}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="appSnowclones:SnowcloneSummary">
                    <Button Content="{Binding Phrase}"
                            Command="{Binding $parent[ItemsControl].DataContext.SelectSnowcloneCommand}"
                            CommandParameter="{Binding}"
                            HorizontalContentAlignment="Left"
                            Classes="listItem" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <StackPanel IsVisible="{Binding IsEmpty}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="{DynamicResource Token.Spacing.CompactGap}">
              <TextBlock Text="No snowclones yet"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource StrongTextBrush}" />
              <TextBlock Text="Create one or import a CSV."
                         FontSize="{DynamicResource Token.Typography.Label}"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>

            <StackPanel IsVisible="{Binding HasNoResults}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="{DynamicResource Token.Spacing.ControlGap}">
              <TextBlock Text="No matching snowclones"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource StrongTextBrush}" />
              <Button Content="Clear search"
                      Command="{Binding ClearSearchCommand}"
                      Classes="secondary" />
            </StackPanel>
          </Grid>

          <Button Grid.Row="2"
                  Content="New snowclone"
                  Command="{Binding NewCommand}"
                  IsEnabled="{Binding CanMutate}"
                  HorizontalAlignment="Left"
                  Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_Group.Right_None.Bottom_None}"
                  Classes="primary" />
        </Grid>
      </Border>

      <Border Grid.Column="1"
              Padding="{DynamicResource Token.Layout.Padding.Uniform.SectionPlus}"
              Background="{DynamicResource ElevatedSurfaceBrush}"
              BorderBrush="{DynamicResource ControlBorderBrush}"
              BorderThickness="1"
              CornerRadius="6">
        <ScrollViewer>
          <StackPanel Spacing="{DynamicResource Token.Spacing.Gap.Panel}">
            <TextBlock Text="Snowclone details"
                       FontSize="{DynamicResource Token.Typography.SubsectionHeading}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource StrongTextBrush}" />

            <TextBlock IsVisible="{Binding !HasSelection}"
                       Text="Select a snowclone or create a new one."
                       Foreground="{DynamicResource SecondaryTextBrush}" />

            <StackPanel IsVisible="{Binding HasSelection}" Spacing="{DynamicResource Token.Spacing.InlineGap}">
              <TextBlock Text="Phrase"
                         FontSize="{DynamicResource Token.Typography.Caption}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <TextBox x:Name="PhraseBox"
                       Text="{Binding Phrase}"
                       PlaceholderText="Example: Easily distracted by {X}"
                       Classes="field" />
            </StackPanel>

            <StackPanel IsVisible="{Binding HasSelection}" Spacing="{DynamicResource Token.Spacing.InlineGap}">
              <TextBlock Text="Guidance"
                         FontSize="{DynamicResource Token.Typography.Caption}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <TextBox x:Name="GuidanceBox"
                       Text="{Binding Guidance}"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MinHeight="150"
                       PlaceholderText="Explain how placeholders should be replaced."
                       Classes="field" />
            </StackPanel>

            <StackPanel IsVisible="{Binding HasSelection}"
                        Orientation="Horizontal"
                        Spacing="{DynamicResource Token.Spacing.ControlGap}">
              <Button Content="Save"
                      Command="{Binding SaveCommand}"
                      IsEnabled="{Binding CanSave}"
                      Classes="primary fixedAction" />
              <Button Content="Delete"
                      Command="{Binding RequestDeleteCommand}"
                      IsEnabled="{Binding CanDelete}"
                      Classes="danger fixedAction" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Spacing="{DynamicResource Token.Spacing.ControlGap}"
                        IsVisible="{Binding IsBusy}">
              <ProgressBar Width="92"
                           Height="3"
                           IsIndeterminate="True"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="Working with snowclones" />
              <TextBlock Text="Working…"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}"
                       IsVisible="{Binding HasError}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DangerTextBrush}" />
            <TextBlock Text="{Binding SummaryMessage}"
                       IsVisible="{Binding HasSummary}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource AccentBrush}" />

            <Border IsVisible="{Binding UnsavedPromptVisible}"
                    Padding="{DynamicResource Token.Layout.Padding.Uniform.Panel}"
                    Background="{DynamicResource WarningBackgroundBrush}"
                    BorderBrush="{DynamicResource WarningBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
              <StackPanel Spacing="{DynamicResource Token.Spacing.ControlGap}">
                <TextBlock Text="{Binding UnsavedPromptMessage}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource StrongTextBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Token.Spacing.ControlGap}">
                  <Button Content="Save"
                          Command="{Binding SaveAndContinueCommand}"
                          Classes="primary fixedAction" />
                  <Button Content="Discard"
                          Command="{Binding DiscardAndContinueCommand}"
                          Classes="danger fixedAction" />
                  <Button Content="Cancel"
                          Command="{Binding CancelPendingCommand}"
                          Classes="secondary fixedAction" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border IsVisible="{Binding DeleteConfirmationVisible}"
                    Padding="{DynamicResource Token.Layout.Padding.Uniform.Panel}"
                    Background="{DynamicResource DangerBackgroundBrush}"
                    BorderBrush="{DynamicResource DangerBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
              <StackPanel Spacing="{DynamicResource Token.Spacing.ControlGap}">
                <TextBlock Text="{Binding DeletePromptMessage}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerTextBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Token.Spacing.ControlGap}">
                  <Button Content="Delete permanently"
                          Command="{Binding ConfirmDeleteCommand}"
                          Classes="danger" />
                  <Button Content="Cancel"
                          Command="{Binding CancelDeleteCommand}"
                          Classes="secondary fixedAction" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Button Grid.Row="3"
            Content="Close"
            Command="{Binding CloseCommand}"
            HorizontalAlignment="Right"
            Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_Section.Right_None.Bottom_None}"
            Classes="secondary fixedAction" />
  </Grid>

  <Window.Styles>
    <Style Selector="Button.primary">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource CommandBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CommandForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CommandBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource DangerStrongBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CommandForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.fixedAction">
      <Setter Property="Width" Value="104" />
    </Style>
    <Style Selector="Button.listItem">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox.field">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Window.Styles>
</Window>
