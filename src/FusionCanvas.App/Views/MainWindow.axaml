<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:doc="clr-namespace:FusionCanvas.App.DocumentWindow"
        xmlns:items="clr-namespace:FusionCanvas.App.Items"
        xmlns:nav="clr-namespace:FusionCanvas.App.Navigation"
        xmlns:stores="clr-namespace:FusionCanvas.App.Stores"
        xmlns:stageTools="clr-namespace:FusionCanvas.App.StageTools"
        xmlns:workspace="clr-namespace:FusionCanvas.App.Workspace"
        xmlns:views="clr-namespace:FusionCanvas.App.Views"
        xmlns:cref="clr-namespace:FusionCanvas.App.ConceptRefinement"
        xmlns:appWorkflowNav="clr-namespace:FusionCanvas.Application.WorkflowNavigation;assembly=FusionCanvas.Application"
        xmlns:appItems="clr-namespace:FusionCanvas.Application.Items;assembly=FusionCanvas.Application"
        xmlns:appGroups="clr-namespace:FusionCanvas.Application.Groups;assembly=FusionCanvas.Application"
        x:Class="FusionCanvas.App.Views.MainWindow"
        x:DataType="views:MainWindowViewModel"
        KeyDown="OnWindowKeyDown"
        Title="FusionCanvas"
        Icon="avares://FusionCanvas.App/Assets/FusionCanvas.ico"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        Background="{DynamicResource ApplicationBackgroundBrush}">
  <Grid x:Name="MainLayoutGrid">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" MinWidth="240" MaxWidth="560" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="*" MinWidth="480" />
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0"
            Background="{DynamicResource ElevatedSurfaceBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="0,0,1,0"
            Padding="18,18,18,0">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <Grid x:Name="NavigationHeader"
              Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="8"
              Margin="0,0,0,18">
          <TextBlock Grid.Column="0"
                     Text="FusionCanvas"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     VerticalAlignment="Center" />
          <Border Grid.Column="1"
                  ToolTip.Tip="Manage workspaces in settings"
                  MinWidth="0"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
              <PathIcon Data="M3,5 H10 L12,7 H21 V19 H3 Z"
                        Width="16" Height="16"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="{Binding Settings.WorkspaceName}"
                         MaxWidth="120"
                         TextTrimming="CharacterEllipsis"
                         FontSize="12"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Button Grid.Column="2"
                  Content="⚙"
                  ToolTip.Tip="Settings"
                  Command="{Binding Settings.OpenCommand}"
                  Classes="iconButton"
                  AutomationProperties.Name="Settings" />
        </Grid>

        <StackPanel Grid.Row="1"
                    Spacing="8"
                    Margin="0,0,0,18">
          <Grid ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="6">
            <TextBlock Text="Stores"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource StrongTextBrush}" />
            <Button Grid.Column="1"
                    Content="{Binding StoreManagement.SelectorToggleGlyph}"
                    ToolTip.Tip="{Binding StoreManagement.SelectorToggleTooltip}"
                    Command="{Binding StoreManagement.ToggleStoreSelectorCommand}"
                    Classes="iconButton" />
            <Button Grid.Column="2"
                    Content="..."
                    ToolTip.Tip="Store actions"
                    AutomationProperties.AutomationId="StoreManagement.Actions"
                    Classes="iconButton">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="Manage stores"
                            AutomationProperties.AutomationId="StoreManagement.OpenEditor"
                            Command="{Binding StoreManagement.OpenStoreEditorCommand}" />
                  <MenuItem Header="Store assets…"
                            Click="OnContextStoreAssets" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </Grid>
          <Button IsVisible="{Binding StoreManagement.IsSelectorCompact}"
                  Content="{Binding StoreManagement.SelectedStore.Name}"
                  Command="{Binding StoreManagement.ToggleStoreSelectorCommand}"
                  Classes="storeSelector selected"
                  HorizontalContentAlignment="Left" />
          <StackPanel IsVisible="{Binding StoreManagement.IsSelectorExpanded}"
                      Spacing="6">
            <ScrollViewer MaxHeight="170"
                          VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding StoreManagement.SelectorStores}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="stores:StoreSelectorEntry">
                    <Button Content="{Binding Name}"
                            Command="{Binding $parent[ItemsControl].DataContext.StoreManagement.SelectStoreCommand}"
                            CommandParameter="{Binding}"
                            Classes="storeSelector"
                            Classes.selected="{Binding IsSelected}"
                            HorizontalContentAlignment="Left" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,12">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
            <Button x:Name="GroupActionsButton"
                    Grid.Column="0"
                    Content="+ New group"
                    ToolTip.Tip="Create a group in the selected niche or group"
                    Command="{Binding WorkspaceTree.BeginCreateCommand}"
                    IsEnabled="{Binding CanCreateGroup}"
                    Classes="storeSecondary" />
            <Button Grid.Column="1"
                    Content="+ New Item"
                    ToolTip.Tip="Capture an Item under the selected topic or default niche"
                    Command="{Binding WorkspaceTree.BeginCreateItemCommand}"
                    IsEnabled="{Binding CanCreateGroup}"
                    Classes="storeSecondary" />
          </Grid>
          <StackPanel Spacing="6">
            <TextBox x:Name="TreeSearchBox"
                     Text="{Binding WorkspaceTree.QueryText}"
                     PlaceholderText="Search names, ideas, notes, tags..."
                     MinHeight="34" />
            <WrapPanel Orientation="Horizontal">
              <Button Content="Clear tags"
                      IsVisible="{Binding WorkspaceTree.IsTagFilterActive}"
                      Command="{Binding WorkspaceTree.ClearTagFiltersCommand}"
                      ToolTip.Tip="Clear the active tag filter"
                      Classes="storeSecondary"
                      HorizontalAlignment="Left"
                      Margin="0,0,6,6" />
              <ComboBox x:Name="StageFilter"
                        SelectedIndex="{Binding WorkspaceTree.StageFilterIndex}"
                        MinWidth="92"
                        MinHeight="34"
                        HorizontalAlignment="Left"
                        ToolTip.Tip="Filter Items by workflow stage"
                        Classes="statusSelector"
                        Margin="0,0,6,6">
                <ComboBoxItem Content="All stages" />
                <ComboBoxItem Content="Idea" />
                <ComboBoxItem Content="Concept" />
                <ComboBoxItem Content="Design" />
                <ComboBoxItem Content="Listing" />
              </ComboBox>
              <ComboBox x:Name="StatusFilter"
                        SelectedIndex="{Binding WorkspaceTree.StatusFilterIndex}"
                        MinWidth="92"
                        MinHeight="34"
                        HorizontalAlignment="Left"
                        ToolTip.Tip="Filter Items by lifecycle status"
                        Classes="statusSelector"
                        Margin="0,0,6,6">
                <ComboBoxItem Content="All statuses" />
                <ComboBoxItem Content="Draft" />
                <ComboBoxItem Content="Published" />
                <ComboBoxItem Content="Paused" />
                <ComboBoxItem Content="Rejected" />
              </ComboBox>
              <ComboBox x:Name="IdeaRatingFilter"
                        SelectedIndex="{Binding WorkspaceTree.IdeaRatingFilterIndex}"
                        MinWidth="110"
                        MinHeight="34"
                        ToolTip.Tip="Filter Items by idea rating"
                        AutomationProperties.Name="Idea rating filter"
                        Classes="statusSelector"
                        Margin="0,0,6,6">
                <ComboBoxItem Content="All ratings" />
                <ComboBoxItem Content="Unrated" />
                <ComboBoxItem Content="★ 1" />
                <ComboBoxItem Content="★ 2" />
                <ComboBoxItem Content="★ 3" />
                <ComboBoxItem Content="★ 4" />
                <ComboBoxItem Content="★ 5" />
              </ComboBox>
              <Button Content="Filters"
                      ToolTip.Tip="Filter by tag, topic scope, or archived work"
                      Command="{Binding WorkspaceTree.ClearFiltersCommand}"
                      Classes="storeSecondary"
                      Classes.active="{Binding WorkspaceTree.HasNonTextFilters}"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,6">
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight"
                          ShowMode="Standard">
                    <Border Width="260" Padding="12">
                      <StackPanel Spacing="10">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Scope" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" />
                          <CheckBox Content="Current topic and below"
                                    IsChecked="{Binding WorkspaceTree.ScopeToCurrentTopic}"
                                    IsEnabled="{Binding WorkspaceTree.CanScopeToCurrentTopic}"
                                    ToolTip.Tip="Limit the tree to the selected niche or group subtree" />
                          <TextBlock IsVisible="{Binding WorkspaceTree.ScopeToCurrentTopic}"
                                     Text="{Binding WorkspaceTree.ScopedTopicName, StringFormat='Current: {0}'}"
                                     FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Separator Margin="0,2" />
                        <StackPanel Spacing="6">
                          <TextBlock Text="Tags" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" />
                          <TextBlock Text="No tags yet in this store."
                                     IsVisible="{Binding !WorkspaceTree.AvailableTags.Count}"
                                     FontSize="11" Foreground="{DynamicResource UnavailableForegroundBrush}" />
                          <ItemsControl ItemsSource="{Binding WorkspaceTree.AvailableTags}"
                                        IsVisible="{Binding WorkspaceTree.AvailableTags.Count}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="nav:TagFilterEntryViewModel">
                                <CheckBox Content="{Binding Name}"
                                          IsChecked="{Binding IsSelected}"
                                          Margin="0,1" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                        <Separator Margin="0,2" />
                        <CheckBox Content="Include archived"
                                  IsChecked="{Binding WorkspaceTree.IncludeArchived}"
                                  ToolTip.Tip="Reveal archived topics and Items with inactive treatment" />
                        <Separator Margin="0,2" />
                        <Button Content="Clear all"
                                HorizontalAlignment="Right"
                                Command="{Binding WorkspaceTree.ClearFiltersCommand}"
                                IsEnabled="{Binding WorkspaceTree.HasActiveFilters}"
                                Classes="storeSecondary" />
                      </StackPanel>
                    </Border>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </WrapPanel>
          </StackPanel>
          <TextBlock Text="{Binding GroupActionStatus}"
                     TextWrapping="Wrap"
                     FontSize="11"
                     Foreground="{DynamicResource SecondaryTextBrush}" />
          <TextBlock Text="{Binding WorkspaceTree.ErrorMessage}"
                     IsVisible="{Binding WorkspaceTree.HasError}"
                     TextWrapping="Wrap"
                     FontSize="11"
                     Foreground="{DynamicResource DangerStrongBrush}"
                     AutomationProperties.AutomationId="WorkspaceTreeError" />
        </StackPanel>

        <Border x:Name="TreeActionsToolbar"
                Grid.Row="3"
                Margin="0,0,0,8">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button x:Name="ExpandCollapseAllButton"
                    Classes="iconButton"
                    Command="{Binding WorkspaceTree.ToggleExpandCollapseAllCommand}"
                    IsEnabled="{Binding WorkspaceTree.CanToggleExpandCollapseAll}"
                    ToolTip.Tip="{Binding WorkspaceTree.ExpandCollapseAllTooltip}"
                    AutomationProperties.Name="{Binding WorkspaceTree.ExpandCollapseAllTooltip}">
              <Grid>
                <PathIcon x:Name="ExpandCollapseAllExpandIcon"
                          Data="M12 5.83 15.17 9l1.41-1.41L12 3 7.41 7.59 8.83 9 12 5.83zm0 12.34L8.83 15l-1.41 1.41L12 21l4.59-4.59L15.17 15 12 18.17z"
                          Width="14" Height="14"
                          Foreground="{DynamicResource SecondaryButtonForegroundBrush}"
                          IsVisible="{Binding WorkspaceTree.NextToggleExpands}" />
                <PathIcon x:Name="ExpandCollapseAllCollapseIcon"
                          Data="M7.41 18.59 8.83 20 12 16.83 15.17 20l1.41-1.41L12 14l-4.59 4.59zm9.18-13.18L15.17 4 12 7.17 8.83 4 7.41 5.41 12 10l4.59-4.59z"
                          Width="14" Height="14"
                          Foreground="{DynamicResource SecondaryButtonForegroundBrush}"
                          IsVisible="{Binding !WorkspaceTree.NextToggleExpands}" />
              </Grid>
            </Button>
          </StackPanel>
        </Border>

        <Border Grid.Row="5"
                Classes="navigationStatusBar"
                Margin="-18,8,-18,0"
                Padding="8,6"
                Background="{DynamicResource PanelSurfaceBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
          <TextBlock Text="{Binding WorkspaceTree.DesignCountLabel}"
                     FontSize="11"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     AutomationProperties.AutomationId="DesignCountLabel" />
        </Border>
        <Grid Grid.Row="4">
          <TreeView x:Name="WorkspaceTreeControl"
                    ItemsSource="{Binding WorkspaceTree.Roots}"
                    Background="Transparent"
                    BorderThickness="0">
            <TreeView.ItemTemplate>
              <TreeDataTemplate x:DataType="nav:WorkspaceTreeNodeViewModel" ItemsSource="{Binding Children}">
                <Border Classes="treeRow"
                        Classes.selected="{Binding IsSelected}"
                        Classes.multiSelected="{Binding IsMultiSelected}"
                        Classes.inactive="{Binding IsInactive}"
                        Classes.cut="{Binding IsCut}"
                        Classes.dropTarget="{Binding IsDropTarget}"
                        Classes.dropBefore="{Binding IsDropBefore}"
                        Classes.dropAfter="{Binding IsDropAfter}"
                        DragDrop.AllowDrop="True"
                        PointerMoved="OnTreeNodePointerMoved"
                        DragDrop.DragOver="OnTreeNodeDragOver"
                        DragDrop.DragLeave="OnTreeNodeDragLeave"
                        DragDrop.Drop="OnTreeNodeDrop"
                        ToolTip.Tip="Click to select; Ctrl-click toggles; Shift-click selects a range; middle-click opens a tab; F2 renames">
                  <Border.ContextMenu>
                    <ContextMenu IsVisible="{Binding HasAssetActions}">
                      <MenuItem Header="Open in new tab"
                                IsVisible="{Binding !HasMultiSelectionContext}"
                                Click="OnContextOpenInTab" />
                      <MenuItem Header="Open in new tabs"
                                IsVisible="{Binding HasMultiSelectionContext}"
                                Click="OnContextOpenSelectedInTabs" />
                      <Separator IsVisible="{Binding HasMultiSelectionContext}" />
                      <MenuItem Header="{Binding SelectionCountLabel}"
                                IsVisible="{Binding HasMultiSelectionContext}"
                                IsEnabled="False" />
                      <MenuItem Header="New group" IsVisible="{Binding IsTopicAndSingleSelection}" Click="OnContextNewGroup" />
                      <MenuItem Header="New Item" IsVisible="{Binding IsSingleSelectionContext}" Click="OnContextNewItem" />
                      <MenuItem Header="Import…" IsVisible="{Binding IsTopicAndSingleSelection}" Click="OnContextImport" />
                      <Separator />
              <MenuItem Header="Rename" IsVisible="{Binding HasContextActionsAndSingleSelection}" Click="OnContextRename" />
              <MenuItem Header="Copy" IsVisible="{Binding HasContextActionsAndSingleSelection}" Click="OnContextCopy" />
              <MenuItem Header="Cut" IsVisible="{Binding HasContextActionsAndSingleSelection}" Click="OnContextCut" />
              <MenuItem Header="Paste" IsVisible="{Binding IsSingleSelectionContext}" IsEnabled="{Binding CanPaste}" Click="OnContextPaste" />
              <MenuItem Header="Duplicate" IsVisible="{Binding IsItemAndSingleSelection}" Click="OnContextDuplicate" />
                      <MenuItem Header="Duplicate" IsVisible="{Binding HasMultiSelectionContext}" Click="OnContextDuplicateSelected" />
                      <MenuItem Header="Export" IsVisible="{Binding HasMultiSelectionContext}" Click="OnContextExportSelected" />
                      <MenuItem Header="Group" IsVisible="{Binding HasMultiSelectionContext}" Click="OnContextGroupSelected" />
                      <MenuItem Header="Archive" IsVisible="{Binding HasMultiSelectionContext}" Click="OnContextArchiveSelected" />
                      <MenuItem Header="Delete" IsVisible="{Binding HasMultiSelectionContext}" Click="OnContextDeleteSelected" />
              <MenuItem Header="Assets…" IsVisible="{Binding IsSingleSelectionContext}" Click="OnContextAssets" />
              <MenuItem Header="Export to CSV..." IsVisible="{Binding IsTopicAndSingleSelection}" Click="OnContextExport" />
                      <Separator />
                      <MenuItem Header="Delete..." IsVisible="{Binding IsGroupAndSingleSelection}" Click="OnContextDelete" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <Grid ColumnDefinitions="3,22,*,Auto" MinHeight="34">
                    <Border Grid.Column="0" Background="{DynamicResource AccentBrush}" CornerRadius="2" />
                    <TextBlock Grid.Column="1" Text="{Binding Icon}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource TreeIconForegroundBrush}" />
                    <Grid Grid.Column="2" Margin="4,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   IsVisible="{Binding !IsEditing}"
                                   TextTrimming="CharacterEllipsis" />
                        <ItemsControl IsVisible="{Binding HasAppliedTags}"
                                      ItemsSource="{Binding VisibleTagColorSequence}"
                                      Margin="6,0,0,0">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="3" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <Border Width="10" Height="10"
                                      CornerRadius="5"
                                      Background="{Binding Converter={x:Static nav:TagBrushConverter.Background}, FallbackValue='#F0F2F5'}"
                                      BorderBrush="{Binding Converter={x:Static nav:TagBrushConverter.Border}, FallbackValue='#D9DEE7'}"
                                      BorderThickness="1"
                                      ToolTip.Tip="Item has this tag applied" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border IsVisible="{Binding HasHiddenTags}"
                                Padding="4,0"
                                CornerRadius="6"
                                Background="{DynamicResource CountBadgeBackgroundBrush}">
                          <TextBlock Text="{Binding HiddenTagLabel}" FontSize="10" Foreground="{DynamicResource TreeIconForegroundBrush}" />
                        </Border>
                      </StackPanel>
                      <TextBox Text="{Binding DraftName}"
                               IsVisible="{Binding IsEditing}"
                               AttachedToVisualTree="OnTreeEditorAttached"
                               KeyDown="OnTreeEditorKeyDown"
                               LostFocus="OnTreeEditorLostFocus"
                               MinHeight="28"
                               Padding="5,2" />
                    </Grid>
                    <Border Grid.Column="3" IsVisible="{Binding HasChildren}" Padding="5,1" CornerRadius="8" Background="{DynamicResource CountBadgeBackgroundBrush}">
                      <TextBlock Text="{Binding CountLabel}" FontSize="10" Foreground="{DynamicResource TreeIconForegroundBrush}" />
                    </Border>
                  </Grid>
                </Border>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
          <Border IsVisible="{Binding WorkspaceTree.HasEmptyFilterResults}"
                  Background="{DynamicResource PanelSurfaceBrush}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        MaxWidth="220">
              <TextBlock Text="Nothing matches the current filters."
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         Foreground="{DynamicResource TreeIconForegroundBrush}"
                         FontSize="12" />
              <Button Content="Clear filters"
                      HorizontalAlignment="Center"
                      Command="{Binding WorkspaceTree.ClearFiltersCommand}"
                      Classes="storeSecondary" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Border>

    <GridSplitter Grid.Column="1"
                  ResizeDirection="Columns"
                  Background="Transparent"
                  Cursor="SizeWestEast"
                  ToolTip.Tip="Drag to resize navigation"
                  AutomationProperties.Name="Resize navigation panel" />

    <Grid Grid.Column="2"
          RowDefinitions="Auto,Auto,*">
      <Border Grid.Row="0"
              Background="{DynamicResource TabBarBackgroundBrush}"
              BorderBrush="{DynamicResource ControlBorderBrush}"
              BorderThickness="0,0,0,1"
              Height="40"
              Padding="6,5,6,0">
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding DocumentWindow.Tabs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="doc:DocumentTabViewModel">
                <Border Classes.active="{Binding IsActive}"
                        Classes="tabFrame">
                  <Grid ColumnDefinitions="*,26"
                        MinWidth="120"
                        MaxWidth="224">
                    <Button Grid.Column="0"
                            Command="{Binding $parent[ItemsControl].DataContext.RequestSelectTabCommand}"
                            CommandParameter="{Binding}"
                            Classes="tab"
                            Classes.active="{Binding IsActive}">
                      <TextBlock Text="{Binding Title}"
                                 TextTrimming="CharacterEllipsis"
                                 MaxLines="1"
                                 VerticalAlignment="Center" />
                    </Button>
                    <Button Grid.Column="1"
                            Content="×"
                            Command="{Binding $parent[ItemsControl].DataContext.RequestCloseTabCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="Close tab"
                            Classes="closeTab" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <Border Grid.Row="1"
              IsVisible="{Binding WorkflowNavigator.HasActiveItem}"
              Padding="20,14"
              Background="{DynamicResource ElevatedSurfaceBrush}"
              BorderBrush="{DynamicResource ControlBorderBrush}"
              BorderThickness="0,0,0,1">
        <StackPanel Spacing="10">
          <ItemsControl ItemsSource="{Binding WorkflowNavigator.Stages}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="appWorkflowNav:WorkflowStageNavigatorEntry">
                <Button Content="{Binding Label}"
                        IsEnabled="{Binding CanNavigate}"
                        Command="{Binding $parent[ItemsControl].DataContext.SelectWorkflowStageCommand}"
                        CommandParameter="{Binding Stage}"
                        Classes.current="{Binding IsCurrent}"
                        Classes.available="{Binding IsAvailable}"
                        Classes.unavailable="{Binding !IsAvailable}"
                        Classes.activeView="{Binding IsActiveView}"
                        Padding="14,8"
                        MinWidth="88" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock IsVisible="{Binding WorkflowNavigator.ShowsInactiveState}"
                     Text="{Binding WorkflowNavigator.InactiveLabel}"
                     FontSize="12"
                     Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>
      </Border>

      <Border Grid.Row="2"
              Margin="20"
              Padding="24"
              Background="{DynamicResource ElevatedSurfaceBrush}"
              BorderBrush="{DynamicResource ControlBorderBrush}"
              BorderThickness="1">
        <Grid>
          <ScrollViewer IsVisible="{Binding DocumentWindow.HasActiveDocument}"
                        VerticalScrollBarVisibility="Auto"
                        Padding="0,0,16,0">
            <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                  ColumnSpacing="8">
              <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Text="{Binding DocumentWindow.ActiveDetailTitle}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="{Binding DocumentWindow.ActiveNavigationPath}"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Text="{Binding IdeationUnavailableMessage}"
                           IsVisible="{Binding IdeationUnavailableMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource DangerTextBrush}" />
              </StackPanel>
              <Button x:Name="IdeationButton"
                      Grid.Column="3"
                      IsVisible="{Binding IsIdeationActionVisible}"
                      IsEnabled="{Binding CanOpenIdeation}"
                      Command="{Binding OpenIdeationCommand}"
                      Content="Ideation…"
                      Margin="0,0,12,0"
                      AutomationProperties.Name="Open Ideation"
                      ToolTip.Tip="{Binding IdeationUnavailableMessage}"
                      VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         IsVisible="{Binding ItemInspector.HasState}"
                         Text="{Binding ItemInspector.StageLabel}"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentBrush}"
                         VerticalAlignment="Center" />
              <ComboBox Grid.Column="2"
                         IsVisible="{Binding HasActiveItem}"
                         ItemsSource="{Binding AvailableItemStatusOptions}"
                         SelectedItem="{Binding SelectedItemStatusOption}"
                         PlaceholderText="{Binding SelectedItemStatusLabel}"
                         MinWidth="120"
                         VerticalAlignment="Center"
                         AutomationProperties.Name="Item lifecycle status"
                         ToolTip.Tip="Lifecycle status"
                         Classes="statusSelector">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="views:ItemStatusOptionViewModel">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
            <Border MinHeight="360"
                    Padding="22"
                    Background="{DynamicResource PanelSurfaceBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    IsVisible="{Binding ShowStageToolHost}">
              <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      Margin="0,0,0,12">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding DocumentWindow.ActiveStageToolName}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource StrongTextBrush}" />
                    <TextBlock Text="{Binding DocumentWindow.ActiveStageToolDescription}"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                  </StackPanel>
                  <ItemsControl Grid.Column="1"
                                IsVisible="{Binding DocumentWindow.HasMultipleStageTools}"
                                ItemsSource="{Binding DocumentWindow.AvailableStageTools}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="doc:StageToolOptionViewModel">
                        <Button Content="{Binding DisplayName}"
                                Command="{Binding $parent[ItemsControl].DataContext.DocumentWindow.SelectStageToolCommand}"
                                CommandParameter="{Binding}"
                                Classes="toolSelector" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>

                <StackPanel Grid.Row="1"
                            Spacing="8">
                  <TextBlock Text="{Binding DocumentWindow.ActiveWorkflowStageLabel}"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource StrongTextBrush}" />
                  <TextBlock Text="{Binding DocumentWindow.ActiveDetailViewKey}"
                             FontSize="13"
                             Foreground="{DynamicResource SecondaryTextBrush}" />
                <Border Margin="0,10,0,0"
                        Padding="12"
                        Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding DocumentWindow.ActiveToolScopeLabel}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource StrongTextBrush}" />
                    <TextBlock Text="{Binding DocumentWindow.ActiveToolScopeDescription}"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock IsVisible="{Binding !DocumentWindow.CanRunActiveTool}"
                               Text="{Binding DocumentWindow.ActiveToolUnavailableMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource DangerTextBrush}" />
                    <TextBlock IsVisible="{Binding !DocumentWindow.CanRunActiveTool}"
                               Text="{Binding DocumentWindow.ActiveStageToolUnavailableMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource DangerTextBrush}" />
                  </StackPanel>
                </Border>
                </StackPanel>
              </Grid>
            </Border>

            <Border IsVisible="{Binding ItemInspector.HasState}"
                    MinHeight="360"
                    Padding="22"
                    Background="{DynamicResource PanelSurfaceBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="14">
                  <TextBlock IsVisible="{Binding ItemInspector.IsReadOnly}"
                             Text="{Binding ItemInspector.InactiveNotice}"
                             TextWrapping="Wrap"
                             FontSize="12"
                             Foreground="{DynamicResource DangerTextBrush}" />
                  <TextBlock Text="{Binding ItemInspector.DisplayPath}"
                             FontSize="12"
                             Foreground="{DynamicResource SecondaryTextBrush}" />

                  <Border Padding="14"
                          Background="{DynamicResource ElevatedSurfaceBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Overview"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource StrongTextBrush}" />
                      <StackPanel Spacing="6">
                        <TextBlock Text="Working title"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBox Grid.Column="0"
                                   Text="{Binding ItemInspector.Title}"
                                   IsReadOnly="{Binding !ItemInspector.CanEditShared}"
                                   MinHeight="32"
                                   PlaceholderText="Optional working title"
                                   AutomationProperties.Name="Item working title"
                                   LostFocus="OnDetailsFieldLostFocus" />
                          <Border Grid.Column="1"
                                  Margin="8,0,0,0"
                                  Background="Transparent"
                                  ToolTip.Tip="{Binding ItemInspector.OptimizeGuidance}">
                            <Button Padding="12,6"
                                    Content="Optimize"
                                    Command="{Binding ItemInspector.OptimizeCommand}"
                                    IsEnabled="{Binding ItemInspector.CanOptimize}"
                                    AutomationProperties.Name="Optimize title" />
                          </Border>
                        </Grid>
                      </StackPanel>
                      <StackPanel Spacing="4">
                        <TextBlock Text="Idea potential"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="2"
                                    AutomationProperties.Name="{Binding ItemInspector.IdeaRatingLabel}">
                          <TextBlock Text="★" Classes="ideaRatingStar" Classes.selected="{Binding ItemInspector.IsIdeaRatingStar1Selected}" />
                          <TextBlock Text="★" Classes="ideaRatingStar" Classes.selected="{Binding ItemInspector.IsIdeaRatingStar2Selected}" />
                          <TextBlock Text="★" Classes="ideaRatingStar" Classes.selected="{Binding ItemInspector.IsIdeaRatingStar3Selected}" />
                          <TextBlock Text="★" Classes="ideaRatingStar" Classes.selected="{Binding ItemInspector.IsIdeaRatingStar4Selected}" />
                          <TextBlock Text="★" Classes="ideaRatingStar" Classes.selected="{Binding ItemInspector.IsIdeaRatingStar5Selected}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="2">
                          <Button Content="★" Command="{Binding ItemInspector.SetIdeaRatingCommand}" CommandParameter="1" IsEnabled="{Binding ItemInspector.CanEditShared}" ToolTip.Tip="Rate 1 star" AutomationProperties.Name="Rate 1 star" />
                          <Button Content="★" Command="{Binding ItemInspector.SetIdeaRatingCommand}" CommandParameter="2" IsEnabled="{Binding ItemInspector.CanEditShared}" ToolTip.Tip="Rate 2 stars" AutomationProperties.Name="Rate 2 stars" />
                          <Button Content="★" Command="{Binding ItemInspector.SetIdeaRatingCommand}" CommandParameter="3" IsEnabled="{Binding ItemInspector.CanEditShared}" ToolTip.Tip="Rate 3 stars" AutomationProperties.Name="Rate 3 stars" />
                          <Button Content="★" Command="{Binding ItemInspector.SetIdeaRatingCommand}" CommandParameter="4" IsEnabled="{Binding ItemInspector.CanEditShared}" ToolTip.Tip="Rate 4 stars" AutomationProperties.Name="Rate 4 stars" />
                          <Button Content="★" Command="{Binding ItemInspector.SetIdeaRatingCommand}" CommandParameter="5" IsEnabled="{Binding ItemInspector.CanEditShared}" ToolTip.Tip="Rate 5 stars" AutomationProperties.Name="Rate 5 stars" />
                          <Button Content="Clear" Command="{Binding ItemInspector.SetIdeaRatingCommand}" CommandParameter="0" IsEnabled="{Binding ItemInspector.CanEditShared}" ToolTip.Tip="Clear idea rating" AutomationProperties.Name="Clear idea rating" />
                          <TextBlock Text="{Binding ItemInspector.IdeaRatingLabel}" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border Padding="14"
                          Background="{DynamicResource ElevatedSurfaceBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6"
                          IsVisible="{Binding ShowsIdeaStageTool}"
                          Classes.emphasized="{Binding ItemInspector.EmphasizesIdea}">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Idea"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource StrongTextBrush}" />
                      <TextBox Text="{Binding ItemInspector.Idea}"
                               IsReadOnly="{Binding !ItemInspector.CanEditStage}"
                               AcceptsReturn="True"
                               MinHeight="64"
                               PlaceholderText="What is the original product idea?"
                               AutomationProperties.Name="Original idea"
                               LostFocus="OnDetailsFieldLostFocus" />
                      <TextBlock IsVisible="{Binding !ItemInspector.CanEditStage}"
                                 Text="{Binding ItemInspector.StageReadOnlyReason}"
                                 TextWrapping="Wrap"
                                 FontSize="12"
                                 Foreground="{DynamicResource DangerTextBrush}" />
                    </StackPanel>
                  </Border>

                  <Border Padding="14"
                          Background="{DynamicResource ElevatedSurfaceBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6"
                          IsVisible="{Binding ShowsConceptStageTool}"
                          Classes.emphasized="{Binding ItemInspector.EmphasizesConcept}">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Concept"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource StrongTextBrush}" />
                      <TextBlock Text="Base idea"
                                 FontSize="11"
                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBox Text="{Binding ItemInspector.Idea}"
                               IsReadOnly="True"
                               AcceptsReturn="True"
                               MinHeight="64"
                               AutomationProperties.Name="Base idea" />
                      <TextBlock IsVisible="{Binding !ItemInspector.CanEditStage}"
                                 Text="{Binding ItemInspector.StageReadOnlyReason}"
                                 TextWrapping="Wrap"
                                 FontSize="12"
                                 Foreground="{DynamicResource DangerTextBrush}" />

                      <TextBlock Text="{Binding ConceptRefinement.UnavailableReason}"
                                 IsVisible="{Binding ConceptRefinement.UnavailableReason, Converter={x:Static ObjectConverters.IsNotNull}}"
                                 TextWrapping="Wrap"
                                 FontSize="11"
                                 Foreground="{DynamicResource DangerTextBrush}" />

                      <!-- VR-001: Inline error -->
                      <TextBlock Text="{Binding ConceptRefinement.ErrorMessage}"
                                 IsVisible="{Binding ConceptRefinement.HasError}"
                                 TextWrapping="Wrap"
                                 FontSize="11"
                                 Foreground="{DynamicResource DangerTextBrush}" />

                      <!-- Initialize button -->
                      <Button Content="Initialize from base idea&#x2026;"
                              IsEnabled="{Binding ConceptRefinement.CanInitialize}"
                              IsVisible="{Binding ShowsConceptStageTool}"
                              AutomationProperties.Name="Initialize from base idea"
                              Command="{Binding ConceptRefinement.InitializeCommand}"
                              ToolTip.Tip="{Binding ConceptRefinement.InitializeDisabledReason}"
                              ToolTip.ShowOnDisabled="True" />

                      <!-- VR-009: Visible guidance when Initialize is disabled -->
                      <TextBlock Text="{Binding ConceptRefinement.InitializeDisabledReason}"
                                 IsVisible="{Binding ConceptRefinement.InitializeDisabledReason, Converter={x:Static ObjectConverters.IsNotNull}}"
                                 TextWrapping="Wrap"
                                 FontSize="11"
                                 Foreground="{DynamicResource DangerTextBrush}" />

                      <!-- Per-corner action rows -->
      <Grid RowDefinitions="Auto,Auto,Auto"
            ColumnDefinitions="Auto,*,Auto,Auto"
            RowSpacing="6"
            ColumnSpacing="4"
            IsVisible="{Binding ShowsConceptStageTool}">
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Concept idea:"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Top" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Text="{Binding ConceptRefinement.ConceptIdeaInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding !ItemInspector.CanEditStage}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="72"
                                 VerticalContentAlignment="Top"
                                 AutomationProperties.Name="Refinement Concept idea input"
                                 LostFocus="OnDetailsFieldLostFocus" />
                        <Button Grid.Row="0"
                                Grid.Column="2"
                                Content="Fine tune"
                                VerticalAlignment="Top"
                                IsEnabled="{Binding ConceptRefinement.CanFineTuneConceptIdea}"
                                Command="{Binding ConceptRefinement.FineTuneConceptIdeaCommand}"
                                AutomationProperties.Name="Fine tune Concept idea"
                                ToolTip.Tip="{Binding ConceptRefinement.FineTuneConceptIdeaDisabledReason}"
                                ToolTip.ShowOnDisabled="True" />
                        <Button Grid.Row="0"
                                Grid.Column="3"
                                Content="Change"
                                VerticalAlignment="Top"
                                IsEnabled="{Binding ConceptRefinement.CanChangeConceptIdea}"
                                Command="{Binding ConceptRefinement.ChangeConceptIdeaCommand}"
                                AutomationProperties.Name="Change Concept idea"
                                ToolTip.Tip="{Binding ConceptRefinement.ChangeConceptIdeaDisabledReason}"
                                ToolTip.ShowOnDisabled="True" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="2"
                                 Grid.ColumnSpan="2"
                                 Text="{Binding ConceptRefinement.ConceptIdeaInstructions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding !ItemInspector.CanEditStage}"
                                 PlaceholderText="Instructions"
                                 VerticalAlignment="Bottom"
                                 AutomationProperties.Name="Instructions for Concept idea" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Phrase:"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Top" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Text="{Binding ConceptRefinement.PhraseInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding !ItemInspector.CanEditStage}"
                                 AcceptsReturn="False"
                                 TextWrapping="Wrap"
                                 MinHeight="72"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.Name="Refinement Phrase input"
                                 LostFocus="OnDetailsFieldLostFocus" />
                        <Button Grid.Row="1"
                                Grid.Column="2"
                                Content="Fine tune"
                                VerticalAlignment="Top"
                                IsEnabled="{Binding ConceptRefinement.CanFineTunePhrase}"
                                Command="{Binding ConceptRefinement.FineTunePhraseCommand}"
                                AutomationProperties.Name="Fine tune Phrase"
                                ToolTip.Tip="{Binding ConceptRefinement.FineTunePhraseDisabledReason}"
                                ToolTip.ShowOnDisabled="True" />
                        <Button Grid.Row="1"
                                Grid.Column="3"
                                Content="Change"
                                VerticalAlignment="Top"
                                IsEnabled="{Binding ConceptRefinement.CanChangePhrase}"
                                Command="{Binding ConceptRefinement.ChangePhraseCommand}"
                                AutomationProperties.Name="Change Phrase"
                                ToolTip.Tip="{Binding ConceptRefinement.ChangePhraseDisabledReason}"
                                ToolTip.ShowOnDisabled="True" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="2"
                                 Grid.ColumnSpan="2"
                                 Text="{Binding ConceptRefinement.PhraseInstructions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding !ItemInspector.CanEditStage}"
                                 PlaceholderText="Instructions"
                                 VerticalAlignment="Bottom"
                                 AutomationProperties.Name="Instructions for Phrase" />

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Graphic:"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Top" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding ConceptRefinement.GraphicDirectionInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding !ItemInspector.CanEditStage}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="72"
                                 VerticalContentAlignment="Top"
                                 AutomationProperties.Name="Refinement Graphic direction input"
                                 LostFocus="OnDetailsFieldLostFocus" />
                        <Button Grid.Row="2"
                                Grid.Column="2"
                                Content="Fine tune"
                                VerticalAlignment="Top"
                                IsEnabled="{Binding ConceptRefinement.CanFineTuneGraphicDirection}"
                                Command="{Binding ConceptRefinement.FineTuneGraphicDirectionCommand}"
                                AutomationProperties.Name="Fine tune Graphic direction"
                                ToolTip.Tip="{Binding ConceptRefinement.FineTuneGraphicDirectionDisabledReason}"
                                ToolTip.ShowOnDisabled="True" />
                        <Button Grid.Row="2"
                                Grid.Column="3"
                                Content="Change"
                                VerticalAlignment="Top"
                                IsEnabled="{Binding ConceptRefinement.CanChangeGraphicDirection}"
                                Command="{Binding ConceptRefinement.ChangeGraphicDirectionCommand}"
                                AutomationProperties.Name="Change Graphic direction"
                                ToolTip.Tip="{Binding ConceptRefinement.ChangeGraphicDirectionDisabledReason}"
                                ToolTip.ShowOnDisabled="True" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="2"
                                 Grid.ColumnSpan="2"
                                 Text="{Binding ConceptRefinement.GraphicDirectionInstructions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding !ItemInspector.CanEditStage}"
                                 PlaceholderText="Instructions"
                                 VerticalAlignment="Bottom"
                                 AutomationProperties.Name="Instructions for Graphic direction" />
                      </Grid>

                      <!-- Score -->
                      <TextBlock IsVisible="{Binding ShowsConceptStageTool}"
                                 FontSize="11"
                                 Foreground="{DynamicResource SecondaryTextBrush}">
                        <Run Text="Triangle completeness: " />
                        <Run Text="{Binding ConceptRefinement.Score}" />
                        <Run Text="%" />
                      </TextBlock>

                      <!-- VR-007c: Busy indicator -->
                      <TextBlock Text="Refinement in progress&#x2026;"
                                 IsVisible="{Binding ConceptRefinement.IsBusy}"
                                 FontSize="11"
                                 Foreground="{DynamicResource SecondaryTextBrush}" />

                      <!-- VR-007a/007d: History list, hidden when empty, disabled in read-only -->
                      <ListBox ItemsSource="{Binding ConceptRefinement.History}"
                               IsVisible="{Binding ConceptRefinement.HasHistory}"
                               IsEnabled="{Binding ItemInspector.CanEditStage}"
                               MaxHeight="160"
                               ScrollViewer.VerticalScrollBarVisibility="Auto"
                               SelectionMode="Single"
                               SelectedItem="{Binding ConceptRefinement.SelectedHistoryEntry, Mode=TwoWay}"
                               SelectedIndex="{Binding ConceptRefinement.CurrentEntryIndex, Mode=OneWay}">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="cref:ConceptRefinementHistoryEntry">
                            <TextBlock Text="{Binding Label}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis" />
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>

                      <!-- SLL generation section -->
                      <Separator Margin="0,4"
                                 IsVisible="{Binding ShowsConceptStageTool}" />
                      <TextBlock Text="Generate SLL sketch"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource StrongTextBrush}"
                                 IsVisible="{Binding ShowsConceptStageTool}" />
                      <TextBlock Text="{Binding SllGeneration.UnavailableReason}"
                                 IsVisible="{Binding SllGeneration.UnavailableReason, Converter={x:Static ObjectConverters.IsNotNull}}"
                                 TextWrapping="Wrap"
                                 FontSize="11"
                                 Foreground="{DynamicResource DangerTextBrush}" />

                      <TextBlock Text="{Binding SllGeneration.ErrorMessage}"
                                 IsVisible="{Binding SllGeneration.HasError}"
                                 TextWrapping="Wrap"
                                 FontSize="11"
                                 Foreground="{DynamicResource DangerTextBrush}" />

                      <Button Content="Generate SLL&#x2026;"
                              IsEnabled="{Binding SllGeneration.CanGenerate}"
                              IsVisible="{Binding ShowsConceptStageTool}"
                              AutomationProperties.Name="Generate SLL sketch"
                              Command="{Binding SllGeneration.GenerateCommand}"
                              ToolTip.Tip="{Binding SllGeneration.GenerateDisabledReason}"
                              ToolTip.ShowOnDisabled="True" />

                      <Button Content="Regenerate SLL&#x2026;"
                              IsEnabled="{Binding SllGeneration.CanRegenerate}"
                              IsVisible="{Binding ShowsConceptStageTool}"
                              AutomationProperties.Name="Regenerate SLL sketch"
                              Command="{Binding SllGeneration.RegenerateCommand}"
                              ToolTip.Tip="{Binding SllGeneration.RegenerateDisabledReason}"
                              ToolTip.ShowOnDisabled="True" />

                      <TextBlock Text="SLL generation in progress&#x2026;"
                                 IsVisible="{Binding SllGeneration.IsBusy}"
                                 FontSize="11"
                                 Foreground="{DynamicResource SecondaryTextBrush}" />

                      <TextBlock Text="This sketch is stale — complete the triangle to regenerate."
                                 IsVisible="{Binding SllGeneration.IsStale}"
                                 TextWrapping="Wrap"
                                 FontSize="11"
                                 Foreground="{DynamicResource WarningTextBrush}" />

                      <TextBox Text="{Binding SllGeneration.AsciiSketch}"
                               IsReadOnly="True"
                               IsVisible="{Binding SllGeneration.HasCurrentSll}"
                               AcceptsReturn="True"
                               TextWrapping="NoWrap"
                               FontFamily="Consolas,Menlo,monospace"
                               FontSize="11"
                               MinHeight="120"
                               AutomationProperties.Name="Generated SLL sketch"
                               ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                     </StackPanel>
                  </Border>

                  <Border Padding="14"
                          Background="{DynamicResource ElevatedSurfaceBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Notes"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource StrongTextBrush}" />
                      <TextBox Text="{Binding ItemInspector.Notes}"
                               IsReadOnly="{Binding !ItemInspector.CanEditShared}"
                               AcceptsReturn="True"
                               MinHeight="80"
                               PlaceholderText="Plain-text notes"
                               AutomationProperties.Name="Item notes"
                               LostFocus="OnDetailsFieldLostFocus" />
                    </StackPanel>
                  </Border>

                  <Border Padding="14"
                          Background="{DynamicResource ElevatedSurfaceBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Tags"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource StrongTextBrush}" />
                      <ItemsControl ItemsSource="{Binding ItemInspector.TagDraft}">
                        <ItemsControl.ItemContainerTheme>
                          <ControlTheme TargetType="ContentPresenter">
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                          </ControlTheme>
                        </ItemsControl.ItemContainerTheme>
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <Border Padding="8,3"
                                    CornerRadius="10"
                                    Background="{DynamicResource AccentSoftBackgroundBrush}"
                                    BorderBrush="{DynamicResource AccentSoftBorderBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,6,6"
                                    HorizontalAlignment="Left">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding}"
                                           FontSize="12"
                                           Foreground="{DynamicResource AccentSoftForegroundBrush}"
                                           VerticalAlignment="Center" />
                                <Button Content="×"
                                        Padding="0"
                                        Width="18"
                                        Height="18"
                                        FontSize="13"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource AccentSoftForegroundBrush}"
                                        ToolTip.Tip="Remove tag"
                                        Command="{Binding $parent[ItemsControl].DataContext.ItemInspector.RemoveTagCommand}"
                                        CommandParameter="{Binding}" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock IsVisible="{Binding !ItemInspector.HasTags}"
                                 Text="No tags yet."
                                 FontSize="12"
                                 Foreground="{DynamicResource MutedTextBrush}" />
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Text="{Binding ItemInspector.TagInput}"
                                 IsEnabled="{Binding ItemInspector.CanEditShared}"
                                 MinHeight="32"
                                 PlaceholderText="Add a tag" />
                        <Button Grid.Column="1"
                                Content="Add"
                                IsEnabled="{Binding ItemInspector.CanEditShared}"
                                Command="{Binding ItemInspector.AddTagCommand}"
                                Classes="storeSecondary" />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Border IsVisible="{Binding ShowsDesignStageTool}"
                          Padding="14"
                          Background="{DynamicResource ElevatedSurfaceBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6"
                          Classes.emphasized="{Binding ItemInspector.EmphasizesDesign}">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Design"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource StrongTextBrush}" />

                      <!-- Read-only banner -->
                      <TextBlock IsVisible="{Binding DesignTool.IsReadOnly}"
                                 Text="{Binding DesignTool.ReadOnlyReason}"
                                 TextWrapping="Wrap"
                                 FontSize="12"
                                 Foreground="{DynamicResource DangerTextBrush}" />

                      <!-- Configuration -->
                      <TextBlock Text="Listing Configuration"
                                 FontSize="13" FontWeight="SemiBold"
                                 Foreground="{DynamicResource StrongTextBrush}" />

                      <StackPanel IsVisible="{Binding !DesignTool.HasConfiguration}" Spacing="8">
                        <TextBlock Text="Select a listing configuration to show the design slot grid."
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <ComboBox ItemsSource="{Binding DesignTool.AvailableOfferings}"
                                  DisplayMemberBinding="{Binding Name}"
                                  SelectedItem="{Binding DesignTool.SelectedOffering}"
                                  IsEnabled="{Binding !DesignTool.IsReadOnly}"
                                  AutomationProperties.Name="Select configuration" />
                      </StackPanel>

                      <StackPanel IsVisible="{Binding DesignTool.HasConfiguration}" Spacing="4">
                        <ComboBox ItemsSource="{Binding DesignTool.AvailableOfferings}"
                                  DisplayMemberBinding="{Binding Name}"
                                  SelectedItem="{Binding DesignTool.SelectedOffering}"
                                  IsEnabled="{Binding !DesignTool.IsReadOnly}"
                                  AutomationProperties.Name="Change configuration" />
<TextBlock Text="{Binding DesignTool.SelectedOfferingName, StringFormat='Selected: {0}'}"
                                           FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding DesignTool.SelectedOfferingStatus}"
                                   IsVisible="{Binding DesignTool.SelectedOfferingStatus, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding DesignTool.SelectedBlueprintName, StringFormat='Blueprint: {0}'}"
                                   IsVisible="{Binding DesignTool.SelectedBlueprintName, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding DesignTool.ProviderNetworkWarning}"
                                   IsVisible="{Binding DesignTool.ProviderNetworkWarning, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   TextWrapping="Wrap"
                                   FontSize="11" Foreground="{DynamicResource WarningTextBrush}" />
                      </StackPanel>

                      <!-- Color Working Set -->
                      <StackPanel IsVisible="{Binding DesignTool.HasConfiguration}" Spacing="6">
                        <TextBlock Text="Color Working Set" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource StrongTextBrush}" />
                        <TextBlock Text="Select the colors this design will use." FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                        <ItemsControl ItemsSource="{Binding DesignTool.AvailableColors}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="stageTools:DesignColorViewModel">
                              <ToggleButton Content="{Binding ColorValue}"
                                            IsChecked="{Binding IsSelected}"
                                            IsEnabled="{Binding !IsReadOnly}"
                                            Click="OnColorToggle"
                                            Classes="compactChip" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Selected colors" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource StrongTextBrush}" />
                        <ItemsControl ItemsSource="{Binding DesignTool.SelectedColors}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="stageTools:DesignColorViewModel">
                              <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                                <TextBlock Text="{Binding ColorValue}"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                <Button Grid.Column="1" Content="Make specific"
                                        IsEnabled="{Binding !IsReadOnly}"
                                        Click="OnMakeSpecificForColor"
                                        Tag="{Binding ColorValue}" FontSize="11"
                                        Classes="compactButton"
                                        AutomationProperties.Name="Make specific design for color" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>

                      <!-- Row x Area Slot Grid -->
                      <StackPanel IsVisible="{Binding DesignTool.HasConfiguration}" Spacing="6">
                        <TextBlock Text="Design Slot Grid" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource StrongTextBrush}" />
                        <ItemsControl ItemsSource="{Binding DesignTool.Rows}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="stageTools:DesignRowViewModel">
                              <Border Padding="8" Margin="0,4"
                                      Background="{DynamicResource PanelSurfaceBrush}"
                                      BorderBrush="{DynamicResource SubtleBorderBrush}"
                                      BorderThickness="1" CornerRadius="6">
                                <StackPanel Spacing="6">
                                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                    <TextBlock Text="{Binding ColorChips}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <Button Grid.Column="1" Content="Remove row"
                                            IsVisible="{Binding CanRemove}"
                                            Click="OnRemoveSpecificRow"
                                            Tag="{Binding RowId}" FontSize="11"
                                            Classes="compactButton" />
                                  </Grid>
                                  <ItemsControl ItemsSource="{Binding Slots}">
                                    <ItemsControl.ItemsPanel>
                                      <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                      </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="stageTools:DesignSlotViewModel">
                                        <Border Padding="4"
                                                Background="{DynamicResource SubtleSurfaceBrush}"
                                                BorderBrush="{DynamicResource SubtleBorderBrush}"
                                                BorderThickness="1" CornerRadius="4"
                                                Width="120" MinHeight="100"
                                                DragDrop.AllowDrop="{Binding !IsReadOnly}"
                                                DragDrop.DragOver="OnSlotDragOver"
                                                DragDrop.Drop="OnSlotDrop"
                                                AutomationProperties.Name="{Binding AreaName, StringFormat='Final design artwork slot: {0}'}">
                                          <StackPanel Spacing="4">
                                            <TextBlock Text="Final design artwork" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock Text="{Binding AreaName}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding PlaceholderDetails}" FontSize="9"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                            <Border IsVisible="{Binding HasImage}" Width="80" Height="60"
                                                    Background="{DynamicResource PanelSurfaceBrush}" CornerRadius="4">
<Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                            </Border>
                                            <Border IsVisible="{Binding !HasImage}" Width="80" Height="60"
                                                    Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="4"
                                                    BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
                                              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Drop artwork here" FontSize="10"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="PNG only · drag and drop" FontSize="8"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           HorizontalAlignment="Center" />
                                              </StackPanel>
                                            </Border>
                                            <Button Content="{Binding ArtworkUploadActionText}"
                                                    IsEnabled="{Binding !IsReadOnly}"
                                                    Click="OnBrowseSlotImage"
                                                    Tag="{Binding .}"
                                                    FontSize="10"
                                                    Classes="miniButton"
                                                    ToolTip.Tip="Browse for a PNG final design artwork or replace the current artwork"
                                                    AutomationProperties.Name="{Binding ArtworkUploadAccessibleName}" />
                                            <StackPanel IsVisible="{Binding HasImage}"
                                                          Orientation="Horizontal" Spacing="2"
                                                          HorizontalAlignment="Center">
                                              <Button Content="Enlarge" Click="OnViewSlotImage"
                                                      Tag="{Binding .}"
                                                      IsEnabled="{Binding CanPreview}"
                                                      FontSize="10" Classes="miniButton"
                                                      ToolTip.Tip="Open a larger preview of this final design artwork"
                                                      AutomationProperties.Name="{Binding ArtworkPreviewAccessibleName}" />
                                              <Button Content="Download" Click="OnExportSlotImage"
                                                      Tag="{Binding .}"
                                                      IsEnabled="{Binding CanExport}"
                                                      FontSize="10" Classes="miniButton"
                                                      ToolTip.Tip="Download a copy of this final design artwork"
                                                      AutomationProperties.Name="Download final design artwork" />
                                              <Button Content="Remove" IsEnabled="{Binding !IsReadOnly}"
                                                      Tag="{Binding .}"
                                                      Click="OnRemoveSlotImage"
                                                      FontSize="10" Classes="miniButton"
                                                      ToolTip.Tip="Remove this final design artwork from the slot"
                                                      AutomationProperties.Name="Remove final design artwork" />
                                            </StackPanel>
                                            <TextBlock IsVisible="{Binding IsMissing}" Text="Missing" FontSize="10"
                                                       Foreground="{DynamicResource DangerTextBrush}" />
                                          </StackPanel>
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>

                      <!-- Supporting Images -->
                      <StackPanel Spacing="6">
                        <TextBlock Text="Supporting Images" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource StrongTextBrush}" />
                        <TextBlock Text="Sketches, references, and existing artwork." FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <Button Content="Import supporting image&#x2026;"
                                IsEnabled="{Binding !DesignTool.IsReadOnly}"
                                Click="OnImportSupportingImage"
                                Classes="storeSecondary"
                                AutomationProperties.Name="Import supporting image" />
                        <ItemsControl ItemsSource="{Binding DesignTool.SupportingImages}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="stageTools:DesignSlotViewModel">
                              <Border Padding="4" Margin="2"
                                      Background="{DynamicResource SubtleSurfaceBrush}"
                                      BorderBrush="{DynamicResource SubtleBorderBrush}"
                                      BorderThickness="1" CornerRadius="4" Width="90">
                                <StackPanel Spacing="2">
                                  <Border Width="64" Height="48"
                                          Background="{DynamicResource PanelSurfaceBrush}" CornerRadius="4">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                  </Border>
                                  <TextBlock Text="{Binding AreaName}" FontSize="10"
                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                             TextTrimming="CharacterEllipsis" MaxWidth="64" />
                                  <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Content="View" Click="OnViewSupportingImage"
                                            Tag="{Binding .}"
                                            IsEnabled="{Binding CanPreview}"
                                            FontSize="10" Classes="miniButton" />
                                    <Button Content="Download" Click="OnExportSupportingImage"
                                            Tag="{Binding .}"
                                            IsEnabled="{Binding CanExport}"
                                            FontSize="10" Classes="miniButton" />
                                    <Button Content="Remove" IsEnabled="{Binding !IsReadOnly}"
                                            Tag="{Binding .}"
                                            Click="OnRemoveSupportingImage"
                                            FontSize="10" Classes="miniButton" />
                                  </StackPanel>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>

                      <!-- Error message -->
                      <TextBlock IsVisible="{Binding DesignTool.ErrorMessage}"
                                 Text="{Binding DesignTool.ErrorMessage}"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource DangerTextBrush}" />

                      <!-- Removal confirmation -->
                      <Border IsVisible="{Binding DesignTool.IsRemovalConfirmationVisible}"
                              Padding="12"
                              Background="{DynamicResource SubtleSurfaceBrush}"
                              BorderBrush="{DynamicResource ControlBorderBrush}"
                              BorderThickness="1"
                              CornerRadius="6">
                        <StackPanel Spacing="8">
                          <TextBlock Text="{Binding DesignTool.RemovalConfirmationMessage}"
                                     TextWrapping="Wrap"
                                     FontSize="12"
                                     Foreground="{DynamicResource PrimaryTextBrush}" />
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Confirm remove"
                                    Classes="danger"
                                    Click="OnConfirmRemoval"
                                    AutomationProperties.Name="Confirm remove design image" />
                            <Button Content="Cancel"
                                    Classes="storeSecondary"
                                    Click="OnCancelRemoval"
                                    AutomationProperties.Name="Cancel design image removal" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>

                  <Border IsVisible="{Binding ShowsListingStageTool}"
                          Padding="14"
                          Background="{DynamicResource ElevatedSurfaceBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Listing"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource StrongTextBrush}" />
                      <TextBlock Text="{Binding ListingTool.StatusSummary}"
                                 TextWrapping="Wrap"
                                 FontSize="12"
                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBlock Text="Marketplace fields, mockups, and external publishing are outside this basic local workflow."
                                 TextWrapping="Wrap"
                                 FontSize="12"
                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBlock Text="Mockup template" FontWeight="SemiBold" />
                      <ComboBox ItemsSource="{Binding ListingTool.Templates}"
                                SelectedValue="{Binding ListingTool.SelectedTemplateId}"
                                SelectedValueBinding="{Binding Id}"
                                AutomationProperties.Name="Mockup template" />
                      <TextBlock Text="{Binding ListingTool.BlockedReason}"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource WarningTextBrush}" />
                      <Button Content="Apply mockup template"
                              Command="{Binding ListingTool.ApplyCommand}"
                              IsEnabled="{Binding ListingTool.CanApply}"
                              AutomationProperties.Name="Apply mockup template" />
                      <TextBlock IsVisible="{Binding ListingTool.IsBusy}" Text="Generating mockups…" />
                      <TextBlock Text="{Binding ListingTool.ErrorMessage}"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource DangerTextBrush}" />
                      <ItemsControl ItemsSource="{Binding ListingTool.Outputs}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource StrongTextBrush}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <Border Padding="14"
                          Background="{DynamicResource ElevatedSurfaceBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Related assets"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource StrongTextBrush}" />
                      <ItemsControl ItemsSource="{Binding ItemInspector.Assets}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="appItems:ItemInspectorAssetEntry">
                            <StackPanel Margin="0,0,0,4" Spacing="2">
                              <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource StrongTextBrush}" />
                              <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                              <TextBlock IsVisible="{Binding IsMissing}"
                                         Text="Missing file"
                                         FontSize="11"
                                         Foreground="{DynamicResource DangerTextBrush}" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock IsVisible="{Binding !ItemInspector.HasAssets}"
                                 Text="No assets attached yet."
                                 FontSize="12"
                                 Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                  </Border>

                  <Border Padding="14"
                          Background="{DynamicResource ElevatedSurfaceBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Lifecycle"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource StrongTextBrush}" />
                      <StackPanel Orientation="Horizontal"
                                  Spacing="8"
                                  HorizontalAlignment="Left">
                        <Button Content="Archive"
                                IsVisible="{Binding ItemInspector.CanArchive}"
                                Command="{Binding RequestArchiveItemCommand}"
                                ToolTip.Tip="Archive this Item without deleting it"
                                Classes="storeSecondary" />
                        <Button Content="Restore"
                                IsVisible="{Binding ItemInspector.CanRestore}"
                                Command="{Binding RestoreItemCommand}"
                                ToolTip.Tip="Restore this Item to its preserved topic"
                                Classes="storeSecondary" />
                        <Button Content="Delete…"
                                IsVisible="{Binding ItemInspector.HasState}"
                                IsEnabled="{Binding ItemInspector.CanDelete}"
                                Command="{Binding RequestDeleteItemCommand}"
                                ToolTip.Tip="Permanently delete this Item"
                                Classes="storeSecondary" />
                      </StackPanel>
                      <Border IsVisible="{Binding ItemInspector.ArchiveConfirmationVisible}"
                              Padding="10"
                              Background="{DynamicResource WarningBackgroundBrush}"
                              CornerRadius="6">
                        <StackPanel Spacing="8">
                          <TextBlock Text="Archive this Item? It leaves active navigation but stays recoverable."
                                     TextWrapping="Wrap"
                                     FontSize="12"
                                     Foreground="{DynamicResource StrongTextBrush}" />
                          <StackPanel Orientation="Horizontal"
                                      Spacing="8"
                                      HorizontalAlignment="Left">
                            <Button Content="Archive"
                                    Command="{Binding ItemInspector.ConfirmArchiveCommand}"
                                    Classes="storeAction" />
                            <Button Content="Cancel"
                                    Command="{Binding ItemInspector.CancelArchiveCommand}"
                                    Classes="storeSecondary" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                      <Border IsVisible="{Binding ItemInspector.DeleteConfirmationVisible}"
                              Padding="10"
                              Background="{DynamicResource DangerBackgroundBrush}"
                              CornerRadius="6">
                        <StackPanel Spacing="8">
                          <TextBlock Text="Permanently delete this Item? Connected creative records will block deletion."
                                     TextWrapping="Wrap"
                                     FontSize="12"
                                     Foreground="{DynamicResource StrongTextBrush}" />
                          <StackPanel Orientation="Horizontal"
                                      Spacing="8"
                                      HorizontalAlignment="Left">
                            <Button Content="Delete permanently"
                                    Command="{Binding ItemInspector.ConfirmDeleteCommand}"
                                    Classes="storeAction" />
                            <Button Content="Cancel"
                                    Command="{Binding ItemInspector.CancelDeleteCommand}"
                                    Classes="storeSecondary" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>

                  <TextBlock IsVisible="{Binding ItemInspector.HasError}"
                             Text="{Binding ItemInspector.ErrorMessage}"
                             TextWrapping="Wrap"
                             FontSize="12"
                             Foreground="{DynamicResource DangerTextBrush}" />
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding IsStatusConfirmationVisible}"
                    Padding="12"
                    Background="{DynamicResource WarningBackgroundBrush}"
                    BorderBrush="{DynamicResource WarningBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
              <StackPanel Spacing="8">
                <TextBlock Text="Confirm lifecycle change"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusConfirmationMessage}"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Confirm"
                          Command="{Binding ConfirmStatusChangeCommand}"
                          Classes="storeAction" />
                  <Button x:Name="CancelStatusChangeButton"
                          Content="Cancel"
                          Command="{Binding CancelStatusChangeCommand}"
                          Classes="storeSecondary" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border IsVisible="{Binding GroupDetails.HasState}"
                    MinHeight="360"
                    Padding="22"
                    Background="{DynamicResource PanelSurfaceBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="14">
                  <TextBlock IsVisible="{Binding GroupDetails.IsReadOnly}"
                             Text="{Binding GroupDetails.InactiveNotice}"
                             TextWrapping="Wrap"
                             FontSize="12"
                             Foreground="{DynamicResource DangerTextBrush}" />
                  <TextBlock Text="{Binding GroupDetails.DisplayPath}"
                             FontSize="12"
                             Foreground="{DynamicResource SecondaryTextBrush}" />

                  <Border Padding="14"
                          Background="{DynamicResource ElevatedSurfaceBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Group details"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource StrongTextBrush}" />
                      <StackPanel Spacing="6">
                        <TextBlock Text="Group name"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBox Text="{Binding GroupDetails.Name}"
                                 IsReadOnly="{Binding !GroupDetails.CanEdit}"
                                 MinHeight="32"
                                 PlaceholderText="Group name"
                                 LostFocus="OnDetailsFieldLostFocus" />
                        <TextBlock Text="Description"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBox Text="{Binding GroupDetails.Description}"
                                 IsReadOnly="{Binding !GroupDetails.CanEdit}"
                                 MinHeight="32"
                                 PlaceholderText="Description or purpose"
                                 LostFocus="OnDetailsFieldLostFocus" />
                        <TextBlock Text="Notes"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBox Text="{Binding GroupDetails.Notes}"
                                 IsReadOnly="{Binding !GroupDetails.CanEdit}"
                                 AcceptsReturn="True"
                                 MinHeight="80"
                                 PlaceholderText="Notes and working context"
                                 LostFocus="OnDetailsFieldLostFocus" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border Padding="14"
                          Background="{DynamicResource ElevatedSurfaceBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Location"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource StrongTextBrush}" />
                      <ComboBox ItemsSource="{Binding GroupDetails.Destinations}"
                                SelectedItem="{Binding GroupDetails.SelectedDestination}"
                                IsEnabled="{Binding GroupDetails.CanEdit}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="appGroups:GroupDestination">
                            <TextBlock Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <StackPanel Orientation="Horizontal"
                                  Spacing="8"
                                  HorizontalAlignment="Left">
                        <Button Content="Move"
                                IsEnabled="{Binding GroupDetails.CanMove}"
                                Command="{Binding GroupDetails.MoveCommand}"
                                ToolTip.Tip="Move this group and its contents to the selected location"
                                Classes="storeSecondary" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border Padding="14"
                          Background="{DynamicResource ElevatedSurfaceBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Lifecycle"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource StrongTextBrush}" />
                      <StackPanel Orientation="Horizontal"
                                  Spacing="8"
                                  HorizontalAlignment="Left">
                        <Button Content="Archive"
                                IsVisible="{Binding GroupDetails.CanArchive}"
                                Command="{Binding GroupDetails.RequestArchiveCommand}"
                                ToolTip.Tip="Archive this group and its subtree without deleting them"
                                Classes="storeSecondary" />
                        <Button Content="Restore"
                                IsVisible="{Binding GroupDetails.CanRestore}"
                                Command="{Binding GroupDetails.RestoreCommand}"
                                ToolTip.Tip="Restore this group and its subtree"
                                Classes="storeSecondary" />
                      </StackPanel>
                      <Border IsVisible="{Binding GroupDetails.ArchiveConfirmationVisible}"
                              Padding="10"
                              Background="{DynamicResource WarningBackgroundBrush}"
                              CornerRadius="6">
                        <StackPanel Spacing="8">
                          <TextBlock Text="Archive this group? The group and its subtree leave active navigation, but all child work and context remain preserved."
                                     TextWrapping="Wrap"
                                     FontSize="12"
                                     Foreground="{DynamicResource StrongTextBrush}" />
                          <StackPanel Orientation="Horizontal"
                                      Spacing="8"
                                      HorizontalAlignment="Left">
                            <Button Content="Archive"
                                    Command="{Binding GroupDetails.ConfirmArchiveCommand}"
                                    Classes="storeAction" />
                            <Button Content="Cancel"
                                    Command="{Binding GroupDetails.CancelArchiveCommand}"
                                    Classes="storeSecondary" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>

                  <TextBlock IsVisible="{Binding GroupDetails.HasError}"
                             Text="{Binding GroupDetails.ErrorMessage}"
                             TextWrapping="Wrap"
                             FontSize="12"
                             Foreground="{DynamicResource DangerTextBrush}" />
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,Auto,Auto"
                  IsVisible="{Binding HasActiveItem}"
                  Margin="0,4,0,0">
              <TextBlock Grid.Column="0"
                         Text="{Binding StageMoveError}"
                         IsVisible="{Binding StageMoveError}"
                         FontSize="12"
                         Foreground="{DynamicResource DangerTextBrush}"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap" />
              <Button Grid.Column="1"
                      Content="{Binding StageMoveBackLabel}"
                      IsEnabled="{Binding CanMoveStageBack}"
                      Command="{Binding MoveStageBackCommand}"
                      Classes="stageMove"
                      Margin="0,0,6,0" />
              <Button Grid.Column="2"
                      Content="{Binding StageMoveForwardLabel}"
                      IsEnabled="{Binding CanMoveStageForward}"
                      Command="{Binding MoveStageForwardCommand}"
                      Classes="stageMove" />
            </Grid>
          </StackPanel>
          </ScrollViewer>

          <StackPanel IsVisible="{Binding !DocumentWindow.HasActiveDocument}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="8">
            <TextBlock Text="{Binding DocumentWindow.EmptyStateTitle}"
                       HorizontalAlignment="Center"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock Text="{Binding DocumentWindow.EmptyStateMessage}"
                       HorizontalAlignment="Center"
                       FontSize="13"
                       Foreground="{DynamicResource EmptyStateTextBrush}" />
          </StackPanel>

          <Border IsVisible="{Binding ShowSelectionSummary}"
                  Background="{DynamicResource ElevatedSurfaceBrush}"
                  Padding="4">
            <StackPanel Spacing="14">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding WorkspaceTree.InspectorKind}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding WorkspaceTree.InspectorTitle}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="{Binding WorkspaceTree.InspectorPath}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
              </StackPanel>
              <Border Padding="18" Background="{DynamicResource PanelSurfaceBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                  <TextBlock Text="Properties" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" />
                  <TextBlock Text="{Binding WorkspaceTree.InspectorDescription}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBlock Text="Selection updates this inspector without opening a tab. Ctrl-click the tree node to keep it in a tab."
                             TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.ColumnSpan="2"
            IsVisible="{Binding WorkspaceManagement.ShouldShowNoWorkspaceState}"
            Background="{DynamicResource OverlayScrimBrush}">
      <Border Width="420"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Padding="20"
              Background="{DynamicResource ElevatedSurfaceBrush}"
              BorderBrush="{DynamicResource ControlBorderBrush}"
              BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="Create your first workspace?"
                     FontSize="22"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}" />
          <TextBlock Text="FusionCanvas needs a workspace before stores can be organized."
                     TextWrapping="Wrap"
                     FontSize="13"
                     Foreground="{DynamicResource SecondaryTextBrush}" />
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="8">
            <Button x:Name="NoWorkspaceImportButton"
                    Content="Import workspace…"
                    IsEnabled="{Binding WorkspaceManagement.CanImportWorkspace}"
                    Command="{Binding WorkspaceManagement.ImportWorkspaceCommand}"
                    Classes="storeAction fixedDialog" />
            <Button Content="Create workspace"
                    IsEnabled="{Binding !WorkspaceManagement.IsTransferRunning}"
                    Command="{Binding WorkspaceManagement.CreateWorkspaceCommand}"
                    Classes="storeAction fixedDialog" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <Border Grid.ColumnSpan="2"
            IsVisible="{Binding ShouldShowFirstStorePrompt}"
            Background="{DynamicResource OverlayScrimBrush}">
      <Border Width="420"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Padding="20"
              Background="{DynamicResource ElevatedSurfaceBrush}"
              BorderBrush="{DynamicResource ControlBorderBrush}"
              BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="Create your first store?"
                     FontSize="22"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}" />
          <TextBlock Text="FusionCanvas needs a store before workspace content can be organized."
                     TextWrapping="Wrap"
                     FontSize="13"
                     Foreground="{DynamicResource SecondaryTextBrush}" />
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="8">
            <Button Content="Create store"
                    Command="{Binding StoreManagement.AcceptFirstStorePromptCommand}"
                    Classes="storeAction fixedDialog" />
            <Button Content="Not now"
                    Command="{Binding StoreManagement.DeclineFirstStorePromptCommand}"
                    Classes="storeSecondary fixedDialog" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
  <Window.Styles>
    <Style Selector="TreeViewItem" x:DataType="nav:WorkspaceTreeNodeViewModel">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="Border.treeRow">
      <Setter Property="Padding" Value="5,2" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.treeRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
    </Style>
    <Style Selector="Border.treeRow.multiSelected">
      <Setter Property="Background" Value="{DynamicResource SelectionSubtleBackgroundBrush}" />
    </Style>
    <Style Selector="Border.treeRow.selected">
      <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
    </Style>
    <Style Selector="Border.treeRow.inactive">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Border.treeRow.inactive:pointerover">
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="Border.treeRow.cut">
      <Setter Property="Opacity" Value="0.48" />
    </Style>
    <Style Selector="Border.treeRow.inactive">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Border.treeRow.dropTarget">
      <Setter Property="Background" Value="{DynamicResource DropTargetBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.treeRow.dropBefore">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentStrongBrush}" />
      <Setter Property="BorderThickness" Value="0,2,0,0" />
    </Style>
    <Style Selector="Border.treeRow.dropAfter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentStrongBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
    <Style Selector="Button.navigation">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Background" Value="{DynamicResource PanelSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.storeSelector">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource AccentSoftBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentSoftForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.storeSelector.selected">
      <Setter Property="Background" Value="{DynamicResource CommandBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CommandForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CommandBorderBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.storeAction">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource CommandBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CommandForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CommandBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.fixedDialog">
      <Setter Property="Width" Value="116" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.storeSecondary">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.storeSecondary.active">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentSoftForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBorderBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.iconButton">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.ideaRatingStar">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Foreground" Value="#7A8088" />
    </Style>
    <Style Selector="TextBlock.ideaRatingStar.selected">
      <Setter Property="Foreground" Value="#F6C445" />
    </Style>
    <Style Selector="Border.tabFrame">
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="5,5,0,0" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.tabFrame.active">
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TabBorderBrush}" />
      <Setter Property="BorderThickness" Value="1,1,1,0" />
    </Style>
    <Style Selector="Button.tab">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="10,0,4,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.tab.active">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.closeTab">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Margin" Value="0,6,4,6" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.closeTab:pointerover">
      <Setter Property="Background" Value="{DynamicResource CloseTabHoverBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <Style Selector="Button.available">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentSoftForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.current">
      <Setter Property="Background" Value="{DynamicResource CommandBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CommandForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CommandBorderBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.unavailable">
      <Setter Property="Background" Value="{DynamicResource UnavailableBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource UnavailableForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    </Style>
    <Style Selector="Button.activeView:not(.current)">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentStrongBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.stageMove">
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.stageMove:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="ComboBox.statusSelector">
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.toolSelector">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="MinWidth" Value="72" />
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.emphasized">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
  </Window.Styles>
</Window>
