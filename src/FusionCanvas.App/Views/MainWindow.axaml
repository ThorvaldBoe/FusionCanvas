<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:doc="clr-namespace:FusionCanvas.App.DocumentWindow"
        xmlns:items="clr-namespace:FusionCanvas.App.Items"
        xmlns:nav="clr-namespace:FusionCanvas.App.Navigation"
        xmlns:stores="clr-namespace:FusionCanvas.App.Stores"
        xmlns:stageTools="clr-namespace:FusionCanvas.App.StageTools"
        xmlns:workspace="clr-namespace:FusionCanvas.App.Workspace"
        xmlns:views="clr-namespace:FusionCanvas.App.Views"
        xmlns:cref="clr-namespace:FusionCanvas.App.ConceptRefinement"
        xmlns:appWorkflowNav="clr-namespace:FusionCanvas.Application.WorkflowNavigation;assembly=FusionCanvas.Application"
        xmlns:appItems="clr-namespace:FusionCanvas.Application.Items;assembly=FusionCanvas.Application"
        xmlns:appGroups="clr-namespace:FusionCanvas.Application.Groups;assembly=FusionCanvas.Application"
        x:Class="FusionCanvas.App.Views.MainWindow"
        x:DataType="views:MainWindowViewModel"
        KeyDown="OnWindowKeyDown"
        Title="FusionCanvas"
        Icon="avares://FusionCanvas.App/Assets/FusionCanvasLogo_Square_LightBg.png"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        Background="{DynamicResource ApplicationBackgroundBrush}">
  <Grid x:Name="MainLayoutGrid">
    <Border Grid.ColumnSpan="3"
            VerticalAlignment="Top"
            HorizontalAlignment="Stretch"
            IsVisible="{Binding IsBusy}"
            Background="{DynamicResource PanelSurfaceBrush}"
            Padding="10,4">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ProgressBar Width="120"
                     Height="4"
                     IsIndeterminate="True"
                     AutomationProperties.Name="Working in FusionCanvas" />
        <TextBlock Text="Working…"
                   FontSize="11"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Border>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" MinWidth="240" MaxWidth="560" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="*" MinWidth="480" />
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0"
            Background="{DynamicResource ElevatedSurfaceBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="0,0,1,0"
            Padding="18,18,18,0">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <Grid x:Name="NavigationHeader"
              Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto,Auto"
              ColumnSpacing="8"
              Margin="0,0,0,18">
          <TextBlock Grid.Column="0"
                     Text="FusionCanvas"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     VerticalAlignment="Center" />
          <Border Grid.Column="1"
                  ToolTip.Tip="Manage workspaces in settings"
                  MinWidth="0"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
              <PathIcon Data="M3,5 H10 L12,7 H21 V19 H3 Z"
                        Width="16" Height="16"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="{Binding Settings.WorkspaceName}"
                         MaxWidth="120"
                         TextTrimming="CharacterEllipsis"
                         FontSize="12"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Button Grid.Column="2"
                  IsVisible="{Binding Settings.Updates.IsUpdateActionVisible}"
                  Content="{Binding Settings.Updates.UpdateActionText}"
                  ToolTip.Tip="Download the available FusionCanvas update"
                  Command="{Binding Settings.Updates.UpdateCommand}"
                  Classes="updateButton"
                  AutomationProperties.Name="Update available"
                  AutomationProperties.AutomationId="Updates.Available" />
          <Button Grid.Column="3"
                  Content="⚙"
                  ToolTip.Tip="Settings"
                  Command="{Binding Settings.OpenCommand}"
                  Classes="iconButton"
                  AutomationProperties.Name="Settings"
                  AutomationProperties.AutomationId="Settings.Open" />
        </Grid>

        <StackPanel Grid.Row="1"
                    Spacing="8"
                    Margin="0,0,0,18">
          <Grid ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="6">
            <TextBlock Text="Stores"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource StrongTextBrush}" />
            <Button Grid.Column="1"
                    Content="{Binding StoreManagement.SelectorToggleGlyph}"
                    ToolTip.Tip="{Binding StoreManagement.SelectorToggleTooltip}"
                    Command="{Binding StoreManagement.ToggleStoreSelectorCommand}"
                    Classes="iconButton" />
            <Button Grid.Column="2"
                    Content="..."
                    ToolTip.Tip="Store actions"
                    AutomationProperties.AutomationId="StoreManagement.Actions"
                    Classes="iconButton">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="Manage stores"
                            AutomationProperties.AutomationId="StoreManagement.OpenEditor"
                            Command="{Binding StoreManagement.OpenStoreEditorCommand}" />
                  <MenuItem Header="Store assets…"
                            Click="OnContextStoreAssets" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </Grid>
          <Button IsVisible="{Binding StoreManagement.IsSelectorCompact}"
                  Content="{Binding StoreManagement.SelectedStore.Name}"
                  Command="{Binding StoreManagement.ToggleStoreSelectorCommand}"
                  Classes="storeSelector selected"
                  HorizontalContentAlignment="Left" />
          <StackPanel IsVisible="{Binding StoreManagement.IsSelectorExpanded}"
                      Spacing="6">
            <ScrollViewer MaxHeight="170"
                          VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding StoreManagement.SelectorStores}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="stores:StoreSelectorEntry">
                    <Button Content="{Binding Name}"
                            Command="{Binding $parent[ItemsControl].DataContext.StoreManagement.SelectStoreCommand}"
                            CommandParameter="{Binding}"
                            Classes="storeSelector"
                            Classes.selected="{Binding IsSelected}"
                            HorizontalContentAlignment="Left" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,12">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
            <Button x:Name="GroupActionsButton"
                    Grid.Column="0"
                    Content="+ New group"
                    ToolTip.Tip="Create a group in the selected niche or group"
                    Command="{Binding WorkspaceTree.BeginCreateCommand}"
                    IsEnabled="{Binding CanCreateGroup}"
                    Classes="storeSecondary" />
            <Button Grid.Column="1"
                    Content="+ New Item"
                    ToolTip.Tip="Capture an Item under the selected topic or default niche"
                    Command="{Binding WorkspaceTree.BeginCreateItemCommand}"
                    IsEnabled="{Binding CanCreateGroup}"
                    Classes="storeSecondary" />
          </Grid>
          <StackPanel Spacing="6">
            <TextBox x:Name="TreeSearchBox"
                     Text="{Binding WorkspaceTree.QueryText}"
                     PlaceholderText="Search names, ideas, notes, tags..."
                     MinHeight="34" />
            <WrapPanel Orientation="Horizontal">
              <Button Content="Clear tags"
                      IsVisible="{Binding WorkspaceTree.IsTagFilterActive}"
                      Command="{Binding WorkspaceTree.ClearTagFiltersCommand}"
                      ToolTip.Tip="Clear the active tag filter"
                      Classes="storeSecondary"
                      HorizontalAlignment="Left"
                      Margin="0,0,6,6" />
              <ComboBox x:Name="StageFilter"
                        SelectedIndex="{Binding WorkspaceTree.StageFilterIndex}"
                        MinWidth="92"
                        MinHeight="34"
                        HorizontalAlignment="Left"
                        ToolTip.Tip="Filter Items by workflow stage"
                        Classes="statusSelector"
                        Margin="0,0,6,6">
                <ComboBoxItem Content="All stages" />
                <ComboBoxItem Content="Idea" />
                <ComboBoxItem Content="Concept" />
                <ComboBoxItem Content="Design" />
                <ComboBoxItem Content="Listing" />
              </ComboBox>
              <ComboBox x:Name="StatusFilter"
                        SelectedIndex="{Binding WorkspaceTree.StatusFilterIndex}"
                        MinWidth="92"
                        MinHeight="34"
                        HorizontalAlignment="Left"
                        ToolTip.Tip="Filter Items by lifecycle status"
                        Classes="statusSelector"
                        Margin="0,0,6,6">
                <ComboBoxItem Content="All statuses" />
                <ComboBoxItem Content="Draft" />
                <ComboBoxItem Content="Published" />
                <ComboBoxItem Content="Paused" />
                <ComboBoxItem Content="Rejected" />
              </ComboBox>
              <ComboBox x:Name="IdeaRatingFilter"
                        SelectedIndex="{Binding WorkspaceTree.IdeaRatingFilterIndex}"
                        MinWidth="110"
                        MinHeight="34"
                        ToolTip.Tip="Filter Items by idea rating"
                        AutomationProperties.Name="Idea rating filter"
                        Classes="statusSelector"
                        Margin="0,0,6,6">
                <ComboBoxItem Content="All ratings" />
                <ComboBoxItem Content="Unrated" />
                <ComboBoxItem Content="★ 1" />
                <ComboBoxItem Content="★ 2" />
                <ComboBoxItem Content="★ 3" />
                <ComboBoxItem Content="★ 4" />
                <ComboBoxItem Content="★ 5" />
                <ComboBoxItem Content="Greater than ★ 1" />
                <ComboBoxItem Content="Greater than ★ 2" />
                <ComboBoxItem Content="Greater than ★ 3" />
                <ComboBoxItem Content="Greater than ★ 4" />
                <ComboBoxItem Content="Less than ★ 5" />
                <ComboBoxItem Content="Less than ★ 4" />
                <ComboBoxItem Content="Less than ★ 3" />
                <ComboBoxItem Content="Less than ★ 2" />
              </ComboBox>
              <Button Content="Filters"
                      ToolTip.Tip="Filter by tag, topic scope, or archived work"
                      Command="{Binding WorkspaceTree.ClearFiltersCommand}"
                      Classes="storeSecondary"
                      Classes.active="{Binding WorkspaceTree.HasNonTextFilters}"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,6">
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight"
                          ShowMode="Standard">
                    <Border Width="260" Padding="12">
                      <StackPanel Spacing="10">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Scope" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" />
                          <CheckBox Content="Current topic and below"
                                    IsChecked="{Binding WorkspaceTree.ScopeToCurrentTopic}"
                                    IsEnabled="{Binding WorkspaceTree.CanScopeToCurrentTopic}"
                                    ToolTip.Tip="Limit the tree to the selected niche or group subtree" />
                          <TextBlock IsVisible="{Binding WorkspaceTree.ScopeToCurrentTopic}"
                                     Text="{Binding WorkspaceTree.ScopedTopicName, StringFormat='Current: {0}'}"
                                     FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Separator Margin="0,2" />
                        <StackPanel Spacing="6">
                          <TextBlock Text="Tags" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" />
                          <TextBlock Text="No tags yet in this store."
                                     IsVisible="{Binding !WorkspaceTree.AvailableTags.Count}"
                                     FontSize="11" Foreground="{DynamicResource UnavailableForegroundBrush}" />
                          <ItemsControl ItemsSource="{Binding WorkspaceTree.AvailableTags}"
                                        IsVisible="{Binding WorkspaceTree.AvailableTags.Count}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="nav:TagFilterEntryViewModel">
                                <CheckBox Content="{Binding Name}"
                                          IsChecked="{Binding IsSelected}"
                                          Margin="0,1" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                        <Separator Margin="0,2" />
                        <CheckBox Content="Include archived"
                                  IsChecked="{Binding WorkspaceTree.IncludeArchived}"
                                  ToolTip.Tip="Reveal archived topics and Items with inactive treatment" />
                        <Separator Margin="0,2" />
                        <Button Content="Clear all"
                                HorizontalAlignment="Right"
                                Command="{Binding WorkspaceTree.ClearFiltersCommand}"
                                IsEnabled="{Binding WorkspaceTree.HasActiveFilters}"
                                Classes="storeSecondary" />
                      </StackPanel>
                    </Border>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </WrapPanel>
          </StackPanel>
          <TextBlock Text="{Binding GroupActionStatus}"
                     TextWrapping="Wrap"
                     FontSize="11"
                     Foreground="{DynamicResource SecondaryTextBrush}" />
          <TextBlock Text="{Binding WorkspaceTree.ErrorMessage}"
                     IsVisible="{Binding WorkspaceTree.HasError}"
                     TextWrapping="Wrap"
                     FontSize="11"
                     Foreground="{DynamicResource DangerStrongBrush}"
                     AutomationProperties.AutomationId="WorkspaceTreeError" />
          <ProgressBar IsVisible="{Binding WorkspaceTree.IsBusy}"
                       IsIndeterminate="True"
                       Height="3"
                       AutomationProperties.Name="Working with workspace tree" />
        </StackPanel>

        <Border x:Name="TreeActionsToolbar"
                Grid.Row="3"
                Margin="0,0,0,8">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button x:Name="ExpandCollapseAllButton"
                    Classes="iconButton"
                    Command="{Binding WorkspaceTree.ToggleExpandCollapseAllCommand}"
                    IsEnabled="{Binding WorkspaceTree.CanToggleExpandCollapseAll}"
                    ToolTip.Tip="{Binding WorkspaceTree.ExpandCollapseAllTooltip}"
                    AutomationProperties.Name="{Binding WorkspaceTree.ExpandCollapseAllTooltip}">
              <Grid>
                <PathIcon x:Name="ExpandCollapseAllExpandIcon"
                          Data="M12 5.83 15.17 9l1.41-1.41L12 3 7.41 7.59 8.83 9 12 5.83zm0 12.34L8.83 15l-1.41 1.41L12 21l4.59-4.59L15.17 15 12 18.17z"
                          Width="14" Height="14"
                          Foreground="{DynamicResource SecondaryButtonForegroundBrush}"
                          IsVisible="{Binding WorkspaceTree.NextToggleExpands}" />
                <PathIcon x:Name="ExpandCollapseAllCollapseIcon"
                          Data="M7.41 18.59 8.83 20 12 16.83 15.17 20l1.41-1.41L12 14l-4.59 4.59zm9.18-13.18L15.17 4 12 7.17 8.83 4 7.41 5.41 12 10l4.59-4.59z"
                          Width="14" Height="14"
                          Foreground="{DynamicResource SecondaryButtonForegroundBrush}"
                          IsVisible="{Binding !WorkspaceTree.NextToggleExpands}" />
              </Grid>
            </Button>
          </StackPanel>
        </Border>

        <Border Grid.Row="5"
                Classes="navigationStatusBar"
                Margin="-18,8,-18,0"
                Padding="8,6"
                Background="{DynamicResource PanelSurfaceBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
          <TextBlock Text="{Binding WorkspaceTree.DesignCountLabel}"
                     FontSize="11"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     AutomationProperties.AutomationId="DesignCountLabel" />
        </Border>
        <Grid Grid.Row="4">
          <TreeView x:Name="WorkspaceTreeControl"
                    ItemsSource="{Binding WorkspaceTree.Roots}"
                    Background="Transparent"
                    BorderThickness="0">
            <TreeView.ItemTemplate>
              <TreeDataTemplate x:DataType="nav:WorkspaceTreeNodeViewModel" ItemsSource="{Binding Children}">
                <Border Classes="treeRow"
                        Classes.selected="{Binding IsSelected}"
                        Classes.multiSelected="{Binding IsMultiSelected}"
                        Classes.inactive="{Binding IsInactive}"
                        Classes.cut="{Binding IsCut}"
                        Classes.dropTarget="{Binding IsDropTarget}"
                        Classes.dropBefore="{Binding IsDropBefore}"
                        Classes.dropAfter="{Binding IsDropAfter}"
                        DragDrop.AllowDrop="True"
                        PointerMoved="OnTreeNodePointerMoved"
                        DragDrop.DragOver="OnTreeNodeDragOver"
                        DragDrop.DragLeave="OnTreeNodeDragLeave"
                        DragDrop.Drop="OnTreeNodeDrop"
                        ToolTip.Tip="Click to select; Ctrl-click toggles; Shift-click selects a range; middle-click opens a tab; F2 renames">
                  <Border.ContextMenu>
                    <ContextMenu IsVisible="{Binding HasAssetActions}">
                      <MenuItem Header="Open in new tab"
                                IsVisible="{Binding !HasMultiSelectionContext}"
                                Click="OnContextOpenInTab" />
                      <MenuItem Header="Open in new tabs"
                                IsVisible="{Binding HasMultiSelectionContext}"
                                Click="OnContextOpenSelectedInTabs" />
                      <Separator IsVisible="{Binding HasMultiSelectionContext}" />
                      <MenuItem Header="{Binding SelectionCountLabel}"
                                IsVisible="{Binding HasMultiSelectionContext}"
                                IsEnabled="False" />
                      <MenuItem Header="New group" IsVisible="{Binding IsTopicAndSingleSelection}" Click="OnContextNewGroup" />
                      <MenuItem Header="New Item" IsVisible="{Binding IsSingleSelectionContext}" Click="OnContextNewItem" />
                      <MenuItem Header="Import…" IsVisible="{Binding IsTopicAndSingleSelection}" Click="OnContextImport" />
                      <Separator />
              <MenuItem Header="Rename" IsVisible="{Binding HasContextActionsAndSingleSelection}" Click="OnContextRename" />
              <MenuItem Header="Copy" IsVisible="{Binding HasContextActionsAndSingleSelection}" Click="OnContextCopy" />
              <MenuItem Header="Cut" IsVisible="{Binding HasContextActionsAndSingleSelection}" Click="OnContextCut" />
              <MenuItem Header="Paste" IsVisible="{Binding IsSingleSelectionContext}" IsEnabled="{Binding CanPaste}" Click="OnContextPaste" />
              <MenuItem Header="Duplicate" IsVisible="{Binding IsItemAndSingleSelection}" Click="OnContextDuplicate" />
                      <MenuItem Header="Duplicate" IsVisible="{Binding HasMultiSelectionContext}" Click="OnContextDuplicateSelected" />
                      <MenuItem Header="Export" IsVisible="{Binding HasMultiSelectionContext}" Click="OnContextExportSelected" />
                      <MenuItem Header="Group" IsVisible="{Binding HasMultiSelectionContext}" Click="OnContextGroupSelected" />
                      <MenuItem Header="Archive" IsVisible="{Binding HasMultiSelectionContext}" Click="OnContextArchiveSelected" />
                      <MenuItem Header="Delete" IsVisible="{Binding HasMultiSelectionContext}" Click="OnContextDeleteSelected" />
              <MenuItem Header="Assets…" IsVisible="{Binding IsSingleSelectionContext}" Click="OnContextAssets" />
              <MenuItem Header="Export to CSV..." IsVisible="{Binding IsTopicAndSingleSelection}" Click="OnContextExport" />
                      <Separator />
                      <MenuItem Header="Delete..." IsVisible="{Binding IsGroupAndSingleSelection}" Click="OnContextDelete" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <Grid ColumnDefinitions="3,22,*,Auto" MinHeight="34">
                    <Border Grid.Column="0" Background="{DynamicResource AccentBrush}" CornerRadius="2" />
                    <TextBlock Grid.Column="1" Text="{Binding Icon}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource TreeIconForegroundBrush}" />
                    <Grid Grid.Column="2" Margin="4,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   IsVisible="{Binding !IsEditing}"
                                   TextTrimming="CharacterEllipsis" />
                        <ItemsControl IsVisible="{Binding HasAppliedTags}"
                                      ItemsSource="{Binding VisibleTagColorSequence}"
                                      Margin="6,0,0,0">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="3" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <Border Width="10" Height="10"
                                      CornerRadius="5"
                                      Background="{Binding Converter={x:Static nav:TagBrushConverter.Background}, FallbackValue='#F0F2F5'}"
                                      BorderBrush="{Binding Converter={x:Static nav:TagBrushConverter.Border}, FallbackValue='#D9DEE7'}"
                                      BorderThickness="1"
                                      ToolTip.Tip="Item has this tag applied" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border IsVisible="{Binding HasHiddenTags}"
                                Padding="4,0"
                                CornerRadius="6"
                                Background="{DynamicResource CountBadgeBackgroundBrush}">
                          <TextBlock Text="{Binding HiddenTagLabel}" FontSize="10" Foreground="{DynamicResource TreeIconForegroundBrush}" />
                        </Border>
                      </StackPanel>
                      <TextBox Text="{Binding DraftName}"
                               IsVisible="{Binding IsEditing}"
                               AttachedToVisualTree="OnTreeEditorAttached"
                               KeyDown="OnTreeEditorKeyDown"
                               LostFocus="OnTreeEditorLostFocus"
                               MinHeight="28"
                               Padding="5,2" />
                    </Grid>
                    <Border Grid.Column="3" IsVisible="{Binding HasChildren}" Padding="5,1" CornerRadius="8" Background="{DynamicResource CountBadgeBackgroundBrush}">
                      <TextBlock Text="{Binding CountLabel}" FontSize="10" Foreground="{DynamicResource TreeIconForegroundBrush}" />
                    </Border>
                  </Grid>
                </Border>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
          <Border IsVisible="{Binding WorkspaceTree.HasEmptyFilterResults}"
                  Background="{DynamicResource PanelSurfaceBrush}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        MaxWidth="220">
              <TextBlock Text="Nothing matches the current filters."
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         Foreground="{DynamicResource TreeIconForegroundBrush}"
                         FontSize="12" />
              <Button Content="Clear filters"
                      HorizontalAlignment="Center"
                      Command="{Binding WorkspaceTree.ClearFiltersCommand}"
                      Classes="storeSecondary" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Border>

    <GridSplitter Grid.Column="1"
                  ResizeDirection="Columns"
                  Background="Transparent"
                  Cursor="SizeWestEast"
                  ToolTip.Tip="Drag to resize navigation"
                  AutomationProperties.Name="Resize navigation panel" />

    <Grid Grid.Column="2"
          RowDefinitions="Auto,Auto,*">
      <Border Grid.Row="0"
              Background="{DynamicResource TabBarBackgroundBrush}"
              BorderBrush="{DynamicResource ControlBorderBrush}"
              BorderThickness="0,0,0,1"
              Height="40"
              Padding="6,5,6,0">
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding DocumentWindow.Tabs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="doc:DocumentTabViewModel">
                <Border Classes.active="{Binding IsActive}"
                        Classes="tabFrame">
                  <Grid ColumnDefinitions="*,26"
                        MinWidth="120"
                        MaxWidth="224">
                    <Button Grid.Column="0"
                            Command="{Binding $parent[ItemsControl].DataContext.RequestSelectTabCommand}"
                            CommandParameter="{Binding}"
                            Classes="tab"
                            Classes.active="{Binding IsActive}">
                      <TextBlock Text="{Binding Title}"
                                 TextTrimming="CharacterEllipsis"
                                 MaxLines="1"
                                 VerticalAlignment="Center" />
                    </Button>
                    <Button Grid.Column="1"
                            Content="×"
                            Command="{Binding $parent[ItemsControl].DataContext.RequestCloseTabCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="Close tab"
                            Classes="closeTab" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <Border Grid.Row="1"
              IsVisible="{Binding WorkflowNavigator.HasActiveItem}"
              Padding="20,14"
              Background="{DynamicResource ElevatedSurfaceBrush}"
              BorderBrush="{DynamicResource ControlBorderBrush}"
              BorderThickness="0,0,0,1">
        <StackPanel Spacing="10">
          <ItemsControl ItemsSource="{Binding WorkflowNavigator.Stages}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="appWorkflowNav:WorkflowStageNavigatorEntry">
                <Button Content="{Binding Label}"
                        IsEnabled="{Binding CanNavigate}"
                        Command="{Binding $parent[ItemsControl].DataContext.SelectWorkflowStageCommand}"
                        CommandParameter="{Binding Stage}"
                        Classes.current="{Binding IsCurrent}"
                        Classes.available="{Binding IsAvailable}"
                        Classes.unavailable="{Binding !IsAvailable}"
                        Classes.activeView="{Binding IsActiveView}"
                        Padding="14,8"
                        MinWidth="88" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock IsVisible="{Binding WorkflowNavigator.ShowsInactiveState}"
                     Text="{Binding WorkflowNavigator.InactiveLabel}"
                     FontSize="12"
                     Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>
      </Border>

      <Border Grid.Row="2"
              Margin="20"
              Padding="24"
              Background="{DynamicResource ElevatedSurfaceBrush}"
              BorderBrush="{DynamicResource ControlBorderBrush}"
              BorderThickness="1">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0"
                      IsVisible="{Binding ItemInspector.HasState}">
            <Grid IsVisible="{Binding DocumentWindow.HasMultipleStageTools}"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="12"
                  Margin="0,0,0,12"
                  AutomationProperties.Name="Item stage tool selector"
                  AutomationProperties.AutomationId="Item.StageToolSelector">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding DocumentWindow.ActiveStageToolName}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource StrongTextBrush}" />
                <TextBlock Text="{Binding DocumentWindow.ActiveStageToolDescription}"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <ItemsControl Grid.Column="1"
                            ItemsSource="{Binding DocumentWindow.AvailableStageTools}"
                            AutomationProperties.Name="Available item stage tools">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="doc:StageToolOptionViewModel">
                    <Button Content="{Binding DisplayName}"
                            Command="{Binding $parent[ItemsControl].DataContext.DocumentWindow.SelectStageToolCommand}"
                            CommandParameter="{Binding}"
                            Classes="toolSelector" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </StackPanel>

          <ScrollViewer Grid.Row="1"
                        IsVisible="{Binding DocumentWindow.HasActiveDocument}"
                        VerticalScrollBarVisibility="Auto"
                        Padding="0,0,16,0">
            <StackPanel Spacing="12">
            <views:DocumentContextHeader IsVisible="{Binding !ItemInspector.HasState}" />
            <Border MinHeight="360"
                    Padding="22"
                    Background="{DynamicResource PanelSurfaceBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    IsVisible="{Binding ShowStageToolHost}">
              <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      Margin="0,0,0,12">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding DocumentWindow.ActiveStageToolName}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource StrongTextBrush}" />
                    <TextBlock Text="{Binding DocumentWindow.ActiveStageToolDescription}"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                  </StackPanel>
                  <ItemsControl Grid.Column="1"
                                IsVisible="{Binding DocumentWindow.HasMultipleStageTools}"
                                ItemsSource="{Binding DocumentWindow.AvailableStageTools}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="doc:StageToolOptionViewModel">
                        <Button Content="{Binding DisplayName}"
                                Command="{Binding $parent[ItemsControl].DataContext.DocumentWindow.SelectStageToolCommand}"
                                CommandParameter="{Binding}"
                                Classes="toolSelector" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>

                <StackPanel Grid.Row="1"
                            Spacing="8">
                  <TextBlock Text="{Binding DocumentWindow.ActiveWorkflowStageLabel}"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource StrongTextBrush}" />
                  <TextBlock Text="{Binding ActiveStageToolContentKey}"
                             FontSize="13"
                             Foreground="{DynamicResource SecondaryTextBrush}" />
                <Border Margin="0,10,0,0"
                        Padding="12"
                        Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding DocumentWindow.ActiveToolScopeLabel}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource StrongTextBrush}" />
                    <TextBlock Text="{Binding DocumentWindow.ActiveToolScopeDescription}"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock IsVisible="{Binding !DocumentWindow.CanRunActiveTool}"
                               Text="{Binding DocumentWindow.ActiveToolUnavailableMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource DangerTextBrush}" />
                    <TextBlock IsVisible="{Binding !DocumentWindow.CanRunActiveTool}"
                               Text="{Binding DocumentWindow.ActiveStageToolUnavailableMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource DangerTextBrush}" />
                    <TextBlock IsVisible="{Binding HasActiveStageToolContentUnavailableMessage}"
                               Text="{Binding ActiveStageToolContentUnavailableMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource DangerTextBrush}" />
                  </StackPanel>
                </Border>
                </StackPanel>
              </Grid>
            </Border>

            <Border x:Name="ItemOverviewComposition"
                    AutomationProperties.Name="Item overview context"
                    IsVisible="{Binding ItemInspector.HasState}"
                    MinHeight="360"
                    Padding="22"
                    Background="{DynamicResource PanelSurfaceBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="14">
                  <views:DocumentContextHeader />
                  <TextBlock IsVisible="{Binding ItemInspector.IsReadOnly}"
                             Text="{Binding ItemInspector.InactiveNotice}"
                             TextWrapping="Wrap"
                             FontSize="12"
                             Foreground="{DynamicResource DangerTextBrush}" />
                  <TextBlock Text="{Binding ItemInspector.DisplayPath}"
                             FontSize="12"
                             Foreground="{DynamicResource SecondaryTextBrush}" />
                  <ProgressBar IsVisible="{Binding ItemInspector.IsWorking}"
                               IsIndeterminate="True"
                               Height="4"
                               AutomationProperties.Name="Working with item" />

                  <Border IsVisible="{Binding ItemInspector.ShowsContentRiskWarning}"
                          Padding="12"
                          Background="{DynamicResource Token.Color.SurfaceElevated}"
                          BorderBrush="{DynamicResource Token.Color.Border}"
                          BorderThickness="1"
                          CornerRadius="6"
                          AutomationProperties.Name="Content risk awareness">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Review content risk before publishing"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource Token.Color.TextStrong}" />
                      <TextBlock Text="{Binding ItemInspector.ContentRiskWarningText}"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource Token.Color.TextSecondary}" />
                      <Button Content="View review details"
                              Command="{Binding ItemInspector.ToggleContentRiskDetailsCommand}"
                              HorizontalAlignment="Left"
                              AutomationProperties.Name="View content risk review details" />
                      <TextBlock IsVisible="{Binding ItemInspector.IsContentRiskDetailsExpanded}"
                                 Text="{Binding ItemInspector.ContentRiskDetailsText}"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource Token.Color.TextSecondary}" />
                    </StackPanel>
                  </Border>

                  <Border Padding="{DynamicResource Token.Layout.CardPadding}"
                          Background="{DynamicResource Token.Color.SurfaceElevated}"
                          BorderBrush="{DynamicResource Token.Color.Border}"
                          BorderThickness="{DynamicResource Token.Border.Default}"
                          CornerRadius="{DynamicResource Token.Radius.Card}"
                          AutomationProperties.AutomationId="ConceptOverview.Surface">
                    <StackPanel Spacing="{DynamicResource Token.Spacing.GroupGap}">
                      <TextBlock Text="Overview"
                                 FontSize="{DynamicResource Token.Typography.SectionHeading}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource Token.Color.TextStrong}" />
                      <StackPanel Spacing="{DynamicResource Token.Spacing.InlineGap}">
                        <TextBlock Text="Working title"
                                   FontSize="{DynamicResource Token.Typography.Label}"
                                   Foreground="{DynamicResource Token.Color.TextSecondary}" />
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="{DynamicResource Token.Spacing.ControlGap}">
                          <TextBox Grid.Column="0"
                                   Text="{Binding ItemInspector.Title}"
                                   IsReadOnly="{Binding !ItemInspector.CanEditShared}"
                                   MinHeight="{DynamicResource Token.Control.MinHeight}"
                                   PlaceholderText="Optional working title"
                                   AutomationProperties.Name="Item working title"
                                   LostFocus="OnDetailsFieldLostFocus" />
                          <Border Grid.Column="1"
                                  Background="Transparent">
                            <StackPanel Spacing="{DynamicResource Token.Spacing.CompactGap}"
                                         ToolTip.Tip="{Binding ItemInspector.OptimizeGuidance}">
                              <Button Padding="{DynamicResource Token.Control.ButtonPadding}"
                                      Content="Optimize"
                                      Command="{Binding ItemInspector.OptimizeCommand}"
                                      IsEnabled="{Binding ItemInspector.CanOptimize}"
                                      AutomationProperties.Name="Optimize title" />
                              <ProgressBar Height="3"
                                           IsVisible="{Binding ItemInspector.IsOptimizing}"
                                           IsIndeterminate="True"
                                           AutomationProperties.Name="Optimizing title"
                                           ToolTip.Tip="Optimizing the working title…" />
                            </StackPanel>
                          </Border>
                        </Grid>
                      </StackPanel>
                      <StackPanel Spacing="4">
                        <TextBlock Text="Idea potential"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="2"
                                    AutomationProperties.Name="{Binding ItemInspector.IdeaRatingLabel}">
                          <TextBlock Text="★" Classes="ideaRatingStar" Classes.selected="{Binding ItemInspector.IsIdeaRatingStar1Selected}" />
                          <TextBlock Text="★" Classes="ideaRatingStar" Classes.selected="{Binding ItemInspector.IsIdeaRatingStar2Selected}" />
                          <TextBlock Text="★" Classes="ideaRatingStar" Classes.selected="{Binding ItemInspector.IsIdeaRatingStar3Selected}" />
                          <TextBlock Text="★" Classes="ideaRatingStar" Classes.selected="{Binding ItemInspector.IsIdeaRatingStar4Selected}" />
                          <TextBlock Text="★" Classes="ideaRatingStar" Classes.selected="{Binding ItemInspector.IsIdeaRatingStar5Selected}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="2">
                          <Button Content="★" Command="{Binding ItemInspector.SetIdeaRatingCommand}" CommandParameter="1" IsEnabled="{Binding ItemInspector.CanEditShared}" ToolTip.Tip="Rate 1 star" AutomationProperties.Name="Rate 1 star" />
                          <Button Content="★" Command="{Binding ItemInspector.SetIdeaRatingCommand}" CommandParameter="2" IsEnabled="{Binding ItemInspector.CanEditShared}" ToolTip.Tip="Rate 2 stars" AutomationProperties.Name="Rate 2 stars" />
                          <Button Content="★" Command="{Binding ItemInspector.SetIdeaRatingCommand}" CommandParameter="3" IsEnabled="{Binding ItemInspector.CanEditShared}" ToolTip.Tip="Rate 3 stars" AutomationProperties.Name="Rate 3 stars" />
                          <Button Content="★" Command="{Binding ItemInspector.SetIdeaRatingCommand}" CommandParameter="4" IsEnabled="{Binding ItemInspector.CanEditShared}" ToolTip.Tip="Rate 4 stars" AutomationProperties.Name="Rate 4 stars" />
                          <Button Content="★" Command="{Binding ItemInspector.SetIdeaRatingCommand}" CommandParameter="5" IsEnabled="{Binding ItemInspector.CanEditShared}" ToolTip.Tip="Rate 5 stars" AutomationProperties.Name="Rate 5 stars" />
                          <Button Content="Clear" Command="{Binding ItemInspector.SetIdeaRatingCommand}" CommandParameter="0" IsEnabled="{Binding ItemInspector.CanEditShared}" ToolTip.Tip="Clear idea rating" AutomationProperties.Name="Clear idea rating" />
                          <TextBlock Text="{Binding ItemInspector.IdeaRatingLabel}" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border IsVisible="{Binding ShowsManualListingDetailsStageTool}"
                          Padding="14"
                          Background="{DynamicResource ElevatedSurfaceBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Listing Details" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" />
                      <TextBlock Text="Record local listing copy, Variant pricing, and fulfillment terms. Tags remain on the Item." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                      <TextBlock Text="Title" FontWeight="SemiBold" />
                      <TextBox Text="{Binding ManualListingDetailsTool.Title, Mode=TwoWay}" AutomationProperties.Name="Listing title" />
                      <TextBlock Text="Description" FontWeight="SemiBold" />
                      <TextBox Text="{Binding ManualListingDetailsTool.Description, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" AutomationProperties.Name="Listing description" />
                      <TextBlock Text="Currency (ISO code)" FontWeight="SemiBold" />
                      <TextBox Text="{Binding ManualListingDetailsTool.Currency, Mode=TwoWay}" MaxLength="3" AutomationProperties.Name="Listing currency" />
                      <TextBlock Text="{Binding ManualListingDetailsTool.OfferingSummary}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding ManualListingDetailsTool.VariantPricingGuidance}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                      <TextBlock Text="Variant pricing and fulfillment cost" FontWeight="SemiBold" />
                      <ItemsControl ItemsSource="{Binding ManualListingDetailsTool.Variants}" IsEnabled="{Binding ManualListingDetailsTool.CanEditFulfillmentTerms}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid ColumnDefinitions="*,120,140" ColumnSpacing="8" Margin="0,2">
                              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                              <TextBox Grid.Column="1" Text="{Binding SellingPrice, Mode=TwoWay}" PlaceholderText="Selling price" AutomationProperties.Name="Variant selling price" />
                              <TextBox Grid.Column="2" Text="{Binding FulfillmentCost, Mode=TwoWay}" PlaceholderText="Fulfillment cost" AutomationProperties.Name="Variant fulfillment cost" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="Shipping option" FontWeight="SemiBold" />
                      <TextBox Text="{Binding ManualListingDetailsTool.ShippingName, Mode=TwoWay}" PlaceholderText="Option name" IsEnabled="{Binding ManualListingDetailsTool.CanEditFulfillmentTerms}" />
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <TextBox Text="{Binding ManualListingDetailsTool.CustomerShippingCharge, Mode=TwoWay}" PlaceholderText="Customer shipping charge" IsEnabled="{Binding ManualListingDetailsTool.CanEditFulfillmentTerms}" />
                        <TextBox Grid.Column="1" Text="{Binding ManualListingDetailsTool.SellerShippingCost, Mode=TwoWay}" PlaceholderText="Expected seller shipping cost" IsEnabled="{Binding ManualListingDetailsTool.CanEditFulfillmentTerms}" />
                      </Grid>
                      <TextBox Text="{Binding ManualListingDetailsTool.DeliveryEstimate, Mode=TwoWay}" PlaceholderText="Delivery estimate (manual, not validated)" IsEnabled="{Binding ManualListingDetailsTool.CanEditFulfillmentTerms}" />
                      <TextBlock Text="{Binding ManualListingDetailsTool.GrossProfitSummary}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                      <TextBlock Text="Gross profit = selling price + customer shipping − fulfillment cost − seller shipping cost." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding ManualListingDetailsTool.Error}" IsVisible="{Binding ManualListingDetailsTool.HasError}" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap" />
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding ManualListingDetailsTool.Status}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <Button Grid.Column="1" Content="Save details" Command="{Binding ManualListingDetailsTool.SaveCommand}" IsEnabled="{Binding ManualListingDetailsTool.CanSave}" />
                      </Grid>
                      <Expander Header="Previous fulfillment setups" IsExpanded="False">
                        <TextBlock Text="{Binding ManualListingDetailsTool.HistorySummary}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                      </Expander>
                    </StackPanel>
                  </Border>

                  <Border IsVisible="{Binding ShowsPrintifyStageTool}"
                          Padding="14"
                          Background="{DynamicResource ElevatedSurfaceBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Printify listing"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource StrongTextBrush}" />
                        <Border Grid.Column="1"
                                Padding="7,2"
                                CornerRadius="8"
                                Background="{DynamicResource SuccessBrush}"
                                AutomationProperties.Name="Printify connection status">
                          <TextBlock Text="{Binding PrintifyTool.ConnectionStatus}" FontSize="11" />
                        </Border>
                      </Grid>
                      <TextBlock Text="{Binding PrintifyTool.Status}" Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBlock Text="{Binding PrintifyTool.ProductSummary}" Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBlock Text="Title" FontWeight="SemiBold" />
                      <TextBox Text="{Binding PrintifyTool.Title, Mode=TwoWay}" AutomationProperties.Name="Printify title" />
                      <TextBlock Text="Description" FontWeight="SemiBold" />
                      <TextBox Text="{Binding PrintifyTool.Description, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" AutomationProperties.Name="Printify description" />
                      <TextBlock Text="Shipping profile" FontWeight="SemiBold" />
                      <TextBox Text="{Binding PrintifyTool.ShippingProfile, Mode=TwoWay}" AutomationProperties.Name="Printify shipping profile" />
                      <TextBlock Text="Out-of-stock policy" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding PrintifyTool.OutOfStockPolicy}"
                                 Foreground="{DynamicResource SecondaryTextBrush}"
                                 AutomationProperties.Name="Printify out-of-stock policy" />
                      <TextBlock Text="Fixed retail price" FontWeight="SemiBold" />
                      <TextBox Text="{Binding PrintifyTool.PriceAmount, Mode=TwoWay}" AutomationProperties.Name="Printify fixed retail price" />
                      <TextBlock Text="{Binding PrintifyTool.VariantSummary}" Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBlock Text="{Binding PrintifyTool.ArtworkSummary}" Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBlock Text="{Binding PrintifyTool.ErrorMessage}"
                                 IsVisible="{Binding PrintifyTool.HasError}"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource DangerTextBrush}"
                                 AutomationProperties.AutomationId="Printify.Error" />
                      <TextBlock Text="{Binding PrintifyTool.FeedbackMessage}"
                                 IsVisible="{Binding PrintifyTool.HasFeedback}"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource StrongTextBrush}" />
                      <Border IsVisible="{Binding PrintifyTool.HasConflict}"
                              Padding="8"
                              Background="{DynamicResource WarningSurfaceBrush}"
                              BorderBrush="{DynamicResource WarningTextBrush}"
                              BorderThickness="1">
                        <StackPanel Spacing="5">
                          <TextBlock Text="Printify changed values outside Fusion Canvas. Choose which values to keep." TextWrapping="Wrap" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding PrintifyTool.ConflictSummary}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="Accept Printify changes" Command="{Binding PrintifyTool.AcceptRemoteCommand}" />
                            <Button Content="Keep Fusion Canvas values" Command="{Binding PrintifyTool.KeepLocalCommand}" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Create / update" Command="{Binding PrintifyTool.CreateOrUpdateCommand}" AutomationProperties.AutomationId="Printify.CreateOrUpdate" />
                        <Button Content="Refresh" Command="{Binding PrintifyTool.RefreshCommand}" />
                        <Button Content="Publish" Command="{Binding PrintifyTool.PublishCommand}" />
                        <Button Content="Unpublish" Command="{Binding PrintifyTool.UnpublishCommand}" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Archive locally" Command="{Binding PrintifyTool.ArchiveCommand}" />
                        <Button Content="Delete remote draft"
                                Command="{Binding PrintifyTool.DeleteCommand}"
                                Classes="danger"
                                IsVisible="{Binding !PrintifyTool.IsDeleteConfirmationVisible}"
                                AutomationProperties.AutomationId="Printify.Delete" />
                        <Border IsVisible="{Binding PrintifyTool.IsDeleteConfirmationVisible}"
                                Background="{DynamicResource DangerBackgroundBrush}"
                                CornerRadius="4"
                                Padding="8"
                                AutomationProperties.Name="Printify delete confirmation">
                          <StackPanel Spacing="6">
                            <TextBlock Text="{Binding PrintifyTool.DeleteConfirmationText}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Button Content="Delete permanently"
                                      Command="{Binding PrintifyTool.ConfirmDeleteCommand}"
                                      Classes="danger"
                                      AutomationProperties.AutomationId="Printify.ConfirmDelete" />
                              <Button Content="Cancel"
                                      Command="{Binding PrintifyTool.CancelDeleteCommand}"
                                      AutomationProperties.AutomationId="Printify.CancelDelete" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border Padding="14"
                          Background="{DynamicResource ElevatedSurfaceBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6"
                          IsVisible="{Binding ShowsIdeaStageTool}"
                          Classes.emphasized="{Binding ItemInspector.EmphasizesIdea}">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Idea"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource StrongTextBrush}" />
                      <TextBox Text="{Binding ItemInspector.Idea}"
                               IsReadOnly="{Binding !ItemInspector.CanEditStage}"
                               AcceptsReturn="True"
                               MinHeight="64"
                               PlaceholderText="What is the original product idea?"
                               AutomationProperties.Name="Original idea"
                               LostFocus="OnDetailsFieldLostFocus" />
                      <TextBlock IsVisible="{Binding !ItemInspector.CanEditStage}"
                                 Text="{Binding ItemInspector.StageReadOnlyReason}"
                                 TextWrapping="Wrap"
                                 FontSize="12"
                                 Foreground="{DynamicResource DangerTextBrush}" />
                    </StackPanel>
                  </Border>

                  <Border Padding="14"
                          Background="{DynamicResource ElevatedSurfaceBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6"
                          IsVisible="{Binding ShowsConceptStageTool}"
                          Classes.emphasized="{Binding ItemInspector.EmphasizesConcept}">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Concept"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource StrongTextBrush}" />
                      <TextBlock Text="Base idea"
                                 FontSize="11"
                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBox Text="{Binding ItemInspector.Idea}"
                               IsReadOnly="True"
                               Classes="readOnlyContext"
                               AcceptsReturn="True"
                               MinHeight="64"
                               AutomationProperties.Name="Base idea" />
                      <TextBlock IsVisible="{Binding !ItemInspector.CanEditStage}"
                                 Text="{Binding ItemInspector.StageReadOnlyReason}"
                                 TextWrapping="Wrap"
                                 FontSize="12"
                                 Foreground="{DynamicResource DangerTextBrush}" />

                      <TextBlock Text="{Binding ConceptRefinement.UnavailableReason}"
                                 IsVisible="{Binding ConceptRefinement.UnavailableReason, Converter={x:Static ObjectConverters.IsNotNull}}"
                                 TextWrapping="Wrap"
                                 FontSize="11"
                                 Foreground="{DynamicResource DangerTextBrush}" />

                      <!-- VR-001: Inline error -->
                      <TextBlock Text="{Binding ConceptRefinement.ErrorMessage}"
                                 IsVisible="{Binding ConceptRefinement.HasError}"
                                 TextWrapping="Wrap"
                                 FontSize="11"
                                 Foreground="{DynamicResource DangerTextBrush}" />

                      <!-- Initialize button -->
                      <Button Content="Initialize from base idea&#x2026;"
                              IsEnabled="{Binding ConceptRefinement.CanInitialize}"
                              IsVisible="{Binding ShowsConceptStageTool}"
                              AutomationProperties.Name="Initialize from base idea"
                              Command="{Binding ConceptRefinement.InitializeCommand}"
                              ToolTip.Tip="{Binding ConceptRefinement.InitializeDisabledReason}"
                              ToolTip.ShowOnDisabled="True" />

                      <!-- VR-009: Visible guidance when Initialize is disabled -->
                      <TextBlock Text="{Binding ConceptRefinement.InitializeDisabledReason}"
                                 IsVisible="{Binding ConceptRefinement.ShowInitializeDisabledReason}"
                                 TextWrapping="Wrap"
                                 FontSize="11"
                                 Foreground="{DynamicResource DangerTextBrush}" />

                      <!-- Per-corner action rows -->
      <Grid RowDefinitions="Auto,Auto,Auto"
            ColumnDefinitions="Auto,*,Auto,Auto"
            RowSpacing="6"
            ColumnSpacing="4"
            IsVisible="{Binding ShowsConceptStageTool}">
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Concept idea:"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Top" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Text="{Binding ConceptRefinement.ConceptIdeaInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding !ItemInspector.CanEditStage}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="72"
                                 VerticalContentAlignment="Top"
                                 AutomationProperties.Name="Refinement Concept idea input"
                                 LostFocus="OnDetailsFieldLostFocus" />
                        <Button Grid.Row="0"
                                Grid.Column="2"
                                Content="Fine tune"
                                VerticalAlignment="Top"
                                IsEnabled="{Binding ConceptRefinement.CanFineTuneConceptIdea}"
                                Command="{Binding ConceptRefinement.FineTuneConceptIdeaCommand}"
                                AutomationProperties.Name="Fine tune Concept idea"
                                ToolTip.Tip="{Binding ConceptRefinement.FineTuneConceptIdeaDisabledReason}"
                                ToolTip.ShowOnDisabled="True" />
                        <Button Grid.Row="0"
                                Grid.Column="3"
                                Content="Change"
                                VerticalAlignment="Top"
                                IsEnabled="{Binding ConceptRefinement.CanChangeConceptIdea}"
                                Command="{Binding ConceptRefinement.ChangeConceptIdeaCommand}"
                                AutomationProperties.Name="Change Concept idea"
                                ToolTip.Tip="{Binding ConceptRefinement.ChangeConceptIdeaDisabledReason}"
                                ToolTip.ShowOnDisabled="True" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="2"
                                 Grid.ColumnSpan="2"
                                 Text="{Binding ConceptRefinement.ConceptIdeaInstructions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding !ItemInspector.CanEditStage}"
                                 PlaceholderText="Instructions"
                                 VerticalAlignment="Bottom"
                                 AutomationProperties.Name="Instructions for Concept idea" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Phrase:"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Top" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Text="{Binding ConceptRefinement.PhraseInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding !ItemInspector.CanEditStage}"
                                 AcceptsReturn="False"
                                 TextWrapping="Wrap"
                                 MinHeight="72"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.Name="Refinement Phrase input"
                                 LostFocus="OnDetailsFieldLostFocus" />
                        <Button Grid.Row="1"
                                Grid.Column="2"
                                Content="Fine tune"
                                VerticalAlignment="Top"
                                IsEnabled="{Binding ConceptRefinement.CanFineTunePhrase}"
                                Command="{Binding ConceptRefinement.FineTunePhraseCommand}"
                                AutomationProperties.Name="Fine tune Phrase"
                                ToolTip.Tip="{Binding ConceptRefinement.FineTunePhraseDisabledReason}"
                                ToolTip.ShowOnDisabled="True" />
                        <Button Grid.Row="1"
                                Grid.Column="3"
                                Content="Change"
                                VerticalAlignment="Top"
                                IsEnabled="{Binding ConceptRefinement.CanChangePhrase}"
                                Command="{Binding ConceptRefinement.ChangePhraseCommand}"
                                AutomationProperties.Name="Change Phrase"
                                ToolTip.Tip="{Binding ConceptRefinement.ChangePhraseDisabledReason}"
                                ToolTip.ShowOnDisabled="True" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="2"
                                 Grid.ColumnSpan="2"
                                 Text="{Binding ConceptRefinement.PhraseInstructions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding !ItemInspector.CanEditStage}"
                                 PlaceholderText="Instructions"
                                 VerticalAlignment="Bottom"
                                 AutomationProperties.Name="Instructions for Phrase" />

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Graphic:"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Top" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding ConceptRefinement.GraphicDirectionInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding !ItemInspector.CanEditStage}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="72"
                                 VerticalContentAlignment="Top"
                                 AutomationProperties.Name="Refinement Graphic direction input"
                                 LostFocus="OnDetailsFieldLostFocus" />
                        <Button Grid.Row="2"
                                Grid.Column="2"
                                Content="Fine tune"
                                VerticalAlignment="Top"
                                IsEnabled="{Binding ConceptRefinement.CanFineTuneGraphicDirection}"
                                Command="{Binding ConceptRefinement.FineTuneGraphicDirectionCommand}"
                                AutomationProperties.Name="Fine tune Graphic direction"
                                ToolTip.Tip="{Binding ConceptRefinement.FineTuneGraphicDirectionDisabledReason}"
                                ToolTip.ShowOnDisabled="True" />
                        <Button Grid.Row="2"
                                Grid.Column="3"
                                Content="Change"
                                VerticalAlignment="Top"
                                IsEnabled="{Binding ConceptRefinement.CanChangeGraphicDirection}"
                                Command="{Binding ConceptRefinement.ChangeGraphicDirectionCommand}"
                                AutomationProperties.Name="Change Graphic direction"
                                ToolTip.Tip="{Binding ConceptRefinement.ChangeGraphicDirectionDisabledReason}"
                                ToolTip.ShowOnDisabled="True" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="2"
                                 Grid.ColumnSpan="2"
                                 Text="{Binding ConceptRefinement.GraphicDirectionInstructions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding !ItemInspector.CanEditStage}"
                                 PlaceholderText="Instructions"
                                 VerticalAlignment="Bottom"
                                 AutomationProperties.Name="Instructions for Graphic direction" />
                      </Grid>

                      <!-- Score -->
                      <TextBlock IsVisible="{Binding ShowsConceptStageTool}"
                                 FontSize="11"
                                 Foreground="{DynamicResource SecondaryTextBrush}">
                        <Run Text="Triangle completeness: " />
                        <Run Text="{Binding ConceptRefinement.Score}" />
                        <Run Text="%" />
                      </TextBlock>

                      <!-- VR-007c: Busy indicator -->
                      <ProgressBar IsVisible="{Binding ConceptRefinement.IsBusy}"
                                   IsIndeterminate="True"
                                   Height="3"
                                   AutomationProperties.Name="Refining concept" />
                      <TextBlock Text="Refinement in progress&#x2026;"
                                 IsVisible="{Binding ConceptRefinement.IsBusy}"
                                 FontSize="11"
                                 Foreground="{DynamicResource SecondaryTextBrush}" />

                      <!-- VR-007a/007d: History list, hidden when empty, disabled in read-only -->
                      <ListBox ItemsSource="{Binding ConceptRefinement.History}"
                               IsVisible="{Binding ConceptRefinement.HasHistory}"
                               IsEnabled="{Binding ItemInspector.CanEditStage}"
                               MaxHeight="160"
                               ScrollViewer.VerticalScrollBarVisibility="Auto"
                               SelectionMode="Single"
                               SelectedItem="{Binding ConceptRefinement.SelectedHistoryEntry, Mode=TwoWay}"
                               SelectedIndex="{Binding ConceptRefinement.CurrentEntryIndex, Mode=OneWay}">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="cref:ConceptRefinementHistoryEntry">
                            <TextBlock Text="{Binding Label}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis" />
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>

                      <!-- SLL generation section -->
                      <Separator Margin="0,4"
                                 IsVisible="{Binding ShowsConceptStageTool}" />
                      <TextBlock Text="Generate SLL sketch"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource StrongTextBrush}"
                                 IsVisible="{Binding ShowsConceptStageTool}" />
                      <Border Padding="8"
                              Background="{DynamicResource AccentSoftBackgroundBrush}"
                              BorderBrush="{DynamicResource AccentSoftBorderBrush}"
                              BorderThickness="1"
                              CornerRadius="4"
                              Focusable="False"
                              IsVisible="{Binding ShowsConceptStageTool}"
                              AutomationProperties.Name="SLL explanation"
                              AutomationProperties.HelpText="SLL stands for Symbolic Layout Languate. It's a rough visual sketch of the proposed design.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="ⓘ"
                                     FontSize="16"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource AccentSoftForegroundBrush}"
                                     VerticalAlignment="Top"
                                     Focusable="False"
                                     IsHitTestVisible="False" />
                          <TextBlock Text="SLL stands for Symbolic Layout Languate. It's a rough visual sketch of the proposed design."
                                     TextWrapping="Wrap"
                                     FontSize="12"
                                     Foreground="{DynamicResource AccentSoftForegroundBrush}" />
                        </StackPanel>
                      </Border>
                      <TextBlock Text="{Binding SllGeneration.UnavailableReason}"
                                 IsVisible="{Binding SllGeneration.UnavailableReason, Converter={x:Static ObjectConverters.IsNotNull}}"
                                 TextWrapping="Wrap"
                                 FontSize="11"
                                 Foreground="{DynamicResource DangerTextBrush}" />

                      <TextBlock Text="{Binding SllGeneration.ErrorMessage}"
                                 IsVisible="{Binding SllGeneration.HasError}"
                                 TextWrapping="Wrap"
                                 FontSize="11"
                                 Foreground="{DynamicResource DangerTextBrush}" />

                      <Button Content="Generate SLL&#x2026;"
                              IsEnabled="{Binding SllGeneration.CanGenerate}"
                              IsVisible="{Binding ShowsConceptStageTool}"
                              AutomationProperties.Name="Generate SLL sketch"
                              Command="{Binding SllGeneration.GenerateCommand}"
                              ToolTip.Tip="{Binding SllGeneration.GenerateDisabledReason}"
                              ToolTip.ShowOnDisabled="True" />

                      <Button Content="Regenerate SLL&#x2026;"
                              IsEnabled="{Binding SllGeneration.CanRegenerate}"
                              IsVisible="{Binding ShowsConceptStageTool}"
                              AutomationProperties.Name="Regenerate SLL sketch"
                              Command="{Binding SllGeneration.RegenerateCommand}"
                              ToolTip.Tip="{Binding SllGeneration.RegenerateDisabledReason}"
                              ToolTip.ShowOnDisabled="True" />

                      <TextBlock Text="SLL generation in progress&#x2026;"
                                 IsVisible="{Binding SllGeneration.IsBusy}"
                                 FontSize="11"
                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                      <ProgressBar IsVisible="{Binding SllGeneration.IsBusy}"
                                   IsIndeterminate="True"
                                   Height="3"
                                   AutomationProperties.Name="Generating SLL sketch" />

                      <TextBlock Text="This sketch is stale — complete the triangle to regenerate."
                                 IsVisible="{Binding SllGeneration.IsStale}"
                                 TextWrapping="Wrap"
                                 FontSize="11"
                                 Foreground="{DynamicResource WarningTextBrush}" />

                      <StackPanel Orientation="Horizontal" Spacing="6"
                                  IsVisible="{Binding SllGeneration.IsStale}">
                        <Button Content="Reset SLL"
                                Command="{Binding SllGeneration.ResetSllCommand}"
                                AutomationProperties.Name="Reset stale SLL" />
                        <Button Content="Keep for reference"
                                Command="{Binding SllGeneration.KeepSllReferenceCommand}"
                                AutomationProperties.Name="Keep stale SLL for reference" />
                      </StackPanel>

                      <TextBox Text="{Binding SllGeneration.AsciiSketch}"
                               IsReadOnly="True"
                               IsVisible="{Binding SllGeneration.HasCurrentSll}"
                               AcceptsReturn="True"
                               TextWrapping="NoWrap"
                               FontFamily="Consolas,Menlo,monospace"
                               FontSize="11"
                               MinHeight="120"
                               AutomationProperties.Name="Generated SLL sketch"
                               ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                     </StackPanel>
                  </Border>

                  <Border Padding="14"
                          Background="{DynamicResource ElevatedSurfaceBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Notes"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource StrongTextBrush}" />
                      <TextBox Text="{Binding ItemInspector.Notes}"
                               IsReadOnly="{Binding !ItemInspector.CanEditShared}"
                               AcceptsReturn="True"
                               MinHeight="80"
                               PlaceholderText="Plain-text notes"
                               AutomationProperties.Name="Item notes"
                               LostFocus="OnDetailsFieldLostFocus" />
                    </StackPanel>
                  </Border>

                  <Border Padding="14"
                          Background="{DynamicResource ElevatedSurfaceBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Tags"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource StrongTextBrush}" />
                      <ItemsControl ItemsSource="{Binding ItemInspector.TagDraft}">
                        <ItemsControl.ItemContainerTheme>
                          <ControlTheme TargetType="ContentPresenter">
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                          </ControlTheme>
                        </ItemsControl.ItemContainerTheme>
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <Border Padding="8,3"
                                    CornerRadius="10"
                                    Background="{DynamicResource AccentSoftBackgroundBrush}"
                                    BorderBrush="{DynamicResource AccentSoftBorderBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,6,6"
                                    HorizontalAlignment="Left">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding}"
                                           FontSize="12"
                                           Foreground="{DynamicResource AccentSoftForegroundBrush}"
                                           VerticalAlignment="Center" />
                                <Button Content="×"
                                        Padding="0"
                                        Width="18"
                                        Height="18"
                                        FontSize="13"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource AccentSoftForegroundBrush}"
                                        ToolTip.Tip="Remove tag"
                                        Command="{Binding $parent[ItemsControl].DataContext.ItemInspector.RemoveTagCommand}"
                                        CommandParameter="{Binding}" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock IsVisible="{Binding !ItemInspector.HasTags}"
                                 Text="No tags yet."
                                 FontSize="12"
                                 Foreground="{DynamicResource MutedTextBrush}" />
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Text="{Binding ItemInspector.TagInput}"
                                 IsEnabled="{Binding ItemInspector.CanEditShared}"
                                 MinHeight="32"
                                 PlaceholderText="Add a tag" />
                        <Button Grid.Column="1"
                                Content="Add"
                                IsEnabled="{Binding ItemInspector.CanEditShared}"
                                Command="{Binding ItemInspector.AddTagCommand}"
                                Classes="storeSecondary" />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Border IsVisible="{Binding ShowsDesignStageTool}"
                          Padding="14"
                          Background="{DynamicResource ElevatedSurfaceBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6"
                          Classes.emphasized="{Binding ItemInspector.EmphasizesDesign}">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Design"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource StrongTextBrush}" />

                      <!-- Read-only banner -->
                      <TextBlock IsVisible="{Binding DesignTool.IsReadOnly}"
                                 Text="{Binding DesignTool.ReadOnlyReason}"
                                 TextWrapping="Wrap"
                                 FontSize="12"
                                 Foreground="{DynamicResource DangerTextBrush}" />

                      <!-- Configuration -->
                      <TextBlock Text="Listing Configuration"
                                 FontSize="13" FontWeight="SemiBold"
                                 Foreground="{DynamicResource StrongTextBrush}" />

                      <StackPanel IsVisible="{Binding DesignTool.ShowsUnconfiguredState}" Spacing="8">
                        <TextBlock Text="Select a listing configuration to show the design slot grid."
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <ComboBox ItemsSource="{Binding DesignTool.AvailableOfferings}"
                                  DisplayMemberBinding="{Binding Name}"
                                  SelectedItem="{Binding DesignTool.SelectedOffering}"
                                  IsEnabled="{Binding !DesignTool.IsReadOnly}"
                                  AutomationProperties.Name="Select configuration" />
                      </StackPanel>

                      <StackPanel IsVisible="{Binding DesignTool.ShowsConfiguredState}" Spacing="4">
                        <ComboBox x:Name="DesignConfigurationComboBox"
                                  ItemsSource="{Binding DesignTool.AvailableOfferings}"
                                  DisplayMemberBinding="{Binding Name}"
                                  SelectedItem="{Binding DesignTool.SelectedOffering}"
                                  IsEnabled="{Binding !DesignTool.IsReadOnly}"
                                  AutomationProperties.Name="Change configuration"
                                  AutomationProperties.AutomationId="Design.ConfigurationSelector" />
<TextBlock Text="{Binding DesignTool.SelectedOfferingName, StringFormat='Selected: {0}'}"
                                           TextWrapping="Wrap"
                                           FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding DesignTool.SelectedOfferingStatus}"
                                   IsVisible="{Binding DesignTool.SelectedOfferingStatus, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   TextWrapping="Wrap"
                                   FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding DesignTool.SelectedBlueprintName, StringFormat='Blueprint: {0}'}"
                                   IsVisible="{Binding DesignTool.SelectedBlueprintName, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   TextWrapping="Wrap"
                                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding DesignTool.ProviderNetworkWarning}"
                                   IsVisible="{Binding DesignTool.ProviderNetworkWarning, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   TextWrapping="Wrap"
                                   FontSize="11" Foreground="{DynamicResource WarningTextBrush}" />
                        <Border IsVisible="{Binding DesignTool.HasOfferingReadiness}"
                                Padding="10"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                AutomationProperties.AutomationId="Design.OfferingReadiness">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Catalog and mockup setup" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DesignTool.OfferingReadinessSummary}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       AutomationProperties.Name="Design Offering readiness" />
                            <TextBlock Text="{Binding DesignTool.ReadyMockupTemplateCount, StringFormat='{}{0} ready Mockup Templates'}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <ItemsControl ItemsSource="{Binding DesignTool.OfferingReadinessGuidance}"
                                          IsVisible="{Binding DesignTool.HasOfferingReadinessGuidance}"
                                          AutomationProperties.Name="Design Offering readiness guidance">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding}"
                                             TextWrapping="Wrap"
                                             Foreground="{DynamicResource WarningTextBrush}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                      </StackPanel>

                      <StackPanel IsVisible="{Binding DesignTool.HasStaleConfiguration}"
                                  Spacing="8"
                                  KeyDown="OnRecoveryConfirmationKeyDown">
                        <TextBlock Text="{Binding DesignTool.StaleConfigurationDisplayName, StringFormat='Unavailable configuration: {0}'}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningTextBrush}" />
                        <TextBlock Text="{Binding DesignTool.RecoveryGuidance}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <ComboBox x:Name="RecoveryOfferingComboBox"
                                  ItemsSource="{Binding DesignTool.RecoveryOfferings}"
                                  DisplayMemberBinding="{Binding Name}"
                                  SelectedItem="{Binding DesignTool.SelectedRecoveryOffering}"
                                  IsEnabled="{Binding DesignTool.CanChooseRecoveryOffering}"
                                  PlaceholderText="Choose an active replacement"
                                  AutomationProperties.Name="Replacement listing configuration" />
                        <Border IsVisible="{Binding DesignTool.IsRecoveryConfirmationVisible}"
                                Padding="12"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource WarningTextBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                          <StackPanel Spacing="8">
                            <TextBlock Text="{Binding DesignTool.RecoveryConfirmationMessage}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Button x:Name="ConfirmConfigurationRecoveryButton"
                                      Content="Replace configuration"
                                      Classes="danger"
                                      Click="OnConfirmConfigurationRecovery"
                                      IsEnabled="{Binding !DesignTool.IsBusy}"
                                      AutomationProperties.Name="Confirm replacement listing configuration" />
                              <Button Content="Cancel"
                                      Classes="storeSecondary"
                                      Click="OnCancelConfigurationRecovery"
                                      IsEnabled="{Binding !DesignTool.IsBusy}"
                                      AutomationProperties.Name="Cancel replacement listing configuration" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </StackPanel>

                      <!-- Color Working Set -->
                      <StackPanel IsVisible="{Binding DesignTool.ShowsConfiguredState}" Spacing="6">
                         <TextBlock Text="Color Working Set" FontSize="{DynamicResource Token.Typography.SectionHeading}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource StrongTextBrush}" />
                         <TextBlock Text="Select the colors this design will use." TextWrapping="Wrap" FontSize="{DynamicResource Token.Typography.Helper}"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                        <ItemsControl ItemsSource="{Binding DesignTool.AvailableColors}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="stageTools:DesignColorViewModel">
                              <ToggleButton Content="{Binding ColorValue}"
                                            IsChecked="{Binding IsSelected}"
                                            IsEnabled="{Binding !IsReadOnly}"
                                            Click="OnColorToggle"
                                            Classes="compactChip" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                         <TextBlock Text="Selected colors" FontSize="{DynamicResource Token.Typography.Label}" FontWeight="SemiBold"
                                    Foreground="{DynamicResource StrongTextBrush}" />
                         <ItemsControl ItemsSource="{Binding DesignTool.SelectedColors}">
                           <ItemsControl.ItemsPanel>
                             <ItemsPanelTemplate>
                               <StackPanel Spacing="{DynamicResource Token.Spacing.SelectedColorRowGap}" />
                             </ItemsPanelTemplate>
                           </ItemsControl.ItemsPanel>
                           <ItemsControl.ItemTemplate>
                             <DataTemplate x:DataType="stageTools:DesignColorViewModel">
                               <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                                 <TextBlock Text="{Binding ColorValue}"
                                            Width="{DynamicResource Token.Control.SelectedColorLabelWidth}"
                                            Foreground="{DynamicResource PrimaryTextBrush}" />
                                <Button Grid.Column="1" Content="Make specific"
                                        IsEnabled="{Binding !IsReadOnly}"
                                        Click="OnMakeSpecificForColor"
                                         Tag="{Binding ColorValue}"
                                         Classes="compactAction"
                                        AutomationProperties.Name="Make specific design for color" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>

                      <!-- Row x Area Slot Grid -->
                      <StackPanel IsVisible="{Binding DesignTool.ShowsConfiguredState}" Spacing="6">
                         <TextBlock Text="Design Slot Grid" FontSize="{DynamicResource Token.Typography.SectionHeading}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource StrongTextBrush}" />
                        <ItemsControl ItemsSource="{Binding DesignTool.Rows}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="stageTools:DesignRowViewModel">
                              <Border Padding="8" Margin="0,4"
                                      Background="{DynamicResource PanelSurfaceBrush}"
                                      BorderBrush="{DynamicResource SubtleBorderBrush}"
                                      BorderThickness="1" CornerRadius="6">
                                <StackPanel Spacing="6">
                                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                     <TextBlock Text="{Binding ColorChips}" FontSize="{DynamicResource Token.Typography.Label}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <Button Grid.Column="1" Content="Remove row"
                                            IsVisible="{Binding CanRemove}"
                                            Click="OnRemoveSpecificRow"
                                             Tag="{Binding RowId}"
                                             Classes="compactAction" />
                                  </Grid>
                                  <ItemsControl ItemsSource="{Binding Slots}">
                                    <ItemsControl.ItemsPanel>
                                      <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                      </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="stageTools:DesignSlotViewModel">
                                        <Border Padding="4"
                                                Background="{DynamicResource SubtleSurfaceBrush}"
                                                BorderBrush="{DynamicResource SubtleBorderBrush}"
                                                BorderThickness="1" CornerRadius="4"
                                                 Width="{DynamicResource Token.Control.DesignStageSlotCardWidth}" MinHeight="100"
                                                DragDrop.AllowDrop="{Binding !IsReadOnly}"
                                                DragDrop.DragOver="OnSlotDragOver"
                                                DragDrop.Drop="OnSlotDrop"
                                                AutomationProperties.Name="{Binding AreaName, StringFormat='Final design artwork slot: {0}'}">
                                          <StackPanel Spacing="4">
                                             <TextBlock Text="Final design artwork" FontSize="{DynamicResource Token.Typography.Label}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                             <TextBlock Text="{Binding AreaName}" FontSize="{DynamicResource Token.Typography.Label}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                             <TextBlock Text="{Binding PlaceholderDetails}" FontSize="{DynamicResource Token.Typography.Helper}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                            <Border IsVisible="{Binding ShowsContentRiskWarning}"
                                                    Padding="5"
                                                    Background="{DynamicResource PanelSurfaceBrush}"
                                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                                    BorderThickness="1">
                                              <StackPanel Spacing="3">
                                                <TextBlock Text="Content risk review"
                                                            FontSize="{DynamicResource Token.Typography.Label}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource WarningTextBrush}" />
                                                <TextBlock Text="{Binding ContentRiskWarningText}"
                                                           TextWrapping="Wrap"
                                                            FontSize="{DynamicResource Token.Typography.Helper}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <Button Content="View review details"
                                                        Command="{Binding ToggleContentRiskDetailsCommand}"
                                                         Classes="compactAction"
                                                        AutomationProperties.Name="View content risk review details" />
                                                <TextBlock Text="{Binding ContentRiskDetailsText}"
                                                           IsVisible="{Binding IsContentRiskDetailsExpanded}"
                                                           TextWrapping="Wrap"
                                                            FontSize="{DynamicResource Token.Typography.Helper}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                              </StackPanel>
                                            </Border>
                                             <Border IsVisible="{Binding HasImage}"
                                                     Width="{DynamicResource Token.Media.DesignStageThumbnailWidth}"
                                                     Height="{DynamicResource Token.Media.DesignStageThumbnailHeight}"
                                                    Background="{DynamicResource PanelSurfaceBrush}" CornerRadius="4">
<Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                            </Border>
                                             <Border IsVisible="{Binding !HasImage}"
                                                     Width="{DynamicResource Token.Media.DesignStageThumbnailWidth}"
                                                     Height="{DynamicResource Token.Media.DesignStageThumbnailHeight}"
                                                    Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="4"
                                                    BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
                                              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                                 <TextBlock Text="Drop artwork here" FontSize="{DynamicResource Token.Typography.Label}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           HorizontalAlignment="Center" />
                                                 <TextBlock Text="PNG only · drag and drop" FontSize="{DynamicResource Token.Typography.Helper}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           HorizontalAlignment="Center" />
                                              </StackPanel>
                                            </Border>
                                            <Button Content="{Binding ArtworkUploadActionText}"
                                                    IsEnabled="{Binding !IsReadOnly}"
                                                    Click="OnBrowseSlotImage"
                                                    Tag="{Binding .}"
                                                     Classes="compactAction"
                                                    ToolTip.Tip="Browse for a PNG final design artwork or replace the current artwork"
                                                    AutomationProperties.Name="{Binding ArtworkUploadAccessibleName}" />
                                            <StackPanel IsVisible="{Binding HasImage}"
                                                          Orientation="Horizontal" Spacing="2"
                                                          HorizontalAlignment="Center">
                                              <Button Content="Enlarge" Click="OnViewSlotImage"
                                                      Tag="{Binding .}"
                                                      IsEnabled="{Binding CanPreview}"
                                                       Classes="compactAction"
                                                      ToolTip.Tip="Open a larger preview of this final design artwork"
                                                      AutomationProperties.Name="{Binding ArtworkPreviewAccessibleName}" />
                                              <Button Content="Download" Click="OnExportSlotImage"
                                                      Tag="{Binding .}"
                                                      IsEnabled="{Binding CanExport}"
                                                       Classes="compactAction"
                                                      ToolTip.Tip="Download a copy of this final design artwork"
                                                      AutomationProperties.Name="Download final design artwork" />
                                              <Button Content="Remove color" Click="OnRemoveColorFromImage"
                                                      Tag="{Binding .}"
                                                      IsEnabled="{Binding CanRemoveColor}"
                                                       Classes="compactAction"
                                                      ToolTip.Tip="Remove a color globally from this final design artwork"
                                                      ToolTip.ShowOnDisabled="True"
                                                      AutomationProperties.Name="Remove a color globally" />
                                            </StackPanel>
                                            <Button Content="Remove" IsEnabled="{Binding !IsReadOnly}"
                                                    Tag="{Binding .}"
                                                    Click="OnRemoveSlotImage"
                                                    HorizontalAlignment="Stretch"
                                                     Classes="compactAction"
                                                    ToolTip.Tip="Remove this final design artwork from the slot"
                                                    AutomationProperties.Name="Remove final design artwork" />
                                             <TextBlock IsVisible="{Binding IsMissing}" Text="Missing" FontSize="{DynamicResource Token.Typography.Label}"
                                                       Foreground="{DynamicResource DangerTextBrush}" />
                                          </StackPanel>
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>

                      <!-- Supporting Images -->
                      <StackPanel Spacing="6">
                         <TextBlock Text="Supporting Images" FontSize="{DynamicResource Token.Typography.SectionHeading}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource StrongTextBrush}" />
                         <TextBlock Text="Sketches, references, and existing artwork." TextWrapping="Wrap" FontSize="{DynamicResource Token.Typography.Helper}"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <Button Content="Import supporting image&#x2026;"
                                IsEnabled="{Binding !DesignTool.IsReadOnly}"
                                Click="OnImportSupportingImage"
                                Classes="storeSecondary"
                                AutomationProperties.Name="Import supporting image"
                                AutomationProperties.AutomationId="Design.ImportSupportingImage" />
                        <ItemsControl ItemsSource="{Binding DesignTool.SupportingImages}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="stageTools:DesignSlotViewModel">
                              <Border Padding="4" Margin="2"
                                      Background="{DynamicResource SubtleSurfaceBrush}"
                                      BorderBrush="{DynamicResource SubtleBorderBrush}"
                                       BorderThickness="1" CornerRadius="4"
                                       Width="{DynamicResource Token.Control.DesignStageSupportingCardWidth}">
                                <StackPanel Spacing="2">
                                  <Border Width="{DynamicResource Token.Media.DesignStageThumbnailWidth}"
                                          Height="{DynamicResource Token.Media.DesignStageThumbnailHeight}"
                                          Background="{DynamicResource PanelSurfaceBrush}" CornerRadius="4">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                  </Border>
                                   <TextBlock Text="{Binding AreaName}" FontSize="{DynamicResource Token.Typography.Label}"
                                              Foreground="{DynamicResource PrimaryTextBrush}"
                                              TextTrimming="CharacterEllipsis"
                                              MaxWidth="{DynamicResource Token.Media.DesignStageThumbnailWidth}" />
                                  <TextBlock Text="{Binding ArtworkWarning}"
                                             IsVisible="{Binding ArtworkWarning, Converter={x:Static ObjectConverters.IsNotNull}}"
                                              TextWrapping="Wrap" FontSize="{DynamicResource Token.Typography.Helper}"
                                             Foreground="{DynamicResource WarningTextBrush}" />
                                  <Border IsVisible="{Binding ShowsContentRiskWarning}"
                                          Padding="5"
                                          Background="{DynamicResource PanelSurfaceBrush}"
                                          BorderBrush="{DynamicResource ControlBorderBrush}"
                                          BorderThickness="1">
                                    <StackPanel Spacing="3">
                                      <TextBlock Text="Content risk review"
                                                  FontSize="{DynamicResource Token.Typography.Label}"
                                                 FontWeight="SemiBold"
                                                 Foreground="{DynamicResource WarningTextBrush}" />
                                      <TextBlock Text="{Binding ContentRiskWarningText}"
                                                 TextWrapping="Wrap"
                                                  FontSize="{DynamicResource Token.Typography.Helper}"
                                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                                      <Button Content="View review details"
                                              Command="{Binding ToggleContentRiskDetailsCommand}"
                                               Classes="compactAction"
                                              AutomationProperties.Name="View content risk review details" />
                                      <TextBlock Text="{Binding ContentRiskDetailsText}"
                                                 IsVisible="{Binding IsContentRiskDetailsExpanded}"
                                                 TextWrapping="Wrap"
                                                  FontSize="{DynamicResource Token.Typography.Helper}"
                                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                  </Border>
                                  <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Content="View" Click="OnViewSupportingImage"
                                            Tag="{Binding .}"
                                            IsEnabled="{Binding CanPreview}"
                                             Classes="compactAction" />
                                    <Button Content="Download" Click="OnExportSupportingImage"
                                            Tag="{Binding .}"
                                            IsEnabled="{Binding CanExport}"
                                             Classes="compactAction" />
                                    <Button Content="Remove color" Click="OnRemoveColorFromImage"
                                            Tag="{Binding .}"
                                            IsEnabled="{Binding CanRemoveColor}"
                                             Classes="compactAction"
                                            ToolTip.Tip="{Binding ColorRemovalAvailabilityMessage}"
                                            ToolTip.ShowOnDisabled="True"
                                            AutomationProperties.Name="Remove a color globally" />
                                    <Button Content="Remove" IsEnabled="{Binding !IsReadOnly}"
                                            Tag="{Binding .}"
                                            Click="OnRemoveSupportingImage"
                                             Classes="compactAction" />
                                  </StackPanel>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>

                      <!-- Artwork generation target -->
                      <StackPanel Spacing="6">
                        <TextBlock Text="Generate Artwork" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource StrongTextBrush}" />
                        <TextBlock Text="{Binding DesignTool.ArtworkGenerationGuidance}"
                                   TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <ComboBox ItemsSource="{Binding DesignTool.ArtworkTargets}"
                                  SelectedValue="{Binding DesignTool.SelectedArtworkTargetId, Mode=TwoWay}"
                                  SelectedValueBinding="{Binding Id}"
                                  DisplayMemberBinding="{Binding Name}"
                                  IsEnabled="{Binding !DesignTool.IsReadOnly}"
                                  AutomationProperties.Name="Artwork target Design Area"
                                  AutomationProperties.AutomationId="Design.ArtworkTargetSelector" />
                        <CheckBox Content="Transparent Background"
                                  IsChecked="{Binding DesignTool.TransparentBackground, Mode=TwoWay}"
                                  IsEnabled="{Binding DesignTool.CanUseTransparentBackground}"
                                  AutomationProperties.Name="Transparent Background"
                                  AutomationProperties.AutomationId="Design.TransparentBackground" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Button Content="Generate"
                                  Command="{Binding DesignTool.GenerateArtworkCommand}"
                                  IsEnabled="{Binding DesignTool.CanGenerateArtwork}"
                                  AutomationProperties.Name="Generate Artwork"
                                  AutomationProperties.AutomationId="Design.GenerateArtwork" />
                          <Button Content="Cancel"
                                  Command="{Binding DesignTool.CancelArtworkCommand}"
                                  IsVisible="{Binding DesignTool.IsArtworkBusy}"
                                  AutomationProperties.Name="Cancel artwork generation" />
                        </StackPanel>
                        <TextBlock Text="{Binding DesignTool.ArtworkProgress}"
                                   IsVisible="{Binding DesignTool.IsArtworkBusy}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <ProgressBar IsVisible="{Binding DesignTool.IsArtworkBusy}"
                                     IsIndeterminate="True"
                                     Height="3"
                                     AutomationProperties.Name="Generating artwork" />
                      </StackPanel>

                      <!-- Error message -->
                      <TextBlock IsVisible="{Binding DesignTool.ErrorMessage}"
                                 Text="{Binding DesignTool.ErrorMessage}"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource DangerTextBrush}"
                                 AutomationProperties.Name="Design error"
                                 AutomationProperties.AutomationId="Design.Error" />

                      <!-- Removal confirmation -->
                      <Border IsVisible="{Binding DesignTool.IsRemovalConfirmationVisible}"
                              Padding="12"
                              Background="{DynamicResource SubtleSurfaceBrush}"
                              BorderBrush="{DynamicResource ControlBorderBrush}"
                              BorderThickness="1"
                              CornerRadius="6">
                        <StackPanel Spacing="8">
                          <TextBlock Text="{Binding DesignTool.RemovalConfirmationMessage}"
                                     TextWrapping="Wrap"
                                     FontSize="12"
                                     Foreground="{DynamicResource PrimaryTextBrush}" />
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Confirm remove"
                                    Classes="danger"
                                    Click="OnConfirmRemoval"
                                    AutomationProperties.Name="Confirm remove design image" />
                            <Button Content="Cancel"
                                    Classes="storeSecondary"
                                    Click="OnCancelRemoval"
                                    AutomationProperties.Name="Cancel design image removal" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>

                  <Border IsVisible="{Binding ShowsListingStageTool}"
                          Padding="14"
                          Background="{DynamicResource ElevatedSurfaceBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Listing"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource StrongTextBrush}" />
                      <TextBlock Text="{Binding ListingTool.StatusSummary}"
                                 TextWrapping="Wrap"
                                 FontSize="12"
                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBlock Text="Marketplace fields, mockups, and external publishing are outside this basic local workflow."
                                 TextWrapping="Wrap"
                                 FontSize="12"
                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBlock Text="Mockup template" FontWeight="SemiBold" />
                      <ComboBox ItemsSource="{Binding ListingTool.Templates}"
                                SelectedItem="{Binding ListingTool.SelectedTemplate, Mode=TwoWay}"
                                DisplayMemberBinding="{Binding Name}"
                                AutomationProperties.Name="Mockup template"
                                AutomationProperties.AutomationId="Listing.MockupTemplateSelector" />
                      <TextBlock Text="{Binding ListingTool.BlockedReason}"
                                 IsVisible="{Binding ListingTool.HasBlockedReason}"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource WarningTextBrush}" />
                      <ItemsControl ItemsSource="{Binding ListingTool.TemplateDiagnostics}"
                                    AutomationProperties.Name="Mockup template readiness diagnostics"
                                    AutomationProperties.AutomationId="Listing.TemplateDiagnostics">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Spacing="2" Margin="0,2,0,0">
                              <TextBlock Text="{Binding TemplateName, StringFormat='{}{0}'}" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding Guidance}" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" />
                              <TextBlock Text="{Binding CoverageSummary}" IsVisible="{Binding HasCoverageSummary}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                              <TextBlock Text="{Binding CoverageAffectedVariantGuidance}"
                                         IsVisible="{Binding HasCoverageAffectedVariantGuidance}"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource SecondaryTextBrush}"
                                         AutomationProperties.Name="Affected Variant mockup guidance" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="Open Store settings → Mockup Templates to correct these items."
                                 IsVisible="{Binding ListingTool.HasTemplateDiagnostics}"
                                 TextWrapping="Wrap"
                                 FontSize="11"
                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                      <Button Content="Apply mockup template"
                              Command="{Binding ListingTool.ApplyCommand}"
                              IsEnabled="{Binding ListingTool.CanApply}"
                              AutomationProperties.Name="Apply mockup template"
                              AutomationProperties.AutomationId="Listing.ApplyMockupTemplate" />
                      <TextBlock IsVisible="{Binding ListingTool.IsBusy}" Text="Generating mockups…" />
                      <TextBlock Text="{Binding ListingTool.StaleMessage}"
                                 IsVisible="{Binding ListingTool.HasStaleMessage}"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource WarningTextBrush}"
                                 AutomationProperties.Name="Mockup freshness notice"
                                 AutomationProperties.AutomationId="Listing.MockupStaleNotice" />
                      <StackPanel Orientation="Horizontal"
                                  Spacing="8"
                                  IsVisible="{Binding ListingTool.IsBusy}">
                        <ProgressBar Width="120"
                                     Height="3"
                                     IsIndeterminate="True"
                                     AutomationProperties.Name="Generating mockups" />
                        <TextBlock Text="Generating mockups…"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Text="{Binding ListingTool.ErrorMessage}"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource DangerTextBrush}"
                                 AutomationProperties.Name="Listing error"
                                 AutomationProperties.AutomationId="Listing.Error" />
                      <TextBlock Text="{Binding ListingTool.FeedbackMessage}"
                                 IsVisible="{Binding ListingTool.HasFeedback}"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource StrongTextBrush}"
                                 AutomationProperties.Name="Listing feedback"
                                 AutomationProperties.AutomationId="Listing.Feedback" />
                      <TextBlock Text="No mockups yet. Apply a template to generate mockups for review."
                                 IsVisible="{Binding ListingTool.IsEmpty}"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource SecondaryTextBrush}"
                                 AutomationProperties.Name="No generated mockups" />
                      <ItemsControl ItemsSource="{Binding ListingTool.Outputs}"
                                    AutomationProperties.Name="Generated mockup outputs"
                                    AutomationProperties.AutomationId="Listing.MockupOutputs">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="stageTools:MockupOutputViewModel">
                            <Border Margin="0,4,0,0"
                                    Padding="8"
                                    Background="{DynamicResource ElevatedSurfaceBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                              <Grid ColumnDefinitions="96,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                                <Border Grid.RowSpan="3"
                                        Width="88"
                                        Height="88"
                                        Background="{DynamicResource ApplicationBackgroundBrush}"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left">
                                  <Image Source="{Binding Thumbnail}"
                                         IsVisible="{Binding !IsMissing}"
                                         Stretch="Uniform"
                                         Margin="4" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           TextWrapping="Wrap"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource StrongTextBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding ColorValue, StringFormat='Color: {0}'}"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{Binding TemplateLabel}"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="1" Grid.RowSpan="3"
                                           Text="Preview unavailable — the managed mockup file is missing."
                                           IsVisible="{Binding IsMissing}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource WarningTextBrush}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Grid.RowSpan="3"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Spacing="4">
                                  <Button Content="View"
                                          Command="{Binding PreviewCommand}"
                                          AutomationProperties.Name="View mockup"
                                          AutomationProperties.AutomationId="Listing.MockupPreview" />
                                  <Button Content="Download"
                                          Command="{Binding SaveCopyCommand}"
                                          AutomationProperties.Name="Download mockup"
                                          AutomationProperties.AutomationId="Listing.MockupDownload" />
                                  <Button Content="Delete"
                                          Command="{Binding RequestRemoveCommand}"
                                          AutomationProperties.Name="Delete mockup"
                                          AutomationProperties.AutomationId="Listing.MockupRemove" />
                                </StackPanel>
                                <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3"
                                        Margin="0,8,0,0"
                                        IsVisible="{Binding IsRemovalConfirmationVisible}"
                                        Background="{DynamicResource ElevatedSurfaceBrush}"
                                        Padding="6">
                                  <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding RemovalPromptMessage}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                      <Button Content="Confirm delete" Command="{Binding ConfirmRemoveCommand}" />
                                      <Button Content="Cancel" Command="{Binding CancelRemoveCommand}" />
                                    </StackPanel>
                                  </StackPanel>
                                </Border>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <Border Padding="14"
                          Background="{DynamicResource ElevatedSurfaceBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Related assets"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource StrongTextBrush}" />
                      <ItemsControl ItemsSource="{Binding ItemInspector.Assets}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="appItems:ItemInspectorAssetEntry">
                            <StackPanel Margin="0,0,0,4" Spacing="2">
                              <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource StrongTextBrush}" />
                              <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                              <TextBlock IsVisible="{Binding IsMissing}"
                                         Text="Missing file"
                                         FontSize="11"
                                         Foreground="{DynamicResource DangerTextBrush}" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock IsVisible="{Binding !ItemInspector.HasAssets}"
                                 Text="No assets attached yet."
                                 FontSize="12"
                                 Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                  </Border>

                  <Border Padding="14"
                          Background="{DynamicResource ElevatedSurfaceBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Lifecycle"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource StrongTextBrush}" />
                      <StackPanel Orientation="Horizontal"
                                  Spacing="8"
                                  HorizontalAlignment="Left">
                        <Button Content="Archive"
                                IsVisible="{Binding ItemInspector.CanArchive}"
                                Command="{Binding RequestArchiveItemCommand}"
                                ToolTip.Tip="Archive this Item without deleting it"
                                Classes="storeSecondary" />
                        <Button Content="Restore"
                                IsVisible="{Binding ItemInspector.CanRestore}"
                                Command="{Binding RestoreItemCommand}"
                                ToolTip.Tip="Restore this Item to its preserved topic"
                                Classes="storeSecondary" />
                        <Button Content="Delete…"
                                IsVisible="{Binding ItemInspector.HasState}"
                                IsEnabled="{Binding ItemInspector.CanDelete}"
                                Command="{Binding RequestDeleteItemCommand}"
                                ToolTip.Tip="Permanently delete this Item"
                                Classes="storeSecondary" />
                      </StackPanel>
                      <Border IsVisible="{Binding ItemInspector.ArchiveConfirmationVisible}"
                              Padding="10"
                              Background="{DynamicResource WarningBackgroundBrush}"
                              CornerRadius="6">
                        <StackPanel Spacing="8">
                          <TextBlock Text="Archive this Item? It leaves active navigation but stays recoverable."
                                     TextWrapping="Wrap"
                                     FontSize="12"
                                     Foreground="{DynamicResource StrongTextBrush}" />
                          <StackPanel Orientation="Horizontal"
                                      Spacing="8"
                                      HorizontalAlignment="Left">
                            <Button Content="Archive"
                                    Command="{Binding ItemInspector.ConfirmArchiveCommand}"
                                    Classes="storeAction" />
                            <Button Content="Cancel"
                                    Command="{Binding ItemInspector.CancelArchiveCommand}"
                                    Classes="storeSecondary" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                      <Border IsVisible="{Binding ItemInspector.DeleteConfirmationVisible}"
                              Padding="10"
                              Background="{DynamicResource DangerBackgroundBrush}"
                              CornerRadius="6">
                        <StackPanel Spacing="8">
                          <TextBlock Text="Permanently delete this Item? Connected creative records will block deletion."
                                     TextWrapping="Wrap"
                                     FontSize="12"
                                     Foreground="{DynamicResource StrongTextBrush}" />
                          <StackPanel Orientation="Horizontal"
                                      Spacing="8"
                                      HorizontalAlignment="Left">
                            <Button Content="Delete permanently"
                                    Command="{Binding ItemInspector.ConfirmDeleteCommand}"
                                    Classes="storeAction" />
                            <Button Content="Cancel"
                                    Command="{Binding ItemInspector.CancelDeleteCommand}"
                                    Classes="storeSecondary" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>

                  <TextBlock IsVisible="{Binding ItemInspector.HasError}"
                             Text="{Binding ItemInspector.ErrorMessage}"
                             TextWrapping="Wrap"
                             FontSize="12"
                             Foreground="{DynamicResource DangerTextBrush}" />
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding IsStatusConfirmationVisible}"
                    Padding="12"
                    Background="{DynamicResource WarningBackgroundBrush}"
                    BorderBrush="{DynamicResource WarningBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
              <StackPanel Spacing="8">
                <TextBlock Text="Confirm lifecycle change"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusConfirmationMessage}"
                                   TextWrapping="Wrap" />
                        <Border IsVisible="{Binding DesignTool.IsListingMigrationReviewVisible}"
                                Padding="10"
                                Background="{DynamicResource WarningSurfaceBrush}"
                                BorderBrush="{DynamicResource WarningTextBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                AutomationProperties.Name="Offering migration review">
                          <StackPanel Spacing="8">
                            <TextBlock Text="Review fulfillment migration" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DesignTool.ListingMigrationReviewSummary}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Button Content="Confirm migration" Command="{Binding DesignTool.ConfirmListingMigrationCommand}" AutomationProperties.AutomationId="Design.ConfirmListingMigration" />
                              <Button Content="Cancel" Command="{Binding DesignTool.CancelListingMigrationCommand}" AutomationProperties.AutomationId="Design.CancelListingMigration" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Confirm"
                          Command="{Binding ConfirmStatusChangeCommand}"
                          Classes="storeAction" />
                  <Button x:Name="CancelStatusChangeButton"
                          Content="Cancel"
                          Command="{Binding CancelStatusChangeCommand}"
                          Classes="storeSecondary" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border IsVisible="{Binding GroupDetails.HasState}"
                    MinHeight="360"
                    Padding="22"
                    Background="{DynamicResource PanelSurfaceBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="14">
                  <ProgressBar IsVisible="{Binding GroupDetails.IsBusy}"
                               IsIndeterminate="True"
                               Height="4"
                               AutomationProperties.Name="Working with group" />
                  <TextBlock IsVisible="{Binding GroupDetails.IsReadOnly}"
                             Text="{Binding GroupDetails.InactiveNotice}"
                             TextWrapping="Wrap"
                             FontSize="12"
                             Foreground="{DynamicResource DangerTextBrush}" />
                  <TextBlock Text="{Binding GroupDetails.DisplayPath}"
                             FontSize="12"
                             Foreground="{DynamicResource SecondaryTextBrush}" />

                  <Border Padding="14"
                          Background="{DynamicResource ElevatedSurfaceBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Group details"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource StrongTextBrush}" />
                      <StackPanel Spacing="6">
                        <TextBlock Text="Group name"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBox Text="{Binding GroupDetails.Name}"
                                 IsReadOnly="{Binding !GroupDetails.CanEdit}"
                                 MinHeight="32"
                                 PlaceholderText="Group name"
                                 LostFocus="OnDetailsFieldLostFocus" />
                        <TextBlock Text="Description"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBox Text="{Binding GroupDetails.Description}"
                                 IsReadOnly="{Binding !GroupDetails.CanEdit}"
                                 MinHeight="32"
                                 PlaceholderText="Description or purpose"
                                 LostFocus="OnDetailsFieldLostFocus" />
                        <TextBlock Text="Notes"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBox Text="{Binding GroupDetails.Notes}"
                                 IsReadOnly="{Binding !GroupDetails.CanEdit}"
                                 AcceptsReturn="True"
                                 MinHeight="80"
                                 PlaceholderText="Notes and working context"
                                 LostFocus="OnDetailsFieldLostFocus" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border Padding="14"
                          Background="{DynamicResource ElevatedSurfaceBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Location"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource StrongTextBrush}" />
                      <ComboBox ItemsSource="{Binding GroupDetails.Destinations}"
                                SelectedItem="{Binding GroupDetails.SelectedDestination}"
                                IsEnabled="{Binding GroupDetails.CanEdit}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="appGroups:GroupDestination">
                            <TextBlock Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <StackPanel Orientation="Horizontal"
                                  Spacing="8"
                                  HorizontalAlignment="Left">
                        <Button Content="Move"
                                IsEnabled="{Binding GroupDetails.CanMove}"
                                Command="{Binding GroupDetails.MoveCommand}"
                                ToolTip.Tip="Move this group and its contents to the selected location"
                                Classes="storeSecondary" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border Padding="14"
                          Background="{DynamicResource ElevatedSurfaceBrush}"
                          BorderBrush="{DynamicResource ControlBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Lifecycle"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource StrongTextBrush}" />
                      <StackPanel Orientation="Horizontal"
                                  Spacing="8"
                                  HorizontalAlignment="Left">
                        <Button Content="Archive"
                                IsVisible="{Binding GroupDetails.CanArchive}"
                                Command="{Binding GroupDetails.RequestArchiveCommand}"
                                ToolTip.Tip="Archive this group and its subtree without deleting them"
                                Classes="storeSecondary" />
                        <Button Content="Restore"
                                IsVisible="{Binding GroupDetails.CanRestore}"
                                Command="{Binding GroupDetails.RestoreCommand}"
                                ToolTip.Tip="Restore this group and its subtree"
                                Classes="storeSecondary" />
                      </StackPanel>
                      <Border IsVisible="{Binding GroupDetails.ArchiveConfirmationVisible}"
                              Padding="10"
                              Background="{DynamicResource WarningBackgroundBrush}"
                              CornerRadius="6">
                        <StackPanel Spacing="8">
                          <TextBlock Text="Archive this group? The group and its subtree leave active navigation, but all child work and context remain preserved."
                                     TextWrapping="Wrap"
                                     FontSize="12"
                                     Foreground="{DynamicResource StrongTextBrush}" />
                          <StackPanel Orientation="Horizontal"
                                      Spacing="8"
                                      HorizontalAlignment="Left">
                            <Button Content="Archive"
                                    Command="{Binding GroupDetails.ConfirmArchiveCommand}"
                                    Classes="storeAction" />
                            <Button Content="Cancel"
                                    Command="{Binding GroupDetails.CancelArchiveCommand}"
                                    Classes="storeSecondary" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>

                  <TextBlock IsVisible="{Binding GroupDetails.HasError}"
                             Text="{Binding GroupDetails.ErrorMessage}"
                             TextWrapping="Wrap"
                             FontSize="12"
                             Foreground="{DynamicResource DangerTextBrush}" />
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,Auto,Auto"
                  IsVisible="{Binding HasActiveItem}"
                  Margin="0,4,0,0">
              <TextBlock Grid.Column="0"
                         Text="{Binding StageMoveError}"
                         IsVisible="{Binding StageMoveError}"
                         FontSize="12"
                         Foreground="{DynamicResource DangerTextBrush}"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap" />
              <Button Grid.Column="1"
                      Content="{Binding StageMoveBackLabel}"
                      IsEnabled="{Binding CanMoveStageBack}"
                      Command="{Binding MoveStageBackCommand}"
                      Classes="stageMove"
                      Margin="0,0,6,0" />
              <Button Grid.Column="2"
                      Content="{Binding StageMoveForwardLabel}"
                      IsEnabled="{Binding CanMoveStageForward}"
                      Command="{Binding MoveStageForwardCommand}"
                      Classes="stageMove" />
            </Grid>
          </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="1"
                      IsVisible="{Binding !DocumentWindow.HasActiveDocument}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="8">
            <TextBlock Text="{Binding DocumentWindow.EmptyStateTitle}"
                       HorizontalAlignment="Center"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock Text="{Binding DocumentWindow.EmptyStateMessage}"
                       HorizontalAlignment="Center"
                       FontSize="13"
                       Foreground="{DynamicResource EmptyStateTextBrush}" />
          </StackPanel>

          <Border Grid.Row="1"
                  IsVisible="{Binding ShowSelectionSummary}"
                  Background="{DynamicResource ElevatedSurfaceBrush}"
                  Padding="4">
            <StackPanel Spacing="14">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding WorkspaceTree.InspectorKind}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding WorkspaceTree.InspectorTitle}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="{Binding WorkspaceTree.InspectorPath}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
              </StackPanel>
              <Border Padding="18" Background="{DynamicResource PanelSurfaceBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                  <TextBlock Text="Properties" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" />
                  <TextBlock Text="{Binding WorkspaceTree.InspectorDescription}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBlock Text="Selection updates this inspector without opening a tab. Ctrl-click the tree node to keep it in a tab."
                             TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.ColumnSpan="2"
            IsVisible="{Binding WorkspaceManagement.ShouldShowNoWorkspaceState}"
            Background="{DynamicResource OverlayScrimBrush}">
      <Border Width="420"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Padding="20"
              Background="{DynamicResource ElevatedSurfaceBrush}"
              BorderBrush="{DynamicResource ControlBorderBrush}"
              BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="Create your first workspace?"
                     FontSize="22"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}" />
          <TextBlock Text="FusionCanvas needs a workspace before stores can be organized."
                     TextWrapping="Wrap"
                     FontSize="13"
                     Foreground="{DynamicResource SecondaryTextBrush}" />
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="8">
            <Button x:Name="NoWorkspaceImportButton"
                    Content="Import workspace…"
                    IsEnabled="{Binding WorkspaceManagement.CanImportWorkspace}"
                    Command="{Binding WorkspaceManagement.ImportWorkspaceCommand}"
                    Classes="storeAction fixedDialog" />
            <Button Content="Create workspace"
                    IsEnabled="{Binding !WorkspaceManagement.IsTransferRunning}"
                    Command="{Binding WorkspaceManagement.CreateWorkspaceCommand}"
                    Classes="storeAction fixedDialog" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <Border Grid.ColumnSpan="2"
            IsVisible="{Binding ShouldShowFirstStorePrompt}"
            Background="{DynamicResource OverlayScrimBrush}">
      <Border Width="420"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Padding="20"
              Background="{DynamicResource ElevatedSurfaceBrush}"
              BorderBrush="{DynamicResource ControlBorderBrush}"
              BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="Create your first store?"
                     FontSize="22"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}" />
          <TextBlock Text="FusionCanvas needs a store before workspace content can be organized."
                     TextWrapping="Wrap"
                     FontSize="13"
                     Foreground="{DynamicResource SecondaryTextBrush}" />
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="8">
            <Button Content="Create store"
                    Command="{Binding StoreManagement.AcceptFirstStorePromptCommand}"
                    Classes="storeAction fixedDialog" />
            <Button Content="Not now"
                    Command="{Binding StoreManagement.DeclineFirstStorePromptCommand}"
                    Classes="storeSecondary fixedDialog" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
  <Window.Styles>
    <Style Selector="TreeViewItem" x:DataType="nav:WorkspaceTreeNodeViewModel">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="Border.treeRow">
      <Setter Property="Padding" Value="5,2" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.treeRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
    </Style>
    <Style Selector="Border.treeRow.multiSelected">
      <Setter Property="Background" Value="{DynamicResource SelectionSubtleBackgroundBrush}" />
    </Style>
    <Style Selector="Border.treeRow.selected">
      <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
    </Style>
    <Style Selector="Border.treeRow.inactive">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Border.treeRow.inactive:pointerover">
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="Border.treeRow.cut">
      <Setter Property="Opacity" Value="0.48" />
    </Style>
    <Style Selector="Border.treeRow.inactive">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Border.treeRow.dropTarget">
      <Setter Property="Background" Value="{DynamicResource DropTargetBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.treeRow.dropBefore">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentStrongBrush}" />
      <Setter Property="BorderThickness" Value="0,2,0,0" />
    </Style>
    <Style Selector="Border.treeRow.dropAfter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentStrongBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
    <Style Selector="Button.navigation">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Background" Value="{DynamicResource PanelSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.storeSelector">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource AccentSoftBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentSoftForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.storeSelector.selected">
      <Setter Property="Background" Value="{DynamicResource CommandBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CommandForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CommandBorderBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.storeAction">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource CommandBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CommandForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CommandBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.fixedDialog">
      <Setter Property="Width" Value="116" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.storeSecondary">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.storeSecondary.active">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentSoftForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBorderBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.iconButton">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.updateButton">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Background" Value="{DynamicResource AccentSoftBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentSoftForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.ideaRatingStar">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Foreground" Value="#7A8088" />
    </Style>
    <Style Selector="TextBlock.ideaRatingStar.selected">
      <Setter Property="Foreground" Value="#F6C445" />
    </Style>
    <Style Selector="Border.tabFrame">
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="5,5,0,0" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.tabFrame.active">
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TabBorderBrush}" />
      <Setter Property="BorderThickness" Value="1,1,1,0" />
    </Style>
    <Style Selector="Button.tab">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="10,0,4,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.tab.active">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.closeTab">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Margin" Value="0,6,4,6" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.closeTab:pointerover">
      <Setter Property="Background" Value="{DynamicResource CloseTabHoverBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <Style Selector="Button.available">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentSoftForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.current">
      <Setter Property="Background" Value="{DynamicResource CommandBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CommandForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CommandBorderBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.unavailable">
      <Setter Property="Background" Value="{DynamicResource UnavailableBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource UnavailableForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    </Style>
    <Style Selector="Button.activeView:not(.current)">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentStrongBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.stageMove">
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.stageMove:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="TextBox.readOnlyContext">
      <Setter Property="Background" Value="{DynamicResource UnavailableBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    </Style>
    <Style Selector="ComboBox.statusSelector">
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.toolSelector">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="MinWidth" Value="72" />
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.emphasized">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
  </Window.Styles>
</Window>
