<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:FusionCanvas.App.Settings"
             x:Class="FusionCanvas.App.Settings.WorkspaceTelemetrySettingsView"
             x:DataType="settings:WorkspaceTelemetrySettingsViewModel">
  <Border Padding="{DynamicResource Token.Layout.CardPadding}"
          Background="{DynamicResource ElevatedSurfaceBrush}"
          BorderBrush="{DynamicResource ControlBorderBrush}"
          BorderThickness="1"
          CornerRadius="6">
    <StackPanel Spacing="{DynamicResource Token.Spacing.GroupGap}">
      <StackPanel Spacing="{DynamicResource Token.Spacing.Gap.Tight}">
        <TextBlock Text="Diagnostics" FontSize="{DynamicResource Token.Typography.SectionHeading}" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" />
        <TextBlock Text="Telemetry is stored locally for this workspace. Captured service bodies may include creative content. Recognized credentials are redacted, and records expire automatically."
                   FontSize="{DynamicResource Token.Typography.Caption}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
      </StackPanel>
      <TextBlock IsVisible="{Binding HasNoWorkspace}" Text="Select an active workspace to manage diagnostics." TextWrapping="Wrap" />
      <StackPanel IsEnabled="{Binding HasWorkspace}" Spacing="{DynamicResource Token.Spacing.Gap.ControlPlus}">
        <ToggleSwitch Content="Debug Mode"
                      IsChecked="{Binding DebugModeEnabled, Mode=TwoWay}"
                      AutomationProperties.AutomationId="Telemetry.DebugMode"
                      OffContent="Off" OnContent="On" />
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Token.Spacing.GroupGap}" VerticalAlignment="Center">
          <TextBlock Text="Automatically delete telemetry after" VerticalAlignment="Center" />
          <ComboBox Width="150" ItemsSource="{Binding RetentionPeriods}" SelectedItem="{Binding RetentionPeriod, Mode=TwoWay}" />
        </StackPanel>
        <ToggleSwitch Content="Show Debug Window"
                      IsChecked="{Binding ShowDebugWindow, Mode=TwoWay}"
                      AutomationProperties.AutomationId="Telemetry.ShowDebugWindow"
                      OffContent="Hidden" OnContent="Shown" />
      </StackPanel>

      <Border IsEnabled="{Binding HasWorkspace}" Padding="{DynamicResource Token.Layout.Padding.Uniform.Group}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4">
        <StackPanel Spacing="{DynamicResource Token.Spacing.ControlGap}">
          <TextBlock Text="Search telemetry" FontWeight="SemiBold" />
          <TextBlock Text="Enter optional UTC timestamps in ISO 8601 format. The end time is exclusive." FontSize="{DynamicResource Token.Typography.Caption}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource Token.Spacing.ControlGap}">
            <TextBox Grid.Column="0" PlaceholderText="From (UTC)" Text="{Binding FromText, Mode=TwoWay}" />
            <TextBox Grid.Column="1" PlaceholderText="To (UTC)" Text="{Binding ToText, Mode=TwoWay}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Token.Spacing.ControlGap}">
            <ComboBox Width="220" ItemsSource="{Binding Areas}" SelectedItem="{Binding SelectedArea, Mode=TwoWay}" />
            <Button Content="Search" Command="{Binding SearchCommand}" />
            <Button Content="Export telemetry" Command="{Binding ExportCommand}" />
            <Button Content="Delete telemetry" Command="{Binding RequestDeleteCommand}" Classes="danger" />
          </StackPanel>
          <ProgressBar IsVisible="{Binding IsBusy}"
                       IsIndeterminate="True"
                       Height="4"
                       AutomationProperties.Name="Working with telemetry" />
          <TextBox Text="{Binding ResultText, Mode=OneWay}"
                   IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                   FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="11" MinHeight="70" MaxHeight="200"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" />
          <Border IsVisible="{Binding ConfirmDelete}" Padding="{DynamicResource Token.Layout.PreviewPadding}" Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel Spacing="{DynamicResource Token.Spacing.InlineGap}">
              <TextBlock Text="{Binding DeleteConfirmationText}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Token.Spacing.ControlGap}">
                <Button Content="Delete" Command="{Binding ConfirmDeleteCommand}" Classes="danger" />
                <Button Content="Cancel" Command="{Binding CancelDeleteCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="{DynamicResource Token.Typography.Caption}" Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
