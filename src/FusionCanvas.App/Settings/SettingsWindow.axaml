<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:FusionCanvas.App.Settings"
        x:Class="FusionCanvas.App.Settings.SettingsWindow"
        x:DataType="settings:SettingsViewModel"
        Title="Settings"
        Width="860"
        Height="680"
        MinWidth="720"
        MinHeight="520"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}">
  <Grid ColumnDefinitions="180,*">
    <Border Grid.Column="0"
            Background="{DynamicResource PanelSurfaceBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="0,0,1,0"
            Padding="{DynamicResource Token.Layout.Padding.Uniform.Panel}">
      <StackPanel Spacing="{DynamicResource Token.Spacing.InlineGap}">
        <TextBlock Text="Settings"
                   FontSize="{DynamicResource Token.Typography.SubsectionHeading}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource StrongTextBrush}"
                   Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_None.Right_None.Bottom_Control}" />
        <ListBox x:Name="SectionSelector"
                 AutomationProperties.AutomationId="Settings.SectionSelector"
                 ItemsSource="{Binding Sections}"
                 SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="settings:SettingsSection">
              <TextBlock Text="{Binding}" FontSize="{DynamicResource Token.Typography.SectionHeading}" Padding="{DynamicResource Token.Layout.Padding.HorizontalVertical.Inline.Compact}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Column="1">
      <Grid Margin="{DynamicResource Token.Layout.PageInset}">
        <StackPanel IsVisible="{Binding IsGeneralSection}" Spacing="{DynamicResource Token.Spacing.Gap.Large}">
          <TextBlock Text="General"
                     FontSize="{DynamicResource Token.Typography.SurfaceHeading}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}" />
          <Border Padding="{DynamicResource Token.Layout.CardPadding}"
                  Background="{DynamicResource ElevatedSurfaceBrush}"
                  BorderBrush="{DynamicResource ControlBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6">
            <StackPanel Spacing="{DynamicResource Token.Spacing.GroupGap}">
              <StackPanel Spacing="{DynamicResource Token.Spacing.Gap.Tight}">
                <TextBlock Text="Appearance"
                           FontSize="{DynamicResource Token.Typography.SectionHeading}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource StrongTextBrush}" />
                <TextBlock Text="Choose the application-wide color appearance."
                           FontSize="{DynamicResource Token.Typography.Caption}"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
              </StackPanel>
              <ToggleSwitch Content="Dark mode"
                            IsChecked="{Binding IsDarkMode, Mode=TwoWay}"
                            OffContent="Light"
                            OnContent="Dark"
                            ToolTip.Tip="Switch between Light and Dark appearance" />
              <TextBlock IsVisible="{Binding HasMessage}"
                         Text="{Binding ErrorMessage}"
                         TextWrapping="Wrap"
                         FontSize="{DynamicResource Token.Typography.Caption}"
                         Foreground="{DynamicResource DangerTextBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsWorkspaceSection}" Spacing="{DynamicResource Token.Spacing.Gap.Large}">
          <TextBlock Text="Workspace"
                     FontSize="{DynamicResource Token.Typography.SurfaceHeading}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}" />
          <Border Padding="{DynamicResource Token.Layout.CardPadding}"
                  Background="{DynamicResource ElevatedSurfaceBrush}"
                  BorderBrush="{DynamicResource ControlBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6">
            <StackPanel Spacing="{DynamicResource Token.Spacing.Gap.Panel}">
              <StackPanel Spacing="{DynamicResource Token.Spacing.Gap.Tight}">
                <TextBlock Text="Active workspace"
                           FontSize="{DynamicResource Token.Typography.Caption}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Text="{Binding WorkspaceName}"
                           FontSize="{DynamicResource Token.Typography.SubsectionHeading}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button Content="Manage workspaces"
                      Command="{Binding ManageWorkspacesCommand}"
                      ToolTip.Tip="Open workspace management"
                      HorizontalAlignment="Left"
                      MinWidth="160"
                      Classes="primary" />
            </StackPanel>
          </Border>
          <settings:WorkspaceTelemetrySettingsView DataContext="{Binding Telemetry}" />
        </StackPanel>

        <StackPanel IsVisible="{Binding IsTermsSection}" Spacing="{DynamicResource Token.Spacing.Gap.Large}">
          <TextBlock Text="Terms and responsible use"
                     FontSize="{DynamicResource Token.Typography.SurfaceHeading}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}" />
          <Border Padding="{DynamicResource Token.Layout.CardPadding}"
                  Background="{DynamicResource ElevatedSurfaceBrush}"
                  BorderBrush="{DynamicResource ControlBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6">
            <StackPanel Spacing="{DynamicResource Token.Spacing.GroupGap}">
              <TextBlock Text="App-wide acknowledgement"
                         FontSize="{DynamicResource Token.Typography.SectionHeading}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource StrongTextBrush}" />
              <TextBlock Text="{Binding TermsConsentSummary}"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource PrimaryTextBrush}" />
              <TextBlock Text="Provider policies are maintained by Printify and Shopify. Review the current official documents before using connected features."
                         TextWrapping="Wrap"
                         FontSize="{DynamicResource Token.Typography.Caption}"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <Button Content="Review terms and policies"
                      Click="OnReviewTerms"
                      HorizontalAlignment="Left"
                      MinWidth="190"
                      AutomationProperties.Name="Review terms and policies"
                      Classes="primary" />
            </StackPanel>
          </Border>
        </StackPanel>

        <Panel IsVisible="{Binding IsAiSection}">
          <settings:AiSettingsView DataContext="{Binding Ai}" />
        </Panel>

        <StackPanel IsVisible="{Binding IsAboutSection}" Spacing="{DynamicResource Token.Spacing.Gap.Large}">
          <TextBlock Text="About"
                     FontSize="{DynamicResource Token.Typography.SurfaceHeading}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}" />
          <Border Padding="{DynamicResource Token.Layout.CardPadding}"
                  Background="{DynamicResource ElevatedSurfaceBrush}"
                  BorderBrush="{DynamicResource ControlBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6">
            <StackPanel Spacing="{DynamicResource Token.Spacing.Gap.Panel}">
              <StackPanel Spacing="{DynamicResource Token.Spacing.Gap.Tight}">
                <TextBlock Text="FusionCanvas"
                           FontSize="{DynamicResource Token.Typography.SubsectionHeading}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource StrongTextBrush}" />
                <TextBlock Text="{Binding Version.ProductVersion, StringFormat='Version {0}'}"
                           FontSize="{DynamicResource Token.Typography.SectionHeading}"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
              </StackPanel>
              <Border Padding="{DynamicResource Token.Layout.Padding.Uniform.Group}"
                      Background="{DynamicResource PanelSurfaceBrush}"
                      BorderBrush="{DynamicResource ControlBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="5">
                <StackPanel Spacing="{DynamicResource Token.Spacing.ControlGap}">
                  <TextBlock Text="Updates"
                             FontSize="{DynamicResource Token.Typography.SectionHeading}"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource StrongTextBrush}" />
                  <StackPanel Spacing="{DynamicResource Token.Spacing.CompactGap}">
                    <TextBlock Text="Update track" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <ComboBox ItemsSource="{Binding Updates.AvailableTracks}"
                              SelectedItem="{Binding Updates.SelectedTrack, Mode=TwoWay}"
                              IsEnabled="{Binding Updates.CanChangeTrack}"
                              AutomationProperties.Name="Update track"
                              AutomationProperties.AutomationId="Updates.Track" />
                  </StackPanel>
                  <TextBlock Text="{Binding Updates.StatusMessage}"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource PrimaryTextBrush}" />
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Token.Spacing.ControlGap}">
                    <Button Content="Check for updates"
                            Command="{Binding Updates.CheckCommand}"
                            IsVisible="{Binding Updates.IsCheckButtonVisible}"
                            AutomationProperties.AutomationId="Updates.Check" />
                    <Button Content="Cancel"
                            Command="{Binding Updates.CancelCommand}"
                            IsVisible="{Binding Updates.IsCancelVisible}"
                            AutomationProperties.AutomationId="Updates.Cancel" />
                    <Button Content="Download update"
                            Command="{Binding Updates.UpdateCommand}"
                            IsVisible="{Binding Updates.IsDownloadCommandVisible}"
                            Classes="primary"
                            AutomationProperties.AutomationId="Updates.Download" />
                    <Button Content="Install update"
                            Command="{Binding Updates.InstallCommand}"
                            IsVisible="{Binding Updates.IsReadyToInstall}"
                            Classes="primary"
                            AutomationProperties.AutomationId="Updates.Install" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <StackPanel Spacing="{DynamicResource Token.Spacing.Gap.Tight}">
                <TextBlock Text="Diagnostics"
                           FontSize="{DynamicResource Token.Typography.Caption}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBox Text="{Binding DiagnosticsText, Mode=OneWay}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                         FontSize="12"
                         MinHeight="84"
                         BorderBrush="{DynamicResource ControlBorderBrush}"
                         Background="{DynamicResource PanelSurfaceBrush}" />
                <Button Content="Copy diagnostics"
                        Command="{Binding CopyDiagnosticsCommand}"
                        ToolTip.Tip="Copy version, commit, and platform to the clipboard"
                        HorizontalAlignment="Left"
                        MinWidth="160"
                        Classes="primary" />
                <Button Content="Open design system gallery"
                        Click="OnOpenDesignSystemGallery"
                        ToolTip.Tip="Inspect shared UI tokens, controls, states, and compositions"
                        HorizontalAlignment="Left"
                        MinWidth="220"
                        AutomationProperties.AutomationId="Settings.OpenDesignSystemGallery"
                        Classes="primary" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <Border IsVisible="{Binding ConfirmDiscardCredentialDraft}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="420"
                Padding="{DynamicResource Token.Layout.Padding.Uniform.SectionPlus}"
                Background="{DynamicResource WarningBackgroundBrush}"
                BorderBrush="{DynamicResource WarningBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
          <StackPanel Spacing="{DynamicResource Token.Spacing.GroupGap}">
            <TextBlock Text="Discard the unsaved API key draft?"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Text="The draft has not been written to the native credential store."
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Token.Spacing.ControlGap}">
              <Button Content="Discard" Command="{Binding ConfirmDiscardCommand}" />
              <Button Content="Keep editing" Command="{Binding CancelDiscardCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
    <ProgressBar Grid.ColumnSpan="2"
                 Margin="{DynamicResource Token.Layout.Margin.Sides.Left_Page.Top_Control.Right_Page.Bottom_None}"
                 VerticalAlignment="Top"
                 IsVisible="{Binding IsBusy}"
                 IsIndeterminate="True"
                 Height="4"
                 AutomationProperties.Name="Saving settings" />
  </Grid>
  <Window.Styles>
    <Style Selector="Button.primary">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource CommandBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CommandForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CommandBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Window.Styles>
</Window>
