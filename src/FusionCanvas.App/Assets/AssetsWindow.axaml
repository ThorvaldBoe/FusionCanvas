<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:assets="using:FusionCanvas.App.Assets"
        x:Class="FusionCanvas.App.Assets.AssetsWindow"
        x:DataType="assets:AssetsViewModel"
        Title="Assets"
        Width="780"
        Height="620"
        MinWidth="560"
        MinHeight="440"
        Background="{DynamicResource ApplicationBackgroundBrush}">
  <Grid RowDefinitions="Auto,*,Auto" Margin="{DynamicResource Token.Layout.Margin.Uniform.Wide}">
    <StackPanel Grid.Row="0" Spacing="{DynamicResource Token.Spacing.CompactGap}" Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_None.Right_None.Bottom_Section}">
      <TextBlock Text="{Binding ContextKindLabel}" FontSize="{DynamicResource Token.Typography.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
      <TextBlock Text="{Binding ContextTitle}" FontSize="{DynamicResource Token.Typography.PageHeading}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
      <TextBlock Text="Import files to attach them to this context and preserve their managed workspace copy." TextWrapping="Wrap" FontSize="{DynamicResource Token.Typography.Label}" Foreground="{DynamicResource SecondaryTextBrush}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_None.Right_None.Bottom_Section}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="{DynamicResource Token.Spacing.GroupGap}">
        <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextWrapping="Wrap" FontSize="{DynamicResource Token.Typography.Caption}" Foreground="{DynamicResource DangerTextBrush}" />

        <Border IsVisible="{Binding IsEmpty}"
                Padding="{DynamicResource Token.Layout.Padding.Uniform.Large}"
                Background="{DynamicResource PanelSurfaceBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
          <StackPanel Spacing="{DynamicResource Token.Spacing.InlineGap}">
            <TextBlock Text="No assets yet" FontSize="{DynamicResource Token.Typography.SectionHeading}" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" />
            <TextBlock Text="Import a design source, export, mockup, reference, texture, brush, or font to attach it here." TextWrapping="Wrap" FontSize="{DynamicResource Token.Typography.Caption}" Foreground="{DynamicResource SecondaryTextBrush}" />
          </StackPanel>
        </Border>

        <ItemsControl x:Name="AssetsList"
                      ItemsSource="{Binding Assets}"
                      AutomationProperties.AutomationId="Assets.List"
                      AutomationProperties.Name="Assets">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="assets:AssetRowViewModel">
              <Border Padding="{DynamicResource Token.Layout.Padding.Uniform.Panel}" Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="{DynamicResource Token.Layout.Margin.Sides.Left_None.Top_None.Right_None.Bottom_Control}">
                <Grid ColumnDefinitions="72,*,180,Auto" ColumnSpacing="{DynamicResource Token.Spacing.GroupGap}">
                  <Button Grid.Column="0"
                          IsVisible="{Binding CanPreview}"
                          Click="OnPreviewClick"
                          Tag="{Binding .}"
                          Padding="0"
                          Background="Transparent"
                          BorderThickness="0"
                          ToolTip.Tip="Open a larger preview"
                          AutomationProperties.AutomationId="Assets.Preview">
                    <Image Source="{Binding Thumbnail}" Width="64" Height="64" Stretch="UniformToFill" />
                  </Button>
                  <StackPanel Grid.Column="1" Spacing="{DynamicResource Token.Spacing.Gap.Micro}">
                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Token.Typography.SectionHeading}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Name}" />
                    <TextBlock Text="{Binding ManagedFileName}" FontSize="{DynamicResource Token.Typography.Label}" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ManagedFileName}" AutomationProperties.Name="{Binding ManagedFileName}" AutomationProperties.HelpText="{Binding ManagedFileName}" />
                    <TextBlock Text="Missing managed file" IsVisible="{Binding IsMissing}" FontSize="{DynamicResource Token.Typography.Label}" Foreground="{DynamicResource DangerTextBrush}" AutomationProperties.Name="Missing managed file" />
                    <TextBlock Text="{Binding ContextLabel}" IsVisible="{Binding ContextLabel, Converter={x:Static ObjectConverters.IsNotNull}}" FontSize="{DynamicResource Token.Typography.Label}" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ContextLabel}" AutomationProperties.Name="{Binding ContextLabel}" AutomationProperties.HelpText="{Binding ContextLabel}" />
                  </StackPanel>
                  <ComboBox Grid.Column="2"
                            ItemsSource="{Binding Parent.AvailablePurposes}"
                            SelectedItem="{Binding SelectedPurpose}"
                            IsEnabled="{Binding !Parent.IsBusy}"
                            ToolTip.Tip="Asset purpose"
                            MinHeight="32"
                            AutomationProperties.AutomationId="Assets.Purpose" />
                  <Button Grid.Column="3"
                          Content="Remove…"
                          Command="{Binding $parent[ItemsControl].DataContext.RequestRemoveCommand}"
                          CommandParameter="{Binding}"
                          IsEnabled="{Binding !Parent.IsBusy}"
                          ToolTip.Tip="Permanently remove asset and managed file"
                          Classes="danger"
                          AutomationProperties.AutomationId="Assets.Remove" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border IsVisible="{Binding HasImportPending}"
                Padding="{DynamicResource Token.Layout.CardPadding}"
                Background="{DynamicResource AccentSoftBackgroundBrush}"
                BorderBrush="{DynamicResource AccentSoftBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
          <StackPanel Spacing="{DynamicResource Token.Spacing.ControlGap}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Token.Spacing.ControlGap}">
              <StackPanel Grid.Column="0" Spacing="{DynamicResource Token.Spacing.Gap.Micro}">
                <TextBlock Text="Confirm import" FontSize="{DynamicResource Token.Typography.Body}" FontWeight="SemiBold" Foreground="{DynamicResource AccentSoftForegroundBrush}" />
                <TextBlock Text="{Binding PendingImportFileName}" FontSize="{DynamicResource Token.Typography.Label}" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding AvailablePurposes}"
                        SelectedItem="{Binding PendingImportPurpose}"
                        IsEnabled="{Binding CanConfirmImport}"
                        ToolTip.Tip="Pre-selected from file extension"
                        MinWidth="160"
                        MinHeight="32"
                        AutomationProperties.AutomationId="Assets.PendingPurpose" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Token.Spacing.ControlGap}">
              <Button Content="Confirm import" Command="{Binding ConfirmImportCommand}" IsEnabled="{Binding CanConfirmImport}" Classes="primary" AutomationProperties.AutomationId="Assets.ConfirmImport" />
              <Button Content="Cancel" Command="{Binding CancelImportCommand}" Classes="secondary" AutomationProperties.AutomationId="Assets.CancelImport" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border IsVisible="{Binding RemovalConfirmationVisible}"
                Padding="{DynamicResource Token.Layout.CardPadding}"
                Background="{DynamicResource DangerBackgroundBrush}"
                BorderBrush="{DynamicResource DangerBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
          <StackPanel Spacing="{DynamicResource Token.Spacing.ControlGap}">
            <TextBlock Text="{Binding RemovalPromptMessage}" TextWrapping="Wrap" FontSize="{DynamicResource Token.Typography.Body}" Foreground="{DynamicResource DangerTextBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Token.Spacing.ControlGap}">
              <Button Content="Remove permanently" Command="{Binding ConfirmRemoveCommand}" Classes="danger" AutomationProperties.AutomationId="Assets.ConfirmRemove" />
              <Button Content="Cancel" Command="{Binding CancelRemoveCommand}" Classes="secondary" AutomationProperties.AutomationId="Assets.CancelRemove" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Token.Spacing.ControlGap}">
      <Button Grid.Column="0" Content="Import…" Command="{Binding ImportCommand}" IsEnabled="{Binding CanImport}" ToolTip.Tip="Choose a file to import" Classes="primary" AutomationProperties.AutomationId="Assets.Import" />
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="{DynamicResource Token.Spacing.ControlGap}"
                  IsVisible="{Binding IsBusy}"
                  VerticalAlignment="Center">
        <ProgressBar Width="92"
                     Height="3"
                     IsIndeterminate="True"
                     AutomationProperties.Name="Loading assets" />
        <TextBlock Text="Loading…"
                   FontSize="{DynamicResource Token.Typography.Caption}"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   VerticalAlignment="Center" />
      </StackPanel>
      <Button Grid.Column="2" Content="Close" Command="{Binding CloseCommand}" Classes="secondary" AutomationProperties.AutomationId="Assets.Close" />
    </Grid>
  </Grid>

  <Window.Styles>
    <Style Selector="Button.primary">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource CommandBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CommandForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CommandBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="{DynamicResource DangerStrongBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CommandForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Window.Styles>
</Window>
