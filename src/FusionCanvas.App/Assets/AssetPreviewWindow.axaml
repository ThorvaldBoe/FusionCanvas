<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:assets="using:FusionCanvas.App.Assets"
        x:Class="FusionCanvas.App.Assets.AssetPreviewWindow"
        x:DataType="assets:AssetRowViewModel"
        Title="Asset preview"
        Width="800" Height="600" MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}">
  <DockPanel Margin="16">
    <Button DockPanel.Dock="Bottom" Content="Close" Click="OnCloseClick" HorizontalAlignment="Center" MinWidth="90" Margin="0,12,0,0" />
    <Border Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
      <Image Source="{Binding Thumbnail}" Stretch="Uniform" MaxWidth="740" MaxHeight="540" />
    </Border>
  </DockPanel>
</Window>
