<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ideation="using:FusionCanvas.App.Ideation"
        x:Class="FusionCanvas.App.Ideation.RejectIdeaWindow"
        x:DataType="ideation:IdeationViewModel"
         Title="Reject idea"
         Width="440"
         Height="300"
         CanResize="False"
         WindowStartupLocation="CenterOwner"
         Background="{DynamicResource ElevatedSurfaceBrush}">
  <Grid Margin="{DynamicResource Token.Layout.Margin.Uniform.Wide}" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="{DynamicResource Token.Spacing.GroupGap}">
    <TextBlock Text="Reject idea candidate?"
               FontSize="18"
               FontWeight="SemiBold" />
    <TextBlock Grid.Row="1"
               Text="{Binding RejectionCandidate.Text}"
               TextWrapping="Wrap"
               Foreground="{DynamicResource SecondaryTextBrush}" />
    <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="{DynamicResource Token.Spacing.Gap.CompactPlus}">
      <TextBlock Text="Reason (optional)"
                 Foreground="{DynamicResource SecondaryTextBrush}" />
      <TextBox x:Name="ReasonTextBox"
               Grid.Row="1"
               Text="{Binding RejectionReason}"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               MinHeight="64"
               MaxHeight="120"
               AutomationProperties.Name="Optional rejection reason" />
    </Grid>
    <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="{DynamicResource Token.Spacing.ControlGap}">
      <Button x:Name="CancelButton"
              Content="Cancel"
              Click="OnCancel"
              AutomationProperties.Name="Cancel rejection" />
      <Button Content="OK"
              Click="OnConfirm"
              AutomationProperties.Name="Confirm rejection" />
    </StackPanel>
  </Grid>
</Window>
