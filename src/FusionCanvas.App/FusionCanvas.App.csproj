<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationIcon>Assets\FusionCanvas.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\FusionCanvasBanner.jpg" />
    <AvaloniaResource Include="Assets\FusionCanvas.ico" />
    <AvaloniaResource Include="Assets\FusionCanvasLogo_Square.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FusionCanvas.Application\FusionCanvas.Application.csproj" />
    <ProjectReference Include="..\FusionCanvas.Integration\FusionCanvas.Integration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FusionCanvas.App.Tests" />
  </ItemGroup>
</Project>
