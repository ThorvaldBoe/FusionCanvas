<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:stageTools="using:FusionCanvas.App.StageTools"
        x:Class="FusionCanvas.App.StageTools.MockupPreviewWindow"
        x:DataType="stageTools:ListingStageToolViewModel"
        Title="{Binding PreviewTitle}"
        Width="800"
        Height="600"
        MinWidth="400"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        CanResize="True">
  <DockPanel LastChildFill="True" Margin="16">
    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="8"
                Margin="0,12,0,0">
      <Button Content="Close"
              Click="OnCloseClick"
              MinWidth="90"
              Classes="storeAction" />
    </StackPanel>
    <Border Background="{DynamicResource ElevatedSurfaceBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="8">
      <Image Source="{Binding PreviewBitmap}"
             Stretch="Uniform"
             MaxWidth="740"
             MaxHeight="540" />
    </Border>
  </DockPanel>
</Window>
