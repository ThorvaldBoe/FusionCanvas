<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FusionCanvas.App.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AvaloniaVirtualDataGrid/Themes/Generic.axaml" />
    <Style Selector="Button.compactAction">
      <Setter Property="MinHeight" Value="{DynamicResource Token.Control.CompactHeight}" />
      <Setter Property="Padding" Value="{DynamicResource Token.Layout.CompactPadding}" />
      <Setter Property="FontSize" Value="{DynamicResource Token.Typography.Label}" />
    </Style>
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://FusionCanvas.App/DesignSystem/DesignTokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
